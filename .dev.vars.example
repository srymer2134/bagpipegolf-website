SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key

# Sentry (optional — leave blank for local dev with no Sentry project).
# When both are set the Worker forwards uncaught exceptions to Sentry.
# Client-side DSN is separate — set as `PUBLIC_SENTRY_DSN` in
# Cloudflare Pages env vars so Astro exposes it to the browser bundle.
#
# `SENTRY_ENVIRONMENT` gates the `beforeSend` filter — only 'production'
# events actually forward; 'preview' / 'development' are dropped to
# keep the prod dashboard's signal-to-noise ratio meaningful.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Card payments (Stripe Connect W1–W4). Leave PAYMENTS_ENABLED unset to
# match production (nothing payment-shaped renders). For local work on
# the pages with no API: set both to 1, run `npm run dev`, and pick a
# state with `?fixture=<name>` (names = src/lib/__fixtures__/payments/).
# PAYMENTS_FIXTURES is ignored by any built Worker.
#   Roster (W5): /app/leagues/<id>/payments?payments=payments_roster
#     (all six statuses); add &fixture=error_<code> to see a refused
#     "Mark paid in cash" / "Waive", and ?roster=<code> for each result.
#   Signup dues step: /app/leagues/<id>/signup?pay=<code> or
#     ?payments=error_payments_disabled (step hidden).
PAYMENTS_ENABLED=
PAYMENTS_FIXTURES=
