SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key

# Sentry (optional — leave blank for local dev with no Sentry project).
# When both are set the Worker forwards uncaught exceptions to Sentry.
# Client-side DSN is separate — set as `PUBLIC_SENTRY_DSN` in
# Cloudflare Pages env vars so Astro exposes it to the browser bundle.
#
# `SENTRY_ENVIRONMENT` gates the `beforeSend` filter — only 'production'
# events actually forward; 'preview' / 'development' are dropped to
# keep the prod dashboard's signal-to-noise ratio meaningful.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Card payments (Stripe Connect W1–W4). Leave PAYMENTS_ENABLED unset to
# match production (nothing payment-shaped renders). For local work on
# the pages with no API: set both to 1, run `npm run dev`, and pick a
# state with `?fixture=<name>` (names = src/lib/__fixtures__/payments/).
# PAYMENTS_FIXTURES is ignored by any built Worker.
#   Roster (W5): /app/leagues/<id>/payments?payments=payments_roster
#     (all six statuses); add &fixture=error_<code> to see a refused
#     "Mark paid in cash" / "Waive", and ?roster=<code> for each result.
#   Signup dues step: /app/leagues/<id>/signup?pay=<code> or
#     ?payments=error_payments_disabled (step hidden).
#   Per-scope gate (paymentsGate.ts) — a league/tournament the API has
#   not allow-listed. Every payment control is hidden:
#     member Pay buttons: /app/leagues/<id>?payments=error_payments_disabled
#       and /app/tournaments/<id>?payments=error_payments_disabled
#     owner set-up link:  /app/leagues/<id>/manage?fixture=error_payments_disabled
#       and /app/tournaments/<id>/manage?fixture=error_payments_disabled
#     payments page 404s: /app/leagues/<id>/payments?fixture=error_payments_disabled
PAYMENTS_ENABLED=
PAYMENTS_FIXTURES=

# Keystatic (the browser CMS at /keystatic, github mode).
#
# DO NOT FILL THESE IN BY HAND. Keystatic's setup wizard writes the
# first three into a local `.env` for you on the first GitHub sign-in
# at http://localhost:4321/keystatic — it creates the GitHub App at
# the same time, and these are that app's credentials. The fourth is
# the app's slug, which is public (it ends up in the browser bundle).
#
# `.env` is where Astro reads them in dev, so the wizard's own file is
# enough locally and these four lines are only here as the contract.
# For the DEPLOYED admin they also have to exist on the Worker (the
# three secrets) and in Workers Builds (the PUBLIC_ one, which is read
# at build time — the same trap PUBLIC_SENTRY_DSN documents in
# astro.config.mjs). See docs/KEYSTATIC_SETUP.md.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
