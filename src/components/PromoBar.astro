---
// The launch-offer strip at the top of the host-facing marketing pages.
// Disappears on its own after the code's deadline (lib/offer.ts). The link
// carries `?promo=`, so clicking it alone saves the code for checkout.
import { FOUNDING_CAP, FOUNDING_CODE, PROMO_CODE, PROMO_ENDS_COPY, PROMO_PERCENT, isFoundingCode, offerActive } from '../lib/offer';
import { visitorPromo } from '../lib/promoCode';

interface Props {
  /** Where "See plans" goes. On /pricing itself it is the plan grid. */
  href?: string;
}
const { href = '/pricing#plans' } = Astro.props;
const [path, hash] = href.split('#');
// A Founding70 visitor (the Colorado outreach) sees the founding offer, and
// the link keeps their code: linking Bagpipe50 here would replace it.
const founding = isFoundingCode(visitorPromo(Astro.url, Astro.cookies));
const code = founding ? FOUNDING_CODE : PROMO_CODE;
const link = `${path}?promo=${code}${hash ? `#${hash}` : ''}`;
---

{offerActive() && founding && (
  <aside class="promobar" aria-label="Founding Club offer">
    <p>
      <strong>Founding Club offer:</strong>{' '}70% off your first year of League or Club, then the
      price locked through 2028. First {FOUNDING_CAP} clubs only, through {PROMO_ENDS_COPY}. Code
      {' '}<span class="promobar__code">{FOUNDING_CODE}</span> is applied for you.
      {' '}<a href={link}>See plans →</a>
    </p>
  </aside>
)}
{offerActive() && !founding && (
  <aside class="promobar" aria-label="Launch offer">
    <p>
      <strong>Launch offer:</strong>{' '}{PROMO_PERCENT}% off your first payment on any plan with code
      {' '}<span class="promobar__code">{PROMO_CODE}</span> — through {PROMO_ENDS_COPY}.
      {' '}<a href={link}>See plans →</a>
    </p>
  </aside>
)}

<style>
  .promobar {
    margin: 0 0 24px;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--brand-green-dark);
    color: #fff;
  }
  .promobar p { margin: 0; font-size: 0.9375rem; line-height: 1.5; }
  .promobar a { color: #fff; font-weight: 700; text-decoration: underline; white-space: nowrap; }
  .promobar__code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.16);
  }
</style>
