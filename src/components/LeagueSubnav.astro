---
interface Props {
  id: string;
  active: 'overview' | 'standings' | 'schedule' | 'signup' | 'manage' | 'coach';
  /**
   * Show the Coach tab. Owner, director or `role='coach'` — pass
   * `league.coach_access`, which is `hasCoachAccess()` in
   * `lib/leaguePortal.ts`.
   *
   * Defaults FALSE: a page that forgets to pass it hides the tab
   * rather than advertising a page the viewer cannot open. Hiding the
   * link is cosmetic either way — `coach.astro` re-checks server-side,
   * because a nav that omits a link is not an access control.
   */
  coachAccess?: boolean;
}

const { id, active, coachAccess = false } = Astro.props;

const links: Array<{ key: Props['active']; label: string }> = [
  { key: 'overview',  label: 'Overview' },
  { key: 'standings', label: 'Standings' },
  { key: 'schedule',  label: 'Schedule' },
  { key: 'signup',    label: 'Sign-up' },
  ...(coachAccess ? [{ key: 'coach' as const, label: 'Coach' }] : []),
  { key: 'manage',    label: 'Manage (Director)' },
];

const hrefFor = (key: Props['active']) =>
  key === 'overview' ? `/app/leagues/${id}` : `/app/leagues/${id}/${key}`;
---

<nav class="lnav">
  {
    links.map((l) => (
      <a
        href={hrefFor(l.key)}
        class:list={['lnav__link', l.key === active && 'is-active']}
      >
        {l.label}
      </a>
    ))
  }
</nav>

<style>
  .lnav {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 28px;
    overflow-x: auto;
  }
  .lnav__link {
    padding: 10px 14px;
    color: var(--ink-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.875rem;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .lnav__link:hover { color: var(--brand-green-dark); }
  .lnav__link.is-active {
    color: var(--brand-green-dark);
    border-bottom-color: var(--brand-green);
  }
</style>
