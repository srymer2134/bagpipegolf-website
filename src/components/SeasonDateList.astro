---
// A season as a list of dates — one field per event.
//
// Shared by /app/leagues/new and /app/leagues/[id]/schedule so the two
// calendar surfaces cannot drift.
//
// DESIGN NOTE, 2026-10-06. The first version put a numbered chip, a
// divider, a hover tint and a per-row Clear button on every line
// inside a bordered container. Sam: "way worse… make it more modern."
// He was right — that was chrome, not design. Eight date pickers do
// not need eight badges. This version removes all of it and lets a
// grid and whitespace do the work: a label, a field, and one quiet
// line once a date is chosen. Nothing else.
//
// DOM CONTRACT, relied on by both pages' submit handlers:
//   • the grid container has id={listId}
//   • every date input is `input[data-slot]`, in slot order
// So a page reads its dates with:
//   [...document.querySelectorAll('#<listId> input[data-slot]')]
//     .map((i) => i.value)

interface Props {
  /** Container id — what the page's submit handler queries. */
  listId?: string;
  /** Id of the number input holding the event count. */
  countInputId: string;
  /** Existing dates by slot, `yyyy-MM-dd`; '' where undecided. */
  initial?: string[];
  /** Default "starting" date for the spacing shortcut. */
  spaceFrom: string;
  /** Default cadence for the shortcut. Never applied on its own. */
  spaceEvery?: number;
}

const {
  listId = 'dateList',
  countInputId,
  initial = [],
  spaceFrom,
  spaceEvery = 7,
} = Astro.props;
---

<div class="sdl">
  <div class="sdl__grid" id={listId} data-count-input={countInputId}></div>

  <div class="sdl__foot">
    <p class="sdl__count" id={`${listId}_summary`}></p>
    <button type="button" class="sdl__link" id={`${listId}_toggle`}>
      Space them out
    </button>
  </div>

  <div class="sdl__spacer" id={`${listId}_spacer`} hidden>
    <label class="sdl__sfield">
      <span>Starting</span>
      <input type="date" id={`${listId}_from`} value={spaceFrom} />
    </label>
    <label class="sdl__sfield">
      <span>Every</span>
      <span class="sdl__days">
        <input type="number" id={`${listId}_every`} min="1" max="365" value={spaceEvery} />
        <span class="sdl__daysuffix">days</span>
      </span>
    </label>
    <button type="button" class="sdl__apply" id={`${listId}_fill`}>Apply</button>
    <p class="sdl__hint">Fills the fields above. Change any of them after.</p>
  </div>
</div>

<script is:inline define:vars={{ listId, initial }}>
  (() => {
    const grid = document.getElementById(listId);
    if (!grid) return;
    const count = document.getElementById(grid.dataset.countInput);
    if (!count) return;

    const WD = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

    // Parsed in parts on purpose: new Date('2026-04-15') is UTC
    // midnight, which renders as the 14th in every US timezone.
    function weekday(iso) {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso || '');
      if (!m) return '';
      return WD[new Date(Date.UTC(+m[1], +m[2] - 1, +m[3])).getUTCDay()];
    }

    function render() {
      const n = Math.max(1, Math.min(52, Number(count.value) || 0));
      const keep = [...grid.querySelectorAll('input[data-slot]')].map((i) => i.value);
      grid.innerHTML = '';
      for (let i = 0; i < n; i++) {
        const cell = document.createElement('label');
        cell.className = 'sdl__cell';

        const lab = document.createElement('span');
        lab.className = 'sdl__label';
        lab.textContent = `Event ${i + 1}`;

        const input = document.createElement('input');
        input.type = 'date';
        input.className = 'sdl__input';
        input.dataset.slot = String(i);
        input.value = keep[i] ?? (initial[i] || '');
        input.setAttribute('aria-label', `Date for event ${i + 1}`);
        input.addEventListener('change', sync);

        const note = document.createElement('span');
        note.className = 'sdl__note';

        cell.append(lab, input, note);
        grid.append(cell);
      }
      sync();
    }

    function sync() {
      const cells = [...grid.querySelectorAll('.sdl__cell')];
      const byDate = new Map();
      let filled = 0;
      for (const cell of cells) {
        const v = cell.querySelector('input[data-slot]').value;
        if (!v) continue;
        filled += 1;
        byDate.set(v, (byDate.get(v) || 0) + 1);
      }
      cells.forEach((cell) => {
        const v = cell.querySelector('input[data-slot]').value;
        const note = cell.querySelector('.sdl__note');
        const clash = !!v && byDate.get(v) > 1;
        cell.classList.toggle('is-set', !!v);
        cell.classList.toggle('is-clash', clash);
        note.textContent = clash ? 'Already used' : v ? weekday(v) : '';
      });
      const summary = document.getElementById(`${listId}_summary`);
      if (summary) {
        const clashes = cells.filter((c) => c.classList.contains('is-clash')).length;
        summary.textContent = clashes
          ? 'Two events share a date'
          : `${filled} of ${cells.length} scheduled`;
        summary.classList.toggle('is-warn', clashes > 0);
      }
    }

    const spacer = document.getElementById(`${listId}_spacer`);
    document.getElementById(`${listId}_toggle`)?.addEventListener('click', () => {
      spacer.hidden = !spacer.hidden;
    });

    document.getElementById(`${listId}_fill`)?.addEventListener('click', () => {
      const from = document.getElementById(`${listId}_from`);
      const every = document.getElementById(`${listId}_every`);
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(from?.value || '');
      if (!m) return;
      const step = Math.max(1, Math.min(365, Number(every?.value) || 7));
      grid.querySelectorAll('input[data-slot]').forEach((input, k) => {
        const dt = new Date(Date.UTC(+m[1], +m[2] - 1, +m[3]));
        dt.setUTCDate(dt.getUTCDate() + step * k);
        input.value = dt.toISOString().slice(0, 10);
      });
      spacer.hidden = true;
      sync();
    });

    count.addEventListener('input', render);
    render();
  })();
</script>

<style>
  .sdl { margin: 18px 0 4px; }

  /* Whitespace does the work. No container border, no dividers, no
     per-row ornament — a set of date fields reads as a set on its own. */
  .sdl__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px 20px;
  }
  @media (min-width: 620px) {
    .sdl__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1040px) {
    .sdl__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .sdl__cell { display: block; min-width: 0; }

  .sdl__label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-muted, #6b7280);
    margin-bottom: 5px;
  }

  .sdl__input {
    font: inherit;
    font-size: 0.9375rem;
    display: block;
    width: 100%;
    padding: 10px 12px;
    color: var(--ink, #1a1a1a);
    background: #fff;
    border: 1px solid #dde4e0;
    border-radius: 10px;
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }
  .sdl__input:hover { border-color: #c3cfc8; }
  .sdl__input:focus-visible {
    outline: none;
    border-color: var(--brand-green, #1a5c38);
    box-shadow: 0 0 0 3px rgba(26, 92, 56, 0.12);
  }
  /* An empty field recedes; a set one reads as content. */
  .sdl__cell:not(.is-set) .sdl__input { color: var(--ink-hint, #9ca3af); }
  .sdl__cell.is-clash .sdl__input { border-color: #c4453a; }
  .sdl__cell.is-clash .sdl__input:focus-visible {
    box-shadow: 0 0 0 3px rgba(196, 69, 58, 0.15);
  }

  /* One quiet line, and only once there is something to say. The fixed
     height stops the grid reflowing as dates are filled in. */
  .sdl__note {
    display: block;
    min-height: 1rem;
    margin-top: 4px;
    font-size: 0.75rem;
    color: var(--ink-hint, #9ca3af);
  }
  .sdl__cell.is-clash .sdl__note { color: #c4453a; }

  .sdl__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-top: 16px;
  }
  .sdl__count {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--ink-muted, #6b7280);
    font-variant-numeric: tabular-nums;
  }
  .sdl__count.is-warn { color: #c4453a; font-weight: 600; }

  .sdl__link {
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0;
    border: 0;
    background: none;
    color: var(--brand-green, #1a5c38);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .sdl__link:hover { color: var(--brand-green-dark, #0f3d25); }

  .sdl__spacer {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid #eef2f0;
  }
  .sdl__sfield { display: flex; flex-direction: column; gap: 5px; }
  .sdl__sfield > span:first-child {
    font-size: 0.75rem;
    color: var(--ink-muted, #6b7280);
  }
  .sdl__sfield input {
    font: inherit;
    font-size: 0.9375rem;
    padding: 9px 12px;
    border: 1px solid #dde4e0;
    border-radius: 10px;
    background: #fff;
  }
  .sdl__days { display: flex; align-items: center; gap: 8px; }
  .sdl__days input { width: 5rem; }
  .sdl__daysuffix { font-size: 0.875rem; color: var(--ink-muted, #6b7280); }

  .sdl__apply {
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 10px 18px;
    border: 1px solid var(--brand-green, #1a5c38);
    border-radius: 10px;
    background: var(--brand-green, #1a5c38);
    color: #fff;
    cursor: pointer;
  }
  .sdl__apply:hover { background: var(--brand-green-dark, #0f3d25); }

  .sdl__hint {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.75rem;
    color: var(--ink-hint, #9ca3af);
  }
</style>
