---

<nav class={rootClass} aria-label="Bagpipe Golf on social media">
  {
    links.map((l) => (
      <a
        href={l.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={l.label}
        class="social__link"
        data-social-platform={l.platform}
        data-social-source={source}
      >
        <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true">
          <path fill="currentColor" d={l.path} />
        </svg>
      </a>
    ))
  }
</nav>

<script>
  // Delegated click tracker. Fires `bpg:social_click` on window with
  // { platform, source, path, ts }. Any analytics tool (PostHog,
  // Plausible, GA4) can subscribe:
  //
  //   window.addEventListener('bpg:social_click', (e) => {
  //     posthog?.capture('social_click', e.detail);
  //   });
  //
  // No listener is wired up today — the plumbing lands now, the
  // analytics tool choice is Sam's later. Runs once per page load
  // regardless of how many SocialLinks components render.
  if (!(window as any).__bpgSocialClickTracker) {
    (window as any).__bpgSocialClickTracker = true;
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const link = target?.closest?.('[data-social-platform]') as
        | HTMLAnchorElement
        | null;
      if (!link) return;
      const detail = {
        platform: link.dataset.socialPlatform,
        source: link.dataset.socialSource,
        path: window.location.pathname,
        ts: Date.now(),
      };
      window.dispatchEvent(new CustomEvent('bpg:social_click', { detail }));
    });
  }
</script>

<style>
  .social {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .social--hero {
    margin-top: 18px;
    justify-content: center;
  }
  .social--footer {
    margin-top: 12px;
    gap: 10px;
  }
  .social__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      transform 0.08s ease,
      box-shadow 0.15s ease;
  }
  .social--hero .social__link {
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--brand-green);
    color: var(--brand-green);
    background: transparent;
  }
  .social--hero .social__link:hover,
  .social--hero .social__link:focus-visible {
    background: var(--brand-green);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgba(26, 92, 56, 0.22);
    outline: none;
  }
  .social--hero .social__link:focus-visible {
    box-shadow:
      0 0 0 3px rgba(26, 92, 56, 0.28),
      0 6px 14px rgba(26, 92, 56, 0.22);
  }
  .social--footer .social__link {
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    color: var(--ink-muted);
    background: var(--paper);
  }
  .social--footer .social__link:hover,
  .social--footer .social__link:focus-visible {
    color: var(--brand-green-dark);
    border-color: var(--brand-green);
    outline: none;
  }
  .social__link svg {
    display: block;
  }
</style>
