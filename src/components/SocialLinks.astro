---
/**
 * Social media link row for Bagpipe Golf.
 *
 * Used in the hero (index.astro) and the site-wide Footer. Two size
 * variants — `hero` (40px, prominent) and `footer` (32px, muted).
 *
 * Handles claimed 2026-09-10; plain `@bagpipegolf` was unavailable on
 * Instagram + X, hence the `-app` / `-1` variants. See
 * `.claude/projects/-Users-bacon-fairwayiq-flutter/memory/reference_social_handles.md`.
 *
 * Click tracking: every anchor carries `data-social-platform` and
 * `data-social-source` attributes. A tiny delegated listener at the
 * bottom of this component fires a `bpg:social_click` CustomEvent on
 * `window`; any analytics library (PostHog, Plausible, GA4, etc.) can
 * attach to the same listener without touching this component again.
 * No analytics tool is currently wired up — the event fires but nobody
 * listens yet. That's deliberate: the plumbing lands now, the tool
 * choice is Sam's later.
 */

interface Props {
  variant?: 'hero' | 'footer';
  source?: string;
}

const { variant = 'hero', source = variant } = Astro.props;
const size = variant === 'hero' ? 22 : 18;
const rootClass = `social social--${variant}`;

const links = [
