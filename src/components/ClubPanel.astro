---
// One club, rendered in full: plan, admin seats, leagues attached.
//
// Extracted from /app/club so a club can have an ADDRESS of its own
// (/app/club/<id>) without the markup existing twice. A club is a
// super-user feature — many leagues, many events, one plan and up to
// four admins — so the owner of one comes back to this page often and
// it should be linkable, bookmarkable and reachable from a menu.
//
// Every button posts to /api/clubs/action, which authorises as the
// signed-in user and 303s back. Nothing here charges anyone.
import { clubPublicPath, publicClubUrl } from '../lib/clubPublic';
import { planDate } from '../lib/clubBilling';
import type { BillingClubRow } from '../lib/billing';

const SITE = Astro.site ?? new URL('https://bagpipegolf.com');

export type Member = {
  user_id: string;
  role: 'owner' | 'admin';
  display_name: string | null;
  email: string | null;
};
export type Invite = { invite_id: string; email: string; expires_at: string };
export type ClubLeague = {
  league_id: string;
  name: string | null;
  owner: string;
  mine: boolean;
  covered: boolean;
};
export type ClubEvent = {
  tournament_id: string;
  name: string | null;
  course_name: string | null;
  completed: boolean;
  /** The league it runs under, or null for a standalone club event. */
  league_id: string | null;
};
export type Club = {
  org_id: string;
  name: string;
  role: 'owner' | 'admin';
  covered: boolean;
  seats_used: number;
  seats_max: number;
  plan_payer?: { display_name: string | null; me: boolean } | null;
  members: Member[];
  invites: Invite[];
  leagues: ClubLeague[];
  /**
   * Optional on purpose: club_state only returns this once 20261217 is
   * applied. Before that the section simply does not render, rather
   * than the page breaking on a key that isn't there yet.
   */
  events?: ClubEvent[];
};

interface Props {
  club: Club;
  userId: string;
  /**
   * The club's slug, for the public-page line. Comes from
   * `Astro.locals.clubs` rather than `club_state`, which does not
   * return it. Null means no public address to show, and the whole
   * row disappears rather than linking somewhere that 404s.
   */
  publicSlug?: string | null;
  /**
   * This club's subscription, when the billing read had one. Gives the plan
   * line its renewal date and puts the Stripe portal HERE, beside the plan
   * it concerns — rather than sending the payer to /app/billing, a page
   * titled "Your league subscription", to do one thing.
   */
  plan?: BillingClubRow | null;
  /** The viewer's leagues that are in no club yet — what "Attach" offers. */
  attachable: Array<{ id: string; name: string | null }>;
  /** Heading level: h2 in a list, h2 on its own page with the name as h1. */
  showName?: boolean;
}

const { club: c, userId, attachable, plan = null, publicSlug = null, showName = true } = Astro.props;

// A club runs events two ways: through its leagues, and directly for a
// one-off like a member-guest. club_state unions both (20261217), so
// this list is the whole picture without the page having to know which
// is which — the league name is shown when there is one.
const events = c.events ?? [];
const leagueName = new Map(c.leagues.map((l) => [l.league_id, l.name || l.league_id]));

// The club's public page. A director had no way of knowing their club
// HAD an address — /c/<slug> went live before anything in the product
// mentioned it, which makes a page nobody can find.
//
// The hint below is the same rule /c/<slug> enforces for itself: an
// empty club page is `noindex`, so saying it is "live" with nothing on
// it would be a half-truth.
const publicUrl = publicSlug ? publicClubUrl(publicSlug, SITE.origin) : null;

// The plan's own facts, for the payer. "Ends" vs "Renews" is the difference
// a director most needs to see, and it is the one thing a hosted portal
// cannot tell them until they have already clicked through to it.
const iPay = c.covered && c.plan_payer?.me === true;
const planOn = planDate(plan?.period_end);
const planEnding = plan?.cancel_at_period_end === true;
const hasPublicContent = c.leagues.length > 0 || events.length > 0;

const day = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric' });
---

<section class="card stack club" id={c.org_id}>
  <div class="club__head">
    {showName && <h2 class="club__name">{c.name}</h2>}
    <span class={`chip ${c.covered ? 'chip--on' : 'chip--off'}`}>{c.covered ? 'Plan active' : 'No plan yet'}</span>
  </div>
  {c.covered && c.plan_payer && !iPay && (
    <p class="club__payer">
      {`${c.plan_payer.display_name || 'Another admin'} pays for this club’s plan.`}
    </p>
  )}
  {iPay && (
    <div class="plan">
      <p class="club__payer">
        You pay for this club’s plan.
        {planEnding && planOn && <> It <strong>ends {planOn}</strong>, and every league in the club loses cover that day.</>}
        {planEnding && !planOn && <> It is set to end at the end of the term, and the leagues in it lose cover then.</>}
        {!planEnding && planOn && <> Renews {planOn}.</>}
      </p>
      {/*
        The portal lives HERE, next to the plan, not behind a hop to a page
        called "Your league subscription". The label names the three jobs a
        director actually has instead of saying "manage" — a vague button
        that leaves the site does not get clicked.
      */}
      <form method="POST" action="/api/billing/portal-session" class="plan__act">
        <button class="btn btn--ghost btn--sm" type="submit">
          Update card, receipts, or cancel →
        </button>
      </form>
      <p class="plan__fine">
        Opens Stripe, where the card was entered. Full history in
        {' '}<a href="/app/billing">Billing</a>.
      </p>
    </div>
  )}
  {!c.covered && c.role === 'owner' && (
    <p class="club__plan">
      Leagues in the club are covered once it has a plan.
      {' '}<a href="/buy/club">Buy the Club plan or start a free trial →</a>
    </p>
  )}

  {publicUrl && (
    <div class="pub">
      <div class="pub__body">
        <span class="pub__label">Your club’s public page</span>
        <a class="pub__url" href={clubPublicPath(publicSlug!)}>{publicUrl}</a>
        <span class="pub__hint">
          {hasPublicContent
            ? 'Share it anywhere. Your leagues, their join codes and your events — nothing about your members or your billing.'
            : 'It is live, and deliberately kept out of Google until a league or an event is on it.'}
        </span>
      </div>
      <button class="btn btn--ghost btn--sm pub__copy" type="button" data-copy-url={publicUrl} hidden>
        Copy link
      </button>
    </div>
  )}

  <h3 class="club__h">Admins <span class="club__count">{c.seats_used} of {c.seats_max} seats</span></h3>
  <ul class="rows">
    {c.members.map((m) => (
      <li class="row">
        <span>
          <strong>{m.display_name || m.email || 'Admin'}</strong>
          {m.role === 'owner' && <span class="tag">Owner</span>}
          {m.user_id === userId && <span class="tag tag--me">You</span>}
          {m.email && <span class="row__sub">{m.email}</span>}
        </span>
        {c.role === 'owner' && m.role !== 'owner' && (
          <span class="row__act">
            <form method="POST" action="/api/clubs/action">
              <input type="hidden" name="action" value="transfer" />
              <input type="hidden" name="org_id" value={c.org_id} />
              <input type="hidden" name="user_id" value={m.user_id} />
              <button class="linkbtn" type="submit">Make owner</button>
            </form>
            <form method="POST" action="/api/clubs/action">
              <input type="hidden" name="action" value="remove" />
              <input type="hidden" name="org_id" value={c.org_id} />
              <input type="hidden" name="user_id" value={m.user_id} />
              <button class="linkbtn linkbtn--danger" type="submit">Remove</button>
            </form>
          </span>
        )}
        {c.role === 'admin' && m.user_id === userId && (
          <form method="POST" action="/api/clubs/action">
            <input type="hidden" name="action" value="leave" />
            <input type="hidden" name="org_id" value={c.org_id} />
            <button class="linkbtn linkbtn--danger" type="submit">Leave the club</button>
          </form>
        )}
      </li>
    ))}
    {c.invites.map((i) => (
      <li class="row row--pending">
        <span>{i.email} <span class="row__sub">Invited · expires {day(i.expires_at)}</span></span>
        <form method="POST" action="/api/clubs/action">
          <input type="hidden" name="action" value="revoke" />
          <input type="hidden" name="invite_id" value={i.invite_id} />
          <button class="linkbtn" type="submit">Cancel invite</button>
        </form>
      </li>
    ))}
  </ul>
  {c.role === 'owner' && c.seats_used < c.seats_max && (
    <form method="POST" action="/api/clubs/action" class="inline">
      <input type="hidden" name="action" value="invite" />
      <input type="hidden" name="org_id" value={c.org_id} />
      <input name="email" type="email" required placeholder="admin@example.com" aria-label="Admin's email" />
      <button class="btn btn--primary btn--sm" type="submit">Invite an admin</button>
    </form>
  )}

  <h3 class="club__h">Leagues</h3>
  {c.leagues.length === 0 && (
    <p class="club__empty">
      No leagues attached yet. A league runs perfectly well on its own — attaching
      it puts it under the club’s plan and its admins.
    </p>
  )}
  <ul class="rows">
    {c.leagues.map((l) => (
      <li class="row">
        <span>
          <strong><a href={`/app/leagues/${l.league_id}`}>{l.name || l.league_id}</a></strong>
          <span class={`row__sub ${l.covered ? 'ok' : ''}`}>{l.covered ? 'Covered by the club' : 'Not covered'}</span>
        </span>
        {(l.mine || c.role === 'owner') && (
          <form method="POST" action="/api/clubs/action">
            <input type="hidden" name="action" value="detach" />
            <input type="hidden" name="org_id" value={c.org_id} />
            <input type="hidden" name="league_id" value={l.league_id} />
            <button class="linkbtn" type="submit">Detach</button>
          </form>
        )}
      </li>
    ))}
  </ul>
  {attachable.length > 0 && (
    <form method="POST" action="/api/clubs/action" class="inline">
      <input type="hidden" name="action" value="attach" />
      <input type="hidden" name="org_id" value={c.org_id} />
      <select name="league_id" aria-label="Your league">
        {attachable.map((l) => <option value={l.id}>{l.name || l.id}</option>)}
      </select>
      <button class="btn btn--ghost btn--sm" type="submit">Attach my league</button>
    </form>
  )}
  <p class="pagewrap__fine">Each admin adds and runs their own leagues.</p>

  {c.events !== undefined && (
    <>
      <h3 class="club__h">Events</h3>
      {events.length === 0 && (
        <p class="club__empty">
          No events yet. Anything your leagues run shows up here, and so does a
          one-off the club runs on its own.
        </p>
      )}
      <ul class="rows">
        {events.map((e) => (
          <li class="row">
            <span>
              <strong><a href={`/app/tournaments/${e.tournament_id}`}>{e.name || 'Event'}</a></strong>
              <span class="row__sub">
                {e.league_id ? leagueName.get(e.league_id) ?? 'A club league' : 'Club event'}
                {e.course_name ? ` · ${e.course_name}` : ''}
              </span>
            </span>
            <span class={`chip ${e.completed ? 'chip--off' : 'chip--on'}`}>
              {e.completed ? 'Finished' : 'Running'}
            </span>
          </li>
        ))}
      </ul>
    </>
  )}

  {c.role === 'owner' && c.members.length === 1 && (
    <details class="danger">
      <summary>Dissolve the club</summary>
      <form method="POST" action="/api/clubs/action" class="stack">
        <input type="hidden" name="action" value="dissolve" />
        <input type="hidden" name="org_id" value={c.org_id} />
        <label class="check"><input type="checkbox" name="confirm" value="yes" /> Detach every league and delete the club</label>
        <button class="btn btn--ghost btn--sm" type="submit">Dissolve</button>
      </form>
    </details>
  )}
</section>

<style>
  .stack { display: grid; gap: 12px; }
  .inline { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .inline input, .inline select {
    font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px;
    flex: 1 1 220px; min-width: 0;
  }
  .club { margin-top: 18px; }
  .club__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .club__name { margin: 0; font-size: 1.375rem; color: var(--brand-green-dark); }
  .club__payer { margin: 0; color: var(--ink-muted); }
  .club__plan { margin: 0; padding: 10px 12px; border-radius: 10px; background: var(--brand-green-pale); }
  .club__h { margin: 10px 0 0; font-size: 1rem; }
  .club__count { font-weight: 500; color: var(--ink-muted); margin-left: 6px; }
  .club__empty { margin: 0; color: var(--ink-muted); }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
  .row:last-child { border-bottom: 0; }
  .row--pending { color: var(--ink-muted); }
  .row__sub { display: block; font-size: 0.875rem; color: var(--ink-muted); }
  .row__sub.ok { color: var(--brand-green); }
  .row__act { display: flex; gap: 12px; }
  .row form, .row__act form { margin: 0; }
  .tag { margin-left: 6px; font-size: 0.75rem; font-weight: 700; padding: 1px 6px; border-radius: 999px; background: var(--paper-tint); }
  .tag--me { background: var(--brand-green-pale); }
  .chip--on { color: var(--brand-green); }
  .chip--off { color: var(--ink-muted); }
  .linkbtn { background: none; border: 0; padding: 0; font: inherit; color: var(--brand-green); text-decoration: underline; cursor: pointer; }
  .linkbtn--danger { color: var(--error); }
  .danger { margin-top: 8px; }
  .danger summary { cursor: pointer; color: var(--error); font-weight: 600; }
  .check { display: flex; gap: 8px; align-items: center; }
  .pagewrap__fine { margin: 0; font-size: 0.875rem; color: var(--ink-muted); }
  .plan { display: grid; gap: 8px; justify-items: start; }
  .plan__act { margin: 0; }
  .plan__fine { margin: 0; font-size: 0.8125rem; color: var(--ink-muted); }
  .pub {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    flex-wrap: wrap; padding: 12px 14px; border-radius: 10px;
    border: 1px solid var(--line); background: var(--paper-tint);
  }
  .pub__body { display: grid; gap: 2px; min-width: 0; }
  .pub__label { font-size: 0.875rem; font-weight: 700; color: var(--brand-green-dark); }
  .pub__url { font-weight: 600; word-break: break-all; }
  .pub__hint { font-size: 0.8125rem; color: var(--ink-muted); }
  .pub__copy { flex: 0 0 auto; }
</style>

<script>
  // Progressive: the URL above is a real link and works with no JS at
  // all. The button only appears once this has run and the clipboard
  // API is actually there, so a director is never shown a control that
  // silently does nothing.
  (() => {
    if (!navigator.clipboard) return;
    for (const btn of document.querySelectorAll('[data-copy-url]')) {
      const url = btn.getAttribute('data-copy-url');
      if (!url) continue;
      btn.hidden = false;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
          const was = btn.textContent;
          btn.textContent = 'Copied';
          setTimeout(() => { btn.textContent = was; }, 1600);
        } catch {
          // Denied permission or an insecure origin. The link is still
          // right there to copy by hand.
        }
      });
    }
  })();
</script>
