---
// Top navigation. Two layers:
//   - Primary horizontal links on the left (key CTAs).
//   - A "Menu" disclosure on the right that opens a grouped sitemap
//     panel — every public + app destination organised by subject.
// State (signed in vs signed out) comes from Astro.locals.user,
// populated by src/middleware.ts.

const user = Astro.locals.user ?? null;
const isSignedIn = !!user;
const pathname = new URL(Astro.request.url).pathname;

type NavLink = { href: string; label: string };
type NavGroup = { title: string; links: NavLink[] };

// Primary horizontal nav — same marketing links regardless of auth
// state. Signed-in users still need to reach product marketing pages
// (to share links with friends, browse features, read about a new
// format) — the earlier "My games / My tournaments / My leagues"
// signed-in variant hid the marketing surfaces from anyone with an
// account. Standard SaaS pattern: marketing site shows marketing
// links; a Dashboard button on the right takes signed-in users into
// the app.
const primaryLinks: NavLink[] = [
  { href: '/features', label: 'Features' },
  { href: '/tournaments', label: 'Tournaments' },
  { href: '/side-games', label: 'Side games' },
  { href: '/leagues', label: 'Leagues' },
  { href: '/pricing', label: 'Pricing' },
];

// Menu panel — grouped sitemap. Five groups for both auth states so the
// panel reads consistently regardless of sign-in:
//
//   Play      — user's app-scoped pages (signed-in only)
//   Explore   — marketing detail pages (Tournaments, Side games, Leagues)
//   Product   — top-level marketing + audience landings
//   Help      — FAQ + Support
//   Legal     — Privacy + Terms
//
// Every marketing detail page is discoverable from either auth state via
// the Explore group.
const exploreLinks: NavLink[] = [
  { href: '/tournaments', label: 'Tournaments' },
  { href: '/side-games', label: 'Side games' },
  { href: '/leagues', label: 'Leagues' },
  { href: '/leagues/schools', label: 'Schools' },
];

const productLinks: NavLink[] = [
  { href: '/', label: 'Home' },
  { href: '/features', label: 'Features' },
  { href: '/for-hosts', label: 'For Hosts' },
  { href: '/for-players', label: 'For Players' },
  { href: '/pricing', label: 'Pricing' },
];

const helpLinks: NavLink[] = [
  { href: '/faq', label: 'FAQ' },
  { href: '/support', label: 'Support' },
];

const legalLinks: NavLink[] = [
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];

const menuGroups: NavGroup[] = isSignedIn
  ? [
      {
        title: 'Play',
        links: [
          { href: '/app', label: 'Dashboard' },
          { href: '/app/history', label: 'Round history' },
          { href: '/app/side-games', label: 'My games' },
          { href: '/app/tournaments', label: 'My tournaments' },
          { href: '/app/leagues', label: 'My leagues' },
          { href: '/app/profile', label: 'Profile' },
        ],
      },
      { title: 'Explore', links: exploreLinks },
      { title: 'Product', links: productLinks },
      { title: 'Help', links: helpLinks },
      { title: 'Legal', links: legalLinks },
    ]
  : [
      { title: 'Explore', links: exploreLinks },
      { title: 'Product', links: productLinks },
      {
        title: 'Account',
        links: [
          { href: '/login', label: 'Sign in' },
          { href: '/signup', label: 'Create account' },
        ],
      },
      { title: 'Help', links: helpLinks },
      { title: 'Legal', links: legalLinks },
    ];

const isActive = (href: string) =>
  href === pathname || (href !== '/' && pathname.startsWith(href + '/'));
---

<nav class="sitenav">
  <div class="sitenav__inner">
    <a class="sitenav__brand" href="/">
      <img
        src="/bagpipe-golf-logo.jpg"
        alt=""
        width="32"
        height="32"
        class="sitenav__mark"
      />
      <span class="sitenav__wordmark">Bagpipe&nbsp;Golf</span>
    </a>

    <ul class="sitenav__primary">
      {
        primaryLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['sitenav__link', isActive(link.href) && 'is-active']}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="sitenav__right">
      <details class="menu">
        <summary class="menu__trigger" aria-label="Open menu">
          <span class="menu__triggerlabel">Menu</span>
          <span class="menu__triggericon" aria-hidden="true">▾</span>
          <span class="menu__triggerhamburger" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
        </summary>

        <div class="menu__panel" role="menu">
          {
            menuGroups.map((group) => (
              <section class="menu__group">
                <span class="menu__grouptitle">{group.title}</span>
                <ul class="menu__grouplinks">
                  {group.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class:list={['menu__link', isActive(link.href) && 'is-active']}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </details>

      <div class="sitenav__cta">
        {
          isSignedIn ? (
            <form method="post" action="/api/auth/signout" class="sitenav__signoutform">
              <a class="btn btn--primary btn--sm" href="/app">Dashboard</a>
              <span class="sitenav__user">{user!.email}</span>
              <button type="submit" class="btn btn--ghost btn--sm">Sign out</button>
            </form>
          ) : (
            <>
              <a class="btn btn--ghost btn--sm" href="/login">Sign in</a>
              <a class="btn btn--primary btn--sm" href="/signup">Create account</a>
            </>
          )
        }
      </div>
    </div>
  </div>
</nav>

<style>
  /* ── Frame ───────────────────────────────────────────── */
  .sitenav {
    background: #fff;
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .sitenav__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .sitenav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--brand-green-dark);
    font-weight: 800;
    font-size: 18px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .sitenav__mark {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    object-fit: cover;
  }

  /* ── Primary horizontal nav (desktop only) ───────────── */
  .sitenav__primary {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4px;
    align-items: center;
    flex: 1;
  }
  .sitenav__link {
    display: inline-block;
    padding: 8px 12px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    border-radius: 8px;
  }
  .sitenav__link:hover {
    color: var(--brand-green-dark);
    background: var(--brand-green-pale);
  }
  .sitenav__link.is-active {
    color: var(--brand-green-dark);
    background: var(--brand-green-pale);
  }

  .sitenav__right {
    display: flex;
    align-items: center;
    gap: 10px;
    position: relative;
  }
  .sitenav__cta {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sitenav__signoutform {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .sitenav__user {
    color: var(--ink-muted);
    font-size: 13px;
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .btn--sm {
    padding: 8px 14px;
    font-size: 14px;
  }

  /* ── Menu disclosure ─────────────────────────────────── */
  .menu { position: relative; }
  .menu summary { list-style: none; cursor: pointer; }
  .menu summary::-webkit-details-marker { display: none; }

  .menu__trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    font-weight: 700;
    font-size: 14px;
    background: #fff;
    transition: border-color 0.12s ease, color 0.12s ease, background 0.12s ease;
  }
  .menu__trigger:hover {
    border-color: var(--brand-green);
    color: var(--brand-green-dark);
  }
  .menu[open] .menu__trigger {
    border-color: var(--brand-green);
    color: var(--brand-green-dark);
    background: var(--brand-green-pale);
  }
  .menu__triggericon {
    transition: transform 0.12s ease;
  }
  .menu[open] .menu__triggericon {
    transform: rotate(180deg);
  }
  /* Hamburger replaces the "Menu ▾" text on small screens. */
  .menu__triggerhamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    width: 18px;
  }
  .menu__triggerhamburger > span {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
  }

  /* ── Menu panel (the grouped sitemap) ────────────────── */
  .menu__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 60;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    box-shadow: 0 24px 48px rgba(15, 61, 37, 0.18), 0 4px 12px rgba(0,0,0,0.06);
    padding: 24px 26px;
    display: grid;
    grid-template-columns: repeat(2, minmax(160px, 1fr));
    gap: 22px 36px;
    min-width: 460px;
    max-width: 640px;
  }
  .menu__group { display: flex; flex-direction: column; gap: 8px; }
  .menu__grouptitle {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 11px;
    font-weight: 800;
    color: var(--ink-muted);
  }
  .menu__grouplinks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .menu__link {
    display: block;
    padding: 6px 8px;
    margin: 0 -8px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    border-radius: 8px;
  }
  .menu__link:hover {
    color: var(--brand-green-dark);
    background: var(--brand-green-pale);
  }
  .menu__link.is-active {
    color: var(--brand-green-dark);
    background: var(--brand-green-pale);
  }

  /* ── Mobile ──────────────────────────────────────────── */
  @media (max-width: 880px) {
    .sitenav__inner { gap: 12px; padding: 12px 16px; }
    /* Primary horizontal nav hides; access via Menu only. */
    .sitenav__primary { display: none; }
    /* "Sign in / Create account" CTAs hide on mobile; same destinations
       live inside the Menu's Account group. Sign out form for signed-in
       users stays visible because it's primary. */
    .sitenav__right > .sitenav__cta > a { display: none; }

    .menu__triggerlabel,
    .menu__triggericon { display: none; }
    .menu__triggerhamburger { display: inline-flex; }
    .menu__trigger {
      padding: 10px 12px;
    }

    .menu__panel {
      position: fixed;
      top: 64px;
      left: 12px;
      right: 12px;
      min-width: 0;
      max-width: none;
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 20px;
      max-height: calc(100dvh - 80px);
      overflow-y: auto;
    }
    /* On mobile, surface Sign in / Create account inside the menu
       panel via an extra anchor block. Achieved by reusing the
       Account group already in menuGroups for signed-out users. */
  }
</style>
