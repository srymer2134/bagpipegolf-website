---
interface Props {
  id: string;
  active: 'overview' | 'leaderboard' | 'scorecard' | 'calcutta' | 'payouts' | 'manage';
}

const { id, active } = Astro.props;

const links: Array<{ key: Props['active']; label: string }> = [
  { key: 'overview',    label: 'Overview' },
  { key: 'leaderboard', label: 'Leaderboard' },
  { key: 'scorecard',   label: 'Scorecard' },
  { key: 'calcutta',    label: 'Calcutta' },
  { key: 'payouts',     label: 'Payouts' },
  { key: 'manage',      label: 'Manage (TD)' },
];

const hrefFor = (key: Props['active']) =>
  key === 'overview' ? `/app/tournaments/${id}` : `/app/tournaments/${id}/${key}`;
---

<nav class="tnav">
  {
    links.map((l) => (
      <a
        href={hrefFor(l.key)}
        class:list={['tnav__link', l.key === active && 'is-active']}
      >
        {l.label}
      </a>
    ))
  }
</nav>

<style>
  .tnav {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 28px;
    overflow-x: auto;
  }
  .tnav__link {
    padding: 10px 14px;
    color: var(--ink-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .tnav__link:hover { color: var(--brand-green-dark); }
  .tnav__link.is-active {
    color: var(--brand-green-dark);
    border-bottom-color: var(--brand-green);
  }
</style>
