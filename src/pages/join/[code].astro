---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { callRailwayPublic } from '../../lib/railway';

// Join landing page — `https://bagpipegolf.com/join/<id>`.
//
// Three shapes land here, disambiguated by the id:
//
//   1. UUID (36 chars)  → an email-to-join INVITE TOKEN, for a
//      TOURNAMENT or a LEAGUE. Preview via Railway
//      `GET /api/invites/:token`, which dispatches on kind, then:
//        * signed in  → "Accept" (POST /api/invites/[token]/accept)
//        * signed out → sign in / create account with ?next= back here
//      Plus "Open in the app" (`fairwayiq://join/<token>` — the app's
//      deep-link parser routes a UUID to its invite-accept screen).
//
//   2. 6-char code → a SHARED TOURNAMENT, a LEAGUE, or a side game.
//      Preview via Railway `GET /api/invites/code/:code`:
//        * tournament → preview + "Join this tournament"
//        * league     → preview + "Join this league"
//        * neither    → the game-agnostic fallback (the app dispatches
//          side-game codes itself once opened).
//
//   3. anything else → malformed.
//
// WHY RAILWAY AND NOT AN ANON RPC. Both previews used to be anon
// Supabase RPC calls made straight from this page. Two things broke
// that: `20260917_close_anon_allowlist.sql` revoked `anon` from
// `get_invite_by_token` and `get_league_by_code` (so the signed-out
// tournament preview dead-ended, and a league code could never have
// resolved), and the league shapes were never handled here at all.
// Railway holds the service role and already dispatches both kinds,
// so routing the lookups through it fixes both without reopening an
// anon grant. See fairwayiq-api `routes/invites.ts`.
//
// When the app IS installed and the universal link verified, iOS /
// Android intercept this URL before the page renders — so everything
// here is the not-installed / laptop / unverified-Android path, and the
// place a web-only user can complete the join without the app.

type Preview = {
  kind: 'tournament' | 'league';
  id: string;
  event_name: string;
  host_name: string | null;
  status: string | null;
  tournament_name?: string;
  league_name?: string;
  course_name?: string | null;
  player_count?: number | null;
  round_count?: number | null;
  registration_open?: boolean;
};

const raw = (Astro.params.code ?? '').trim();
const uuidShape = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const codeShape = /^[A-Za-z0-9]{6}$/;

const kind: 'invite' | 'code' | 'invalid' = uuidShape.test(raw)
  ? 'invite'
  : codeShape.test(raw)
    ? 'code'
    : 'invalid';

const token = kind === 'invite' ? raw.toLowerCase() : '';
const code = kind === 'code' ? raw.toUpperCase() : '';

const user = (Astro.locals as App.Locals).user;
const signedIn = Boolean(user);
const here = `/join/${kind === 'invite' ? token : code}`;
const loginHref = `/login?next=${encodeURIComponent(here)}`;
const signupHref = `/signup?next=${encodeURIComponent(here)}`;

let preview: Preview | null = null;
let inviteStatus: string | null = null;
let lookupFailed = false;

if (kind !== 'invalid') {
  try {
    if (kind === 'invite') {
      // Kind-dispatched invite summary. 404 = no such token, which is
      // a "not valid" render rather than an error render.
      const row = await callRailwayPublic<{
        kind?: 'tournament' | 'league';
        event_name?: string;
        tournament_name?: string;
        league_name?: string;
        inviter_name?: string | null;
        status?: string;
      }>(Astro, { method: 'GET', path: `/api/invites/${encodeURIComponent(token)}` });

      if (row?.kind) {
        inviteStatus = row.status ?? null;
        preview = {
          kind: row.kind,
          id: '',
          event_name: row.event_name ?? row.tournament_name ?? row.league_name ?? 'an event',
          host_name: row.inviter_name ?? null,
          status: row.status ?? null,
          tournament_name: row.tournament_name,
          league_name: row.league_name,
        };
      }
    } else {
      preview = await callRailwayPublic<Preview>(Astro, {
        method: 'GET',
        path: `/api/invites/code/${encodeURIComponent(code)}`,
      });
    }
  } catch (err) {
    // A 404 is a legitimate "nothing here" answer, not a failure — the
    // page renders its own not-found / side-game-fallback state. Only
    // a real fault (5xx, network, unbound env) becomes lookupFailed,
    // because that is the one case where "try again" is the right
    // advice.
    const status = (err as { status?: number })?.status;
    if (status !== 404) {
      console.error('[join] lookup failed', err);
      lookupFailed = true;
    }
  }
}

const isLeague = preview?.kind === 'league';
const isTournament = preview?.kind === 'tournament';
const tournament = isTournament ? preview : null;
const league = isLeague ? preview : null;

const inviteActionable = inviteStatus === 'pending';
const eventFinished = preview !== null && preview.status === 'completed';
const registrationClosed = preview?.registration_open === false;
const tournamentFinished = isTournament && eventFinished;
const tournamentJoinable = isTournament && !eventFinished && !registrationClosed;
const leagueJoinable = isLeague && !eventFinished;

const appScheme =
  kind === 'invite' ? `fairwayiq://join/${token}` : kind === 'code' ? `fairwayiq://join/${code}` : null;
const appStoreHref = 'https://apps.apple.com/app/id6775045734';

const title =
  kind === 'invite'
    ? `You're invited · Bagpipe Golf`
    : kind === 'code'
      ? `Join code ${code} · Bagpipe Golf`
      : 'Join · Bagpipe Golf';
---

<BaseLayout title={title}>
  <main class="pagewrap pagewrap--narrow">
    {kind === 'invite' && (
      <>
        <p class="pagewrap__eyebrow">{isLeague ? 'League invite' : 'Tournament invite'}</p>
        {preview === null ? (
          <>
            <h1 class="pagewrap__title">{lookupFailed ? "We couldn't load this invite." : "This invite isn't valid."}</h1>
            <p class="pagewrap__sub">
              {lookupFailed
                ? 'Something went wrong looking it up. Try again in a moment.'
                : 'It may have been withdrawn, or the link was copied incompletely. Ask the host to send a fresh one.'}
            </p>
            {!signedIn && !lookupFailed && (
              <p class="pagewrap__sub">
                If you already have an account, <a href={loginHref}>sign in</a> — an invite sent to
                your address will be waiting inside the app.
              </p>
            )}
            <a class="btn btn--primary" href="/">Back to home</a>
          </>
        ) : (
          <>
            <h1 class="pagewrap__title">You're invited.</h1>
            <p class="pagewrap__sub">
              <strong>{preview.host_name ?? 'The host'}</strong> invited you to{' '}
              {isLeague ? 'play in' : 'play in'}{' '}
              <strong>{preview.event_name}</strong>
              {isLeague ? <> — a season, not a one-off.</> : <>.</>}
            </p>

            {inviteStatus === 'accepted' && (
              <div class="notice notice--ok">
                You've already accepted this invite.{' '}
                <a href={isLeague ? '/app/leagues' : '/app/tournaments'}>
                  Open your {isLeague ? 'leagues' : 'tournaments'}
                </a>.
              </div>
            )}
            {(inviteStatus === 'revoked' || inviteStatus === 'expired') && (
              <div class="notice notice--warn">
                This invite has {inviteStatus === 'revoked' ? 'been withdrawn by the host' : 'expired'}. Ask them to send a new one.
              </div>
            )}

            {inviteActionable && (
              <section class="joincard" id="joinCard" data-kind="invite" data-token={token} data-event-kind={preview.kind}>
                <div id="joinError" class="errorbar" hidden></div>
                {signedIn ? (
                  <>
                    <p class="joincard__hint">
                      {isLeague
                        ? 'Accepting adds you to the league roster with the name and handicap on your profile. You RSVP to each event separately.'
                        : 'Accepting adds you to the roster with the name and handicap on your profile.'}
                    </p>
                    <button type="button" id="acceptBtn" class="btn btn--primary btn--block">Accept invite</button>
                  </>
                ) : (
                  <>
                    <p class="joincard__hint">Sign in to accept, or create an account — you'll land right back here.</p>
                    <div class="cta-row">
                      <a class="btn btn--primary" href={loginHref}>Sign in to accept</a>
                      <a class="btn btn--ghost" href={signupHref}>Create an account</a>
                    </div>
                  </>
                )}
              </section>
            )}

            <div id="joinDone" class="notice notice--ok" hidden>
              You're in.{' '}
              <a id="joinDoneLink" href={isLeague ? '/app/leagues' : '/app/tournaments'}>
                Open the {isLeague ? 'league' : 'tournament'}
              </a>, or open it in the app below.
            </div>

            <div class="cta-row">
              {appScheme && <a class="btn btn--ghost" href={appScheme}>Open in the app</a>}
              <a class="btn btn--ghost" href={appStoreHref}>Get the app (App Store)</a>
            </div>
          </>
        )}
      </>
    )}

    {kind === 'code' && league !== null && (
      <>
        <p class="pagewrap__eyebrow">League registration</p>
        <h1 class="pagewrap__title">{league.event_name}</h1>
        <p class="pagewrap__sub">
          Run by <strong>{league.host_name ?? 'the commissioner'}</strong>
          {eventFinished ? <> · this season has finished</> : null}
        </p>

        {leagueJoinable ? (
          <section class="joincard" id="joinCard" data-kind="code" data-event-kind="league" data-code={code}>
            <div id="joinError" class="errorbar" hidden></div>
            {signedIn ? (
              <>
                <p class="joincard__hint">
                  Joining adds you to the league roster with the name and handicap on your profile.
                  You RSVP to each event separately once you're in.
                </p>
                <button type="button" id="acceptBtn" class="btn btn--primary btn--block">Join this league</button>
              </>
            ) : (
              <>
                <p class="joincard__hint">Sign in to join, or create an account — you'll land right back here.</p>
                <div class="cta-row">
                  <a class="btn btn--primary" href={loginHref}>Sign in to join</a>
                  <a class="btn btn--ghost" href={signupHref}>Create an account</a>
                </div>
              </>
            )}
          </section>
        ) : (
          <div class="notice notice--warn">This season has finished. You can still view the standings.</div>
        )}

        <div id="joinDone" class="notice notice--ok" hidden>
          You're in. <a id="joinDoneLink" href="/app/leagues">Open the league</a>, or open it in the app below.
        </div>

        <section class="codecard">
          <span class="codecard__label">League code</span>
          <code class="codecard__value" data-code={code}>{code}</code>
          <button id="copyBtn" class="codecard__copy" type="button" aria-label="Copy code">Copy</button>
        </section>

        <div class="cta-row">
          {appScheme && <a class="btn btn--ghost" href={appScheme}>Open in the app</a>}
          <a class="btn btn--ghost" href={appStoreHref}>Get the app (App Store)</a>
          <a class="btn btn--ghost" href={`/l/${league.id}/standings`}>Standings</a>
        </div>
      </>
    )}

    {kind === 'code' && tournament !== null && (
      <>
        <p class="pagewrap__eyebrow">Tournament registration</p>
        <h1 class="pagewrap__title">{tournament.event_name}</h1>
        <p class="pagewrap__sub">
          {tournament.course_name ? <>{tournament.course_name} · </> : null}
          Hosted by <strong>{tournament.host_name ?? 'the host'}</strong>
          {typeof tournament.player_count === 'number' ? <> · {tournament.player_count} in the field</> : null}
          {typeof tournament.round_count === 'number' && tournament.round_count > 0
            ? <> · {tournament.round_count} {tournament.round_count === 1 ? 'round' : 'rounds'}</>
            : null}
        </p>

        {tournamentJoinable ? (
          <section class="joincard" id="joinCard" data-kind="code" data-event-kind="tournament" data-code={code} data-tournament-id={tournament.id}>
            <div id="joinError" class="errorbar" hidden></div>
            {signedIn ? (
              <>
                <p class="joincard__hint">Joining adds you to the field with the name and handicap on your profile.</p>
                <button type="button" id="acceptBtn" class="btn btn--primary btn--block">Join this tournament</button>
              </>
            ) : (
              <>
                <p class="joincard__hint">Sign in to join, or create an account — you'll land right back here.</p>
                <div class="cta-row">
                  <a class="btn btn--primary" href={loginHref}>Sign in to join</a>
                  <a class="btn btn--ghost" href={signupHref}>Create an account</a>
                </div>
              </>
            )}
          </section>
        ) : tournamentFinished ? (
          <div class="notice notice--warn">This tournament has finished. You can still view the results.</div>
        ) : (
          <div class="notice notice--warn">Registration is closed — the host isn't accepting sign-ups via link right now. You can still follow along, or ask the host for an email invite.</div>
        )}

        <div id="joinDone" class="notice notice--ok" hidden>
          You're in. <a id="joinDoneLink" href={`/app/tournaments/${tournament.id}`}>Open the tournament</a>, or open it in the app below.
        </div>

        <section class="codecard">
          <span class="codecard__label">Join code</span>
          <code class="codecard__value" data-code={code}>{code}</code>
          <button id="copyBtn" class="codecard__copy" type="button" aria-label="Copy code">Copy</button>
        </section>

        <div class="cta-row">
          {appScheme && <a class="btn btn--ghost" href={appScheme}>Open in the app</a>}
          <a class="btn btn--ghost" href={appStoreHref}>Get the app (App Store)</a>
          <a class="btn btn--ghost" href={`/app/tournaments/${tournament.id}/leaderboard`}>Leaderboard</a>
        </div>
      </>
    )}

    {kind === 'code' && preview === null && (
      <>
        <p class="pagewrap__eyebrow">Join a live game</p>
        <h1 class="pagewrap__title">You're invited.</h1>
        <p class="pagewrap__sub">
          Tap "Open in the app" to jump straight to the live game — the app works out whether it's a tournament or a side game. If the app isn't installed yet, grab it first and your code will be ready.
        </p>

        <section class="codecard">
          <span class="codecard__label">Your join code</span>
          <code class="codecard__value" data-code={code}>{code}</code>
          <button id="copyBtn" class="codecard__copy" type="button" aria-label="Copy code">Copy</button>
        </section>

        <div class="cta-row">
          {appScheme && <a class="btn btn--primary" href={appScheme}>Open in the app</a>}
          <a class="btn btn--ghost" href={appStoreHref}>Get the app (App Store)</a>
        </div>

        <details class="manual">
          <summary>Or enter the code manually</summary>
          <ol>
            <li>Open <strong>Bagpipe Golf</strong> on your phone.</li>
            <li>For a <strong>side game</strong>: tap the <strong>Play</strong> tab and choose <strong>Join Game</strong>, then paste <code>{code}</code>.</li>
            <li>For a <strong>tournament</strong>: tap the <strong>Events</strong> tab and choose <strong>Join Tournament</strong>, then paste <code>{code}</code>.</li>
            <li>Not sure which? Either flow will bounce you to the right screen once the code resolves.</li>
          </ol>
        </details>
      </>
    )}

    {kind === 'invalid' && (
      <>
        <p class="pagewrap__eyebrow">Join a live game</p>
        <h1 class="pagewrap__title">That link doesn't look right.</h1>
        <p class="pagewrap__sub">
          Bagpipe Golf join codes are 6 letters and numbers — like <code>ABC123</code> — and invite links are longer. Check the link you tapped and try again, or open the app and use <strong>Join Game</strong> (Play tab) or <strong>Join Tournament</strong> (Events tab) to type a code manually.
        </p>
        <a class="btn btn--primary" href="/">Back to home</a>
      </>
    )}
  </main>

  {kind === 'code' && (
    <script is:inline define:vars={{ code }}>
      const btn = document.getElementById('copyBtn');
      if (btn && navigator.clipboard) {
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(code);
            const original = btn.textContent;
            btn.textContent = 'Copied';
            setTimeout(() => { btn.textContent = original ?? 'Copy'; }, 1500);
          } catch (_) {
            // Clipboard API blocked — the code is still visible.
          }
        });
      }
    </script>
  )}

  <script is:inline>
    // Accept / join. Same-origin POST to the Astro proxy, which forwards
    // the session JWT to Railway. Both upstreams are idempotent.
    (() => {
      const card = document.getElementById('joinCard');
      const accept = document.getElementById('acceptBtn');
      if (!card || !accept) return;
      const errorBar = document.getElementById('joinError');
      const done = document.getElementById('joinDone');
      const doneLink = document.getElementById('joinDoneLink');
      const kind = card.dataset.kind;
      const eventKind = card.dataset.eventKind;
      // A tournament code keeps its existing route: that proxy also
      // reports `handicap_defaulted`, so the visitor is told when 18.0
      // was substituted. Leagues go through the code-accept endpoint.
      const url =
        kind === 'invite'
          ? `/api/invites/${encodeURIComponent(card.dataset.token || '')}/accept`
          : eventKind === 'league'
            ? `/api/invites/code/${encodeURIComponent(card.dataset.code || '')}/accept`
            : `/api/tournaments/${encodeURIComponent(card.dataset.tournamentId || '')}/join`;

      accept.addEventListener('click', async () => {
        accept.disabled = true;
        const label = accept.textContent;
        accept.textContent = kind === 'invite' ? 'Accepting…' : 'Joining…';
        if (errorBar) { errorBar.hidden = true; errorBar.textContent = ''; }
        try {
          const res = await fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' } });
          const body = await res.json().catch(() => ({}));
          if (!res.ok) {
            const msg = body && body.error ? body.error : `Request failed (${res.status}).`;
            if (errorBar) { errorBar.textContent = msg; errorBar.hidden = false; }
            accept.disabled = false;
            accept.textContent = label;
            return;
          }
          if (doneLink) {
            if (body && body.league_id) {
              doneLink.setAttribute('href', '/app/leagues');
            } else if (body && body.tournament_id) {
              doneLink.setAttribute('href', `/app/tournaments/${body.tournament_id}`);
            }
          }
          if (done) {
            if (body && body.handicap_defaulted) {
              const note = document.createElement('div');
              note.className = 'notice__sub';
              note.textContent = 'No handicap was set on your profile, so 18.0 was used. Update it in Profile any time.';
              done.appendChild(note);
            }
            done.hidden = false;
          }
          card.hidden = true;
        } catch (err) {
          if (errorBar) { errorBar.textContent = 'Network error. Please try again.'; errorBar.hidden = false; }
          accept.disabled = false;
          accept.textContent = label;
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  .pagewrap--narrow { max-width: 560px; }

  .joincard {
    padding: 20px;
    border: 1px solid var(--brand-green, #2f7d44);
    border-radius: 16px;
    background: var(--brand-green-soft, #f0f7f2);
    margin: 20px 0;
  }
  .joincard__hint {
    margin: 0 0 14px;
    color: var(--ink-muted, #4b5b54);
    line-height: 1.5;
  }

  .notice {
    padding: 14px 16px;
    border-radius: 12px;
    margin: 16px 0;
    line-height: 1.5;
  }
  .notice--ok {
    background: var(--brand-green-soft, #f0f7f2);
    border: 1px solid var(--brand-green, #2f7d44);
    color: var(--brand-green-dark, #1f5b30);
  }
  .notice--warn {
    background: #fff7e6;
    border: 1px solid #e0a53c;
    color: #6b4a00;
  }
  .notice__sub { margin-top: 8px; font-size: 14px; }
  .notice a { font-weight: 700; color: inherit; }

  .errorbar {
    background: #fdecec;
    border: 1px solid #d64545;
    color: #7a1f1f;
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 12px;
    font-size: 14px;
  }

  .codecard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 28px 24px;
    background: var(--brand-green-soft, #f0f7f2);
    border: 2px solid var(--brand-green, #2f7d44);
    border-radius: 16px;
    margin: 24px 0;
  }
  .codecard__label {
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--brand-green-dark, #1f5b30);
  }
  .codecard__value {
    font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 40px;
    font-weight: 800;
    letter-spacing: 10px;
    color: var(--brand-green-dark, #1f5b30);
  }
  .codecard__copy {
    appearance: none;
    background: transparent;
    border: 1px solid var(--brand-green, #2f7d44);
    color: var(--brand-green-dark, #1f5b30);
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }
  .codecard__copy:hover { background: rgba(47, 125, 68, 0.08); }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 12px 0 24px;
  }
  .btn {
    flex: 1 1 200px;
    text-align: center;
    padding: 14px 18px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    cursor: pointer;
  }
  .btn--block { flex-basis: 100%; }
  .btn--primary {
    background: var(--brand-green, #2f7d44);
    color: white;
    border: 1px solid var(--brand-green, #2f7d44);
  }
  .btn--primary:hover { background: var(--brand-green-dark, #1f5b30); }
  .btn--primary:disabled { opacity: 0.6; cursor: default; }
  .btn--ghost {
    background: transparent;
    border: 1px solid var(--brand-green, #2f7d44);
    color: var(--brand-green-dark, #1f5b30);
  }
  .btn--ghost:hover { background: rgba(47, 125, 68, 0.08); }

  .manual { margin-top: 24px; }
  .manual summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--brand-green-dark, #1f5b30);
    padding: 12px 0;
  }
  .manual ol { padding-left: 24px; color: var(--ink-muted, #4b5b54); }
  .manual li { padding: 6px 0; line-height: 1.5; }
  .manual code {
    background: rgba(47, 125, 68, 0.1);
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 700;
  }
</style>
