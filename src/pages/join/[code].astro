---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Join-code landing page.
//
// Reached when someone taps a `https://bagpipegolf.com/join/<CODE>`
// link and:
//   (a) the app isn't installed yet — show install + manual-entry
//       instructions, OR
//   (b) iOS / Android failed the Universal-Link / App-Link
//       verification (placeholder Android cert fingerprint until the
//       release key is minted), so the OS landed on the web page
//       instead of opening the app.
//
// When the app IS installed and verified, iOS / Android intercept
// this URL before the page ever renders — so the "Open in app"
// affordance below is a graceful fallback rather than the primary
// flow.
//
// Codes here are ambiguous by design: the same 6-char alphabet
// covers both shared bet games and shared tournaments. The
// Flutter side dispatches on lookup (`JoinDispatcherScreen`) once
// the app opens, so this page stays game-agnostic.

const rawCode = (Astro.params.code ?? '').toUpperCase();
// Tighten the displayed code to 6 alphanumerics so a typo URL
// doesn't render a giant blob. We keep the user on the page with
// an error state when the code is malformed.
const isValid = /^[A-Z0-9]{6}$/.test(rawCode);
const code = isValid ? rawCode : '';
const fairwayiqScheme = isValid ? `fairwayiq://join/${code}` : null;
---

<BaseLayout title={isValid ? `Join code ${code} · Bagpipe Golf` : 'Join · Bagpipe Golf'}>
  <main class="pagewrap pagewrap--narrow">
    {isValid ? (
      <>
        <p class="pagewrap__eyebrow">Join a live game</p>
        <h1 class="pagewrap__title">You're invited.</h1>
        <p class="pagewrap__sub">
          Tap "Open in Bagpipe Golf" below to jump straight to the live game — the app will figure out whether it's a tournament or a side-bet game. If the app isn't installed yet, grab it first and your code will be ready.
        </p>

        <section class="codecard">
          <span class="codecard__label">Your join code</span>
          <code class="codecard__value" data-code={code}>{code}</code>
          <button id="copyBtn" class="codecard__copy" type="button" aria-label="Copy code">Copy</button>
        </section>

        <div class="cta-row">
          {fairwayiqScheme && (
            <a class="btn btn--primary" href={fairwayiqScheme}>
              Open in Bagpipe Golf
            </a>
          )}
          <a class="btn btn--ghost" href={`mailto:hello@bagpipegolf.com?subject=Bagpipe%20Golf%20TestFlight%20invite%20(join%20${code})`}>
            Get the app
          </a>
        </div>

        <details class="manual">
          <summary>Or enter the code manually</summary>
          <ol>
            <li>Open <strong>Bagpipe Golf</strong> on your phone.</li>
            <li>For a <strong>side-bet game</strong>: tap the <strong>Play</strong> tab and choose <strong>Join Game</strong>, then paste <code>{code}</code>.</li>
            <li>For a <strong>tournament</strong>: tap the <strong>Events</strong> tab and choose <strong>Join Tournament</strong>, then paste <code>{code}</code>.</li>
            <li>Not sure which? Either flow will bounce you to the right screen once the code resolves.</li>
          </ol>
        </details>
      </>
    ) : (
      <>
        <p class="pagewrap__eyebrow">Join a live game</p>
        <h1 class="pagewrap__title">That code doesn't look right.</h1>
        <p class="pagewrap__sub">
          Bagpipe Golf join codes are 6 letters and numbers — like <code>ABC123</code>. Check the link you tapped and try again, or open the app and use <strong>Join Game</strong> (Play tab) or <strong>Join Tournament</strong> (Events tab) to type the code manually.
        </p>
        <a class="btn btn--primary" href="/">Back to home</a>
      </>
    )}
  </main>

  {isValid && (
    <script is:inline define:vars={{ code }}>
      // Copy-to-clipboard for the code chip. Inline so the page works
      // without the marketing-site JS bundle (which is empty today).
      const btn = document.getElementById('copyBtn');
      if (btn && navigator.clipboard) {
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(code);
            const original = btn.textContent;
            btn.textContent = 'Copied';
            setTimeout(() => { btn.textContent = original ?? 'Copy'; }, 1500);
          } catch (_) {
            // Clipboard API blocked — no-op. The code is still visible.
          }
        });
      }
    </script>
  )}
</BaseLayout>

<style>
  .pagewrap--narrow { max-width: 560px; }

  .codecard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 28px 24px;
    background: var(--brand-green-soft, #f0f7f2);
    border: 2px solid var(--brand-green, #2f7d44);
    border-radius: 16px;
    margin: 24px 0;
  }
  .codecard__label {
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--brand-green-dark, #1f5b30);
  }
  .codecard__value {
    font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 40px;
    font-weight: 800;
    letter-spacing: 10px;
    color: var(--brand-green-dark, #1f5b30);
  }
  .codecard__copy {
    appearance: none;
    background: transparent;
    border: 1px solid var(--brand-green, #2f7d44);
    color: var(--brand-green-dark, #1f5b30);
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }
  .codecard__copy:hover { background: rgba(47, 125, 68, 0.08); }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 12px 0 24px;
  }
  .btn {
    flex: 1 1 200px;
    text-align: center;
    padding: 14px 18px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
  }
  .btn--primary {
    background: var(--brand-green, #2f7d44);
    color: white;
  }
  .btn--primary:hover { background: var(--brand-green-dark, #1f5b30); }
  .btn--ghost {
    background: transparent;
    border: 1px solid var(--brand-green, #2f7d44);
    color: var(--brand-green-dark, #1f5b30);
  }
  .btn--ghost:hover { background: rgba(47, 125, 68, 0.08); }

  .manual { margin-top: 24px; }
  .manual summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--brand-green-dark, #1f5b30);
    padding: 12px 0;
  }
  .manual ol { padding-left: 24px; color: var(--ink-muted, #4b5b54); }
  .manual li { padding: 6px 0; line-height: 1.5; }
  .manual code {
    background: rgba(47, 125, 68, 0.1);
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 700;
  }
</style>
