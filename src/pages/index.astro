---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Bagpipe Golf — Play games. Settle scores.">
  <main>
    <!-- ───────── Hero ───────── -->
    <section class="hero">
      <div class="hero__inner">
        <img
          src="/bagpipe-golf-logo.jpg"
          alt="Bagpipe Golf — the green bagpiper, with the wordmark Bagpipe Golf"
          class="hero__logo"
          width="260"
          height="260"
        />
        <h1 class="hero__title">Play games.<br />Settle scores.</h1>
        <p class="hero__tagline">
          The on-course caddie, scorecard, and side-bet engine for
          buddies trips, tournaments, and everything in between.
          Buddies trip customizable templates, 30 side games, full
          settlement math, flighted tournaments, a clubhouse-TV kiosk
          view — built by golfers who got tired of doing skins on a
          napkin.
        </p>

        <!-- Launch banner — replaces the sitenav "Live on App Store"
             button per Sam 2026-08-25. Prominent visual push on the
             homepage, doesn't clutter every-page nav chrome. -->
        <a class="launchBanner" href="https://apps.apple.com/app/id6775045734">
          <img
            src="/bagpipe-golf-logo.jpg"
            alt=""
            class="launchBanner__logo"
            width="72"
            height="72"
          />
          <div class="launchBanner__copy">
            <span class="launchBanner__eyebrow">App Launch</span>
            <span class="launchBanner__title">Now Available on the App Store</span>
            <span class="launchBanner__sub">iPhone &amp; iPad · free · Android coming soon</span>
          </div>
          <span class="launchBanner__arrow" aria-hidden="true">↗</span>
        </a>

        <div class="hero__ctas">
          <a class="btn btn--primary" href="#features">See what's inside</a>
          <a class="btn btn--ghost" href="#directors">Run a tournament</a>
        </div>
        <p class="hero__sub">
          Not on iPhone? Email
          <a href="mailto:hello@bagpipegolf.com?subject=Bagpipe%20Golf">hello@bagpipegolf.com</a>
          — we'll ping you when Android ships.
        </p>
      </div>
    </section>

    <!-- ───────── Feature triad ───────── -->
    <section class="features" id="features">
      <div class="features__inner">
        <h2 class="section__title">Three apps, one round.</h2>
        <div class="grid grid--3">
          <article class="card">
            <div class="card__icon" aria-hidden="true">🏌️</div>
            <h3>Smart scorecard</h3>
            <p>
              GHIN-style notation, per-hole FIR / GIR / putts, course
              handicap math done for you. Tap a cell, enter a score,
              done. Career stats roll up automatically — no spreadsheet,
              no math on the cart path.
            </p>
          </article>
          <article class="card">
            <div class="card__icon" aria-hidden="true">💰</div>
            <h3>30 side games</h3>
            <p>
              Skins, Nassau, Wolf, Vegas, Stableford, Hammer, Bingo Bango
              Bongo, Scotch, Six-Six-Six and 21 more — full settlement
              math, hole-by-hole, zero-sum guaranteed. Add a press at
              the 9th and the engine still balances.
            </p>
          </article>
          <article class="card">
            <div class="card__icon" aria-hidden="true">🏆</div>
            <h3>Tournaments &amp; leagues</h3>
            <p>
              Flighted gross / net / Stableford, Calcutta lots,
              closest-to-pin + longest-drive pools, placing-payout
              curves, shotgun pairings, a TV kiosk for the clubhouse,
              and season-long league standings. Run your member-guest
              from a phone.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ───────── For buddies trips ───────── -->
    <section class="buddies" id="buddies">
      <div class="buddies__inner">
        <span class="buddies__chip">Buddies Trip Ready</span>
        <h2 class="section__title buddies__title">Made for the trip of the year.</h2>
        <p class="buddies__lead">
          <strong>Buddies trip customizable templates.</strong>
          Ryder-Cup-style Cups across every course, cumulative team scoring,
          live standings for the whole group &mdash; pre-loaded and ready
          in under a minute. Pick your format, pick your teams, hand out
          the join code. The app handles the rest.
        </p>
        <ul class="bullets bullets--dark">
          <li>Team Cups across 3, 4, or 5 rounds &mdash; front / back / overall segments</li>
          <li>Custom formats: match play, best ball, scramble, alternate shot, Nassau, skins</li>
          <li>Handicaps handled &mdash; mixed-skill trips stay fair</li>
          <li>Live share codes so spouses, brothers-in-law, and the guy who bailed can watch the money in real time</li>
          <li>Post-trip recap the group forwards home &mdash; the moment that gets people planning next year</li>
        </ul>
        <a class="btn btn--primary" href="mailto:hello@bagpipegolf.com?subject=Bagpipe%20Golf%20for%20my%20buddies%20trip">
          Plan your trip &rarr;
        </a>
      </div>
    </section>

    <!-- ───────── For directors ───────── -->
    <section class="directors" id="directors">
      <div class="directors__inner">
        <div class="directors__text">
          <h2 class="section__title">Built for tournament directors.</h2>
          <p>
            Roster, tee sheet, flights, pairings, shotgun starts,
            leaderboards, the kiosk wall — generated from one wizard.
            Players score themselves on their phones; you watch the
            leaderboard update live on the clubhouse TV. Sponsor logos,
            branded scorecards, cart signs, bag tags — exported as a
            one-tap print pack.
          </p>
          <ul class="bullets">
            <li>Wizard-driven setup — flights, side pools, payouts, shotgun</li>
            <li>Live kiosk leaderboard for the clubhouse TV</li>
            <li>Sponsor placement on leaderboard, kiosk, and print pack</li>
            <li>Director-controlled payout distribution with a balance guard</li>
            <li>Real-time spectator share codes — friends &amp; family follow live</li>
            <li>GHIN Sync — coming soon</li>
            <li>AI-assisted tournament comms (push / email / SMS) — coming soon</li>
          </ul>
          <a class="btn btn--primary" href="mailto:hello@bagpipegolf.com?subject=Bagpipe%20Golf%20for%20my%20event">
            Pitch your event →
          </a>
        </div>
      </div>
    </section>

    <!-- ───────── Coming soon strip ───────── -->
    <section class="comingsoon">
      <div class="comingsoon__inner">
        <span class="comingsoon__chip">In flight</span>
        <p>
          AI-assisted tournament comms (push, email, SMS) · GHIN sync ·
          Android.
        </p>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  /* ── Layout primitives ─────────────────────────────── */
  main { display: block; }
  .grid { display: grid; gap: 24px; }
  .grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 880px) {
    .grid--3 { grid-template-columns: 1fr; }
  }

  /* ── Buttons ───────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 14px 22px;
    font-size: 16px;
    font-weight: 700;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.06s ease, box-shadow 0.12s ease;
  }
  .btn:hover { transform: translateY(-1px); }
  .btn--primary {
    background: var(--brand-green);
    color: #fff;
    box-shadow: 0 4px 14px rgba(26, 92, 56, 0.28);
  }
  .btn--primary:hover { background: var(--brand-green-dark); color: #fff; }
  .btn--ghost {
    background: transparent;
    color: var(--brand-green);
    border: 2px solid var(--brand-green);
  }
  .btn--ghost:hover { background: var(--brand-green); color: #fff; }

  /* ── Hero ──────────────────────────────────────────── */
  .hero {
    background: linear-gradient(180deg, var(--brand-green-pale) 0%, var(--paper) 100%);
    padding: 72px 24px 96px;
    text-align: center;
  }
  .hero__inner {
    max-width: 760px;
    margin: 0 auto;
  }
  .hero__logo {
    width: 260px;
    height: 260px;
    margin: 0 auto 28px;
    border-radius: 32px;
    object-fit: contain;
    box-shadow: 0 18px 50px rgba(26, 92, 56, 0.18);
  }
  .hero__title {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 800;
    color: var(--brand-green-dark);
    margin-bottom: 16px;
    line-height: 1.05;
  }
  .hero__tagline {
    font-size: 19px;
    color: var(--ink);
    margin: 0 auto 28px;
    max-width: 580px;
  }
  .hero__ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ── Launch banner ─────────────────────────────────── */
  .launchBanner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
    max-width: 640px;
    margin: 0 auto 24px;
    padding: 16px 22px;
    background:
      linear-gradient(
        135deg,
        var(--brand-green-dark) 0%,
        var(--brand-green) 100%
      );
    border-radius: 16px;
    box-shadow: 0 10px 32px rgba(15, 61, 37, 0.35);
    text-decoration: none;
    color: #fff;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .launchBanner:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 38px rgba(15, 61, 37, 0.42);
  }
  .launchBanner__logo {
    width: 72px;
    height: 72px;
    border-radius: 12px;
    object-fit: cover;
    background: #fff;
    padding: 4px;
    box-sizing: border-box;
  }
  .launchBanner__copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
    min-width: 0;
  }
  .launchBanner__eyebrow {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .launchBanner__title {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }
  .launchBanner__sub {
    font-size: 13px;
    opacity: 0.85;
    margin-top: 2px;
  }
  .launchBanner__arrow {
    font-size: 28px;
    font-weight: 700;
    opacity: 0.85;
    padding-right: 4px;
  }
  @media (max-width: 520px) {
    .launchBanner {
      grid-template-columns: auto 1fr;
      gap: 14px;
      padding: 14px 16px;
    }
    .launchBanner__arrow { display: none; }
    .launchBanner__logo { width: 56px; height: 56px; }
    .launchBanner__title { font-size: 17px; }
  }
  .hero__sub {
    margin-top: 24px;
    color: var(--ink-muted);
    font-size: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    align-items: center;
  }
  .hero__chip {
    background: var(--brand-green-dark);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }

  /* ── Features ──────────────────────────────────────── */
  .features { padding: 80px 24px; }
  .features__inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .section__title {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 800;
    color: var(--brand-green-dark);
    margin-bottom: 36px;
    text-align: center;
  }
  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 26px 22px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }
  .card__icon { font-size: 30px; margin-bottom: 12px; }
  .card h3 {
    font-size: 20px;
    font-weight: 700;
    color: var(--brand-green-dark);
    margin: 0 0 8px;
  }
  .card p { margin: 0; color: var(--ink-muted); }

  /* ── Buddies trips ─────────────────────────────────── */
  .buddies {
    background: var(--brand-green-pale);
    padding: 72px 24px;
  }
  .buddies__inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: left;
  }
  .buddies__chip {
    display: inline-block;
    background: var(--brand-green-dark);
    color: var(--brand-green-pale);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  .buddies__title {
    text-align: left;
    margin-bottom: 16px;
  }
  .buddies__lead {
    font-size: 18px;
    color: var(--ink);
    margin: 0 0 20px;
    line-height: 1.5;
  }
  .buddies__lead strong {
    color: var(--brand-green-dark);
    font-weight: 800;
  }
  /*
   * Specificity boost via `.bullets.bullets--dark` (0,0,2,1) so
   * these dark-on-light rules beat the base `.bullets li` white
   * text (0,0,1,1) that appears LATER in the source. Without the
   * extra `.bullets` in the selector, source order wins the tie
   * and the buddies-trip bullets render as white-on-mint —
   * effectively invisible (Sam screenshot 2026-08-25).
   */
  .bullets.bullets--dark li {
    color: var(--ink);
  }
  .bullets.bullets--dark li::before {
    color: var(--brand-green);
  }

  /* ── Directors ─────────────────────────────────────── */
  .directors {
    background: var(--brand-green);
    color: #fff;
    padding: 80px 24px;
  }
  .directors__inner {
    max-width: 760px;
    margin: 0 auto;
  }
  .directors .section__title { color: #fff; }
  .directors p { color: rgba(255, 255, 255, 0.92); }
  .bullets {
    list-style: none;
    padding: 0;
    margin: 24px 0;
    display: grid;
    gap: 10px;
  }
  .bullets li {
    padding-left: 28px;
    position: relative;
    color: rgba(255, 255, 255, 0.92);
  }
  .bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--brand-green-pale);
    font-weight: 800;
  }
  .directors .btn--primary {
    background: #fff;
    color: var(--brand-green-dark);
    margin-top: 12px;
  }
  .directors .btn--primary:hover {
    background: var(--brand-green-pale);
    color: var(--brand-green-dark);
  }

  /* ── Coming soon ───────────────────────────────────── */
  .comingsoon {
    background: var(--paper);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 32px 24px;
  }
  .comingsoon__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .comingsoon__chip {
    background: var(--brand-green-dark);
    color: var(--brand-green-pale);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .comingsoon p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 15px;
  }

</style>
