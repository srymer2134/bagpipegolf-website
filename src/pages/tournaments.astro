---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppLinkBanner from '../components/AppLinkBanner.astro';
import { CUP_TEMPLATE_LIST } from '../lib/cupTemplates';

// Content sourced from the Flutter repo's canonical `docs/HOWTO_TOURNAMENTS.md`
// (2026-08-19). Format list + handicap allowances should stay in sync with the
// engine — update both docs in the same PR when a new format ships.
//
// The Buddies Trip Templates grid pulls its round schedules from the
// shared `src/lib/cupTemplates.ts` module — the same source the
// wizard's Step 0 picker consumes, so the marketing pages and the
// wizard can never drift. Copy (`pitch`, `fit`, `includes`, `meta`,
// `detail`) also lives in that module.

interface Format {
  name: string;
  kind: 'individual' | 'team';
  players?: string;
  body: string;
  allowance?: string;
}

const formats: Format[] = [
  {
    name: 'Stroke Play',
    kind: 'individual',
    body:
      'Each player records gross strokes per hole; the lowest 18-hole total wins. Net = gross minus course handicap. The World Handicap System caps any hole at net double bogey.',
    allowance: '95% Course Handicap',
  },
  {
    name: 'Match Play (Singles)',
    kind: 'individual',
    body:
      '1-on-1 hole by hole. Win the hole = +1. The match ends when one side leads by more holes than remain (e.g. 4&3). Net match play applies 100% of the handicap difference on the lowest-index holes.',
  },
  {
    name: 'Stableford',
    kind: 'individual',
    body:
      'Points format: bogey=1, par=2, birdie=3, eagle=4, double-eagle=5; double-bogey or worse=0. Net Stableford applies handicap before scoring.',
    allowance: '95% Course Handicap',
  },
  {
    name: 'Modified Stableford',
    kind: 'individual',
    body:
      'Stableford with a custom table that rewards aggressive play. PGA Tour Barracuda uses: eagle +5, birdie +2, par 0, bogey −1, double-or-worse −3.',
  },
  {
    name: 'Best Ball / Four-Ball',
    kind: 'team',
    players: '2-person teams',
    body:
      'Each player plays their own ball; the lower of the two team scores counts as the team hole score. Handicap applied BEFORE comparing (net per hole, not low gross). Common at member-guest events.',
    allowance: '85% Course Handicap (each player)',
  },
  {
    name: 'Scramble',
    kind: 'team',
    players: '4-person default (2 and 3 supported)',
    body:
      'All teammates tee off; the captain picks the best drive; everyone plays their next shot from there until holed. One team gross per hole. Texas Scramble adds a minimum-drives rule (each player\'s drive used at least 3 times) — organize manually.',
    allowance: '4 players: 25%A + 20%B + 15%C + 10%D (70% total)',
  },
  {
    name: 'Foursomes (Alternate Shot)',
    kind: 'team',
    players: '2-person teams',
    body:
      'Partners alternate STROKES on a single ball. One partner tees off odd holes, the other even. Traditional, punishing, and gorgeous when it works.',
    allowance: '(low + high) × 50%',
  },
  {
    name: 'Greensomes (Modified Alternate)',
    kind: 'team',
    players: '2-person teams',
    body:
      'Both partners tee off; pick the better drive; the partner whose drive was NOT chosen plays the second. Alternate strokes from there.',
    allowance: '60% low + 40% high Course Handicap',
  },
  {
    name: 'Pinehurst (Chapman)',
    kind: 'team',
    players: '2-person teams',
    body:
      'Both partners tee off, then SWAP balls for the second shot. After the two seconds, pick one ball; the OTHER partner plays the third, and they alternate to the hole.',
    allowance: '60% low + 40% high',
  },
  {
    name: 'Bloodsome (Reverse Scramble)',
    kind: 'team',
    players: '2-person teams',
    body:
      'Worst-drive variant of Foursomes. Both partners tee off; the captain picks the WORSE drive; the team plays alternate shot from there. Punishing but memorable.',
    allowance: '50% of combined Course Handicaps',
  },
  {
    name: 'Round Robin',
    kind: 'team',
    players: '4 players',
    body:
      'Partners rotate every 6 holes so every pairing plays together once. Holes 1–6: AB vs CD. 7–12: AC vs BD. 13–18: AD vs BC. Each 6-hole segment is its own match.',
  },
  {
    name: 'Six-Six-Six',
    kind: 'team',
    players: '4 players',
    body:
      'Same rotation as Round Robin — three 6-hole segments — but best-ball scoring within each segment rather than match play.',
  },
];

// Buddies Trip Templates — pulled from the shared cupTemplates
// module (also consumed by /buddies-trips + the wizard's Step 0).
// Point weights + formats mirror the mobile app's canonical
// wizard specs. Update `src/lib/cupTemplates.ts` when a preset's
// round order or point weighting changes.
//
// The presentation shape below (session / format / points strings)
// is derived from the shared `CupTemplateRound` — a small helper
// keeps the display layer decoupled from the wire values.

const roundFormatLabels: Record<string, string> = {
  stroke_play: 'Singles Stroke Play',
  match_play_singles: 'Singles Match Play',
  best_ball: 'Best Ball (Four-Ball)',
  best_ball_four_man: '4-Man Best Ball',
  best_three_of_four: 'Best Three of Four',
  foursomes: 'Foursomes (Alt Shot)',
  greensomes: 'Greensomes',
  pinehurst: 'Pinehurst',
  modified_stableford: 'Modified Stableford',
  high_low_2v2: 'High-Low',
  twelves: 'Twelves',
  bramble: 'Bramble',
  yellow_ball: 'Yellow Ball',
};

const buddiesTemplates = CUP_TEMPLATE_LIST.map((t) => ({
  name: t.name,
  tagline: t.tagline,
  rounds: t.rounds.map((r, i) => ({
    session: `R${i + 1}`,
    // Prefer the human name from the template (already carries
    // course hints for Bandon signature rounds like "R1 · Best
    // Ball (Pacific Dunes)"); fall back to the format label.
    format: r.name.replace(/^R\d+\s*[·—-]\s*/, '') || roundFormatLabels[r.format] || r.format,
    points: `${r.pointsAvailable} pts`,
  })),
  meta: t.copy.meta,
  detail: t.copy.detail,
}));
---

<BaseLayout title="Tournaments · Bagpipe Golf" description="Eleven tournament formats, four Buddies Trip Cup templates (Ryder Cup, Scarecrow Cup, Ballyneal Brigade, Bandon Dunes Cup), and a wizard to build your own — every pairing, point, and payout handled on your phone.">
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">Tournaments</p>
    <h1 class="pagewrap__title">The tournament engine for your best golf trip.</h1>
    <p class="pagewrap__sub">
      Eleven formats. Four shipping Cup templates. And a wizard to design
      the trip your crew has been running on spreadsheets for years. Bagpipe
      handles pairings, points, and payouts — you show up and play.
    </p>

    <AppLinkBanner
      singular="tournament"
      plural="tournaments"
      appPath="/app/tournaments"
      productLabel="tournament formats"
    />

    <section class="formats">
      <div class="section-head">
        <h2>Tournament formats</h2>
        <p class="section-sub">
          Each round of a multi-round tournament picks its own format
          independently. Handicap allowances follow USGA defaults; the
          leaderboard reads the configured allowance when computing Net.
        </p>
      </div>

      <h3 class="grouptitle">Individual formats</h3>
      <div class="fgrid">
        {
          formats.filter((f) => f.kind === 'individual').map((f) => (
            <article class="fcard">
              <header class="fcard__head">
                <h4>{f.name}</h4>
                <span class="chip chip--muted">Individual</span>
              </header>
              <p>{f.body}</p>
              {f.allowance && (
                <p class="fcard__meta">
                  <span class="fcard__metalabel">Allowance:</span> {f.allowance}
                </p>
              )}
            </article>
          ))
        }
      </div>

      <h3 class="grouptitle">Team formats</h3>
      <div class="fgrid">
        {
          formats.filter((f) => f.kind === 'team').map((f) => (
            <article class="fcard">
              <header class="fcard__head">
                <h4>{f.name}</h4>
                <span class="chip chip--muted">{f.players ?? 'Team'}</span>
              </header>
              <p>{f.body}</p>
              {f.allowance && (
                <p class="fcard__meta">
                  <span class="fcard__metalabel">Allowance:</span> {f.allowance}
                </p>
              )}
            </article>
          ))
        }
      </div>

      <aside class="callout">
        <strong>Why a "team" round still tracks per-player stats.</strong>
        Even in Best Ball or Scramble you can enter each player's per-hole gross
        — the leaderboard derives the team gross as the MIN of members per hole.
        Necessary when a side bet (FIRs, Skins, Greenies) needs per-player
        data alongside the team format.
      </aside>
    </section>

    <section class="buddies">
      <div class="section-head">
        <span class="chip">Buddies Trip Templates</span>
        <h2>Four cup templates. Pick one, drop in your roster, tee off.</h2>
        <p class="section-sub">
          Multi-day team-match trips are the reason golf gets scheduled a
          year in advance. Every round, format, and point weight is preset —
          the wizard takes 90 seconds instead of 90 minutes.
        </p>
      </div>

      <div class="bgrid">
        {
          buddiesTemplates.map((t) => (
            <article class="bcard">
              <header class="bcard__head">
                <h3>{t.name}</h3>
              </header>
              <p class="bcard__tagline">{t.tagline}</p>
              <ol class="bcard__rounds">
                {
                  t.rounds.map((r) => (
                    <li class="bcard__round">
                      <span class="bcard__roundlabel">{r.session}</span>
                      <span class="bcard__roundformat">{r.format}</span>
                      {r.points && (
                        <span class="bcard__roundpoints">{r.points}</span>
                      )}
                    </li>
                  ))
                }
              </ol>
              <p class="bcard__meta">{t.meta}</p>
              <p class="bcard__detail">{t.detail}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="build-own">
      <div class="build-own__grid">
        <div class="build-own__copy">
          <span class="chip">Design Your Own</span>
          <h2>Build a Cup for the trip you actually run.</h2>
          <p>
            Not on the list? Build it. Any round count, any format
            combination, any point weighting — the wizard turns it into
            a preset you can reuse next year.
          </p>
          <ul class="build-own__bullets">
            <li>Any number of rounds, mix any formats round by round.</li>
            <li>Set your own point value per session — flat, weighted, whatever.</li>
            <li>Team composer, live Cup scoreboard, printable scorecard packs.</li>
            <li>Save it, name it, share the invite link.</li>
          </ul>
          <div class="build-own__ctas">
            <a class="btn btn--primary" href="/signup">Create account · Start designing</a>
            <a class="btn btn--ghost" href="/features">See what else is in the box</a>
          </div>
        </div>
        <div class="build-own__preview" aria-hidden="true">
          <div class="preview-round">
            <span class="preview-round__label">Round 1</span>
            <span class="preview-round__format">Your format</span>
            <span class="preview-round__points">? pts</span>
          </div>
          <div class="preview-round">
            <span class="preview-round__label">Round 2</span>
            <span class="preview-round__format">Your format</span>
            <span class="preview-round__points">? pts</span>
          </div>
          <div class="preview-round">
            <span class="preview-round__label">Round 3</span>
            <span class="preview-round__format">Your format</span>
            <span class="preview-round__points">? pts</span>
          </div>
          <div class="preview-round preview-round--faded">
            <span class="preview-round__label">+ Add round</span>
          </div>
        </div>
      </div>
    </section>

    <section class="cta">
      <h2>Ready to run one?</h2>
      <p>Sign up, pick a format, invite your crew. The whole thing lives on your phone.</p>
      <div class="cta__row">
        <a class="btn btn--primary" href="/signup">Create account</a>
        <a class="btn btn--ghost" href="/side-games">Explore side games</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .section-head {
    margin: 24px 0 20px;
  }
  .section-head h2 {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 8px 0 8px;
  }
  .section-sub {
    color: var(--ink-muted);
    margin: 0;
    font-size: 0.938rem;
    max-width: 68ch;
  }

  .grouptitle {
    font-size: 0.812rem;
    font-weight: 800;
    color: var(--ink-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 32px 0 12px;
  }

  .fgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 720px) {
    .fgrid { grid-template-columns: 1fr; }
  }

  .fcard {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fcard__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .fcard__head h4 {
    font-size: 1.062rem;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0;
  }
  .fcard p {
    margin: 0;
    color: var(--ink);
    font-size: 0.938rem;
    line-height: 1.5;
  }
  .fcard__meta {
    color: var(--ink-muted);
    font-size: 0.812rem;
  }
  .fcard__metalabel {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.625rem;
    font-weight: 800;
    color: var(--brand-green);
    margin-right: 4px;
  }

  .callout {
    margin-top: 20px;
    padding: 18px 22px;
    background: var(--brand-green-pale);
    border-radius: 12px;
    color: var(--ink);
    font-size: 0.938rem;
    line-height: 1.55;
  }
  .callout strong {
    color: var(--brand-green-dark);
    display: block;
    margin-bottom: 4px;
  }

  .buddies {
    margin-top: 56px;
    padding: 40px 32px;
    background: linear-gradient(180deg, #fff 0%, var(--paper-tint) 100%);
    border: 1px solid var(--line);
    border-radius: 20px;
  }
  .buddies .section-head {
    text-align: left;
    margin-top: 0;
  }
  .buddies .section-head .chip {
    margin-bottom: 12px;
  }

  .bgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 12px;
  }
  @media (max-width: 880px) {
    .bgrid { grid-template-columns: 1fr; }
  }

  .bcard {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 22px 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 4px 12px rgba(15, 61, 37, 0.04);
    transition: transform 0.08s ease, box-shadow 0.12s ease, border-color 0.12s ease;
  }
  .bcard:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(15, 61, 37, 0.10);
    border-color: rgba(26, 92, 56, 0.28);
  }
  .bcard__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .bcard__head h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .bcard__tagline {
    margin: 0 0 4px;
    color: var(--ink);
    font-size: 0.938rem;
    line-height: 1.5;
  }
  .bcard__rounds {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .bcard__round {
    display: grid;
    grid-template-columns: 76px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    background: var(--brand-green-pale);
    border-radius: 8px;
    font-size: 0.812rem;
    line-height: 1.35;
  }
  .bcard__roundlabel {
    font-weight: 800;
    color: var(--brand-green-dark);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-size: 0.656rem;
  }
  .bcard__roundformat {
    color: var(--ink);
    font-weight: 600;
  }
  .bcard__roundpoints {
    font-weight: 800;
    color: var(--brand-green-dark);
    background: #fff;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.719rem;
    letter-spacing: 0.02em;
  }
  .bcard__meta {
    margin: 4px 0 0;
    color: var(--brand-green-dark);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .bcard__detail {
    margin: 0;
    color: var(--ink-muted);
    font-size: 0.812rem;
    line-height: 1.5;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

  /* ── Design Your Own Cup ─────────────────────────────────── */
  .build-own {
    margin-top: 40px;
    padding: 40px 32px;
    background: var(--brand-green-dark);
    border-radius: 20px;
    color: #fff;
  }
  .build-own__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: center;
  }
  @media (max-width: 880px) {
    .build-own { padding: 32px 24px; }
    .build-own__grid { grid-template-columns: 1fr; gap: 28px; }
  }

  .build-own__copy .chip {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    margin-bottom: 12px;
  }
  .build-own__copy h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: #fff;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .build-own__copy > p {
    margin: 0 0 16px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 1rem;
    line-height: 1.55;
  }
  .build-own__bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .build-own__bullets li {
    padding-left: 22px;
    position: relative;
    color: rgba(255, 255, 255, 0.94);
    font-size: 0.938rem;
    line-height: 1.5;
  }
  .build-own__bullets li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 800;
    color: #fff;
  }
  .build-own__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .build-own__ctas .btn--primary {
    background: #fff;
    color: var(--brand-green-dark);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  }
  .build-own__ctas .btn--primary:hover {
    background: rgba(255, 255, 255, 0.92);
    color: var(--brand-green-dark);
  }
  .build-own__ctas .btn--ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }
  .build-own__ctas .btn--ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border-color: #fff;
  }

  .build-own__preview {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    border: 1px dashed rgba(255, 255, 255, 0.28);
  }
  .preview-round {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    font-size: 0.812rem;
  }
  .preview-round__label {
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.656rem;
  }
  .preview-round__format {
    color: rgba(255, 255, 255, 0.82);
    font-weight: 600;
    font-style: italic;
  }
  .preview-round__points {
    font-weight: 800;
    color: #fff;
    background: rgba(255, 255, 255, 0.16);
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.719rem;
  }
  .preview-round--faded {
    background: rgba(255, 255, 255, 0.04);
    border: 1px dashed rgba(255, 255, 255, 0.22);
    grid-template-columns: 1fr;
    justify-items: center;
  }
  .preview-round--faded .preview-round__label {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.70);
    letter-spacing: 0;
    text-transform: none;
  }

  .cta {
    margin-top: 56px;
    text-align: center;
    padding: 48px 24px;
    background: var(--brand-green-pale);
    border-radius: 20px;
  }
  .cta h2 {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0 0 8px;
  }
  .cta p {
    color: var(--ink);
    margin: 0 0 20px;
    font-size: 1rem;
  }
  .cta__row {
    display: inline-flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
