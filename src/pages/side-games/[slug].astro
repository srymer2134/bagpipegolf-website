---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppLinkBanner from '../../components/AppLinkBanner.astro';
import {
  categories,
  gameBySlug,
  gamesWithSlugs,
} from '../../lib/sideGames';

// ============================================================
// One page per side game — GTM §4.6 / decision R3
// ============================================================
// R3 settled 32 pages over 14: the catalog is 32 games, and 14 covered
// 44% of the cheapest traffic we have. Someone searching "wolf golf game
// rules" is mid-argument on a tee box — maximal intent, almost no
// competition for the term — and organic is the only channel in the plan
// that keeps compounding after the ad budget stops.
//
// SERVER-RENDERED, like every other marketing page here. Static
// prerendering is the better shape for 32 long-tail landing pages and
// astro.config.mjs already anticipates it ("once we want them
// SEO-snappy") — but `prerender = true` runs `src/middleware.ts` at BUILD
// time, and that middleware initialises Supabase and throws without
// runtime env. Making it skip public routes is a sensible follow-up and a
// change to the auth path; it is not part of shipping the pages, so it is
// deliberately not bundled here.
const { slug } = Astro.params;
const game = gameBySlug(slug!);

// A slug that isn't in the catalog is a real 404, not an empty page —
// an empty 200 is worse than a 404 for both crawlers and readers.
if (!game) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const cat = categories[game.category];

// Related reading: the rest of this game's category. Internal links are
// how a long-tail library stops being 32 orphans — a visitor who landed
// on "Wolf" is one tap from every other match-play game.
const related = gamesWithSlugs
  .filter((g) => g.category === game.category && g.slug !== game.slug)
  .slice(0, 6);

const title = `${game.name} — golf side game rules, scoring & payouts | Bagpipe Golf`;
const description =
  `How to play ${game.name} (${game.players} players): the rules, a worked ` +
  `example with real money, and how to settle it without a spreadsheet.`;
const canonical = `/side-games/${game.slug}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Side games',
          item: 'https://bagpipegolf.com/side-games',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: game.name,
          item: `https://bagpipegolf.com${canonical}`,
        },
      ],
    },
    {
      '@type': 'Article',
      headline: `${game.name} — golf side game rules and scoring`,
      description: game.what,
      about: { '@type': 'Thing', name: `${game.name} (golf side game)` },
      isPartOf: {
        '@type': 'WebPage',
        name: 'Golf side games',
        url: 'https://bagpipegolf.com/side-games',
      },
    },
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <set:html value={`<script type="application/ld+json">${JSON.stringify(jsonLd)}</script>`} />

  <main class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/side-games">Side games</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{game.name}</span>
    </nav>

    <header class="head">
      <h1>{game.name}</h1>
      <p class="head__sub">
        {cat.title} &middot; {game.players} players
      </p>
    </header>

    <section class="block">
      <h2>How {game.name} works</h2>
      <p class="lede">{game.what}</p>
      {game.needsTracking && (
        <p class="note">
          Needs <strong>{game.needsTracking}</strong> tracking switched on at
          round start — the field it scores off doesn&rsquo;t exist otherwise.
        </p>
      )}
    </section>

    {game.example && (
      <section class="block">
        <h2>A worked example</h2>
        <div class="example">{game.example}</div>
      </section>
    )}

    <section class="block">
      <h2>Settling it without a spreadsheet</h2>
      <p>
        {game.name} is scored <strong>hole by hole</strong>, so the money moves
        the moment a hole is fully entered — you know who&rsquo;s up before you
        step to the next tee, not after three beers and an argument.
      </p>
      <p>
        Every dollar someone wins comes from someone else. That&rsquo;s simply
        what a side game is, and it&rsquo;s the property that makes the
        settlement checkable: the winnings and the losses have to cancel. At the
        19th you get one list of who pays whom, already netted down to the
        fewest transfers.
      </p>
      <p>
        You can stack {game.name} with any of the other games on the same
        round &mdash; one scorecard feeds all of them, so there&rsquo;s no
        double entry.
      </p>
    </section>

    <section class="block">
      <h2>More {cat.title.toLowerCase()} games</h2>
      <ul class="related">
        {related.map((g) => (
          <li>
            <a href={`/side-games/${g.slug}`}>{g.name}</a>
            <span class="related__players">{g.players}</span>
          </li>
        ))}
      </ul>
      <p class="related__all">
        <a href="/side-games">See all 32 side games &rarr;</a>
      </p>
    </section>

    <AppLinkBanner />

    <section class="cta">
      <h2>Score {game.name} on your next round.</h2>
      <p>Free for a limited time. First game set up in about 60 seconds.</p>
      <div class="cta__row">
        <a class="btn btn--primary" href="/signup">Create account</a>
        <a class="btn btn--ghost" href="/side-games">Browse all games</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 20px 64px;
  }

  .crumbs {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 13px;
    color: var(--ink-muted);
    margin-bottom: 18px;
  }
  .crumbs a {
    color: var(--brand-green-dark);
    text-decoration: none;
    font-weight: 600;
  }
  .crumbs a:hover { text-decoration: underline; }

  .head { margin-bottom: 28px; }
  .head h1 {
    font-size: 36px;
    line-height: 1.15;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0 0 8px;
    text-wrap: balance;
  }
  .head__sub {
    margin: 0;
    color: var(--ink-muted);
    font-size: 15px;
    font-weight: 600;
  }

  .block { margin-bottom: 34px; }
  .block h2 {
    font-size: 20px;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0 0 10px;
  }
  .block p {
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink);
  }
  .lede { font-size: 17px; }

  .note {
    background: var(--brand-green-pale);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 15px;
  }

  .example {
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 10px;
    padding: 14px 16px;
    font-size: 16px;
    line-height: 1.6;
    color: #78350f;
  }

  .related {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 20px;
  }
  @media (max-width: 620px) {
    .related { grid-template-columns: 1fr; }
  }
  .related li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--line);
    padding: 8px 0;
    font-size: 15px;
  }
  .related a {
    color: var(--brand-green-dark);
    font-weight: 700;
    text-decoration: none;
  }
  .related a:hover { text-decoration: underline; }
  .related__players { color: var(--ink-muted); font-size: 13px; }
  .related__all { font-size: 15px; }
  .related__all a {
    color: var(--brand-green-dark);
    font-weight: 700;
    text-decoration: none;
  }

  .cta {
    margin-top: 40px;
    text-align: center;
    background: var(--brand-green-pale);
    border-radius: 16px;
    padding: 30px 22px;
  }
  .cta h2 {
    font-size: 24px;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0 0 6px;
    text-wrap: balance;
  }
  .cta p { margin: 0 0 16px; color: var(--ink); font-size: 15px; }
  .cta__row {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
