---
import BaseLayout from '../layouts/BaseLayout.astro';
// The questions live in Keystatic now (content/faq/*.json, edited at
// /keystatic). src/lib/faq.ts reads them at build time and substitutes
// the {sideGameCount} token, so the side-game number stays derived
// from the library even though an editor owns the sentence around it.
import { faqEntries } from '../lib/faq';
---

<BaseLayout title="FAQ · Bagpipe Golf">
  <main class="pagewrap pagewrap--narrow">
    <p class="pagewrap__eyebrow">FAQ</p>
    <h1 class="pagewrap__title">Quick answers.</h1>
    <p class="pagewrap__sub">
      Don't see your question? <a href="mailto:support@bagpipegolf.com">Email support</a>.
    </p>

    <section class="faqs">
      {
        faqEntries.map((f) => (
          <details class="faq">
            <summary class="faq__q">{f.question}</summary>
            <p class="faq__a">{f.answer}</p>
          </details>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .faqs { display: grid; gap: 12px; }
  .faq {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 20px;
  }
  .faq__q {
    cursor: pointer;
    font-weight: 700;
    color: var(--brand-green-dark);
    list-style: none;
    font-size: 1rem;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::after {
    content: '+';
    float: right;
    color: var(--ink-muted);
    font-weight: 400;
  }
  .faq[open] .faq__q::after { content: '–'; }
  .faq__a {
    margin: 12px 0 0;
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }
</style>
