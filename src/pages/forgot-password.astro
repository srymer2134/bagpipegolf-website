---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createSupabaseClient } from '../lib/supabase';

let error: string | null = null;
let info: string | null = null;
let prefillEmail = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = (form.get('email') ?? '').toString().trim();
  prefillEmail = email;

  if (!email) {
    error = 'Email is required.';
  } else {
    const supabase = createSupabaseClient({
      request: Astro.request,
      cookies: Astro.cookies,
      locals: Astro.locals,
    });
    const { error: authErr } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: new URL('/login', Astro.request.url).toString(),
    });
    if (authErr) {
      error = authErr.message || 'Reset failed.';
    } else {
      info = `If an account exists for ${email}, a reset link is on the way.`;
    }
  }
}
---

<BaseLayout title="Reset password · Bagpipe Golf">
  <main class="pagewrap pagewrap--narrow">
    <p class="pagewrap__eyebrow">Reset password</p>
    <h1 class="pagewrap__title">Forgot your password?</h1>
    <p class="pagewrap__sub">
      We'll email you a link to reset it.
    </p>

    <form method="post" class="card authform">
      {error && <div class="authform__error" role="alert">{error}</div>}
      {info && <div class="authform__info" role="status">{info}</div>}

      <label class="authform__field">
        <span class="authform__label">Email</span>
        <input
          name="email"
          type="email"
          autocomplete="email"
          required
          value={prefillEmail}
          class="authform__input"
        />
      </label>

      <button type="submit" class="btn btn--primary btn--block">Send reset link</button>

      <div class="authform__meta">
        <a href="/login">Back to sign in</a>
      </div>
    </form>
  </main>
</BaseLayout>

<style>
  .authform { display: grid; gap: 18px; margin-top: 8px; }
  .authform__error,
  .authform__info {
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 14px;
    border-width: 1px;
    border-style: solid;
  }
  .authform__error {
    background: #FEF2F2;
    border-color: #FECACA;
    color: var(--error);
  }
  .authform__info {
    background: var(--brand-green-pale);
    border-color: var(--brand-green);
    color: var(--brand-green-dark);
  }
  .authform__field { display: grid; gap: 6px; }
  .authform__label {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .authform__input {
    border: 1.5px solid var(--line);
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 16px;
    font-family: inherit;
    background: #fff;
    transition: border-color 0.12s ease;
  }
  .authform__input:focus {
    outline: none;
    border-color: var(--brand-green);
    box-shadow: 0 0 0 4px rgba(26, 92, 56, 0.12);
  }
  .authform__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .authform__meta a { font-weight: 600; }
</style>
