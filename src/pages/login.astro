---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createSupabaseClient } from '../lib/supabase';

let error: string | null = null;
const url = new URL(Astro.request.url);
const next = url.searchParams.get('next') || '/app';
let prefillEmail = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = (form.get('email') ?? '').toString().trim();
  const password = (form.get('password') ?? '').toString();
  prefillEmail = email;

  if (!email || !password) {
    error = 'Email and password are required.';
  } else {
    try {
      const supabase = createSupabaseClient({
        request: Astro.request,
        cookies: Astro.cookies,
        locals: Astro.locals,
      });
      const { error: authErr } = await supabase.auth.signInWithPassword({ email, password });
      if (authErr) {
        error = authErr.message || 'Sign-in failed. Check your email and password.';
      } else {
        return Astro.redirect(next.startsWith('/') ? next : '/app', 303);
      }
    } catch (err: any) {
      // Something below Supabase auth threw (env misconfig, Workers
      // runtime edge case, transient upstream). Surface the message
      // so we can diagnose instead of returning a bare 500.
      console.error('[login POST] auth call threw', err);
      error =
        'Sign-in is temporarily unavailable. Please try again in a moment. ' +
        (err?.message ? `(${err.message})` : '');
    }
  }
}
---

<BaseLayout title="Sign in · Bagpipe Golf">
  <main class="pagewrap pagewrap--narrow">
    <p class="pagewrap__eyebrow">Sign in</p>
    <h1 class="pagewrap__title">Welcome back.</h1>
    <p class="pagewrap__sub">
      Use the same email and password as the Bagpipe Golf mobile app.
    </p>

    <form method="post" class="card authform">
      {error && <div class="authform__error" role="alert">{error}</div>}

      <label class="authform__field">
        <span class="authform__label">Email</span>
        <input
          name="email"
          type="email"
          autocomplete="email"
          required
          value={prefillEmail}
          class="authform__input"
        />
      </label>

      <label class="authform__field">
        <span class="authform__label">Password</span>
        <input
          name="password"
          type="password"
          autocomplete="current-password"
          required
          class="authform__input"
        />
      </label>

      <button type="submit" class="btn btn--primary btn--block">Sign in</button>

      <div class="authform__meta">
        <a href="/forgot-password">Forgot password?</a>
        <span>New here? <a href={`/signup?next=${encodeURIComponent(next)}`}>Create an account</a></span>
      </div>
    </form>
  </main>
</BaseLayout>

<style>
  .authform { display: grid; gap: 18px; margin-top: 8px; }
  .authform__error {
    background: #FEF2F2;
    border: 1px solid #FECACA;
    color: var(--error);
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 14px;
  }
  .authform__field { display: grid; gap: 6px; }
  .authform__label {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .authform__input {
    border: 1.5px solid var(--line);
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 16px;
    font-family: inherit;
    background: #fff;
    transition: border-color 0.12s ease;
  }
  .authform__input:focus {
    outline: none;
    border-color: var(--brand-green);
    box-shadow: 0 0 0 4px rgba(26, 92, 56, 0.12);
  }
  .authform__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .authform__meta a { font-weight: 600; }
</style>
