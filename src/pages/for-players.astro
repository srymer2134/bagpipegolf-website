---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="For Players · Bagpipe Golf">
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">For Players</p>
    <h1 class="pagewrap__title">Keep score. Settle bets. Watch the leaderboard.</h1>
    <p class="pagewrap__sub">
      Tap a cell, enter a score, done. The engine handles the math while you focus on the next shot.
    </p>

    <section class="grid grid--3">
      <article class="card">
        <h3>Scorecard</h3>
        <p>Tap-to-enter, per-hole stats, GHIN-style notation, career rollups.</p>
      </article>
      <article class="card">
        <h3>Side games</h3>
        <p>30 game types. Add a press at the 9th and the engine still balances.</p>
      </article>
      <article class="card">
        <h3>Tournaments &amp; leagues</h3>
        <p>Join via code or invite. Watch live leaderboards and standings.</p>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .card h3 {
    font-size: 18px;
    font-weight: 700;
    color: var(--brand-green-dark);
    margin: 0 0 6px;
  }
  .card p { margin: 0; color: var(--ink-muted); font-size: 15px; }
</style>
