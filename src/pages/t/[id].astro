---
// Short URL redirect: /t/:id → /app/tournaments/:id/leaderboard
//
// Kept as an Astro page (not a static redirect map) so we can:
//   * Preserve any query string the caller supplied (e.g. ?kiosk=1
//     from a shared kiosk-mode QR code)
//   * Return a real HTTP 302 with cache-friendly headers
//   * Give a bare fallback when :id is missing
//
// Sam 2026-07-27: /t/:id is the short, TV-remotable URL for the
// public leaderboard. Full path is /app/tournaments/:id/leaderboard;
// both routes render the same page (the short URL just hops).

const { id } = Astro.params;
const search = new URL(Astro.request.url).search;

if (!id) {
  return Astro.redirect('/app/tournaments', 302);
}

const target = `/app/tournaments/${id}/leaderboard${search}`;
return Astro.redirect(target, 302);
---
