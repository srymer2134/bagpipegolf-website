---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppLinkBanner from '../components/AppLinkBanner.astro';
import {
  categories,
  categoryOrder,
  gamesWithSlugs as games,
  totalCount,
} from '../lib/sideGames';

// The catalog moved to `src/lib/sideGames.ts` (2026-09-27, GTM R3) so the
// hub and the per-game pages at `/side-games/<slug>` read the same rows.
// Cards now link to those pages.
//
// `principles` stays page-local: it is hub framing, not per-game content,
// so the per-game pages say the same three things in their own words
// rather than importing marketing copy written for a catalog view.
const principles = [
  {
    title: 'Stack every game you love',
    body:
      'Run Skins, a Nassau, and Greenies on the same round. Every game reads the same scorecard — no double-entry, no math at the 19th.',
  },
  {
    title: 'The math always adds up',
    body:
      "Every dollar someone wins comes from someone else — that's how side games work. Bagpipe Golf tracks it hole by hole and settles it clean at the 19th. No spreadsheet. No arguments.",
  },
  {
    title: 'See the swing live',
    body:
      "Watch the pot move the moment a hole is fully scored. Know who's up before you step to the next tee — no waiting on the beers to find out.",
  },
];
---

<BaseLayout
  title="Side Games · Bagpipe Golf"
  description={`Skins, Nassau, Wolf and ${totalCount - 3} more. Play any side game with your buddies — Bagpipe Golf tracks every dollar hole by hole so the tab settles itself at the 19th.`}
>
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">Side Games</p>
    <h1 class="pagewrap__title">Play any side game. Never argue about the tab.</h1>
    <p class="pagewrap__sub">
      Skins, Nassau, Wolf, Vegas, Scotch, Hammer — plus a few you'll want
      to try. Stack as many as you want on the same round. Bagpipe Golf
      tracks every dollar hole by hole; the tab settles itself by the 19th.
    </p>

    <AppLinkBanner
      singular="game"
      plural="games"
      appPath="/app/side-games"
      productLabel="side games"
    />

    <section class="principles" aria-label="How side games work in Bagpipe Golf">
      {
        principles.map((p) => (
          <article class="principle">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))
      }
    </section>

    <section class="catalog" aria-label={`All ${totalCount} side games`}>
      <div class="catalog__head">
        <h2>{totalCount} games, grouped so you can find one fast</h2>
        <p class="catalog__sub">
          Four categories cover the whole catalog. The three tagged
          <span class="chip chip--pop-inline">Most played</span> are the ones
          you'll see in almost every buddies group.
        </p>
      </div>

      {
        categoryOrder.map((catKey) => {
          const cat = categories[catKey];
          const catGames = games.filter((g) => g.category === catKey);
          return (
            <div class="catsection">
              <header class="catsection__head">
                <h3 class="catsection__title">{cat.title}</h3>
                <p class="catsection__blurb">{cat.blurb}</p>
                <span class="catsection__count">{catGames.length} games</span>
              </header>
              <div class="catalog__grid">
                {catGames.map((g) => (
                  <article class={`gcard${g.featured ? ' gcard--featured' : ''}`}>
                    <header class="gcard__head">
                      <h4><a class="gcard__link" href={`/side-games/${g.slug}`}>{g.name}</a></h4>
                      <div class="gcard__chips">
                        {g.featured && (
                          <span class="chip chip--pop">Most played</span>
                        )}
                        <span class="chip chip--muted">{g.players} players</span>
                      </div>
                    </header>
                    <p class="gcard__what">{g.what}</p>
                    {g.example && (
                      <p class="gcard__example">
                        <span class="gcard__examplelabel">Example ·</span> {g.example}
                      </p>
                    )}
                    {g.needsTracking && (
                      <p class="gcard__meta">
                        Requires <strong>{g.needsTracking}</strong> tracking on.
                      </p>
                    )}
                    <a class="gcard__more" href={`/side-games/${g.slug}`}>
                      {g.name} rules &amp; scoring &rarr;
                    </a>
                  </article>
                ))}
              </div>
            </div>
          );
        })
      }
    </section>

    <section class="cta">
      <h2>Your next round, sorted.</h2>
      <p>Free for a limited time. Set up your first game in about 60 seconds.</p>
      <div class="cta__row">
        <a class="btn btn--primary" href="/signup">Create account</a>
        <a class="btn btn--ghost" href="/features">See all features</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 56px;
  }
  @media (max-width: 880px) {
    .principles { grid-template-columns: 1fr; }
  }
  .principle {
    background: var(--brand-green-pale);
    border-radius: 14px;
    padding: 22px 22px;
  }
  .principle h3 {
    font-size: 15px;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0 0 8px;
    letter-spacing: 0.02em;
  }
  .principle p {
    margin: 0;
    color: var(--ink);
    font-size: 15px;
    line-height: 1.5;
  }

  .gcard__link {
    color: inherit;
    text-decoration: none;
  }
  .gcard__link:hover {
    text-decoration: underline;
  }
  .gcard__more {
    display: inline-block;
    margin-top: 10px;
    font-size: 13px;
    font-weight: 700;
    color: var(--brand-green-dark);
    text-decoration: none;
  }
  .gcard__more:hover {
    text-decoration: underline;
  }

  .catalog__head {
    margin: 24px 0 20px;
  }
  .catalog__head h2 {
    font-size: 28px;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0 0 6px;
  }
  .catalog__sub {
    color: var(--ink-muted);
    margin: 0;
    font-size: 15px;
  }

  /* ── Category section — divider between the four buckets ──── */
  .catsection {
    margin-top: 36px;
  }
  .catsection:first-of-type {
    margin-top: 20px;
  }
  .catsection__head {
    border-top: 1px solid var(--line);
    padding-top: 20px;
    margin-bottom: 16px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    row-gap: 4px;
    column-gap: 16px;
  }
  .catsection__title {
    font-size: 22px;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0;
  }
  .catsection__count {
    font-size: 12px;
    font-weight: 700;
    color: var(--ink-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .catsection__blurb {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--ink-muted);
    font-size: 14px;
    max-width: 68ch;
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 720px) {
    .catalog__grid { grid-template-columns: 1fr; }
  }

  .gcard {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  /* Featured card — subtle brand-green ring so Skins/Nassau/Wolf
     draw the eye without breaking the visual grid rhythm. */
  .gcard--featured {
    border-color: var(--brand-green);
    box-shadow: 0 4px 14px rgba(26, 92, 56, 0.10);
  }
  .gcard__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .gcard__head h4 {
    font-size: 17px;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0;
  }
  .gcard__chips {
    display: inline-flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .gcard__what {
    margin: 0;
    color: var(--ink);
    font-size: 15px;
    line-height: 1.5;
  }
  .gcard__example {
    margin: 0;
    color: var(--ink-muted);
    font-size: 14px;
    line-height: 1.5;
    font-style: italic;
  }
  .gcard__examplelabel {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 10px;
    font-weight: 800;
    font-style: normal;
    color: var(--brand-green);
    margin-right: 4px;
  }
  .gcard__meta {
    margin: 0;
    color: var(--ink-muted);
    font-size: 13px;
  }

  /* "Most played" pill — brand green fill so it reads as "editors'
     pick" without looking loud. Inline variant (used in the catalog
     head paragraph) shares the same look at a slightly smaller size
     so the shape matches what's on the cards. */
  .chip--pop,
  .chip--pop-inline {
    background: var(--brand-green);
    color: #fff;
  }
  .chip--pop-inline {
    padding: 2px 8px;
    font-size: 11px;
  }

  .cta {
    text-align: center;
    padding: 48px 24px;
    background: var(--brand-green-pale);
    border-radius: 20px;
    margin-top: 56px;
  }
  .cta h2 {
    font-size: 28px;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0 0 8px;
  }
  .cta p {
    color: var(--ink);
    margin: 0 0 20px;
    font-size: 16px;
  }
  .cta__row {
    display: inline-flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
