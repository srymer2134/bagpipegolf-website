---
// /buy/<plan> — where every "Buy" button on the marketing pages points.
//
// One job: get a director from "I'll take that one" to Stripe Checkout in
// as few screens as possible, wherever they are in the setup.
//
//   league  signed out          → /signup?next=/buy/league
//           owns no league      → /app/leagues/new?then=billing (create, then pay)
//           owns a league       → /app/billing (trial or Subscribe per league)
//   event   signed out          → /signup?next=/buy/event
//           no open tournament  → /app/tournaments/new
//           one                 → /app/billing?tournament_id=<it>
//           several             → a picker, below
//   club    anyone              → the page below: Buy Club (signed out, the
//                                 button goes through sign-up first), or a
//                                 30-day trial by email. Bought Clubs are set up
//                                 by hand (api #196); checkout returns here with
//                                 ?billing=success.
//
// The `?promo=` on the link is stored by the middleware before this page
// runs (lib/promoCode.ts), so every redirect here drops the query string
// without losing the code.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuySteps from '../../components/BuySteps.astro';
import PromoCodeBox from '../../components/PromoCodeBox.astro';
import { visitorPromo } from '../../lib/promoCode';
import { buttonPrice, loadPromoView } from '../../lib/promoPreview';
import { createSupabaseClient } from '../../lib/supabase';
import {
  PLANS,
  PROMO_CODE,
  FOUNDING_CAP,
  FOUNDING_CODE,
  foundingPrice,
  isFoundingCode,
  PROMO_PERCENT,
  PROMO_ENDS_COPY,
  dollars,
  isPlanKey,
  offerActive,
  offerPrice,
} from '../../lib/offer';

const plan = Astro.params.plan;
if (!isPlanKey(plan)) return new Response('Not found', { status: 404 });

const user = (Astro.locals as App.Locals).user;
const here = `/buy/${plan}`;

let picks: Array<{ id: string; name: string }> = [];

if (plan !== 'club') {
  if (!user) return Astro.redirect(`/signup?next=${encodeURIComponent(here)}`, 302);

  const supabase = createSupabaseClient({
    request: Astro.request,
    cookies: Astro.cookies,
    locals: Astro.locals,
  });

  if (plan === 'league') {
    const { data } = await supabase.from('leagues').select('id').eq('user_id', user.id).limit(1);
    return Astro.redirect((data ?? []).length > 0 ? '/app/billing' : '/app/leagues/new?then=billing', 302);
  }

  // event: the director's own tournaments that are not finished.
  const { data } = await supabase
    .from('tournaments')
    .select('id, name')
    .eq('user_id', user.id)
    .is('completed_at', null)
    .order('created_at', { ascending: false })
    .limit(25);
  picks = ((data ?? []) as Array<{ id: string; name: string | null }>).map((t) => ({
    id: t.id,
    name: (t.name ?? '').trim() || 'Untitled tournament',
  }));
  if (picks.length === 0) return Astro.redirect('/app/tournaments/new', 302);
  if (picks.length === 1) {
    return Astro.redirect(`/app/billing?tournament_id=${encodeURIComponent(picks[0].id)}`, 302);
  }
}

const offer = offerActive();
const club = PLANS.club;
// The code's effect on the Club price, so applying one changes this page.
const clubView = plan === 'club'
  ? await loadPromoView(Astro, 'club', visitorPromo(Astro.url, Astro.cookies))
  : ({ kind: 'none' } as const);
const clubApplied = clubView.kind === 'applied';
const clubLaunch = offer && clubApplied && clubView.code.toLowerCase() === PROMO_CODE.toLowerCase();
// Founding70 (Colorado outreach): the first 25 clubs, 70% off, locked through 2028.
const clubFounding = offer && clubApplied && isFoundingCode(clubView.code);
const clubBuyCopy = `Buy Club — ${buttonPrice(clubView, 'club', `${dollars(club.price)} / year`)}`;
// Where Club checkout sends people back (api/billing/club-checkout.ts).
const clubResult = plan === 'club' ? Astro.url.searchParams.get('billing') : null;
const clubNotice =
  clubResult === 'cancelled'
    ? 'Checkout was cancelled. Nothing was charged.'
    : clubResult === 'already_subscribed'
      ? 'You already have a Club plan — it covers every league you run. Email us if a league is not switched on yet.'
      : clubResult && clubResult !== 'success'
        ? "We couldn't open checkout just now. Nothing was charged — please try again, or email us."
        : null;
const clubMail =
  'mailto:hello@bagpipegolf.com?subject=' +
  encodeURIComponent('Club plan — start our 30-day trial') +
  '&body=' +
  encodeURIComponent(
    'Club or facility name:\nHow many leagues you run:\nAdmins (up to 4) — names and emails:\nBest phone number:\n' +
      (offer ? `\nPromo code: ${clubFounding ? FOUNDING_CODE : PROMO_CODE}\n` : ''),
  );
---

<BaseLayout title={plan === 'club' ? 'Club plan · Bagpipe Golf' : 'Pick your event · Bagpipe Golf'}>
  <main class="pagewrap pagewrap--narrow">
    {plan === 'event' && (
      <>
        <BuySteps plan="event" step={2} />
        <p class="pagewrap__eyebrow">Tournament pass</p>
        <h1 class="pagewrap__title">Which event is the pass for?</h1>
        <p class="pagewrap__sub">
          One pass opens one tournament to a field of any size. Events of 36
          players or fewer are free — you only need a pass above that.
        </p>
        <ul class="picklist">
          {picks.map((t) => (
            <li>
              <a class="picklist__row" href={`/app/billing?tournament_id=${encodeURIComponent(t.id)}`}>
                <span>{t.name}</span>
                <span class="picklist__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <p><a class="btn btn--ghost btn--sm" href="/app/tournaments/new">+ Set up a new event instead</a></p>
      </>
    )}

    {plan === 'club' && clubResult === 'success' && (
      <>
        <p class="pagewrap__eyebrow">Club plan</p>
        <h1 class="pagewrap__title">Thanks — your Club plan is paid.</h1>
        <p class="pagewrap__sub">
          Stripe has emailed your receipt. We're switching on every league you
          run now and will email you when it's done. Name your club and invite
          up to 3 more admins from your club page.
        </p>
        <p class="clubcta">
          <a class="btn btn--primary" href="/app/club">Set up your club</a>
          <a class="btn btn--ghost" href="/app/leagues">Your leagues</a>
        </p>
      </>
    )}

    {plan === 'club' && clubResult !== 'success' && (
      <>
        <p class="pagewrap__eyebrow">Club plan</p>
        <h1 class="pagewrap__title">Every league you run, one plan.</h1>
        {clubNotice && <p class="notice" role="status">{clubNotice}</p>}
        <p class="pagewrap__sub">
          Unlimited leagues for {dollars(club.price)} a year, with up to 4 admins
          each running their own leagues under the one plan. Pay by card now and
          we switch on every league you run — or start with 30 days free.
        </p>
        {offer && (!clubApplied || clubLaunch) && (
          <p class="clubdeal">
            <strong>{PROMO_CODE}:</strong> {PROMO_PERCENT}% off your first year —
            {' '}<s>{dollars(club.price)}</s> <strong>{dollars(offerPrice(club))}</strong>, plus
            applicable sales tax, through {PROMO_ENDS_COPY}.
            {clubLaunch ? <> Applied for you at checkout.</> : <> Apply it below.</>}
          </p>
        )}
        {clubFounding && (
          <p class="clubdeal">
            <strong>Founding Club:</strong> 70% off your first year —
            {' '}<s>{dollars(club.price)}</s> <strong>{dollars(foundingPrice(club))}</strong>, plus
            applicable sales tax — then the price locked through 2028, and your club listed as a
            Founding Club on bagpipegolf.com. First {FOUNDING_CAP} clubs only, through {PROMO_ENDS_COPY}.
            Code {FOUNDING_CODE} is applied for you at checkout.
          </p>
        )}
        <PromoCodeBox plan="club" view={clubView} />
        <div class="clubcta">
          {user ? (
            <form method="POST" action="/api/billing/club-checkout">
              <button class="btn btn--primary" type="submit">
                {clubBuyCopy}
              </button>
            </form>
          ) : (
            <a class="btn btn--primary" href={`/signup?next=${encodeURIComponent('/buy/club')}`}>
              {clubBuyCopy}
            </a>
          )}
          <a class="btn btn--ghost" href={clubMail} id="trial">Start a 30-day free trial</a>
        </div>
        <p class="pagewrap__fine">
          Card payment by Stripe — card details never reach Bagpipe. Renews
          yearly; cancel any time and it runs to the end of the year you paid
          for. Running just one league? The <a href="/buy/league">League plan</a>
          {' '}is {dollars(PLANS.league.price)} a year.
        </p>
      </>
    )}
  </main>
</BaseLayout>

<style>
  .picklist { list-style: none; margin: 20px 0; padding: 0; border: 1px solid var(--line); border-radius: 12px; }
  .picklist li + li { border-top: 1px solid var(--line); }
  .picklist__row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 16px; color: var(--ink); font-weight: 600; text-decoration: none;
  }
  .picklist__row:hover { background: var(--brand-green-pale); }
  .picklist__go { color: var(--brand-green); }
  .clubdeal {
    margin: 0 0 18px; padding: 12px 14px; border-radius: 12px;
    background: var(--brand-green-pale); color: var(--ink);
  }
  .clubcta { display: flex; flex-wrap: wrap; gap: 10px; }
  .clubcta form { margin: 0; }
  .notice {
    margin: 0 0 16px; padding: 10px 14px; border-radius: 10px;
    border: 1px solid var(--line); background: rgba(180, 83, 9, 0.07);
  }
  .pagewrap__fine { margin-top: 20px; font-size: 0.875rem; color: var(--ink-muted); }
</style>
