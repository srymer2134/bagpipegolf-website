---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sideGames } from '../lib/sideGames';
import PoweredByStripe from '../components/payments/PoweredByStripe.astro';
---

<BaseLayout title="Pricing · Bagpipe Golf">
  <main class="pagewrap">
    <!-- League plan (LEAGUE_SUBSCRIPTION_AND_PLAN_GATING_PLAN.md, flutter
         repo): $2,000 a year PER LEAGUE, card only, 12 months from the start
         date, renews yearly. Leagues that existed before the plan launched
         get 12 months free (plan L5/L9).
         Tournaments (Sam, 2026-10-25): free with a field of up to 36
         players "for now"; $170 per tournament at 37 or more (was $240 until Sam set $170, 2026-10-30). The threshold lives in
         billing.config, so this copy and that number change together.
         A tournament run inside a league is covered by that league's plan.
         llmsTxt.ts states the same figures — pricingCopy.test.ts keeps the
         two in step. -->
    <p class="pagewrap__eyebrow">Pricing</p>
    <h1 class="pagewrap__title">Free to play. Simple pricing to host.</h1>
    <p class="pagewrap__sub">
      Players pay nothing. Small tournaments are free; bigger ones are a
      one-time fee, and leagues are one plan a year.
    </p>

    <section class="grid grid--3">
      <article class="card">
        <span class="chip">Players</span>
        <h3>Free</h3>
        <p>Full scorecard, all {sideGames.length} side games, friends, spectator share, history and stats.</p>
      </article>
      <article class="card">
        <span class="chip">Tournaments</span>
        <h3>Free <span class="card__per">up to 36 players</span></h3>
        <p><strong>$170 per tournament</strong> for a field of 37 or more — a charity day, a member-guest, a company outing. Pairings, live leaderboards, and card entry fees if you want them.</p>
      </article>
      <article class="card card--plan" id="league-plan">
        <span class="chip">Leagues</span>
        <h3>$2,000 <span class="card__per">/ year per league</span></h3>
        <p>Season setup, weekly pairings and standings, card dues collection — and every tournament your league runs is included.</p>
      </article>
    </section>

    <section class="feeblock" id="league-plan-details">
      <h2 class="feeblock__h">How the league plan works</h2>
      <ul class="feeblock__list">
        <li>
          <strong>One plan covers one league for 12 months</strong> from the
          day you start it, and renews each year. Cancel any time and it runs
          to the end of the year you paid for.
        </li>
        <li>
          <strong>Paid by card</strong>, plus sales tax where it applies.
          You get an invoice, and you can update your card or download
          invoices any time.
        </li>
        <li>
          <strong>Starting next season?</strong> Your plan moves to the new
          season's league — once a year — so you don't pay twice.
        </li>
        <li>
          <strong>Already running a league on Bagpipe?</strong> It stays free
          for 12 months after the plan launches. We'll email you before
          anything changes.
        </li>
        <li>
          <strong>Smaller league?</strong> Discounted rates are available —
          <a href="mailto:hello@bagpipegolf.com?subject=Smaller%20league%20pricing">email hello@bagpipegolf.com</a>
          for details.
        </li>
        <li>
          <strong>Running several leagues or a club?</strong>
          <a href="mailto:hello@bagpipegolf.com?subject=League%20plan%20pricing">Email hello@bagpipegolf.com</a>
          and we'll talk.
        </li>
      </ul>
      <p class="feeblock__p">
        Without a plan, a league keeps what it already has — its current
        season, results and payments — but can't set up a new season, add
        tournaments, or start taking card payments.
      </p>
    </section>

    <!-- Competitor comparison (Sam, 2026-10-30). Every figure is the
         vendor's OWN published price, read 2026-10-30 — except BlueGolf,
         which publishes none:
           golfgenius.com/products/tm — TM Club $1,425/yr + "$200 one-time
             onboarding fee"; TM Premium $4,275/yr + "$500 one-time
             onboarding fee"; up to 36 holes per facility.
           livetourney.com/pricing — "Single Event $199 / per event",
             "Live Tourney … $2,700 / per year" (Unlimited Events),
             "Live Tourney Pro … $3,900 / per year"; no setup fee listed.
             (A Live Tourney blog post from Jan 2024 said $2,000/yr; their
             pricing page no longer does.)
           BlueGolf — no public pricing. Its figures are as REPORTED in
             that same Live Tourney post (Jan 2024), and the page says so.
         Wrong rival prices on our pricing page are a false-advertising
         exposure: re-read each source before changing a cell, and keep
         the date in the note below current. -->
    <section class="feeblock" id="compare">
      <h2 class="feeblock__h">How Bagpipe compares</h2>
      <p class="feeblock__p">
        Golf event software is usually a yearly subscription, often with
        a one-time setup fee before your first event. Here is how the
        best-known options line up.
      </p>
      <div class="compare">
        <table class="compare__table">
          <thead>
            <tr>
              <td></td>
              <th scope="col">Annual price</th>
              <th scope="col">Premium</th>
              <th scope="col">Setup / onboarding</th>
              <th scope="col">Events</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Golf Genius</th>
              <td>$1,425 / year</td>
              <td>$4,275 / year</td>
              <td>$200; $500 for Premium</td>
              <td>Per facility, up to 36 holes</td>
            </tr>
            <tr>
              <th scope="row">BlueGolf<sup>*</sup></th>
              <td>About $2,000 / year</td>
              <td>$3,000 / year</td>
              <td>$500</td>
              <td>25 tournaments; unlimited on Premium</td>
            </tr>
            <tr>
              <th scope="row">Live Tourney</th>
              <td>$2,700 / year</td>
              <td>$3,900 / year (Pro)</td>
              <td>None listed</td>
              <td>Unlimited, or $199 per single event</td>
            </tr>
            <tr class="compare__us">
              <th scope="row">Bagpipe Golf</th>
              <td>$2,000 / year per league</td>
              <td>—</td>
              <td>Free</td>
              <td>Unlimited in your league; single events free up to 36 players, $170 above</td>
            </tr>
          </tbody>
        </table>
      </div>
      <h3 class="compare__h">Included in every Bagpipe price</h3>
      <ul class="feeblock__list">
        <li><strong>No setup, onboarding or training fees.</strong> Create an event and send the invite.</li>
        <li>
          <strong>Players never pay.</strong> The full scorecard, all
          {sideGames.length} side games with settle-up, and live
          leaderboards are free for every golfer in your field.
        </li>
        <li><strong>Leagues include their tournaments.</strong> Every event your league runs is covered by its plan.</li>
        <li><strong>Entry fees and dues go straight to you</strong>, through your own Stripe account.</li>
      </ul>
      <p class="compare__note">
        Prices as published on 30 October 2026 by
        <a href="https://www.golfgenius.com/products/tm" rel="noopener">Golf Genius</a> and
        <a href="https://www.livetourney.com/pricing" rel="noopener">Live Tourney</a>.
        <sup>*</sup>BlueGolf does not publish pricing; its figures are as reported by
        <a href="https://livetourney.com/blog/level-up" rel="noopener">Live Tourney in January 2024</a>.
        Plans and prices change, so check with each company before you decide.
        Golf Genius, BlueGolf and Live Tourney are trademarks of their respective owners.
      </p>
    </section>

    <!-- W6 — fee disclosure for hosts who collect money through us.
         Bagpipe's platform fee is 2% (F2, 2026-10-09; Sam re-confirmed
         2026-10-23), the same figure leagues/card-payments.astro shows.
         It is set per connected account (`merchant_accounts.
         application_fee_bps`, default 200), so this page states the
         number — keep the two pages in step if it ever changes. -->
    <section class="feeblock" id="collecting-money">
      <h2 class="feeblock__h">Collecting entry fees and dues</h2>
      <p class="feeblock__p">
        Optional, and off unless you turn it on. If you'd rather keep
        taking cash, Venmo or cheques, the roster has a
        <strong>Mark paid in cash</strong> button and nothing here
        applies to you.
      </p>
      <p class="feeblock__p">
        When you do collect by card, the money goes to
        <strong>your own Stripe account</strong>, not ours — you connect
        it once, Stripe verifies you, and payouts land in your bank on
        Stripe's schedule. We never hold your players' money.
      </p>
      <ul class="feeblock__list">
        <li>
          <strong>Stripe's processing fee</strong> comes out of each
          payment. Stripe sets it and publishes it at
          <a href="https://stripe.com/pricing" rel="noopener">stripe.com/pricing</a>
          — it's their price, not ours, and it's the same whether you
          use us or not.
        </li>
        <li>
          <strong>Our platform fee is 2%</strong> of each card payment,
          taken before the money reaches you — on $50 dues that's $1.00.
          Your players see one total at checkout, never a line item for us.
        </li>
        <li>
          <strong>Refunds are yours to issue</strong>, from our roster
          or from your own Stripe dashboard. Either way the roster
          updates.
        </li>
      </ul>
      <PoweredByStripe />
    </section>

    <!-- W7 — what connecting actually asks of a host, said BEFORE they
         start. Stripe's onboarding asks for a bank account, a tax id
         and a photo id; a host who meets that cold, three screens in,
         abandons it and tells us the feature is broken. -->
    <section class="feeblock" id="connecting-stripe">
      <h2 class="feeblock__h">Before you connect Stripe</h2>
      <p class="feeblock__p">
        Stripe — not us — has to verify who you are before it will move
        money for you. Worth having to hand:
      </p>
      <ul class="feeblock__list">
        <li><strong>A bank account</strong> for payouts.</li>
        <li>
          <strong>A tax ID</strong> — an EIN if the league is a legal
          entity, otherwise your SSN.
        </li>
        <li><strong>A photo ID</strong>, and your date of birth and address.</li>
      </ul>
      <p class="feeblock__p">
        It takes a few minutes, and Stripe may take a day or two to
        finish verifying. You can set up your league and open sign-ups
        before it completes — only card payments wait.
      </p>
      <p class="feeblock__p">
        One person per league holds the Stripe login. Pick whoever keeps
        the books.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .card { display: grid; gap: 6px; }
  .card .chip { justify-self: start; }
  .card h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 6px 0 4px;
  }
  .card p { margin: 0; color: var(--ink-muted); font-size: 0.9375rem; }
  .card__per { font-size: 1rem; font-weight: 600; color: var(--ink-muted); }
  .feeblock { margin-top: 48px; }
  .feeblock__h {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0 0 10px;
  }
  .feeblock__p {
    margin: 0 0 12px;
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 62ch;
  }
  .feeblock__list {
    margin: 0;
    padding-left: 20px;
    color: var(--ink-muted);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 62ch;
  }
  .feeblock__list li { margin-bottom: 10px; }
  .compare {
    overflow-x: auto;
    margin: 4px 0 24px;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .compare__table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .compare__table th,
  .compare__table td {
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
  }
  .compare__table tbody tr:last-child th,
  .compare__table tbody tr:last-child td { border-bottom: 0; }
  .compare__table thead th { font-weight: 800; color: var(--ink); }
  .compare__table tbody th { font-weight: 600; color: var(--ink); }
  .compare__table .compare__us th,
  .compare__table .compare__us td {
    color: var(--brand-green-dark);
    font-weight: 700;
    background: rgba(22, 101, 52, 0.06);
  }
  .compare__h {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0 0 10px;
  }
  .compare__note {
    margin: 4px 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: 62ch;
  }
</style>
