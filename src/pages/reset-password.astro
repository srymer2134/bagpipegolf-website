---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createSupabaseClient } from '../lib/supabase';
import {
  EXPIRED_LINK_MESSAGE,
  MIN_PASSWORD_LENGTH,
  RECOVERY_COOKIE,
  RECOVERY_COOKIE_MAX_AGE_S,
  readRecoveryParams,
  validateNewPassword,
} from '../lib/passwordReset';

// See src/lib/passwordReset.ts for the whole flow.

let error: string | null = null;
let linkError: string | null = null;
let done = false;

const url = new URL(Astro.request.url);
const supabase = createSupabaseClient({
  request: Astro.request,
  cookies: Astro.cookies,
  locals: Astro.locals,
});

if (Astro.request.method === 'GET') {
  const params = readRecoveryParams(url);
  if (params.kind === 'error') {
    linkError = EXPIRED_LINK_MESSAGE;
  } else if (params.kind === 'code' || params.kind === 'token_hash') {
    try {
      const { error: authErr } =
        params.kind === 'code'
          ? await supabase.auth.exchangeCodeForSession(params.code)
          : await supabase.auth.verifyOtp({ type: 'recovery', token_hash: params.tokenHash });
      if (authErr) {
        linkError = EXPIRED_LINK_MESSAGE;
      } else {
        Astro.cookies.set(RECOVERY_COOKIE, '1', {
          path: '/reset-password',
          httpOnly: true,
          secure: url.protocol === 'https:',
          sameSite: 'lax',
          maxAge: RECOVERY_COOKIE_MAX_AGE_S,
        });
        // Drop the one-time code from the address bar.
        return Astro.redirect('/reset-password', 303);
      }
    } catch (err: any) {
      console.error('[reset-password GET] exchange threw', err);
      linkError = EXPIRED_LINK_MESSAGE;
    }
  } else if (!Astro.cookies.get(RECOVERY_COOKIE)) {
    linkError = EXPIRED_LINK_MESSAGE;
  }
}

if (Astro.request.method === 'POST') {
  if (!Astro.cookies.get(RECOVERY_COOKIE)) {
    linkError = EXPIRED_LINK_MESSAGE;
  } else {
    const form = await Astro.request.formData();
    const password = (form.get('password') ?? '').toString();
    const confirm = (form.get('confirm') ?? '').toString();
    error = validateNewPassword(password, confirm);
    if (!error) {
      try {
        const { error: authErr } = await supabase.auth.updateUser({ password });
        if (authErr) {
          error = authErr.message || 'Could not update your password.';
        } else {
          Astro.cookies.delete(RECOVERY_COOKIE, { path: '/reset-password' });
          done = true;
        }
      } catch (err: any) {
        console.error('[reset-password POST] updateUser threw', err);
        error =
          'Password reset is temporarily unavailable. Please try again in a moment. ' +
          (err?.message ? `(${err.message})` : '');
      }
    }
  }
}
---

<BaseLayout title="Choose a new password · Bagpipe Golf">
  <main class="pagewrap pagewrap--narrow">
    <p class="pagewrap__eyebrow">Reset password</p>
    {done ? (
      <>
        <h1 class="pagewrap__title">Password updated.</h1>
        <p class="pagewrap__sub">
          Use your new password here and in the Bagpipe Golf app.
        </p>
        <p><a href="/app" class="btn btn--primary btn--block">Continue</a></p>
      </>
    ) : linkError ? (
      <>
        <h1 class="pagewrap__title">This link didn't work.</h1>
        <div class="card authform">
          <div class="authform__error" role="alert">{linkError}</div>
          <a href="/forgot-password" class="btn btn--primary btn--block">Send a new link</a>
        </div>
      </>
    ) : (
      <>
        <h1 class="pagewrap__title">Choose a new password.</h1>
        <p class="pagewrap__sub">
          It works on the website and in the Bagpipe Golf app.
        </p>
        <form method="post" class="card authform">
          {error && <div class="authform__error" role="alert">{error}</div>}
          <label class="authform__field">
            <span class="authform__label">New password</span>
            <input
              name="password"
              type="password"
              autocomplete="new-password"
              minlength={MIN_PASSWORD_LENGTH}
              required
              class="authform__input"
            />
          </label>
          <label class="authform__field">
            <span class="authform__label">Confirm new password</span>
            <input
              name="confirm"
              type="password"
              autocomplete="new-password"
              minlength={MIN_PASSWORD_LENGTH}
              required
              class="authform__input"
            />
          </label>
          <button type="submit" class="btn btn--primary btn--block">Save new password</button>
        </form>
      </>
    )}
  </main>
</BaseLayout>

<style>
  .authform { display: grid; gap: 18px; margin-top: 8px; }
  .authform__error,
  .authform__info {
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 0.875rem;
    border-width: 1px;
    border-style: solid;
  }
  .authform__error {
    background: #FEF2F2;
    border-color: #FECACA;
    color: var(--error);
  }
  .authform__info {
    background: var(--brand-green-pale);
    border-color: var(--brand-green);
    color: var(--brand-green-dark);
  }
  .authform__field { display: grid; gap: 6px; }
  .authform__label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .authform__input {
    border: 1.5px solid var(--line);
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 1rem;
    font-family: inherit;
    background: #fff;
    transition: border-color 0.12s ease;
  }
  .authform__input:focus {
    outline: none;
    border-color: var(--brand-green);
    box-shadow: 0 0 0 4px rgba(26, 92, 56, 0.12);
  }
  .authform__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .authform__meta a { font-weight: 600; }
</style>
