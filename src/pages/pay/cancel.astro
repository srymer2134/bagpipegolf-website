---
// Stripe Checkout return — the CANCEL url (W4).
//
// Cancelling is NOT a failure. The player chose it, nothing was
// charged, the row stays `pending`, and Pay still works. Showing an
// error here would tell someone they broke something by changing their
// mind.
//
// No polling: there is nothing to wait for.
//
// FLAG OFF (production today): the same neutral "Returning you to
// Bagpipe…" page as /pay/success, for the same reason — the path is a
// published universal link, so it renders rather than 404s, but says
// nothing about money while no payments are live.
//
// The query string is left exactly as Stripe sent it; the app's
// universal-link handler reads `payment_id`, `scope` and `id`.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { eventPath, readReturnParams } from '../../lib/payments';
import { modeFor } from '../../lib/paymentsServer';

const enabled = modeFor(Astro.locals as App.Locals) !== 'off';
const params = readReturnParams(Astro.url.searchParams);
const back = params.scope && params.id ? eventPath(params.scope, params.id) : '/app';
---

<BaseLayout
  title={enabled ? 'Payment cancelled · Bagpipe Golf' : 'Bagpipe Golf'}
  ogTitle="Bagpipe Golf"
  description="Returning you to Bagpipe Golf."
>
  {enabled ? (
    <main class="pagewrap">
      <p class="pagewrap__eyebrow">Payment</p>
      <h1 class="pagewrap__title">Payment cancelled</h1>
      <p class="pagewrap__sub">
        Nothing was charged — you can pay any time. Your spot is still
        there.
      </p>
      <p class="pagewrap__sub">
        <a href={back}>Back to your event</a>
      </p>
    </main>
  ) : (
    <main class="pagewrap">
      <h1 class="pagewrap__title">Returning you to Bagpipe…</h1>
      <p class="pagewrap__sub">
        If the Bagpipe Golf app didn’t open, open it from your home
        screen, or <a href="/app">continue on the web</a>.
      </p>
    </main>
  )}
</BaseLayout>
