---
// Stripe Checkout return — the SUCCESS url.
//
// HOTFIX 2026-10-07: NEUTRAL UNTIL PAYMENTS ARE LIVE.
//
// The #144 version of this page polled `/api/payments`, a route that does
// not exist yet (404), and after ten seconds told the visitor "Your payment
// is still being confirmed … there's no need to pay again". No payment
// can have been made — Stripe is not wired — so that was a money claim
// nobody had earned, on a published universal link.
//
// The path must still RENDER, not 404: `wellKnown.ts` publishes
// /pay/success and /pay/cancel, and an iOS install whose universal link
// does not fire falls back to Safari here. So it says only where to go.
//
// The real, polling page arrives with bagpipegolf-website #145 (W4),
// behind PAYMENTS_ENABLED. Until then this page makes NO statement about
// money, and the query string is left as-is for the app's link handler.
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Bagpipe Golf"
  ogTitle="Bagpipe Golf"
  description="Returning you to Bagpipe Golf."
>
  <main class="pagewrap">
    <h1 class="pagewrap__title">Returning you to Bagpipe…</h1>
    <p class="pagewrap__sub">
      If the Bagpipe Golf app didn’t open, open it from your home
      screen, or <a href="/app">continue on the web</a>.
    </p>
  </main>
</BaseLayout>
