---
import BaseLayout from '../../layouts/BaseLayout.astro';

// League Card Payments — step-by-step for League Directors connecting their
// league to Stripe so members can pay season dues by card.
//
// Every button name and status here is the real one: "Set up card payments"
// (league screen + MerchantSetup.astro), the four statuses from
// src/lib/payments.ts merchantView (Not set up / Finishing setup / Stripe is
// verifying / Ready), "You're set up." / "Back from Stripe." from
// app/payments/return.astro, and the "Before you start" facts from
// MerchantSetup.astro. Keep them in step if any of those change.
//
// Stripe's pages are drawn as plain, unbranded forms on purpose.
// Fees: Bagpipe 2% (F2, 2026-10-09). Stripe 2.9% + 30¢ is Stripe's standard
// US card rate — re-check both whenever pricing changes.

const title = 'League Card Payments · Bagpipe Golf';
const description =
  'Step-by-step: connect your league to Stripe so members can pay season dues by card in the Bagpipe Golf app or on bagpipegolf.com. What you need, every screen, and what each status means.';
---

<BaseLayout title={title} description={description}>
  <main class="guide wrap">

  <header class="intro">
    <a class="back" href="/leagues">&larr; Leagues</a>
    <span class="eyebrow">For League Directors</span>
    <h1>Collect season dues by card</h1>
    <p class="lede">Connect your league to Stripe once, and your members can pay their season dues with a card in the Bagpipe Golf app or on bagpipegolf.com. The money goes to your league's own bank account. Here is every step, with what you'll see on screen.</p>
  </header>

  <section class="prep" aria-labelledby="prep-h">
    <div style="display:flex;flex-wrap:wrap;gap:8px 16px;align-items:baseline;justify-content:space-between">
      <h2 id="prep-h">Before you start</h2>
      <span class="time">About 10 minutes. Stripe may take a day or two to verify.</span>
    </div>
    <ul>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="12" r="2.5"/><path d="M14 10h4M14 14h3"/></svg>
        <div><strong>Photo ID</strong><span>Stripe confirms who you are.</span></div>
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10l9-5 9 5"/><path d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18"/></svg>
        <div><strong>Bank account</strong><span>Routing and account number, for payouts.</span></div>
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/></svg>
        <div><strong>EIN or SSN</strong><span>The league's EIN, or your SSN if the league isn't a registered business.</span></div>
      </li>
      <li>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18.5h2"/></svg>
        <div><strong>Your phone</strong><span>With an authenticator app. Stripe requires one to secure your login.</span></div>
      </li>
    </ul>
  </section>

  <ol class="steps">

    <!-- 1 -->
    <li class="step">
      <div class="step-text">
        <span class="num"><b>1</b> Set your dues</span>
        <span class="where"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2"/></svg>Bagpipe Golf app</span>
        <h3>Tell members what they owe</h3>
        <p>Open your league, tap the <span class="ui">☰</span> menu in the top right, and choose <span class="ui">Set season dues…</span>. Enter the amount and, if you like, a due date.</p>
        <p class="tip">Members can't pay until dues are set, so do this first.</p>
      </div>
      <div class="mock phone" aria-label="Example: the league menu in the app with Set season dues highlighted">
        <div class="screen">
          <div class="appbar"><span>‹</span><span>Tuesday Night League</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></div>
          <div class="mbody">
            <div class="menu">
              <div>Mark season complete</div>
              <div>Substitute scoring…</div>
              <div>Flights &amp; playoff…</div>
              <div>Edit schedule…</div>
              <div class="hl" style="font-weight:700">Set season dues…</div>
              <div>Share public page</div>
            </div>
          </div>
        </div>
      </div>
    </li>

    <!-- 2 -->
    <li class="step">
      <div class="step-text">
        <span class="num"><b>2</b> Open card payments</span>
        <span class="where"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2"/></svg>App or website</span>
        <h3>Open “Set up card payments”</h3>
        <p><strong>In the app:</strong> on your league screen, just under the season dues line, tap <span class="ui">Set up card payments</span>. It shows <span class="chip grey">Not set up</span> until you finish. Only the league's owner sees this row. Setup opens bagpipegolf.com in your phone's browser — Stripe needs a real browser, so this part never happens inside the app.</p>
        <p><strong>On the website:</strong> go to bagpipegolf.com, sign in, open <span class="ui">Leagues</span>, then <span class="ui">Manage</span> on your league, then the card payments link. This works on a phone or a computer.</p>
      </div>
      <div class="mock phone" aria-label="Example: the league screen with the Set up card payments row highlighted">
        <div class="screen">
          <div class="appbar"><span>‹</span><span>Tuesday Night League</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></div>
          <div class="mbody">
            <div class="mrow"><span class="l">Season dues $50</span><span class="chip grey">Pay dues</span></div>
            <div class="mrow hl"><span class="l" style="display:flex;align-items:center;gap:6px"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--green)" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>Set up card payments</span><span class="chip grey">Not set up</span></div>
            <div class="mrow" style="background:transparent;border:1px solid var(--line)"><span class="l">Roster</span><span style="color:var(--muted)">12 members</span></div>
          </div>
        </div>
      </div>
    </li>

    <!-- 3 -->
    <li class="step">
      <div class="step-text">
        <span class="num"><b>3</b> Start on Bagpipe</span>
        <span class="where"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="15" rx="2"/><path d="M3 8h18"/></svg>bagpipegolf.com</span>
        <h3>Read the checklist, then continue to Stripe</h3>
        <p>Sign in with the same email and password you use in the app. The <span class="ui">Card payments</span> page repeats the “Before you start” list above. When you're ready, press <span class="ui">Set up card payments</span>.</p>
        <p>You'll leave Bagpipe for Stripe's own pages, then come back here when you're done.</p>
      </div>
      <div class="mock browser" aria-label="Example: the Card payments page on bagpipegolf.com">
        <div class="bar"><span class="dots"><i></i><i></i><i></i></span><span class="url">bagpipegolf.com/app/leagues/…/payments</span></div>
        <div class="page">
          <span class="eb">League · owner</span>
          <span class="t">Card payments.</span>
          <div class="mrow"><span class="l">Status</span><span class="chip grey">Not set up</span></div>
          <p style="font-size:0.75rem;color:var(--muted)">Before you start: ID, a bank account, an EIN or SSN, and your phone.</p>
          <span class="mbtn hl">Set up card payments</span>
          <span class="ext">You'll leave Bagpipe for Stripe's own pages, then come back here.</span>
        </div>
      </div>
    </li>

    <!-- 4 -->
    <li class="step">
      <div class="step-text">
        <span class="num"><b>4</b> Create your Stripe login</span>
        <span class="where"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="15" rx="2"/><path d="M3 8h18"/></svg>Stripe's pages</span>
        <h3>Email, password, then your authenticator app</h3>
        <p>Stripe asks for an email and password for the league's Stripe account. Use an address you check, because Stripe sends payout and verification notices there.</p>
        <p>Before you can finish, Stripe has you link an authenticator app on your phone and enter the 6-digit code it shows.</p>
        <p class="tip">Already have a Stripe login? You can sign in with it. The league still gets its own account.</p>
      </div>
      <div class="mock browser" aria-label="Example: a sign-up form and a six-digit code entry on Stripe's pages">
        <div class="bar"><span class="dots"><i></i><i></i><i></i></span><span class="url">Stripe · create your account</span></div>
        <div class="page">
          <label class="field"><span>Email</span><i>director@yourleague.org</i></label>
          <label class="field"><span>Password</span><i>••••••••••••</i></label>
          <span style="font-size:0.6875rem;font-weight:700;color:var(--muted)">Enter the code from your authenticator app</span>
          <div class="otp"><i>4</i><i>8</i><i>2</i><i>9</i><i>1</i><i>6</i></div>
        </div>
      </div>
    </li>

    <!-- 5 -->
    <li class="step">
      <div class="step-text">
        <span class="num"><b>5</b> Describe your league</span>
        <span class="where"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="15" rx="2"/><path d="M3 8h18"/></svg>Stripe's pages</span>
        <h3>Who runs the league, and how it's set up</h3>
        <ul>
          <li><strong>Business type.</strong> Choose <em>Individual / sole proprietor</em> if the league isn't a registered business, or <em>Company</em> / <em>Non-profit</em> if it is.</li>
          <li><strong>Your details.</strong> Legal name, date of birth, home address and phone.</li>
          <li><strong>Tax ID.</strong> The league's EIN, or your SSN for an individual.</li>
          <li><strong>What you sell.</strong> Something like “Golf league season dues”.</li>
        </ul>
        <p class="tip">Stripe may ask for a photo of your ID. That's normal, and it goes to Stripe, not to Bagpipe.</p>
      </div>
      <div class="mock browser" aria-label="Example: business details form on Stripe's pages">
        <div class="bar"><span class="dots"><i></i><i></i><i></i></span><span class="url">Stripe · tell us about your business</span></div>
        <div class="page">
          <label class="field"><span>Type of business</span><i>Individual / sole proprietor ▾</i></label>
          <label class="field"><span>Legal name</span><i>Jordan Lee</i></label>
          <label class="field"><span>Date of birth</span><i>MM / DD / YYYY</i></label>
          <label class="field"><span>SSN or EIN</span><i>•••-••-1234</i></label>
          <label class="field"><span>Product description</span><i>Golf league season dues</i></label>
        </div>
      </div>
    </li>

    <!-- 6 -->
    <li class="step">
      <div class="step-text">
        <span class="num"><b>6</b> Add your bank</span>
        <span class="where"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="15" rx="2"/><path d="M3 8h18"/></svg>Stripe's pages</span>
        <h3>Where the dues are paid out</h3>
        <p>Enter the routing and account number for the account the league's money should land in, ideally a league or club account. Stripe pays out to it automatically.</p>
        <p class="tip">Bagpipe never holds your members' money. Payments go to the league's Stripe account and out to this bank.</p>
      </div>
      <div class="mock browser" aria-label="Example: payout bank account form on Stripe's pages">
        <div class="bar"><span class="dots"><i></i><i></i><i></i></span><span class="url">Stripe · add a payout account</span></div>
        <div class="page">
          <label class="field"><span>Routing number</span><i>•••••••••</i></label>
          <label class="field"><span>Account number</span><i>••••••6789</i></label>
          <label class="field"><span>Confirm account number</span><i>••••••6789</i></label>
        </div>
      </div>
    </li>

    <!-- 7 -->
    <li class="step">
      <div class="step-text">
        <span class="num"><b>7</b> Submit and come back</span>
        <span class="where"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="15" rx="2"/><path d="M3 8h18"/></svg>bagpipegolf.com</span>
        <h3>Stripe sends you back to Bagpipe</h3>
        <p>Review your details and submit. Stripe returns you to Bagpipe, which shows <strong>“You're set up.”</strong> when everything went through, or <strong>“Back from Stripe.”</strong> when something still needs attention (step 8 explains each status).</p>
      </div>
      <div class="mock browser" aria-label="Example: the You're set up page after returning from Stripe">
        <div class="bar"><span class="dots"><i></i><i></i><i></i></span><span class="url">bagpipegolf.com/app/payments/return</span></div>
        <div class="page">
          <span class="eb">League · card payments</span>
          <span class="t">You're set up.</span>
          <p style="font-size:0.75rem;color:var(--muted)">Tuesday Night League</p>
          <div class="mrow"><span class="l">Status</span><span class="chip green">Ready</span></div>
        </div>
      </div>
    </li>

    <!-- 8 -->
    <li class="step">
      <div class="step-text">
        <span class="num"><b>8</b> Check your status</span>
        <span class="where"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2"/></svg>App or website</span>
        <h3>What each status means</h3>
        <p>The same status shows on the card payments row in the app and on the website.</p>
        <ul>
          <li><span class="chip grey">Not set up</span> You haven't started. Begin at step 2.</li>
          <li><span class="chip amber">Finishing setup</span> Stripe needs something else. Press <span class="ui">Continue setup</span> (or <span class="ui">Finish in Stripe</span>) and complete what's listed.</li>
          <li><span class="chip blue">Stripe is verifying</span> Stripe is checking your details, which can take a day or two. Nothing to do; press <span class="ui">Refresh status</span> later. You can run the league as normal while you wait.</li>
          <li><span class="chip green">Ready</span> Members can pay.</li>
        </ul>
      </div>
      <div class="mock" style="padding:14px" aria-label="The four setup statuses">
        <div class="statusgrid">
          <div class="mrow"><span class="l">Not set up</span><span class="chip grey">start</span></div>
          <div class="mrow"><span class="l">Finishing setup</span><span class="chip amber">action needed</span></div>
          <div class="mrow"><span class="l">Stripe is verifying</span><span class="chip blue">wait</span></div>
          <div class="mrow"><span class="l">Ready</span><span class="chip green">members can pay</span></div>
        </div>
      </div>
    </li>

    <!-- 9 -->
    <li class="step">
      <div class="step-text">
        <span class="num"><b>9</b> Members pay</span>
        <span class="where"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2"/></svg>Bagpipe Golf app</span>
        <h3>Invite members and watch who's paid</h3>
        <ul>
          <li>Share your league's join code so members are on the roster.</li>
          <li>Each member opens the league and taps <span class="ui">Pay dues</span>, then pays on Stripe's secure checkout page.</li>
          <li>Watch who's paid on the roster on the website's card payments page. For cash or a check, use <span class="ui">Mark paid in cash</span> so the roster stays complete.</li>
        </ul>
      </div>
      <div class="mock phone" aria-label="Example: a member's league screen with the Pay dues button">
        <div class="screen">
          <div class="appbar"><span>‹</span><span>Tuesday Night League</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></div>
          <div class="mbody">
            <div class="mrow"><span class="l">Season dues $50</span><span class="mbtn hl" style="padding:6px 14px">Pay dues</span></div>
            <div class="mrow" style="background:transparent;border:1px solid var(--line)"><span class="l">You</span><span class="chip green">Paid</span></div>
          </div>
        </div>
      </div>
    </li>
  </ol>

  <section aria-labelledby="gtk-h" style="display:flex;flex-direction:column;gap:20px">
    <h2 id="gtk-h">Good to know</h2>
    <div class="facts">
      <div class="fact">
        <h3>The league is the merchant</h3>
        <p>Payments go to your league's own Stripe account and pay out to its bank. Bagpipe never holds the money.</p>
      </div>
      <div class="fact">
        <h3>What can be paid by card</h3>
        <p>Season dues and tournament entry fees only. Weekly pots, closest-to-the-pin and long-drive entries, Calcuttas and Side Games are never collected by card.</p>
      </div>
      <div class="fact">
        <h3>Refunds</h3>
        <p>You can refund a payment, but Stripe keeps its processing fee, so a refund costs the league that fee.</p>
      </div>
      <div class="fact">
        <h3>One login from Bagpipe</h3>
        <p>Only the league's owner can open card payments from Bagpipe. Inside Stripe you can invite others, such as a treasurer, yourself.</p>
      </div>
      <div class="fact">
        <h3>What it costs</h3>
        <p>Fees come out of each payment before it reaches the league. Example for $50 dues:</p>
        <table class="money">
          <tr><td>Member pays</td><td>$50.00</td></tr>
          <tr><td>Stripe processing (2.9% + 30¢)</td><td>−$1.75</td></tr>
          <tr><td>Bagpipe platform fee (2%)</td><td>−$1.00</td></tr>
          <tr><td>League receives</td><td>$47.25</td></tr>
        </table>
      </div>
    </div>
  </section>

  <p class="foot">Stuck on a step? Email <a href="mailto:support@bagpipegolf.com">support@bagpipegolf.com</a> with your league's name and the status you see. New to leagues? <a href="/leagues/get-started">How to set one up</a>.</p>
</main>
</BaseLayout>

<style>
/* Layout: one reading column; each step = text left, screen mockup right (stacks on phones). */
.guide {
  --green: var(--brand-green);
  --green-dark: var(--brand-green-dark);
  --green-pale: var(--brand-green-pale);
  --ink: var(--ink);
  --muted: #5B6470;
  --paper: #FFFFFF;
  --tint: #F4F6F5;
  --line: #E1E5E3;
  --warn: #B45309;
  --warn-pale: #FEF3E2;
  --ok: #15803D;
  --ok-pale: #E6F4EA;
  --info-pale: #EEF2FF;
  --info: #3730A3;
  --mock-bg: #FFFFFF;
  --mock-chrome: #E9ECEB;
  --shadow: 0 1px 2px rgba(15, 61, 37, .06), 0 8px 24px rgba(15, 61, 37, .08);
  --font: inherit;
  --font-display: inherit;
}
* { box-sizing: border-box; }
.guide { color: var(--ink); font-size: 1rem; line-height: 1.55; }
.wrap { max-width: 980px; margin: 0 auto; padding-inline: 20px; padding-block: 40px 72px; display: flex; flex-direction: column; gap: 48px; }
h1, h2, h3 { font-family: var(--font-display); text-wrap: balance; margin: 0; color: var(--ink); }
h1 { font-size: clamp(1.875rem, 5vw, 2.75rem); line-height: 1.1; letter-spacing: -0.02em; }
h2 { font-size: 1.5rem; line-height: 1.2; letter-spacing: -0.01em; }
h3 { font-size: 1.1875rem; line-height: 1.3; }
p { margin: 0; }
.eyebrow { font-size: 0.75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--green); }
.lede { font-size: 1.125rem; color: var(--muted); max-width: 62ch; }
.intro { display: flex; flex-direction: column; gap: 14px; }

/* checklist */
.prep { background: var(--green-pale); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 16px; }
.prep ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; }
.prep li { background: var(--paper); border-radius: 12px; padding: 14px 16px; display: flex; gap: 12px; align-items: flex-start; min-width: 0; }
.prep li svg { flex: none; width: 22px; height: 22px; color: var(--green); margin-top: 2px; }
.prep li strong { display: block; }
.prep li span { color: var(--muted); font-size: 0.875rem; }
.time { font-size: 0.875rem; color: var(--muted); }

/* steps */
.steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 40px; counter-reset: step; }
.step { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 340px); gap: 32px; align-items: start; padding-top: 32px; border-top: 1px solid var(--line); }
.step:first-child { border-top: 0; padding-top: 0; }
.step-text { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
.num { display: inline-flex; align-items: center; gap: 10px; font-size: 0.8125rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--green); }
.num b { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--green); color: var(--paper); font-size: 0.875rem; letter-spacing: 0; }
.where { display: inline-flex; align-items: center; gap: 6px; font-size: 0.8125rem; font-weight: 600; color: var(--muted); }
.where svg { width: 15px; height: 15px; }
.step-text ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
.tip { font-size: 0.875rem; color: var(--muted); border-left: 3px solid var(--line); padding-left: 12px; }
kbd, .ui { font-family: var(--font); font-weight: 600; color: var(--ink); background: var(--tint); border: 1px solid var(--line); border-radius: 6px; padding: 1px 7px; font-size: .92em; white-space: nowrap; }

/* mockups */
.mock { background: var(--mock-bg); border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow); overflow: hidden; font-size: 0.8125rem; color: var(--ink); max-width: 100%; }
.mock.phone { border-radius: 28px; padding: 8px; background: var(--mock-chrome); }
.phone .screen { background: var(--mock-bg); border-radius: 22px; overflow: hidden; }
