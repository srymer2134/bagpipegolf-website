---
// /app/billing — the league subscription ($2,140/yr).
//
// Plan: LEAGUE_SUBSCRIPTION_AND_PLAN_GATING_PLAN.md §3.9 (flutter repo).
//
// WHAT THIS PAGE IS NOT. It is not the Connect setup at /app/payments — that
// one connects a league's own Stripe account so MEMBERS can pay the host.
// This one is the director paying Bagpipe. Opposite direction, and the copy
// has to make that obvious or a commissioner will think they already did it.
//
// THE SERVER DECIDES WHETHER THIS PAGE EXISTS. `billing_available` comes from
// GET /api/billing/entitlements, which is false unless the caller is
// allow-listed (BILLING_ENABLED, or billing.config.gate_profiles). While it
// is false we 404 — because /pricing still says "every feature, no credit
// card", and a page offering a $2,140 subscription alongside that is us
// telling two stories at once.
//
// Rendering only READS. The Checkout Session and the Portal link are both
// minted by POSTs (the two /api/billing/* routes), never here: a
// link-preview bot following this URL must not spend a single-use link.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { callRailway } from '../../../lib/railway';
import {
  LEAGUE_DIRECTOR_PRICE_COPY,
  billingErrorMessage,
  moveTargets,
  offersManage,
  offersTrial,
  rowDetail,
  rowState,
  trialButtonCopy,
  type BillingListResponse,
  type BillingLeagueRow,
  type OwnedLeague,
} from '../../../lib/billing';
import { supabaseFor, type RouteCtx } from '../../../lib/paymentsRoutes';
import {
  clubBillingChip,
  clubBillingDetail,
  clubBillingRows,
  hasClubPlan,
} from '../../../lib/clubBilling';
import { clubHref } from '../../../lib/clubs';
import type { Club } from '../../../components/ClubPanel.astro';
import PoweredByStripe from '../../../components/payments/PoweredByStripe.astro';
import PromoCodeBox from '../../../components/PromoCodeBox.astro';
import { rememberedPromo } from '../../../lib/promoCode';
import { buttonPrice, loadPromoView, sentencePrice } from '../../../lib/promoPreview';
import { PLANS, PROMO_CODE, PROMO_PERCENT, dollars, offerActive, offerPrice } from '../../../lib/offer';
import {
  TOURNAMENT_PASS_PRICE_COPY,
  offersPass,
  parseTournamentId,
  passDetail,
  passState,
  type TournamentEntitlement,
} from '../../../lib/tournamentPass';

const locals = Astro.locals as App.Locals;
const user = locals.user;
// ?tournament_id= turns this into one tournament's pass ($240, one time):
// where the field-size refusal and the manage page's "Tournament pass" link
// send a director (lib/tournamentPass.ts).
const tournamentId = parseTournamentId(Astro.url.searchParams.get('tournament_id'));
if (!user) {
  const here = tournamentId ? `/app/billing?tournament_id=${encodeURIComponent(tournamentId)}` : '/app/billing';
  return Astro.redirect(`/login?next=${encodeURIComponent(here)}`, 302);
}

let state: BillingListResponse | null = null;
let loadFailed = false;
try {
  state = await callRailway<BillingListResponse>(Astro, {
    method: 'GET',
    path: '/api/billing/entitlements',
  });
} catch {
  loadFailed = true;
}

// Not admitted → this page does not exist for you. A 404 rather than an
// explanation: there is nothing useful to say to someone who cannot buy it,
// and "you're not on the list" invites a request we are not ready for.
//
// `manage_available` is the exception, and it matters: someone who has
// already PAID is never told this page does not exist. A club payer is not
// on the checkout allowlist, so without this clause the only page that can
// reach their card 404s at them (api #214).
if (!loadFailed && state && !state.billing_available && !state.manage_available) {
  return new Response('Not found', { status: 404 });
}

// The tournament view reads its own entitlement; the league list is not shown.
let pass: TournamentEntitlement | null = null;
let passName = '';
if (tournamentId && !loadFailed) {
  try {
    pass = await callRailway<TournamentEntitlement>(Astro, {
      method: 'GET',
      path: '/api/billing/entitlements',
      query: { tournament_id: tournamentId },
    });
  } catch {
    pass = null;
  }
  const { data: t } = await supabaseFor(Astro as unknown as RouteCtx)
    .from('tournaments')
    .select('name')
    .eq('id', tournamentId)
    .maybeSingle();
  passName = ((t as { name?: string | null } | null)?.name ?? '').trim() || 'Your tournament';
}
const passView = passState(pass);

const rows: BillingLeagueRow[] = state?.leagues ?? [];
// `state` is shadowed inside the row map (the row's badge state), so the
// response gets a second name for the trial checks there.
const billingState = state;

// League names are not in the entitlements response — it is keyed by id — so
// they come from the same read /app/payments/setup uses.
const supabase = supabaseFor(Astro as unknown as RouteCtx);
const { data: leagueRows } = await supabase
  .from('leagues')
  .select('id, name, created_at, completed_at')
  .eq('user_id', user.id);
const owned: OwnedLeague[] = ((leagueRows ?? []) as Array<{
  id: string; name: string | null; created_at: string | null; completed_at: string | null;
}>).map((l) => ({
  id: l.id,
  name: (l.name ?? '').trim() || l.id,
  created_at: l.created_at,
  completed_at: l.completed_at,
}));
const nameFor = new Map<string, string>(owned.map((l) => [l.id, l.name]));

const notice = billingErrorMessage(Astro.url.searchParams.get('billing'));
const promoPlan = tournamentId ? 'event' : 'league';
const promoView = await loadPromoView(Astro, promoPlan, rememberedPromo(Astro.cookies));
const showPortal = offersManage(state, rows);

// ── The club plan, when there is one ────────────────────────
// A club is a super-user feature and most people have none, so this costs
// nothing for almost everybody: middleware already knows whether the viewer
// is in any club, and the Railway hop only happens when they are.
//
// Needed here because a club subscription is NOT in the entitlements
// response and structurally cannot be — `billing_get_state` reads
// league-scoped rows and a club row's `league_id` is NULL.
let clubs: Club[] = [];
if (!tournamentId && (locals.clubs ?? []).length > 0) {
  try {
    clubs = (await callRailway<{ clubs: Club[] }>(Astro, { method: 'GET', path: '/api/clubs' })).clubs ?? [];
  } catch {
    // A dropped club read costs this section, never the league list below.
    clubs = [];
  }
}
const clubRows = clubBillingRows(clubs);
const clubPayer = hasClubPlan(clubRows);
const sorted = [...rows].sort((a, b) =>
  (nameFor.get(a.league_id) ?? a.league_id).localeCompare(nameFor.get(b.league_id) ?? b.league_id),
);
---

<BaseLayout title={tournamentId ? 'Tournament pass · Bagpipe Golf' : 'League subscription · Bagpipe Golf'}>
  <section class="pagewrap">
    <p class="pagewrap__eyebrow">Billing</p>
    <h1 class="pagewrap__title">{tournamentId ? 'Your tournament pass.' : 'Your league subscription.'}</h1>

    {notice && <p class="notice" role="status">{notice}</p>}

    {!loadFailed && <PromoCodeBox plan={promoPlan} view={promoView} />}

    {loadFailed && (
      <p class="pagewrap__sub">
        We couldn’t load your billing just now. Nothing has changed — try
        again in a moment.
      </p>
    )}

    {tournamentId && !loadFailed && (
      <>
        <p class="pagewrap__sub">
          A tournament outside a league is free up to 36 players. One pass,
          {' '}{sentencePrice(promoView, 'event', TOURNAMENT_PASS_PRICE_COPY)}{' '}one time, opens the field to as many as you like.
        </p>
        <ul class="billlist">
          <li class="billlist__row">
            <div class="billlist__text">
              <span class="billlist__name">{passName}</span>
              <span class={`chip chip--${passView === 'covered' ? 'active' : passView === 'league' ? 'comped' : 'subscribe'}`}>
                {passView === 'covered' && 'Pass active'}
                {passView === 'league' && 'League plan'}
                {passView === 'needed' && 'At the free limit'}
                {passView === 'optional' && 'Free'}
                {passView === 'unknown' && 'Unknown'}
              </span>
              <span class="billlist__detail">{passDetail(passView, pass?.field)}</span>
            </div>
            {offersPass(passView) ? (
              <form method="POST" action="/api/billing/tournament-checkout">
                <input type="hidden" name="tournament_id" value={tournamentId} />
                <button class="btn btn--primary btn--sm" type="submit">
                  Buy pass · {buttonPrice(promoView, 'event', TOURNAMENT_PASS_PRICE_COPY)}
                </button>
              </form>
            ) : (
              passView === 'covered' && <span class="billlist__done" aria-hidden="true">✓</span>
            )}
          </li>
        </ul>
        <p>
          <a class="btn btn--ghost btn--sm" href={`/app/tournaments/${encodeURIComponent(tournamentId)}/manage`}>Back to the tournament</a>
        </p>
        <p class="pagewrap__fine">
          Payment is taken by Stripe — card details never reach Bagpipe. You
          get an invoice, and applicable sales tax is calculated at checkout.
        </p>
        <PoweredByStripe />
      </>
    )}

    {!tournamentId && !loadFailed && clubRows.length > 0 && (
      <section class="clubsec">
        <h2 class="clubsec__h">Your club</h2>
        <ul class="billlist">
          {clubRows.map(({ club, state: cstate }) => (
            <li class="billlist__row">
              <div class="billlist__text">
                <a class="billlist__name" href={clubHref(club.org_id)}>{club.name}</a>
                <span class={`chip chip--${cstate === 'yours' ? 'active' : cstate === 'unsubscribed' ? 'subscribe' : 'comped'}`}>
                  {clubBillingChip(cstate)}
                </span>
                <span class="billlist__detail">{clubBillingDetail({ club, state: cstate })}</span>
              </div>
              {cstate === 'unsubscribed' ? (
                <a class="btn btn--primary btn--sm" href="/buy/club">Subscribe</a>
              ) : (
                <span class="billlist__done" aria-hidden="true">✓</span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    {!tournamentId && !loadFailed && sorted.length === 0 && (
      clubPayer ? (
        <>
          <h2 class="clubsec__h">Your leagues</h2>
          <p class="pagewrap__sub">
            Your Club plan covers every league you attach to it — there is
            nothing more to buy per league. Attach one and it is covered the
            moment it lands.
          </p>
          <p class="emptycta">
            <a class="btn btn--primary" href="/app/leagues/new?then=billing">Create a league</a>
            <a class="btn btn--ghost" href="/app/club">Your club</a>
          </p>
        </>
      ) : (
        <>
          <p class="pagewrap__sub">
            A subscription covers one league for twelve months. Create your
            league first — it takes a minute — and you'll come straight back
            here to start your free trial or subscribe. Only the person who
            creates a league can subscribe it.
          </p>
          <p class="emptycta">
            <a class="btn btn--primary" href="/app/leagues/new?then=billing">Create your league</a>
            <a class="btn btn--ghost" href="/app/leagues">Your leagues</a>
          </p>
        </>
      )
    )}

    {!tournamentId && !loadFailed && sorted.length > 0 && (
      <>
        {clubRows.length > 0 && <h2 class="clubsec__h">Your leagues</h2>}
        <p class="pagewrap__sub">
          {clubPayer
            ? 'Every league attached to your club is covered by its plan. A league outside the club is its own subscription.'
            : `${sentencePrice(promoView, 'league', LEAGUE_DIRECTOR_PRICE_COPY)}, per league, renewing annually.`}
          {' '}This is separate from <a href="/app/payments/setup">card payments</a>, which
          is how your <em>members</em> pay <em>you</em>.
        </p>

        <ul class="billlist">
          {sorted.map((row) => {
            const state = rowState(row);
            const name = nameFor.get(row.league_id) ?? row.league_id;
            return (
              <li class="billlist__row">
                <div class="billlist__text">
                  <span class="billlist__name">{name}</span>
                  <span class={`chip chip--${state}`}>
                    {state === 'active' && 'Subscribed'}
                    {state === 'ending' && 'Ending'}
                    {state === 'comped' && 'No charge'}
                    {state === 'trial' && 'Free trial'}
                    {state === 'subscribe' && 'Not subscribed'}
                  </span>
                  <span class="billlist__detail">{rowDetail(row)}</span>
                </div>
                {(() => {
                  const targets = moveTargets(row, owned, rows);
                  return targets.length > 0 && (
                    <form method="POST" action="/api/billing/move" class="move">
                      <input type="hidden" name="from_league_id" value={row.league_id} />
                      <label class="move__label">
                        <span>Season over? Move this plan to</span>
                        <select name="to_league_id" class="move__pick">
                          {targets.map((t) => <option value={t.id}>{t.name}</option>)}
                        </select>
                      </label>
                      <button class="btn btn--ghost btn--sm" type="submit">Move to next season</button>
                    </form>
                  );
                })()}
                {state === 'subscribe' || state === 'trial' ? (
                  <div class="billlist__actions">
                    {offersTrial(billingState, row) && (
                      <form method="POST" action="/api/billing/trial">
                        <input type="hidden" name="league_id" value={row.league_id} />
                        <button class="btn btn--primary btn--sm" type="submit">
                          {trialButtonCopy(billingState?.trial)}
                        </button>
                      </form>
                    )}
                    <form method="POST" action="/api/billing/checkout-session">
                      <input type="hidden" name="league_id" value={row.league_id} />
                      <button
                        class={`btn btn--sm ${offersTrial(billingState, row) ? 'btn--ghost' : 'btn--primary'}`}
                        type="submit"
                      >
                        Subscribe · {buttonPrice(promoView, 'league', LEAGUE_DIRECTOR_PRICE_COPY)}
                      </button>
                    </form>
                  </div>
                ) : (
                  <span class="billlist__done" aria-hidden="true">✓</span>
                )}
              </li>
            );
          })}
        </ul>
      </>
    )}

    {/*
      OUTSIDE the league list on purpose. It used to sit inside it, so a club
      payer with no leagues of their own — the state a Club buyer starts in —
      got the "create your league" empty page and no way to reach their card
      at all (api #214).
    */}
    {!tournamentId && !loadFailed && showPortal && (
      <form method="POST" action="/api/billing/portal-session" class="portal">
        <button class="btn btn--ghost btn--sm" type="submit">
          Manage {clubPayer && sorted.length === 0 ? 'your Club plan' : 'subscription'}
        </button>
        <span class="portal__hint">
          Update your card, download invoices, or cancel at the end of the
          term.
        </span>
      </form>
    )}

    {!tournamentId && !loadFailed && (
      <>
        <p class="pagewrap__fine">
          Payment is taken by Stripe — card details never reach Bagpipe.
          Applicable sales tax is calculated at checkout.
        </p>
        <PoweredByStripe />
      </>
    )}
  </section>
</BaseLayout>

<style>
  .billlist { list-style: none; margin: 1.25rem 0 0; padding: 0; }
  .clubsec { margin: 1.25rem 0 0; }
  .clubsec__h { margin: 1.5rem 0 0; font-size: 1.0625rem; color: var(--brand-green-dark); }
  .clubsec .billlist { margin-top: 0.5rem; }
  .billlist__row {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; padding: 0.95rem 0;
    border-bottom: 1px solid var(--rule, #e5e7eb);
  }
  .billlist__row:last-child { border-bottom: 0; }
  .billlist__text { display: flex; flex-direction: column; gap: 0.25rem; }
  .billlist__name { font-weight: 600; }
  .billlist__detail { font-size: 0.9rem; opacity: 0.75; }
  .billlist__done { font-size: 1.1rem; opacity: 0.55; }
  .promo {
    margin: 0 0 1rem; padding: 0.7rem 0.9rem; border-radius: 8px;
    background: var(--brand-green-pale); color: var(--ink);
  }
  .promo--quiet { background: transparent; padding: 0; color: var(--ink-muted); font-size: 0.9rem; }
  .emptycta { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .chip {
    align-self: flex-start;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.12rem 0.45rem; border-radius: 999px;
    border: 1px solid currentColor;
  }
  .chip--active { color: #15803d; }
  .chip--ending { color: #b45309; }
  .chip--comped { color: #1d4ed8; }
  .chip--trial { color: #7c3aed; }
  .billlist__actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .chip--subscribe { color: #6b7280; }
  .notice {
    margin: 0 0 1rem; padding: 0.7rem 0.9rem;
    border-radius: 8px; border: 1px solid var(--rule, #e5e7eb);
    background: rgba(180, 83, 9, 0.07);
  }
  .move { display: flex; align-items: flex-end; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .move__label { display: flex; flex-direction: column; gap: 0.2rem; font-size: 0.85rem; opacity: 0.85; }
  .move__pick { font: inherit; padding: 0.35rem 0.5rem; border-radius: 8px; border: 1px solid var(--rule, #e5e7eb); }
  .portal { margin-top: 1.5rem; display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .portal__hint { font-size: 0.9rem; opacity: 0.75; }
  .pagewrap__fine { margin-top: 1.5rem; font-size: 0.85rem; opacity: 0.65; }
  @media (max-width: 520px) {
    .billlist__row { flex-direction: column; align-items: flex-start; }
  }
</style>
