---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Leagues · Bagpipe Golf">
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">Leagues</p>
    <h1 class="pagewrap__title">Your leagues.</h1>
    <p class="pagewrap__sub">
      Seasons you're playing in, directing, or signed up to sub for.
    </p>

    <section class="grid grid--2">
      <article class="card">
        <span class="chip">In season</span>
        <h3 class="muted">Loading from Supabase…</h3>
        <p>Cards land here for each active league.</p>
      </article>
      <article class="card">
        <span class="chip chip--muted">Completed</span>
        <h3 class="muted">Loading from Supabase…</h3>
        <p>Past seasons with final standings.</p>
      </article>
      <article class="card">
        <span class="chip chip--warn">LD</span>
        <h3 class="muted">Loading from Supabase…</h3>
        <p>Leagues where you're the league director — manage controls available.</p>
      </article>
    </section>

    <p class="hint">
      Sample microsite (public, no auth): <a href="/l/demo">/l/demo</a>
    </p>
  </main>
</BaseLayout>

<style>
  .card h3 {
    font-size: 17px;
    color: var(--brand-green-dark);
    margin: 8px 0 4px;
  }
  .card h3.muted { color: var(--ink-muted); font-weight: 600; }
  .card p { margin: 0; color: var(--ink-muted); font-size: 14px; }
  .hint {
    margin-top: 32px;
    color: var(--ink-muted);
    font-size: 14px;
  }
</style>
