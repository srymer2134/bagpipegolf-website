---
import {
  mergeRosterHandicaps,
  rosterUserIds,
  type ProfileHandicapRow,
  type RosterRow,
  type RosterWithHandicap,
} from '../../../../lib/leagueRoster';
import { formatDuesLine } from '../../../../lib/leagueDues';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import LeagueSubnav from '../../../../components/LeagueSubnav.astro';
import { createSupabaseClient } from '../../../../lib/supabase';
import { leagueDetail, visibilityLabel, type PortalDetail } from '../../../../lib/leaguePortal';

// `/app/leagues/[id]/manage` — the director's read-only view.
//
// GATED on being the commissioner. The placeholder this replaced carried
// the note "PR #2 will gate this on the user being the league's
// directorUserId"; that gate had never been built, so any signed-in
// member could open a page headed "director controls". Now a non-
// commissioner is bounced to the overview.
//
// READ-ONLY on purpose. Season setup, roster, pairings, flighting and
// subs are all write surfaces the app already owns, and putting a second
// writer on the web would mean two paths into league configuration with
// different validation. This page shows what IS configured and says
// where to change it.

const { id } = Astro.params;
const user = (Astro.locals as App.Locals).user;

let d: PortalDetail | null = null;
let config: Record<string, unknown> | null = null;
let roster: RosterWithHandicap[] = [];
let failed = false;

try {
  const supabase = createSupabaseClient({
    request: Astro.request,
    cookies: Astro.cookies,
    locals: Astro.locals as App.Locals,
  });
  if (id && user?.id) {
    d = await leagueDetail(supabase, id, user.id);
    if (d?.league.role === 'commissioner') {
      const [cfgRes, rosRes] = await Promise.all([
        supabase
          .from('leagues')
          .select('points_model, week_format, team_size, holes_per_week, handicap_basis, allowance_pct, sub_scoring_rule, sub_handicap_rule, absent_rule, bye_rule, attendance_points, flight_count, playoff_size, default_tee, default_first_tee, tee_interval_minutes, timezone, reminder_time, join_code, dues_cents, dues_due_date')
          .eq('id', id)
          .maybeSingle(),
        supabase
          .from('league_members')
          .select('user_id, display_name, role, status')
          .eq('league_id', id),
      ]);
      config = (cfgRes.data as Record<string, unknown> | null) ?? null;
      // Handicaps come from profiles — the one source the app reads too.
      // league_members.handicap is a drifting add-time copy, pending
      // removal (fairwayiq-flutter PATRICK_BACKLOG §68); not read here.
      const rows = (rosRes.data ?? []) as RosterRow[];
      const ids = rosterUserIds(rows);
      let profiles: ProfileHandicapRow[] = [];
      if (ids.length > 0) {
        const profRes = await supabase
          .from('profiles')
          .select('id, handicap')
          .in('id', ids);
        profiles = (profRes.data ?? []) as ProfileHandicapRow[];
      }
      roster = mergeRosterHandicaps(rows, profiles);
    }
  }
} catch (err) {
  console.error('[app/league/manage] load failed', err);
  failed = true;
}

if (d && d.league.role !== 'commissioner') {
  return Astro.redirect(`/app/leagues/${id}`, 302);
}

const active = roster.filter((r) => !r.status || r.status === 'active');
const label = (k: string) => k.replace(/_/g, ' ');
const setupKeys = [
  'points_model', 'week_format', 'team_size', 'holes_per_week',
  'handicap_basis', 'allowance_pct', 'sub_scoring_rule', 'sub_handicap_rule',
  'absent_rule', 'bye_rule', 'attendance_points', 'flight_count', 'playoff_size',
];
const dayKeys = ['default_tee', 'default_first_tee', 'tee_interval_minutes', 'timezone', 'reminder_time'];
// Season dues get their own formatted row rather than joining
// `setupKeys`: the column is an integer of CENTS, so the generic
// String() renderer would print "4500". Null when the league charges
// none, which drops the row entirely instead of showing "$0".
const duesLine = config
  ? formatDuesLine(config.dues_cents, config.dues_due_date)
  : null;
---

<BaseLayout title={d ? `Manage ${d.league.name} · Bagpipe Golf` : 'Manage league · Bagpipe Golf'}>
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">League · director</p>
    <h1 class="pagewrap__title">Manage league.</h1>

    {!d ? (
      <section class="card">
        <h3>{failed ? "Couldn't load this league" : 'Not your league'}</h3>
        <a class="btn btn--primary" href="/app/leagues">Your leagues</a>
      </section>
    ) : (
      <>
        <p class="pagewrap__sub">{d.league.name}</p>
        <LeagueSubnav id={d.league.id} active="manage" />

        <div class="notice">
          <strong>This page reads; the app writes.</strong> Season setup,
          roster, pairings, subs and flighting are edited in the Bagpipe Golf
          app. Putting a second editor here would mean two paths into league
          configuration with different validation, so the portal deliberately
          shows what's set rather than letting you set it.
        </div>

        <section class="grid grid--2">
          <article class="card">
            <span class="chip">Season setup</span>
            <h3>{config ? 'Current configuration' : 'Not available'}</h3>
            {config && (
              <>
                <dl class="kv">
                  {setupKeys.filter((k) => config![k] !== null && config![k] !== undefined).map((k) => (
                    <div><dt>{label(k)}</dt><dd>{String(config![k])}</dd></div>
                  ))}
                  {duesLine && <div><dt>season dues</dt><dd>{duesLine}</dd></div>}
                </dl>
                {!duesLine && (
                  <p class="small muted">
                    No season dues set. The commissioner sets them in the app
                    under League&nbsp;&rsaquo;&nbsp;Season&nbsp;dues.
                  </p>
                )}
              </>
            )}
          </article>

          <article class="card">
            <span class="chip">Day defaults</span>
            <h3>Tee times &amp; reminders</h3>
            {config && (
              <dl class="kv">
                {dayKeys.filter((k) => config![k] !== null && config![k] !== undefined).map((k) => (
                  <div><dt>{label(k)}</dt><dd>{String(config![k])}</dd></div>
                ))}
              </dl>
            )}
            <p class="small muted">
              Reminders only send once <code>JOB_SECRET</code> is set on the
              API — §40.
            </p>
          </article>

          <article class="card">
            <span class="chip">Roster</span>
            <h3>{active.length} active {active.length === 1 ? 'member' : 'members'}</h3>
            {active.length > 0 && (
              <div class="scroll">
                <table class="tbl">
                  <thead><tr><th>Name</th><th>HCP</th><th>Role</th></tr></thead>
                  <tbody>
                    {active.map((m) => (
                      <tr>
                        <td>{m.display_name ?? 'Player'}</td>
                        <td>{m.handicap ?? '—'}</td>
                        <td>{m.role ?? 'member'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {config?.join_code && (
              <p class="small">
                Join code <code>{String(config.join_code)}</code> ·
                <span class="muted"> bagpipegolf.com/join/{String(config.join_code)}</span>
              </p>
            )}
          </article>

          <article class="card">
            <span class="chip">Public page</span>
            <h3>{visibilityLabel(d.league.page_visibility)}</h3>
            <p>
              {d.league.page_visibility === 'private'
                ? 'Nobody can open the public page. Change it in the app under Weeks → Course, tee + tee times.'
                : d.league.page_visibility === 'members'
                  ? 'Signed-in members of this league can open it; everyone else is asked to sign in.'
                  : 'Anyone with the link can open it.'}
            </p>
            {d.league.page_visibility !== 'private' && (
              <a class="btn btn--ghost" href={`/l/${d.league.id}`}>View public page</a>
            )}
          </article>
        </section>

        <section class="lsec">
          <h2 class="lsec__h">Edited in the app</h2>
          <p class="small muted">
            Pairings and substitutes · flighting · weekly matchups · the pot ·
            messaging the league. Each of these writes through the app's
            validation, and several are mid-round surfaces that have to work
            offline.
          </p>
        </section>
      </>
    )}
  </main>
</BaseLayout>

<style>
  .card h3 { font-size: 1.0625rem; color: var(--brand-green-dark); margin: 8px 0 6px; }
  .card p { margin: 0 0 6px; color: var(--ink-muted); font-size: 0.875rem; }
  .kv { margin: 0; display: flex; flex-direction: column; gap: 2px; }
  .kv div { display: flex; justify-content: space-between; gap: 12px; font-size: 0.84375rem; }
  .kv dt { color: var(--ink-muted, #4b5b54); margin: 0; text-transform: capitalize; }
  .kv dd { margin: 0; font-variant-numeric: tabular-nums; text-align: right; }
  .lsec { margin-top: 28px; }
  .lsec__h {
    font-size: 0.9375rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--ink-muted, #4b5b54); margin: 0 0 10px;
  }
  .scroll { overflow-x: auto; }
  .tbl { border-collapse: collapse; width: 100%; font-size: 0.875rem; }
  .tbl th, .tbl td { text-align: left; padding: 6px 10px; border-bottom: 1px solid #e3e9e5; }
  .tbl th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-muted, #4b5b54); }
  .notice {
    padding: 14px 16px; border-radius: 12px; margin: 16px 0; line-height: 1.5;
    font-size: 0.875rem; background: #f4f7f5; border: 1px solid #e3e9e5;
  }
  .small { font-size: 0.78125rem; }
  .muted { color: var(--ink-muted, #4b5b54); }
  code { background: #eef3f0; padding: .1em .35em; border-radius: 3px; }
</style>
