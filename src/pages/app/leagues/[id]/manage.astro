---
import {
  mergeRosterHandicaps,
  rosterUserIds,
  type ProfileHandicapRow,
  type RosterRow,
  type RosterWithHandicap,
} from '../../../../lib/leagueRoster';
import {
  groupedConfigFields, inputKindFor, numberStepFor, suggestionsFor,
  parseIntList,
} from '../../../../lib/leagueConfigForm';
import {
  FIELD_COPY, appliesTo, centsToInput, fieldLabel, sectionEmptyReason,
  valueHelp, valueLabel, CENTS_FIELDS,
} from '../../../../lib/leagueFieldLanguage';
import { LEAGUE_CONFIG_FIELDS } from '../../../../lib/leagueCreate';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import LeagueSubnav from '../../../../components/LeagueSubnav.astro';
import RosterInvite from '../../../../components/leagues/RosterInvite.astro';
import RosterCsvImport from '../../../../components/leagues/RosterCsvImport.astro';
import { createSupabaseClient } from '../../../../lib/supabase';
import { leagueDetail, visibilityLabel, type PortalDetail } from '../../../../lib/leaguePortal';
import { fixtureParam, getMerchant, modeFor } from '../../../../lib/paymentsServer';
import { paymentsGate } from '../../../../lib/paymentsGate';
import OwnerParticipation from '../../../../components/OwnerParticipation.astro';
import {
  isOrganizer, loadOwnMembership, needsParticipationPrompt, type OwnMembership,
} from '../../../../lib/leagueParticipation';

// `/app/leagues/[id]/manage` — the director's desk.
//
// GATED on being the commissioner. The placeholder this replaced carried
// the note "PR #2 will gate this on the user being the league's
// directorUserId"; that gate had never been built, so any signed-in
// member could open a page headed "director controls". Now a non-
// commissioner is bounced to the overview.
//
// WHAT THIS PAGE MAY WRITE — AND WHY A "READ-ONLY ON PURPOSE" PAGE HAS
// WRITE SURFACES ON IT.
//
// It began read-only, on this reasoning: "Season setup, roster,
// pairings, flighting and subs are all write surfaces the app already
// owns, and putting a second writer on the web would mean two paths
// into league configuration with different validation."
//
// The substance of that objection was never "the web must not write" —
// it was "two validators". Both exceptions since are answers to it
// rather than overrides of it:
//
//   1. SEASON SETTINGS (W2b). The form below is GENERATED from the
//      migrations, so the fields, the allowed values and the
//      cross-field rules all come from the one place Postgres gets
//      them. One definition rendered twice. See
//      src/pages/api/leagues/[id]/config.ts.
//
//      SEASON DUES live in that form (group `dues`, anchor
//      `#settings-dues`): the web half of the app's "Set season dues…"
//      sheet, linked from the payments panel and the card-payments
//      guide. Server-checked by `validateDuesPatch` (lib/leagueDues.ts).
//
//   2. MEMBERSHIP, OWNER-ONLY — invite by email and CSV import (Sam,
//      2026-10-13; fairwayiq-flutter docs/plans/
//      LD_ROSTER_MANAGEMENT_PLAN.md D1 + D2). Emailing a roster and
//      importing a spreadsheet are desk work; nobody types 40 rows on
//      a phone. And membership already had a second writer — the
//      join-code flow — so this reopens nothing. The write goes
//      through the Railway API, which keeps the validation in one
//      place; that is D2, and it is why there is no Supabase-direct
//      membership write anywhere on this page.
//
// SCOPE OF THE EXCEPTION: membership only, and the OWNER only
// (`leagues.user_id` — the same identity the payments pages check, not
// every commissioner). Pairings, substitutes, weekly matchups and
// anything mid-round stay in the app, where the offline outbox is. The
// line is the parity plan's: the desk, not the tee box.

const { id } = Astro.params;
const user = (Astro.locals as App.Locals).user;

let d: PortalDetail | null = null;
let config: Record<string, unknown> | null = null;
let roster: RosterWithHandicap[] = [];
let failed = false;
// The owner's own participation (playing / organizing + their dues
// override) — LEAGUE_OWNER_PARTICIPATION_PLAN.md D4/D5. Null for a
// co-director: participation is the OWNER's control.
let own: OwnMembership | null = null;
let ownerIdForParticipation: string | null = null;

try {
  const supabase = createSupabaseClient({
    request: Astro.request,
    cookies: Astro.cookies,
    locals: Astro.locals as App.Locals,
  });
  if (id && user?.id) {
    d = await leagueDetail(supabase, id, user.id);
    if (d?.league.role === 'commissioner') {
      const [cfgRes, rosRes] = await Promise.all([
        supabase
          .from('leagues')
          .select(
            // Every generated config column, plus the few this page
            // shows but does not edit. Hand-listing the config half is
            // what let it drift before — it now comes from the schema.
            // `user_id` rides along because the owner-only surfaces
            // (payments, roster writes) all need it and this is
            // already a read of the same row. It cannot be written
            // back: the settings POST accepts only generated column
            // names, and the form renders a control only for those.
            [...LEAGUE_CONFIG_FIELDS.map((f) => f.name),
             'points_model', 'sub_scoring_rule', 'flight_count',
             'playoff_size', 'join_code', 'user_id'].join(', '),
          )
          .eq('id', id)
          .maybeSingle(),
        supabase
          .from('league_members')
          .select('user_id, display_name, role, status')
          .eq('league_id', id),
      ]);
      config = (cfgRes.data as Record<string, unknown> | null) ?? null;
      // Handicaps come from profiles — the one source the app reads too.
      // league_members.handicap is a drifting add-time copy, pending
      // removal (fairwayiq-flutter PATRICK_BACKLOG §68); not read here.
      const rows = (rosRes.data ?? []) as RosterRow[];
      const ids = rosterUserIds(rows);
      let profiles: ProfileHandicapRow[] = [];
      if (ids.length > 0) {
        const profRes = await supabase
          .from('profiles')
          .select('id, handicap')
          .in('id', ids);
        profiles = (profRes.data ?? []) as ProfileHandicapRow[];
      }
      roster = mergeRosterHandicaps(rows, profiles);
      ownerIdForParticipation = (config?.user_id as string | null | undefined) ?? null;
      if (ownerIdForParticipation === user.id) {
        try {
          own = await loadOwnMembership(supabase, id, user.id);
        } catch (err) {
          // A failed read hides the control rather than prompting an
          // owner who may well have answered already.
          console.error('[app/league/manage] own membership read failed', err);
        }
      }
    }
  }
} catch (err) {
  console.error('[app/league/manage] load failed', err);
  failed = true;
}

if (d && d.league.role !== 'commissioner') {
  return Astro.redirect(`/app/leagues/${id}`, 302);
}

// The league's OWNER (`leagues.user_id`) — one identity, used by both
// owner-only surfaces: payments (F5, "one login from Bagpipe") and the
// roster writes below. NOT every commissioner. This used to be a second
// query for the same column on the same row; it now comes off the read
// above, so a config read that failed also means no owner surfaces,
// which is the safe direction to fail.
const leagueOwnerId = (config?.user_id as string | null | undefined) ?? null;
const isOwner = Boolean(user?.id) && leagueOwnerId === user?.id;

// Phase 1's pending chips, server-rendered so the panel is populated on
// first paint. `league_invites` carries an owner-scoped SELECT policy
// ("owner reads own league invites", 20260812_league_invites.sql), so a
// non-owner's read returns nothing rather than erroring — the isOwner
// check is about not making a pointless query, not about security.
// Accepted invites are excluded: those people are on the roster now.
type PendingInvite = { id: string; email: string; status: string; created_at: string | null };
let invites: PendingInvite[] = [];
if (isOwner && id) {
  try {
    const supabase = createSupabaseClient({
      request: Astro.request,
      cookies: Astro.cookies,
      locals: Astro.locals as App.Locals,
    });
    const { data } = await supabase
      .from('league_invites')
      .select('id, email, status, created_at')
      .eq('league_id', id)
      .neq('status', 'accepted')
      .order('created_at', { ascending: false });
    invites = (data ?? []) as PendingInvite[];
  } catch (err) {
    // An empty list is wrong but harmless — the panel re-reads from
    // /api/leagues/[id]/invites after any change.
    console.error('[app/league/manage] invite read failed', err);
  }
}

// W1 entry point — the payments link, only when the API says THIS
// league takes payments. The owner's merchant read (§2.2) is the gate
// (paymentsGate.ts): 503 `payments_disabled` for a league not on the
// allow-list, any error or a timeout → no link. Called for the owner
// only, so one call at most — and `paymentsGate` returns before the
// probe runs when PAYMENTS_ENABLED is unset, so flag-off still makes
// no call.
let showPaymentsLink = false;
if (id && isOwner) {
  const payMode = modeFor(Astro.locals as App.Locals);
  const gate = await paymentsGate(payMode, () =>
    getMerchant({ locals: Astro.locals as App.Locals }, payMode, 'league', id!, fixtureParam(payMode, Astro.url)));
  showPaymentsLink = gate.enabled;
}

const active = roster.filter((r) => !r.status || r.status === 'active');
const showPrompt = own !== null && needsParticipationPrompt({
  supported: own.supported, isOwner: true, row: own.row,
});
const showParticipation = own !== null && own.supported && !showPrompt;

// The settings form, built entirely from the generated schema. A new
// column on `leagues` appears here by being regenerated — see
// lib/leagueConfigForm.ts, whose test fails if any generated field is
// left out of a group.
const groups = groupedConfigFields();

/** The current value, in the shape the control expects. */
function fieldValue(name: string, kind: string): string {
  const raw = config?.[name];
  // Money is stored in cents and typed in dollars.
  if (CENTS_FIELDS.has(name)) return centsToInput(raw);
  if (raw === null || raw === undefined) return '';
  if (kind === 'intlist') return parseIntList(raw).join(', ');
  // A Postgres `time` comes back as HH:MM:SS; <input type=time> wants HH:MM.
  if (kind === 'time') return String(raw).slice(0, 5);
  return String(raw);
}

// Most of these columns arrived with the weekly-matchup migration and
// describe a MATCH. A position or stroke-aggregate league has no
// opponent, so showing them is worse than useless — a director assumes
// a setting they can see does something. Hiding is display only;
// nothing is cleared.
const snapshot = (config ?? {}) as Record<string, unknown>;
const visibleGroups = groups
  .map((g) => ({ ...g, fields: g.fields.filter((f) => appliesTo(f.name, snapshot)) }))
  .filter((g) => g.fields.length > 0 || sectionEmptyReason(g.key, snapshot));
---

<BaseLayout title={d ? `Manage ${d.league.name} · Bagpipe Golf` : 'Manage league · Bagpipe Golf'}>
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">League · director</p>
    <h1 class="pagewrap__title">Manage league.</h1>

    {!d ? (
      <section class="card">
        <h3>{failed ? "Couldn't load this league" : 'Not your league'}</h3>
        <a class="btn btn--primary" href="/app/leagues">Your leagues</a>
      </section>
    ) : (
      <>
        <p class="pagewrap__sub">{d.league.name}</p>
        <LeagueSubnav id={d.league.id} active="manage" coachAccess={d.league.coach_access} />

        {showPrompt && (
          <OwnerParticipation leagueId={d.league.id} mode="prompt" row={null}
            leagueDuesCents={(config?.dues_cents as number | null | undefined) ?? null} />
        )}

        {showPaymentsLink && (
          <p class="pagewrap__sub">
            <a class="btn btn--ghost" href={`/app/leagues/${d.league.id}/payments`}>Set up card payments</a>
          </p>
        )}

        <div class="notice">
          <strong>Season settings are editable here.</strong> Every field
          below is generated from the database's own column definitions and
          rules, so this form and the app are the same definition rendered
          twice — not two opinions. Saving writes only what you changed, and
          the league's rules are re-checked on the server before anything
          lands. Pairings, substitutes and anything mid-round stay in the
          app, where an offline outbox protects them.
        </div>

        <form id="cfgForm" class="cfg">
          {visibleGroups.map((g) => (
            <fieldset class="card cfg__g" id={`settings-${g.key}`}>
              <legend class="chip">{g.title}</legend>
              <p class="small muted">{g.blurb}</p>
              {sectionEmptyReason(g.key, snapshot) && (
                <p class="cfg__na">{sectionEmptyReason(g.key, snapshot)}</p>
              )}
              {g.fields.map((fld) => {
                const kind = inputKindFor(fld);
                const val = fieldValue(fld.name, kind);
                const opts = suggestionsFor(fld);
                const copy = FIELD_COPY[fld.name];
                const chosenHelp = kind === 'select' ? valueHelp(fld.name, val) : undefined;
                const isCents = CENTS_FIELDS.has(fld.name);
                return (
                  <div class="cfg__row">
                    <label class="cfg__lab" for={`f_${fld.name}`}>{fieldLabel(fld.name)}</label>
                    <div class="cfg__in">
                      <div class="cfg__ctl">
                        {copy?.prefix && <span class="cfg__affix">{copy.prefix}</span>}
                        {kind === 'select' ? (
                          <select id={`f_${fld.name}`} data-col={fld.name}>
                            {!fld.notNull && <option value="">Not set</option>}
                            {opts.map((o) => (
                              <option value={o} selected={String(val) === o}>
                                {valueLabel(fld.name, o)}
                              </option>
                            ))}
                          </select>
                        ) : kind === 'checkbox' ? (
                          <input type="checkbox" id={`f_${fld.name}`} data-col={fld.name}
                                 checked={val === 'true'} />
                        ) : kind === 'number' ? (
                          <input type="number" id={`f_${fld.name}`} data-col={fld.name}
                                 data-cents={isCents ? 'true' : undefined}
                                 step={isCents ? '0.01' : numberStepFor(fld)} value={val}
                                 inputmode="decimal" />
                        ) : kind === 'time' ? (
                          <input type="time" id={`f_${fld.name}`} data-col={fld.name} value={val} />
                        ) : kind === 'date' ? (
                          <input type="date" id={`f_${fld.name}`} data-col={fld.name} value={val} />
                        ) : kind === 'intlist' ? (
                          <input type="text" id={`f_${fld.name}`} data-col={fld.name}
                                 value={val} placeholder="3, 7, 12" inputmode="numeric" />
                        ) : (
                          <>
                            <input type="text" id={`f_${fld.name}`} data-col={fld.name}
                                   value={val} list={opts.length ? `l_${fld.name}` : undefined} />
                            {opts.length > 0 && (
                              <datalist id={`l_${fld.name}`}>
                                {opts.map((o) => (
                                  <option value={o} label={valueLabel(fld.name, o)}></option>
                                ))}
                              </datalist>
                            )}
                          </>
                        )}
                        {copy?.suffix && <span class="cfg__affix">{copy.suffix}</span>}
                      </div>
                      {(chosenHelp || copy?.help) && (
                        <span class="cfg__hint">{chosenHelp ?? copy?.help}</span>
                      )}
                    </div>
                  </div>
                );
              })}
            </fieldset>
          ))}
          <div class="cfg__bar">
            <button type="submit" id="cfgBtn" class="btn btn--primary">Save settings</button>
            <span id="cfgMsg" class="small muted"></span>
          </div>
        </form>

        {showParticipation && (
          <OwnerParticipation leagueId={d.league.id} mode="settings" row={own!.row}
            leagueDuesCents={(config?.dues_cents as number | null | undefined) ?? null} />
        )}

        <section class="grid grid--2">
          <article class="card">
            <span class="chip">Roster</span>
            <h3>{active.length} active {active.length === 1 ? 'member' : 'members'}</h3>
            {active.length > 0 && (
              <div class="scroll">
                <table class="tbl">
                  <thead><tr><th>Name</th><th>HCP</th><th>Role</th></tr></thead>
                  <tbody>
                    {active.map((m) => (
                      <tr>
                        <td>{m.display_name ?? 'Player'}</td>
                        <td>{m.handicap ?? '—'}</td>
                        <td>{isOrganizer(m) ? 'organizer (not playing)' : (m.role ?? 'member')}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {config?.join_code && (
              <p class="small">
                Join code <code>{String(config.join_code)}</code> ·
                <span class="muted"> bagpipegolf.com/join/{String(config.join_code)}</span>
              </p>
            )}
          </article>

          <article class="card">
            <span class="chip">Public page</span>
            <h3>{visibilityLabel(d.league.page_visibility)}</h3>
            <p>
              {d.league.page_visibility === 'private'
                ? 'Nobody can open the public page. Change it in the app under Weeks → Course, tee + tee times.'
                : d.league.page_visibility === 'members'
                  ? 'Signed-in members of this league can open it; everyone else is asked to sign in.'
                  : 'Anyone with the link can open it.'}
            </p>
            {d.league.page_visibility !== 'private' && (
              <a class="btn btn--ghost" href={`/l/${d.league.id}`}>View public page</a>
            )}
          </article>
        </section>

        {isOwner && (
          <section class="lsec">
            <h2 class="lsec__h">Add players</h2>
            <p class="small muted">
              Only you can do this — the login that owns this league, not
              every commissioner. Removing a player, and withdrawing an
              invite, are still done from the league roster in the app.
            </p>
            <RosterInvite leagueId={d.league.id} invites={invites} />
            <RosterCsvImport leagueId={d.league.id} />
          </section>
        )}

        <section class="lsec">
          <h2 class="lsec__h">Still edited in the app</h2>
          <p class="small muted">
            Pairings and substitutes · weekly matchups · recording scores ·
            messaging the league · removing a player or withdrawing an
            invite. These are mid-round, on-course or roster-removal
            surfaces, and the app has an offline outbox that a browser tab
            does not — the dividing line the parity plan calls "the desk,
            not the tee box".
          </p>
        </section>
      </>
    )}
  </main>
</BaseLayout>

<script is:inline define:vars={{ leagueId: d?.league?.id ?? '' }}>
  (() => {
    const form = document.getElementById('cfgForm');
    if (!form || !leagueId) return;
    const btn = document.getElementById('cfgBtn');
    const msg = document.getElementById('cfgMsg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Send every field; the SERVER diffs against the current row.
      // Diffing here would mean the browser deciding what changed,
      // which is the thing a stale tab gets wrong.
      const payload = {};
      for (const el of form.querySelectorAll('[data-col]')) {
        if (el.type === 'checkbox') {
          payload[el.dataset.col] = el.checked;
        } else if (el.dataset.cents === 'true') {
          // Typed in dollars, stored in cents. Rounded, not truncated:
          // 45.55 * 100 is 4554.999… in binary floating point.
          const s = String(el.value).replace(/[^0-9.]/g, '');
          payload[el.dataset.col] =
            s === '' ? 0 : Math.max(0, Math.round(Number(s) * 100));
        } else {
          payload[el.dataset.col] = el.value;
        }
      }
      const label = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Saving…';
      msg.textContent = '';
      msg.className = 'small muted';
      try {
        const res = await fetch(
          `/api/leagues/${encodeURIComponent(leagueId)}/config`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          },
        );
        const out = await res.json().catch(() => ({}));
        if (!res.ok) {
          msg.textContent = out.error || 'Could not save.';
          msg.className = 'small cfg__err';
          return;
        }
        const n = (out.changed || []).length;
        msg.textContent = n === 0
          ? 'No changes.'
          : `Saved ${n} setting${n === 1 ? '' : 's'}.`;
      } catch {
        msg.textContent = 'Could not reach the server.';
        msg.className = 'small cfg__err';
      } finally {
        btn.disabled = false;
        btn.textContent = label;
      }
    });
  })();
</script>

<style>
  .card h3 { font-size: 1.0625rem; color: var(--brand-green-dark); margin: 8px 0 6px; }
  .card p { margin: 0 0 6px; color: var(--ink-muted); font-size: 0.875rem; }
  .kv { margin: 0; display: flex; flex-direction: column; gap: 2px; }
  .kv div { display: flex; justify-content: space-between; gap: 12px; font-size: 0.84375rem; }
  .kv dt { color: var(--ink-muted, #4b5b54); margin: 0; text-transform: capitalize; }
  .kv dd { margin: 0; font-variant-numeric: tabular-nums; text-align: right; }
  .lsec { margin-top: 28px; }
  .lsec__h {
    font-size: 0.9375rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--ink-muted, #4b5b54); margin: 0 0 10px;
  }
  .scroll { overflow-x: auto; }
  .tbl { border-collapse: collapse; width: 100%; font-size: 0.875rem; }
  .tbl th, .tbl td { text-align: left; padding: 6px 10px; border-bottom: 1px solid #e3e9e5; }
  .tbl th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-muted, #4b5b54); }
  .notice {
    padding: 14px 16px; border-radius: 12px; margin: 16px 0; line-height: 1.5;
    font-size: 0.875rem; background: #f4f7f5; border: 1px solid #e3e9e5;
  }
  .cfg { display: grid; gap: 14px; margin: 16px 0; }
  .cfg__g { border: 1px solid #e3e9e5; }
  .cfg__g legend { padding: 0 6px; }
  .cfg__row {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 10px; align-items: start; padding: 6px 0;
    border-top: 1px solid #f0f4f2;
  }
  .cfg__lab {
    font-size: 0.84375rem; text-transform: capitalize;
    color: var(--ink-muted, #4b5b54); padding-top: 6px;
  }
  .cfg__in { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .cfg__in input[type="text"], .cfg__in input[type="number"],
  .cfg__in input[type="time"], .cfg__in input[type="date"], .cfg__in select {
    width: 100%; padding: 6px 8px; font-size: 0.875rem;
    border: 1px solid #cfdad4; border-radius: 8px; background: #fff;
  }
  .cfg__in input[type="checkbox"] { width: 18px; height: 18px; margin: 6px 0; }
  .cfg__ctl { display: flex; align-items: center; gap: 8px; }
  .cfg__affix { font-size: 0.875rem; color: var(--ink-muted, #4b5b54); flex: 0 0 auto; }
  .cfg__hint { font-size: 0.75rem; color: var(--ink-muted, #4b5b54); line-height: 1.45; }
  .cfg__na {
    margin: 4px 0 0; font-size: 0.8125rem; line-height: 1.5;
    color: var(--ink-muted, #4b5b54);
  }
  .cfg__bar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .cfg__err { color: #a3261f; }
  @media (max-width: 560px) { .cfg__row { grid-template-columns: 1fr; } }
  .small { font-size: 0.78125rem; }
  .muted { color: var(--ink-muted, #4b5b54); }
  code { background: #eef3f0; padding: .1em .35em; border-radius: 3px; }
</style>
