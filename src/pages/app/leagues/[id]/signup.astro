---
// Sign up for one league event: the player's answer ("I'm in" /
// "Can't make it") for one slot of the season, plus optional season dues.
//
// The answer is the same `league_signups` row the app writes; it is saved
// by `POST /api/leagues/[id]/rsvp`, which also adds a playing member to
// the event's tournament field when the slot is bound to one.
//
// Season dues are real only with PAYMENTS_ENABLED (`signupDuesStep` in
// `src/lib/paymentsSignup.ts`); with the flag off the block is absent.
// Payment returns land back here with `?slot=`.

import BaseLayout from '../../../../layouts/BaseLayout.astro';
import LeagueSubnav from '../../../../components/LeagueSubnav.astro';
import { createSupabaseClient } from '../../../../lib/supabase';
import { leagueDetail } from '../../../../lib/leaguePortal';
import PayButton from '../../../../components/payments/PayButton.astro';
import { fixtureParam, listPayments, modeFor } from '../../../../lib/paymentsServer';
import { loadPayable, supabaseFor, withQuery, type RouteCtx } from '../../../../lib/paymentsRoutes';
import { signupDuesStep, type SignupDues } from '../../../../lib/paymentsSignup';
import { loadOwnMembership } from '../../../../lib/leagueParticipation';

const { id } = Astro.params;
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.request.url)}`, 302);
}

const supabase = createSupabaseClient({
  request: Astro.request,
  cookies: Astro.cookies,
  locals: Astro.locals,
});

let detail = null;
let loadError: string | null = null;
try {
  detail = await leagueDetail(supabase, id!, user.id);
} catch (err: any) {
  loadError = err?.message ?? 'Could not load the league.';
}

// The signed-in player's own profile — the point of the page is that
// most of the form is already answered.
let profile: {
  display_name: string | null;
  handicap: number | null;
  phone: string | null;
} | null = null;
if (detail) {
  const { data } = await supabase
    .from('profiles')
    .select('display_name, handicap, phone')
    .eq('id', user.id)
    .maybeSingle();
  profile = (data as typeof profile) ?? null;
}

const league = detail?.league ?? null;

// Which event? `?slot=N`, else the next one not yet complete.
const slotRaw = Astro.url.searchParams.get('slot');
const slotParam = slotRaw === null ? null : Number(slotRaw);
const events = detail?.events ?? [];
const event = (slotParam !== null && Number.isInteger(slotParam)
    ? events.find((e) => e.slot_index === slotParam)
    : null)
  ?? events.find((e) => e.status !== 'complete')
  ?? events[0]
  ?? null;

// The player's existing answer for this slot, if any.
const myRsvp = event ? detail?.signups?.[event.slot_index] : undefined;

const eventDate = event?.week_of
  ? new Date(`${event.week_of}T12:00:00Z`).toLocaleDateString('en-US',
      { weekday: 'long', month: 'long', day: 'numeric' })
  : null;

// ── Season dues — only with PAYMENTS_ENABLED ─────────────────────
// With the flag off nothing below runs, `dues` stays null and the page
// renders exactly as it did before (steps 1–5 above are still the
// placeholder; step 5's inert button is untouched either way).
//
// Being on this page already means being on the league's roster —
// `leagueDetail` returns null otherwise — so the SEASON signup has
// happened (the join). Season dues hang off that, not off the
// per-event answer below, which is still inert.
//
// OPTIONAL BY DESIGN: nothing here blocks signing up. A commissioner
// may collect in cash and record it on the roster (W5).
//
// The amount is display only (`leagues.dues_cents` via leagueDues.ts).
// The Pay form posts exactly {scope, id, kind}; the server derives the
// price (contract §0 rule 1). Hidden entirely on `payments_disabled`.
const payMode = modeFor(Astro.locals as App.Locals);
let dues: SignupDues | null = null;
if (payMode !== 'off' && detail && id) {
  try {
    dues = await signupDuesStep({
      mode: payMode,
      payParam: Astro.url.searchParams.get('pay'),
      slotParam: Astro.url.searchParams.get('slot'),
      fixture: fixtureParam(payMode, Astro.url),
      listFixture: payMode === 'fixtures' ? Astro.url.searchParams.get('payments') : null,
      loadDues: () => loadPayable(supabaseFor(Astro as unknown as RouteCtx), 'league', id!),
      loadOwn: () => loadOwnMembership(supabaseFor(Astro as unknown as RouteCtx), id!, user.id),
      listPayments: (f) => listPayments({ locals: Astro.locals as App.Locals }, payMode, 'league', id!, f),
      withQuery,
    });
  } catch (err) {
    console.error('[app/league/signup] payments load failed', err);
  }
}
---

<BaseLayout title="Event sign-up · Bagpipe Golf">
  <main class="pagewrap pagewrap--narrow">
    {loadError && <div class="notice notice--warn">{loadError}</div>}
    {!detail && !loadError && (
      <div class="notice notice--warn">
        That league could not be found, or you are not on its roster.
      </div>
    )}

    {league && (
      <>
        <p class="pagewrap__eyebrow">{league.name}</p>
        <h1 class="pagewrap__title">Sign up for this event.</h1>
        <LeagueSubnav id={id!} active="signup" coachAccess={detail?.league.coach_access ?? false} />

        {!event && (
          <div class="notice notice--warn">
            No events are scheduled for this season yet. Check back once your
            commissioner has set the schedule.
          </div>
        )}

        {event && (
        <section class="evt">
          <div class="evt__main">
            <p class="evt__eyebrow">Event {event.slot_index + 1}</p>
            <h2 class="evt__name">{eventDate ?? `Event ${event.slot_index + 1}`}</h2>
            <p class="evt__meta">
              {[
                event.first_tee_at ? `First tee ${event.first_tee_at.slice(0, 5)}` : null,
                event.holes ? `${event.holes} holes` : null,
                event.tee ? `${event.tee} tees` : null,
              ].filter(Boolean).join(' · ') || 'Tee time and details to come'}
            </p>
          </div>
          <div class="evt__side">
            <span id="rsvpPill" class:list={['pill', myRsvp === 'in' && 'pill--in',
                               myRsvp === 'out' && 'pill--out']}>
              {myRsvp === 'in' ? "You're in"
                : myRsvp === 'out' ? "You're out"
                : 'No answer yet'}
            </span>
          </div>
        </section>
        )}

        {event && (
        <section class="blk">
          <h2 class="blk__h">Your details</h2>
          <dl class="known">
            <div><dt>Name</dt><dd>{profile?.display_name ?? '—'}</dd></div>
            <div><dt>Email</dt><dd>{user.email}</dd></div>
            <div>
              <dt>Handicap</dt>
              <dd>{profile?.handicap != null ? profile.handicap : 'not set'}</dd>
            </div>
          </dl>
          <p class="hint">
            Something wrong? Update it in <a href="/app/profile">Profile</a>.
          </p>
        </section>
        )}

        {event && (event.status === 'complete' ? (
          <p class="notice">This event has already been played.</p>
        ) : (
          <section class="blk" id="rsvp" data-league={id} data-slot={event.slot_index}>
            <h2 class="blk__h">Are you playing?</h2>
            <div id="rsvpMsg" class="notice" hidden></div>
            <div class="rsvp">
              <button type="button" class="btn btn--primary" data-status="in">I'm in</button>
              <button type="button" class="btn btn--ghost" data-status="out">Can't make it</button>
            </div>
            <p class="hint">You can change your answer until the event is played.</p>
          </section>
        ))}

        {dues && (
          <section class="blk" id="dues-step">
            <h2 class="blk__h">Season dues</h2>
            <p class="hint">
              <strong>Optional.</strong> You&rsquo;re on the roster whether or
              not you pay here &mdash; your commissioner may collect dues in
              cash instead.
            </p>
            <PayButton
              nothing={dues.nothing}
              scope="league"
              id={id!}
              amountLabel={dues.amountLabel}
              paid={dues.paid}
              refunded={dues.refunded}
              notice={dues.notice}
              action={dues.action}
            />
          </section>
        )}
      </>
    )}
  </main>

  <script>
    const box = document.getElementById('rsvp');
    const msg = document.getElementById('rsvpMsg');
    const pill = document.getElementById('rsvpPill');
    box?.querySelectorAll('button[data-status]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const status = (btn as HTMLButtonElement).dataset.status;
        const buttons = box.querySelectorAll('button');
        buttons.forEach((b) => ((b as HTMLButtonElement).disabled = true));
        msg!.hidden = true;
        try {
          const res = await fetch(`/api/leagues/${encodeURIComponent(box.dataset.league!)}/rsvp`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slot: Number(box.dataset.slot), status }),
          });
          const body = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(body.error || 'Could not save your answer.');
          pill!.textContent = status === 'in' ? "You're in" : "You're out";
          pill!.className = 'pill ' + (status === 'in' ? 'pill--in' : 'pill--out');
          msg!.className = 'notice';
          msg!.textContent = status === 'in'
            ? (body.field_error
                ? `You're in. We couldn't add you to the event's field yet (${body.field_error}). Your commissioner can add you.`
                : "You're in. See you on the tee.")
            : "Got it — you're out for this one.";
          msg!.hidden = false;
        } catch (err) {
          msg!.className = 'notice notice--warn';
          msg!.textContent = (err as Error).message;
          msg!.hidden = false;
        } finally {
          buttons.forEach((b) => ((b as HTMLButtonElement).disabled = false));
        }
      });
    });
  </script>

  <style>
    .blk { margin: 0 0 30px; }
    .blk__h {
      font-size: 0.9375rem; margin: 0 0 4px;
      padding-bottom: 6px; border-bottom: 1px solid var(--line, #dfe6e2);
    }
    .hint {
      font-size: 0.78125rem; color: var(--ink-muted, #4b5b54);
      margin: 6px 0 12px; line-height: 1.55;
    }
    .muted { color: var(--ink-muted, #4b5b54); }

    .known, .fees { margin: 0 0 12px; }
    .known > div, .fees__row {
      display: flex; justify-content: space-between; gap: 14px;
      padding: 7px 0; border-bottom: 1px solid var(--line, #dfe6e2);
    }
    .known dt, .fees__row dt {
      font-size: 0.8125rem; color: var(--ink-muted, #4b5b54); margin: 0;
    }
    .known dd, .fees__row dd {
      font-size: 0.8125rem; font-weight: 600; margin: 0;
      font-variant-numeric: tabular-nums; text-align: right;
    }
    .fees__row dt em { font-style: normal; opacity: 0.75; }
    .fees__row--total {
      border-bottom: none; border-top: 2px solid var(--line, #dfe6e2);
      padding-top: 10px; margin-top: 2px;
    }
    .fees__row--total dt, .fees__row--total dd {
      font-size: 0.9375rem; color: var(--ink, #16231d); font-weight: 700;
    }

    .field { display: block; margin: 0 0 14px; }
    .field > span { display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 4px; }
    .field > span em { font-style: normal; font-weight: 400; opacity: 0.7; }
    .field input, .field select, .field textarea {
      width: 100%; box-sizing: border-box; font-size: 0.8125rem; padding: 7px 8px;
    }
    .field input:disabled, .field select:disabled, .field textarea:disabled {
      background: var(--wash, #f3f6f4); cursor: not-allowed;
    }
    .fieldnote {
      display: block; font-style: normal; font-size: 0.75rem;
      color: var(--ink-muted, #4b5b54); margin-top: 4px; line-height: 1.5;
    }

    .rsvp { display: flex; gap: 10px; flex-wrap: wrap; }

    .evt {
      display: flex; flex-wrap: wrap; gap: 12px;
      justify-content: space-between; align-items: flex-start;
      border: 1px solid var(--line, #dfe6e2); border-radius: 8px;
      padding: 14px 16px; margin: 0 0 10px;
    }
    .evt__main { min-width: 0; }
    .evt__eyebrow {
      font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em;
      color: var(--ink-muted, #4b5b54); margin: 0 0 2px;
    }
    .evt__name { font-size: 1.0625rem; margin: 0 0 4px; }
    .evt__meta {
      font-size: 0.78125rem; color: var(--ink-muted, #4b5b54);
      margin: 0; line-height: 1.5;
    }
    .evt__side { flex: none; }
    .pill {
      display: inline-block; font-size: 0.75rem; font-weight: 600;
      padding: 4px 10px; border-radius: 999px;
      border: 1px solid var(--line, #dfe6e2);
      color: var(--ink-muted, #4b5b54);
    }
    .pill--in { background: #1f6f43; border-color: #1f6f43; color: #fff; }
    .pill--out { background: var(--wash, #f3f6f4); }

  </style>
</BaseLayout>
