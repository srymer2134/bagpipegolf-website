---
// Sign up for one league EVENT — PLACEHOLDER, no payment is taken.
//
// Sam 2026-10-02: modelled on how City Park Players Club collects
// sign-ups through Unknown Golf
// (`league.unknowngolf.com/signUpQuestionnaire.jsp`).
//
// 🚨 SCOPE, CORRECTED. Their page is "CPPC Tournament #12: October 11 -
// 10am" — ONE EVENT INSIDE A SEASON, not the season itself. Sam pointed
// this out and it decides the data model, so it is worth stating:
//
//   * a season has slots (`league_weeks` / `leagues.schedule`)
//   * a slot may be BOUND to a tournament —
//     `schedule.bindings[slot]` → `tournaments.id`
//   * a player's per-event answer already exists: a `league_signups`
//     row keyed (league_id, user_id, slot_index) with a status
//
// So the fee is PER EVENT, and the existing `EntryFee` model
// (`tournament_id`, `amount_cents`, `due_date`) is already the right
// shape — a league event IS a tournament. **No new league dues column
// is needed for this flow**, which is the opposite of what reading
// their page as a season sign-up suggested.
//
// 🚨 NOTHING HERE CHARGES ANYONE. The fee block is illustrative and the
// pay button is inert. The real seam already exists and is flag-gated —
// see "What connecting Stripe actually needs" at the bottom of the page
// and `FeatureFlags.stripeEnabled` in the Flutter repo.
//
// WHAT THEIR FORM ASKS, AND WHY OURS IS SHORTER
//
// Unknown Golf's questionnaire collects 17 fields: gender, first/last
// name, suffix, email, handle, mobile, USGA handicap id, a PHOTO of the
// handicap card, date of birth, age, tee box, division, team partners
// (each repeating most of the above), team name, tee time, promo code,
// entry fee, comments.
//
// It has to. There is no account behind it — every sign-up starts from
// nothing, every season, for every event.
//
// We already know the player. So the honest replication is not
// "reproduce 17 fields"; it is "ask only what the event adds". That is
// the section split below: what we know (read-only, from the profile)
// versus what the event needs (the only things anyone types).
//
// Deliberately NOT copied:
//   * handicap-card photo upload — we hold a handicap and a GHIN id on
//     the profile; a photo is a manual-verification workflow we have no
//     reviewer for, so it would collect a liability and change nothing.
//   * age, computed from DOB — we only need DOB where an age division
//     exists, and then the division is what matters, not the number.
//   * separate gender field — the field_gender / tee resolution already
//     carries this where it affects play.

import BaseLayout from '../../../../layouts/BaseLayout.astro';
import LeagueSubnav from '../../../../components/LeagueSubnav.astro';
import { createSupabaseClient } from '../../../../lib/supabase';
import { leagueDetail } from '../../../../lib/leaguePortal';

const { id } = Astro.params;
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.request.url)}`, 302);
}

const supabase = createSupabaseClient({
  request: Astro.request,
  cookies: Astro.cookies,
  locals: Astro.locals,
});

let detail = null;
let loadError: string | null = null;
try {
  detail = await leagueDetail(supabase, id!, user.id);
} catch (err: any) {
  loadError = err?.message ?? 'Could not load the league.';
}

// The signed-in player's own profile — the point of the page is that
// most of the form is already answered.
let profile: {
  display_name: string | null;
  handicap: number | null;
  phone: string | null;
} | null = null;
if (detail) {
  const { data } = await supabase
    .from('profiles')
    .select('display_name, handicap, phone')
    .eq('id', user.id)
    .maybeSingle();
  profile = (data as typeof profile) ?? null;
}

const league = detail?.league ?? null;

// Which event? `?slot=N`, else the next one not yet complete.
const slotRaw = Astro.url.searchParams.get('slot');
const slotParam = slotRaw === null ? null : Number(slotRaw);
const events = detail?.events ?? [];
const event = (slotParam !== null && Number.isInteger(slotParam)
    ? events.find((e) => e.slot_index === slotParam)
    : null)
  ?? events.find((e) => e.status !== 'complete')
  ?? events[0]
  ?? null;

// The tournament this slot is bound to, if the director bound one.
// That id is what an `EntryFee` row keys on.
const boundTournamentId = event
  ? (detail?.schedule?.bindings?.[String(event.slot_index)] ?? null)
  : null;

// The player's existing answer for this slot, if any.
const myRsvp = event ? detail?.signups?.[event.slot_index] : undefined;

const eventDate = event?.week_of
  ? new Date(`${event.week_of}T12:00:00Z`).toLocaleDateString('en-US',
      { weekday: 'long', month: 'long', day: 'numeric' })
  : null;

// ── Illustrative figures ────────────────────────────────────────
// Hard-coded ON PURPOSE and labelled as such in the UI. There is no
// season-dues column on `leagues` yet — only the weekly pot columns
// (`pot_skins_entry`, `pot_ctp_entry`, `pot_ld_entry` from migration
// 20261017) and the tournament-scoped `EntryFee` model
// (`amount_cents`, `due_date`). Inventing a dues column here to make a
// placeholder look real is how a placeholder becomes a schema.
const EXAMPLE = {
  entryFeeCents: 2500,
  greensFeeCents: 3500,
  potSkinsCents: 1000,
  potCtpCents: 500,
};
const money = (cents: number) =>
  `$${(cents / 100).toFixed(2).replace(/\.00$/, '')}`;

// Only the entry fee would run through Bagpipe. Greens fees and pots
// are listed so the real cost of turning up is visible, and flagged so
// nobody expects a card charge to cover them.
const feeRows = [
  { label: 'Event entry', value: money(EXAMPLE.entryFeeCents), note: 'collected by the league', viaApp: true },
  { label: 'Greens fee', value: money(EXAMPLE.greensFeeCents), note: 'paid at the course', viaApp: false },
  { label: 'Skins pot', value: money(EXAMPLE.potSkinsCents), note: 'optional, on the day', viaApp: false },
  { label: 'Closest to the pin', value: money(EXAMPLE.potCtpCents), note: 'optional, on the day', viaApp: false },
];
const dueNowCents = EXAMPLE.entryFeeCents;
---

<BaseLayout title="League sign-up · Bagpipe Golf">
  <main class="pagewrap pagewrap--narrow">
    {loadError && <div class="notice notice--warn">{loadError}</div>}
    {!detail && !loadError && (
      <div class="notice notice--warn">
        That league could not be found, or you are not on its roster.
      </div>
    )}

    {league && (
      <>
        <p class="pagewrap__eyebrow">{league.name}</p>
        <h1 class="pagewrap__title">Sign up for this event.</h1>
        <LeagueSubnav id={id!} active="signup" />

        <div class="notice notice--warn ph">
          <strong>Placeholder.</strong> Shows the shape of signing up for one
          league event and <strong>takes no payment</strong>. Figures are
          examples, not this league's real fees. Card payment arrives with
          Stripe; what that needs is listed at the bottom.
        </div>

        {!event && (
          <div class="notice notice--warn">
            This season has no events scheduled yet, so there is nothing to
            sign up for. Add a season on
            <a href={`/app/leagues/${id}/schedule`}> Schedule</a> first.
          </div>
        )}

        {event && (
        <section class="evt">
          <div class="evt__main">
            <p class="evt__eyebrow">Event {event.slot_index + 1}</p>
            <h2 class="evt__name">{eventDate ?? `Slot ${event.slot_index + 1}`}</h2>
            <p class="evt__meta">
              {[
                event.first_tee_at ? `first tee ${event.first_tee_at}` : null,
                event.holes ? `${event.holes} holes` : null,
                event.tee ? `${event.tee} tees` : null,
                event.course_id ?? null,
              ].filter(Boolean).join(' · ') || 'Details not set yet'}
            </p>
          </div>
          <div class="evt__side">
            <span class:list={['pill', myRsvp === 'in' && 'pill--in',
                               myRsvp === 'out' && 'pill--out']}>
              {myRsvp === 'in' ? 'You are in'
                : myRsvp === 'out' ? 'You are out'
                : 'No answer yet'}
            </span>
          </div>
        </section>
        )}

        {event && (
        <p class="hint">
          Their page is one event &mdash; <em>"CPPC Tournament #12: October 11
          - 10am"</em> &mdash; not a season. Ours is the same: you answer per
          event, and a season's answers live in <code>league_signups</code>
          keyed by slot. {boundTournamentId
            ? 'This slot is bound to a tournament, which is what an entry fee would attach to.'
            : 'This slot has no tournament bound yet, so there is nothing for an entry fee to attach to.'}
        </p>
        )}

        {/* ── 1. What we already know ─────────────────────────── */}
        <section class="blk">
          <h2 class="blk__h">1 &middot; Your details</h2>
          <p class="hint">
            Already on your profile &mdash; nothing to re-type. Change any of
            it in <a href="/app/profile">Profile</a> and it follows you into
            every league and event.
          </p>
          <dl class="known">
            <div><dt>Name</dt><dd>{profile?.display_name ?? '—'}</dd></div>
            <div><dt>Email</dt><dd>{user.email}</dd></div>
            <div>
              <dt>Handicap</dt>
              <dd>{profile?.handicap != null ? profile.handicap : 'not set'}</dd>
            </div>
            <div>
              <dt>Mobile</dt>
              <dd>{profile?.phone ?? <span class="muted">not set — optional</span>}</dd>
            </div>
          </dl>
          <p class="hint">
            Unknown Golf asks City Park players for name, email, phone,
            handicap, date of birth and a photo of their handicap card
            <em>every single sign-up</em>, because there is no account behind
            the form. This is the part we do not have to ask.
          </p>
        </section>

        {/* ── 2. What the event actually adds ─────────────────── */}
        <section class="blk">
          <h2 class="blk__h">2 &middot; What this event needs</h2>
          <p class="hint">The only things anyone types.</p>

          <label class="field">
            <span>Tee box you'll play</span>
            <select disabled>
              <option>Select a tee —</option>
            </select>
            <em class="fieldnote">
              Populated from the event's course once the director sets
              one{event?.course_id ? '' : ' — this event has no course yet'}.
            </em>
          </label>

          <label class="field">
            <span>Division / flight <em>optional</em></span>
            <select disabled>
              <option>Director decides from handicaps —</option>
            </select>
            <em class="fieldnote">
              Leagues already compute flights from handicap
              (<code>flight_count</code>), so this is a request, not an
              assignment.
            </em>
          </label>

          <label class="field">
            <span>GHIN / USGA handicap ID <em>optional</em></span>
            <input type="text" placeholder="e.g. 1234567" disabled />
            <em class="fieldnote">
              Only useful once GHIN sync is live. No card photo &mdash; we
              would have nobody to review it.
            </em>
          </label>

          <label class="field">
            <span>Anything the director should know <em>optional</em></span>
            <textarea rows="3" placeholder="Can't make the first two weeks…" disabled></textarea>
          </label>
        </section>

        {/* ── 3. Partner, only when the format needs one ──────── */}
        <section class="blk">
          <h2 class="blk__h">3 &middot; Your partner</h2>
          <p class="hint">
            Shown only for a team format. This league is
            <strong> {league.points_model ?? 'not yet configured'}</strong>
            {league.points_model === 'match_play'
              ? ' — a two-player team league, so a partner is required.'
              : ' — no partner needed.'}
          </p>
          <label class="field">
            <span>Partner</span>
            <input type="text" placeholder="Search the roster, or invite by email" disabled />
            <em class="fieldnote">
              Roster search first, then an email invite &mdash; the same
              invite path the app already uses, so an unregistered partner
              gets a real account rather than a typed-in name.
            </em>
          </label>
        </section>

        {/* ── 4. Money ───────────────────────────────────────── */}
        <section class="blk">
          <h2 class="blk__h">4 &middot; What it costs</h2>
          <p class="hint">
            <strong>Example figures.</strong> Only the entry fee would run
            through Bagpipe &mdash; the rest is listed so the real cost of
            turning up is visible.
          </p>
          <dl class="fees">
            {feeRows.map((r) => (
              <div class="fees__row">
                <dt>
                  {r.label} <em>{r.note}</em>
                  {!r.viaApp && <span class="offapp">not via Bagpipe</span>}
                </dt>
                <dd>{r.value}</dd>
              </div>
            ))}
            <div class="fees__row fees__row--total">
              <dt>Due now</dt>
              <dd>{money(dueNowCents)}</dd>
            </div>
          </dl>
          <label class="field">
            <span>Promo code <em>optional</em></span>
            <input type="text" placeholder="CPPC2026" disabled />
          </label>
          <p class="hint">
            An entry fee is per event, which is exactly the shape the existing
            <code>EntryFee</code> model already has &mdash;
            <code>tournament_id</code>, <code>amount_cents</code>,
            <code>due_date</code>. A league event <em>is</em> a tournament, so
            nothing new is needed to store this.
          </p>
        </section>

        {/* ── 5. The payment step, inert ──────────────────────── */}
        <section class="blk">
          <h2 class="blk__h">5 &middot; Payment</h2>
          <div class="pay">
            <div class="pay__amt">{money(dueNowCents)}</div>
            <button type="button" class="btn btn--primary" disabled>
              Pay by card
            </button>
            <p class="pay__note">
              Inert. No charge is possible from this page &mdash; there is no
              payment provider connected.
            </p>
          </div>
          <p class="hint">
            The alternative we should keep either way: a director marks a
            player paid by cash or transfer. Unknown Golf's flow ends in
            "pending approval" for exactly this reason, and most club money
            still moves offline.
          </p>
        </section>

        <button type="button" class="btn btn--primary btn--wide" disabled>
          I'm in for this event
        </button>
        <p class="hint">
          Would write the <code>league_signups</code> row for this slot and
          notify the director &mdash; the same two-step Unknown Golf uses
          ("pending approval", then a confirmation email). Inert here.
        </p>

        {/* ── What Stripe actually needs ──────────────────────── */}
        <section class="blk blk--gates">
          <h2 class="blk__h">What connecting Stripe actually needs</h2>
          <p class="hint">
            The client seam is already built and flag-gated in the app &mdash;
            <code>PaymentsService</code> with a working mock,
            <code>EntryFee</code> and <code>TournamentPayment</code> models, a
            payments screen, and <code>FeatureFlags.stripeEnabled</code>. It is
            off behind three named gates, none of which are code:
          </p>
          <ol class="gates">
            <li><strong>The <code>/api/payments/*</code> endpoints</strong> on Railway (Patrick) &mdash; Track B plan, phases 1&ndash;2.</li>
            <li><strong>Phase 0.3 legal review.</strong> Taking money for someone else's league has terms, refund and liability consequences.</li>
            <li><strong><code>STRIPE_PUBLISHABLE_KEY</code></strong> set in the environment.</li>
          </ol>
          <p class="hint">
            <strong>Per-event fees need no new schema.</strong>
            <code>EntryFee</code> is already keyed on
            <code>tournament_id</code>, and a bound league event is a
            tournament. A <em>season</em>-wide dues charge would be the thing
            needing a new column &mdash; worth knowing which of the two
            City Park actually runs before building either.
          </p>
          <p class="hint">
            The existing scope note still holds: entry fees only &mdash;
            <strong>side-game settlement stays off-app</strong>. The pots
            above are marked accordingly.
          </p>
        </section>
      </>
    )}
  </main>

  <style>
    .ph { margin: 0 0 26px; }
    .blk { margin: 0 0 30px; }
    .blk__h {
      font-size: 0.9375rem; margin: 0 0 4px;
      padding-bottom: 6px; border-bottom: 1px solid var(--line, #dfe6e2);
    }
    .blk--gates {
      background: var(--wash, #f3f6f4); border-radius: 8px;
      padding: 14px 16px; margin-top: 36px;
    }
    .hint {
      font-size: 0.78125rem; color: var(--ink-muted, #4b5b54);
      margin: 6px 0 12px; line-height: 1.55;
    }
    .muted { color: var(--ink-muted, #4b5b54); }

    .known, .fees { margin: 0 0 12px; }
    .known > div, .fees__row {
      display: flex; justify-content: space-between; gap: 14px;
      padding: 7px 0; border-bottom: 1px solid var(--line, #dfe6e2);
    }
    .known dt, .fees__row dt {
      font-size: 0.8125rem; color: var(--ink-muted, #4b5b54); margin: 0;
    }
    .known dd, .fees__row dd {
      font-size: 0.8125rem; font-weight: 600; margin: 0;
      font-variant-numeric: tabular-nums; text-align: right;
    }
    .fees__row dt em { font-style: normal; opacity: 0.75; }
    .fees__row--total {
      border-bottom: none; border-top: 2px solid var(--line, #dfe6e2);
      padding-top: 10px; margin-top: 2px;
    }
    .fees__row--total dt, .fees__row--total dd {
      font-size: 0.9375rem; color: var(--ink, #16231d); font-weight: 700;
    }

    .field { display: block; margin: 0 0 14px; }
    .field > span { display: block; font-size: 0.8125rem; font-weight: 600; margin-bottom: 4px; }
    .field > span em { font-style: normal; font-weight: 400; opacity: 0.7; }
    .field input, .field select, .field textarea {
      width: 100%; box-sizing: border-box; font-size: 0.8125rem; padding: 7px 8px;
    }
    .field input:disabled, .field select:disabled, .field textarea:disabled {
      background: var(--wash, #f3f6f4); cursor: not-allowed;
    }
    .fieldnote {
      display: block; font-style: normal; font-size: 0.75rem;
      color: var(--ink-muted, #4b5b54); margin-top: 4px; line-height: 1.5;
    }

    .pay {
      border: 1px dashed var(--line, #dfe6e2); border-radius: 8px;
      padding: 16px; text-align: center;
    }
    .pay__amt {
      font-size: 1.75rem; font-weight: 700;
      font-variant-numeric: tabular-nums; margin-bottom: 10px;
    }
    .pay__note {
      font-size: 0.75rem; color: var(--ink-muted, #4b5b54);
      margin: 10px 0 0;
    }
    .btn--wide { width: 100%; }

    .evt {
      display: flex; flex-wrap: wrap; gap: 12px;
      justify-content: space-between; align-items: flex-start;
      border: 1px solid var(--line, #dfe6e2); border-radius: 8px;
      padding: 14px 16px; margin: 0 0 10px;
    }
    .evt__main { min-width: 0; }
    .evt__eyebrow {
      font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em;
      color: var(--ink-muted, #4b5b54); margin: 0 0 2px;
    }
    .evt__name { font-size: 1.0625rem; margin: 0 0 4px; }
    .evt__meta {
      font-size: 0.78125rem; color: var(--ink-muted, #4b5b54);
      margin: 0; line-height: 1.5;
    }
    .evt__side { flex: none; }
    .pill {
      display: inline-block; font-size: 0.75rem; font-weight: 600;
      padding: 4px 10px; border-radius: 999px;
      border: 1px solid var(--line, #dfe6e2);
      color: var(--ink-muted, #4b5b54);
    }
    .pill--in { background: #1f6f43; border-color: #1f6f43; color: #fff; }
    .pill--out { background: var(--wash, #f3f6f4); }

    .offapp {
      display: inline-block; font-size: 0.6875rem; font-style: normal;
      margin-left: 6px; padding: 1px 6px; border-radius: 4px;
      background: var(--wash, #f3f6f4); color: var(--ink-muted, #4b5b54);
      border: 1px solid var(--line, #dfe6e2);
    }
    .gates { margin: 0 0 10px; padding-left: 20px; }
    .gates li { font-size: 0.8125rem; margin-bottom: 6px; line-height: 1.55; }
  </style>
</BaseLayout>
