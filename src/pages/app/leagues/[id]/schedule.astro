---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import LeagueSubnav from '../../../../components/LeagueSubnav.astro';

const { id } = Astro.params;
---

<BaseLayout title={`Schedule · League ${id} · Bagpipe Golf`}>
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">League · schedule</p>
    <h1 class="pagewrap__title">Season schedule.</h1>
    <p class="pagewrap__sub">Weekly events, formats, courses, RSVPs.</p>

    <LeagueSubnav id={id!} active="schedule" />

    <section class="grid grid--2">
      <article class="card">
        <span class="chip chip--muted">Coming soon</span>
        <h3>Upcoming</h3>
        <p>Date, course, format, your RSVP.</p>
      </article>
      <article class="card">
        <span class="chip chip--muted">Coming soon</span>
        <h3>Completed</h3>
        <p>Past weeks with results.</p>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .card h3 {
    font-size: 17px;
    color: var(--brand-green-dark);
    margin: 8px 0 4px;
  }
  .card p { margin: 0; color: var(--ink-muted); font-size: 14px; }
</style>
