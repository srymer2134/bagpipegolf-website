---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import LeagueSubnav from '../../../../components/LeagueSubnav.astro';
import { createSupabaseClient } from '../../../../lib/supabase';
import { leagueDetail, rsvpLabel, type PortalDetail } from '../../../../lib/leaguePortal';
import { dateLabel } from '../../../../lib/leaguePublic';

const { id } = Astro.params;
const user = (Astro.locals as App.Locals).user;

let d: PortalDetail | null = null;
let failed = false;
try {
  const supabase = createSupabaseClient({
    request: Astro.request,
    cookies: Astro.cookies,
    locals: Astro.locals as App.Locals,
  });
  if (id && user?.id) d = await leagueDetail(supabase, id, user.id);
} catch (err) {
  console.error('[app/league/schedule] load failed', err);
  failed = true;
}

const today = new Date().toISOString().slice(0, 10);
// `events` merges real league_weeks rows with dates derived from
// leagues.schedule — week rows are created lazily, so reading only
// those showed "no events" for any season that has not generated
// matchups yet.
const all = d?.events ?? [];
const upcoming = all.filter((w) => w.week_of >= today);
const completed = all.filter((w) => w.week_of < today).reverse();
const isDirector = d?.league.role === 'commissioner';
const sched = d?.schedule ?? null;

// The dates already stored on `league_weeks`, indexed by slot — the
// authority. A league that predates per-event dates has none, so the
// boxes fall back to the jsonb seed's derived series and the first
// save materialises them as real rows.
const existingDates: string[] = [];
for (const w of all) existingDates[w.slot_index] = w.week_of;
if (existingDates.length === 0 && sched?.startDate) {
  const [sy, sm, sd] = sched.startDate.split('-').map(Number);
  const every = Math.max(1, Number(sched.intervalDays) || 7);
  for (let k = 0; k < Math.min(Number(sched.eventCount) || 0, 52); k++) {
    const dt = new Date(Date.UTC(sy, sm - 1, sd));
    dt.setUTCDate(dt.getUTCDate() + every * k);
    existingDates[k] = dt.toISOString().slice(0, 10);
  }
}
---

<BaseLayout title={d ? `${d.league.name} schedule · Bagpipe Golf` : 'League schedule · Bagpipe Golf'}>
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">League · schedule</p>
    <h1 class="pagewrap__title">Season schedule.</h1>

    {!d ? (
      <section class="card">
        <h3>{failed ? "Couldn't load this league" : 'Not your league'}</h3>
        <a class="btn btn--primary" href="/app/leagues">Your leagues</a>
      </section>
    ) : (
      <>
        <p class="pagewrap__sub">{d.league.name} · your RSVP shown per event</p>
        <LeagueSubnav id={d.league.id} active="schedule" />

        {all.length === 0 && !isDirector && (
          <div class="notice">
            No events scheduled yet. Your league director sets the season's
            dates.
          </div>
        )}

        {isDirector && (
          <section class="card setup">
            <h3>{sched ? 'Edit the season' : 'Set up the season'}</h3>
            <p class="small muted">
              {sched
                ? 'Each event has its own date. Move one and the rest stay put. Tournaments you have bound to a slot are kept.'
                : 'How many events, and the dates you know. Leave the rest blank and add them later.'}
            </p>
            <div id="schedErr" class="notice notice--warn" hidden></div>
            <form id="schedForm">
              <label class="field">
                <span>Events this season</span>
                <input type="number" name="eventCount" id="evCount" min="2" max="52"
                       required value={sched?.eventCount ?? 8} />
              </label>

              <div class="dates" id="dateList"></div>

              <details class="helper">
                <summary>Space them out for me</summary>
                <div class="setupgrid">
                  <label class="field">
                    <span>Starting</span>
                    <input type="date" id="spaceFrom" value={sched?.startDate ?? today} />
                  </label>
                  <label class="field">
                    <span>Every&hellip; days</span>
                    <input type="number" id="spaceEvery" min="1" max="365"
                           value={sched?.intervalDays ?? 7} />
                  </label>
                </div>
                <button type="button" class="btn btn--ghost btn--sm" id="spaceBtn">
                  Fill the dates
                </button>
                <p class="small muted">
                  Only fills the boxes. Change any of them afterwards.
                </p>
              </details>

              <button type="submit" id="schedBtn" class="btn btn--primary">
                {sched ? 'Save schedule' : 'Create schedule'}
              </button>
            </form>
            <p class="small muted">
              Per-event course, tees and tee times are set in the app. An event
              that has already been played cannot be moved.
            </p>
          </section>
        )}

        {upcoming.length > 0 && (
          <section class="lsec">
            <h2 class="lsec__h">Upcoming</h2>
            <div class="scroll">
              <table class="tbl">
                <thead>
                  <tr><th>#</th><th>Date</th><th>Tee</th><th>Holes</th><th>First tee</th><th>You</th></tr>
                </thead>
                <tbody>
                  {upcoming.map((w) => (
                    <tr>
                      <td>{w.slot_index + 1}</td>
                      <td>{dateLabel(w.week_of)}</td>
                      <td>{w.tee ?? '—'}</td>
                      <td>{w.holes ?? '—'}</td>
                      <td>{w.first_tee_at ? w.first_tee_at.slice(0, 5) : '—'}</td>
                      <td class:list={[d.signups[w.slot_index] === 'in' && 'yes', d.signups[w.slot_index] === 'out' && 'no']}>
                        {rsvpLabel(d.signups[w.slot_index])}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="small muted">RSVP in the app — this portal reads it, it doesn't set it.</p>
            {d.weeks.length === 0 && (
              <p class="small muted">
                These dates come from the season settings. Course and tee times
                appear once the director sets them per event.
              </p>
            )}
          </section>
        )}

        {completed.length > 0 && (
          <section class="lsec">
            <h2 class="lsec__h">Completed</h2>
            <div class="scroll">
              <table class="tbl">
                <thead>
                  <tr><th>#</th><th>Date</th><th>Tee</th><th>Holes</th><th>Status</th><th>You</th></tr>
                </thead>
                <tbody>
                  {completed.map((w) => (
                    <tr>
                      <td>{w.slot_index + 1}</td>
                      <td>{dateLabel(w.week_of)}</td>
                      <td>{w.tee ?? '—'}</td>
                      <td>{w.holes ?? '—'}</td>
                      <td>{w.status === 'cancelled' ? 'Cancelled' : w.locked_at ? 'Locked' : 'Played'}</td>
                      <td class:list={[d.signups[w.slot_index] === 'in' && 'yes', d.signups[w.slot_index] === 'out' && 'no']}>
                        {rsvpLabel(d.signups[w.slot_index])}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}
      </>
    )}
  </main>
</BaseLayout>

<script is:inline define:vars={{ leagueId: id, existingDates }}>
  (() => {
    const form = document.getElementById('schedForm');
    if (!form) return;
    const btn = document.getElementById('schedBtn');
    const err = document.getElementById('schedErr');

    // One date box per event, seeded from the dates already stored on
    // `league_weeks` (the authority), falling back to the jsonb seed
    // for a league that predates per-event dates.
    const evCount = document.getElementById('evCount');
    const dateList = document.getElementById('dateList');
    const spaceFrom = document.getElementById('spaceFrom');
    const spaceEvery = document.getElementById('spaceEvery');
    const spaceBtn = document.getElementById('spaceBtn');

    function renderDates() {
      const n = Math.max(1, Math.min(52, Number(evCount.value) || 0));
      const keep = [...dateList.querySelectorAll('input[data-slot]')].map((i) => i.value);
      dateList.innerHTML = '';
      for (let i = 0; i < n; i++) {
        const row = document.createElement('label');
        row.className = 'field dates__row';
        const span = document.createElement('span');
        span.textContent = `Event ${i + 1}`;
        const input = document.createElement('input');
        input.type = 'date';
        input.dataset.slot = String(i);
        // An event already bridged to a played round is frozen by a DB
        // trigger. We do not grey it out here — the portal does not
        // fetch event_id — so the server reports it precisely instead
        // of this page guessing and disabling the wrong row.
        input.value = keep[i] || existingDates[i] || '';
        row.append(span, input);
        dateList.append(row);
      }
    }

    function fillSpaced() {
      const first = spaceFrom.value;
      const every = Math.max(1, Math.min(365, Number(spaceEvery.value) || 7));
      if (!/^\d{4}-\d{2}-\d{2}$/.test(first)) return;
      const [y, m, d] = first.split('-').map(Number);
      dateList.querySelectorAll('input[data-slot]').forEach((input, k) => {
        const dt = new Date(Date.UTC(y, m - 1, d));
        dt.setUTCDate(dt.getUTCDate() + every * k);
        input.value = dt.toISOString().slice(0, 10);
      });
    }

    evCount.addEventListener('input', renderDates);
    spaceBtn.addEventListener('click', fillSpaced);
    renderDates();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      btn.disabled = true;
      const label = btn.textContent;
      btn.textContent = 'Saving…';
      const fd = new FormData(form);
      try {
        const res = await fetch(`/api/leagues/${encodeURIComponent(leagueId)}/schedule`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            eventCount: Number(fd.get('eventCount') || 0),
            dates: [...dateList.querySelectorAll('input[data-slot]')].map((i) => i.value),
          }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          err.textContent = body.error || `Could not save (${res.status}).`;
          err.hidden = false;
          btn.disabled = false;
          btn.textContent = label;
          return;
        }
        if (body.weeksError) {
          err.textContent = body.weeksError;
          err.hidden = false;
          btn.disabled = false;
          btn.textContent = label;
          return;
        }
        window.location.reload();
      } catch {
        err.textContent = 'Network error. Please try again.';
        err.hidden = false;
        btn.disabled = false;
        btn.textContent = label;
      }
    });
  })();
</script>

<style>
  .dates { display: grid; gap: 6px; margin: 10px 0; }
  .dates__row { display: grid; grid-template-columns: 5.5rem 1fr; align-items: center; gap: 10px; }
  .dates__row span { font-size: 0.8125rem; color: var(--ink-muted, #4b5b54); }
  .helper { margin: 6px 0 12px; font-size: 0.875rem; }
  .helper summary { cursor: pointer; color: var(--brand-green-dark); }
  .helper > div, .helper > button, .helper > p { margin-top: 8px; }
  .btn--sm { padding: 6px 12px; font-size: 0.8125rem; }

  .card h3 { font-size: 1.0625rem; color: var(--brand-green-dark); margin: 8px 0 6px; }
  .lsec { margin-top: 28px; }
  .lsec__h {
    font-size: 0.9375rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--ink-muted, #4b5b54); margin: 0 0 10px;
  }
  .scroll { overflow-x: auto; }
  .tbl { border-collapse: collapse; width: 100%; font-size: 0.875rem; }
  .tbl th, .tbl td { text-align: left; padding: 7px 10px; border-bottom: 1px solid #e3e9e5; white-space: nowrap; }
  .tbl th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-muted, #4b5b54); }
  .tbl td { font-variant-numeric: tabular-nums; }
  .tbl td.yes { color: var(--brand-green-dark, #1f5b30); font-weight: 600; }
  .tbl td.no { color: #9a3b32; }
  .notice { padding: 14px 16px; border-radius: 12px; margin: 16px 0; line-height: 1.5; font-size: 0.875rem; background: #f4f7f5; border: 1px solid #e3e9e5; }
  .setup { margin: 16px 0 8px; }
  .setup h3 { font-size: 1rem; color: var(--brand-green-dark); margin: 0 0 4px; }
  .setupgrid {
    display: grid; grid-template-columns: 1.3fr .7fr .7fr auto;
    gap: 10px; align-items: end; margin-top: 10px;
  }
  @media (max-width: 640px) { .setupgrid { grid-template-columns: 1fr; } }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .field > span { font-size: 0.8125rem; color: var(--ink-muted, #4b5b54); }
  .field input {
    font: inherit; padding: 8px 10px; border: 1px solid #c8d4cd;
    border-radius: 8px; background: #fff; width: 100%;
  }
  .notice--warn { background: #fdecea; border: 1px solid #c4453a; color: #7d241c; }
  .small { font-size: 0.78125rem; }
  .muted { color: var(--ink-muted, #4b5b54); }
</style>
