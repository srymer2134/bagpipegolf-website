---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import LeagueSubnav from '../../../../components/LeagueSubnav.astro';
import { createSupabaseClient } from '../../../../lib/supabase';
import {
  leagueDetail, nextWeek, lastWeek, myPlayerRow, teamRows,
  standingsAvailability, rsvpLabel, visibilityLabel, type PortalDetail,
} from '../../../../lib/leaguePortal';
import { dateLabel, fmtPts } from '../../../../lib/leaguePublic';
import PayButton from '../../../../components/payments/PayButton.astro';
import { formatDuesLine } from '../../../../lib/leagueDues';
import { checkoutNotice, payNoticeCode, settledRowFor } from '../../../../lib/payments';
import { fixtureParam, listPayments, modeFor } from '../../../../lib/paymentsServer';
import { loadPayable, supabaseFor, withQuery, type RouteCtx } from '../../../../lib/paymentsRoutes';

const { id } = Astro.params;
const user = (Astro.locals as App.Locals).user;

let d: PortalDetail | null = null;
let failed = false;
try {
  const supabase = createSupabaseClient({
    request: Astro.request,
    cookies: Astro.cookies,
    locals: Astro.locals as App.Locals,
  });
  if (id && user?.id) d = await leagueDetail(supabase, id, user.id);
} catch (err) {
  console.error('[app/league] load failed', err);
  failed = true;
}

const next = d ? nextWeek(d.weeks) : null;
const last = d ? lastWeek(d.weeks) : null;
const myName = d && user?.id ? d.memberNames[user.id] : null;
const me = d ? myPlayerRow(d.snapshot?.standings, myName) : null;
const rows = d ? teamRows(d.snapshot?.standings) : [];
const avail = d ? standingsAvailability(d.league, d.snapshot) : 'ok';
const played = d ? d.weeks.filter((w) => w.week_of < new Date().toISOString().slice(0, 10)).length : 0;

// W3 — "Pay season dues". Nothing below runs unless PAYMENTS_ENABLED:
// with the flag off `pay` stays null and no Pay control renders. Shown
// only when the league has dues set; the amount is display-only (the
// server derives what is charged).
const payMode = modeFor(Astro.locals as App.Locals);
let pay: { amountLabel: string; paid: boolean; action: string; notice: ReturnType<typeof checkoutNotice> } | null = null;
if (payMode !== 'off' && d && id) {
  try {
    const payable = await loadPayable(supabaseFor(Astro as unknown as RouteCtx), 'league', id);
    const amountLabel = formatDuesLine(payable?.duesCents, payable?.duesDueDate);
    if (amountLabel) {
      const fixture = fixtureParam(payMode, Astro.url);
      const list = await listPayments({ locals: Astro.locals as App.Locals }, payMode, 'league', id,
        payMode === 'fixtures' ? Astro.url.searchParams.get('payments') : null);
      pay = {
        amountLabel,
        paid: list.ok ? settledRowFor(list.data.payments, 'season_dues') !== null : false,
        action: withQuery('/api/payments/checkout-session', { fixture }),
        notice: checkoutNotice(payNoticeCode(Astro.url.searchParams.get('pay')), 'league'),
      };
    }
  } catch (err) {
    console.error('[app/league] payments load failed', err);
  }
}
---

<BaseLayout title={d ? `${d.league.name} · Bagpipe Golf` : 'League · Bagpipe Golf'}>
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">League</p>
    <h1 class="pagewrap__title">{d ? d.league.name : 'League'}</h1>

    {!d ? (
      <section class="card">
        <h3>{failed ? "Couldn't load this league" : 'Not your league'}</h3>
        <p>
          {failed
            ? 'Try again in a moment.'
            : "You're not a member of this league, so there's nothing here. Ask the commissioner for the join code."}
        </p>
        <a class="btn btn--primary" href="/app/leagues">Your leagues</a>
      </section>
    ) : (
      <>
        <p class="pagewrap__sub">
          {d.league.role === 'commissioner' ? 'You run this league. ' : ''}
          {d.weeks.length} {d.weeks.length === 1 ? 'event' : 'events'} · {played} played
        </p>
        <LeagueSubnav id={d.league.id} active="overview" />

        {pay && (
          <PayButton
            scope="league"
            id={d.league.id}
            amountLabel={pay.amountLabel}
            paid={pay.paid}
            notice={pay.notice}
            action={pay.action}
          />
        )}

        <section class="grid grid--2">
          <article class="card">
            <span class="chip">Season at a glance</span>
            <h3>{d.weeks.length} events · {played} played</h3>
            <dl class="kv">
              <div><dt>Scoring</dt><dd>{d.league.points_model ?? '—'}</dd></div>
              {d.league.week_format && <div><dt>Format</dt><dd>{d.league.week_format}</dd></div>}
              <div><dt>Public page</dt><dd>{visibilityLabel(d.league.page_visibility)}</dd></div>
            </dl>
          </article>

          <article class="card">
            <span class="chip">Your position</span>
            {me ? (
              <>
                <h3>{me.place}{['st', 'nd', 'rd'][me.place - 1] ?? 'th'} · {fmtPts(me.row.total)} pts</h3>
                <dl class="kv">
                  <div><dt>Weeks played</dt><dd>{me.row.weeks_played}</dd></div>
                  <div><dt>Absent</dt><dd>{me.row.weeks_absent}</dd></div>
                  <div><dt>As a sub</dt><dd>{me.row.weeks_as_sub}</dd></div>
                </dl>
              </>
            ) : (
              <>
                <h3 class="muted">Not in the standings yet</h3>
                <p>
                  {avail === 'model-not-supported'
                    ? "This league scores by position points, which aren't published to the web yet."
                    : "You'll appear once you've played a week that's been scored."}
                </p>
              </>
            )}
          </article>

          <article class="card">
            <span class="chip">Next event</span>
            {next ? (
              <>
                <h3>{dateLabel(next.week_of)}</h3>
                <dl class="kv">
                  {next.tee && <div><dt>Tees</dt><dd>{next.tee}</dd></div>}
                  {next.holes && <div><dt>Holes</dt><dd>{next.holes}</dd></div>}
                  {next.first_tee_at && <div><dt>First tee</dt><dd>{next.first_tee_at.slice(0, 5)}</dd></div>}
                  <div><dt>Your RSVP</dt><dd>{rsvpLabel(d.signups[next.slot_index])}</dd></div>
                </dl>
                <p class="small muted">RSVP in the app — the portal reads it.</p>
              </>
            ) : (
              <h3 class="muted">{d.weeks.length ? 'Season complete' : 'No events scheduled'}</h3>
            )}
          </article>

          <article class="card">
            <span class="chip">Recent week</span>
            {last ? (
              <>
                <h3>{dateLabel(last.week_of)}</h3>
                <dl class="kv">
                  <div><dt>Status</dt><dd>{last.locked_at ? 'Locked' : last.status}</dd></div>
                  <div><dt>Your RSVP</dt><dd>{rsvpLabel(d.signups[last.slot_index])}</dd></div>
                </dl>
                <a class="btn btn--ghost" href={`/app/leagues/${d.league.id}/schedule`}>Full schedule</a>
              </>
            ) : (
              <h3 class="muted">No events played yet</h3>
            )}
          </article>
        </section>

        {rows.length > 0 && (
          <section class="lsec">
            <h2 class="lsec__h">Top of the table</h2>
            <div class="scroll">
              <table class="tbl">
                <thead><tr><th>#</th><th>Team</th><th>Pts</th><th>W-L-T</th></tr></thead>
                <tbody>
                  {rows.slice(0, 5).map((r, i) => (
                    <tr>
                      <td>{i + 1}</td>
                      <td>{r.name}</td>
                      <td>{fmtPts(r.points)}</td>
                      <td>{r.wins}-{r.losses}-{r.ties}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <a class="btn btn--ghost" href={`/app/leagues/${d.league.id}/standings`}>Full standings</a>
          </section>
        )}
      </>
    )}
  </main>
</BaseLayout>

<style>
  .card h3 { font-size: 1.0625rem; color: var(--brand-green-dark); margin: 8px 0 6px; }
  .card h3.muted { color: var(--ink-muted); font-weight: 600; }
  .card p { margin: 0 0 6px; color: var(--ink-muted); font-size: 0.875rem; }
  .kv { margin: 0; display: flex; flex-direction: column; gap: 2px; }
  .kv div { display: flex; justify-content: space-between; gap: 12px; font-size: 0.875rem; }
  .kv dt { color: var(--ink-muted, #4b5b54); margin: 0; }
  .kv dd { margin: 0; font-variant-numeric: tabular-nums; }
  .lsec { margin-top: 28px; }
  .lsec__h {
    font-size: 0.9375rem; text-transform: uppercase; letter-spacing: .08em;
    color: var(--ink-muted, #4b5b54); margin: 0 0 10px;
  }
  .scroll { overflow-x: auto; }
  .tbl { border-collapse: collapse; width: 100%; font-size: 0.875rem; }
  .tbl th, .tbl td { text-align: left; padding: 7px 10px; border-bottom: 1px solid #e3e9e5; }
  .tbl th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-muted, #4b5b54); }
  .tbl td { font-variant-numeric: tabular-nums; }
  .small { font-size: 0.78125rem; }
  .muted { color: var(--ink-muted, #4b5b54); }
</style>
