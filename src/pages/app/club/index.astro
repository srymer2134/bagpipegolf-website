---
// /app/club — the entry point every club link used to share, now a
// router rather than a destination.
//
//   no club  → create one (a club is optional; this is the only page
//              in the product that says so)
//   one club → straight to its own page, query string intact
//   several  → a list
//
// The per-club page is /app/club/<id> (see [id].astro). Keeping this
// path working matters: /api/clubs/action 303s here after every
// mutation and /buy/club links here.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { loadClubPage } from '../../../lib/clubPage';
import { clubMessage } from '../../../lib/club';
import { clubHref } from '../../../lib/clubs';

const { clubs, loadFailed } = await loadClubPage(Astro);

// Exactly one club is the common case. Carry the query string so a
// post-checkout `?welcome=1` and an action's `?club=<code>` both
// survive the hop.
if (clubs.length === 1) {
  const search = Astro.url.search;
  return Astro.redirect(`${clubHref(clubs[0].org_id)}${search}`, 302);
}

const notice = clubMessage(Astro.url.searchParams.get('club'));
---

<BaseLayout title="Your clubs · Bagpipe Golf">
  <main class="pagewrap pagewrap--narrow">
    <p class="pagewrap__eyebrow">Club</p>
    <h1 class="pagewrap__title">{clubs.length ? 'Your clubs.' : 'Set up your club.'}</h1>

    {notice && <p class={`notice ${notice.good ? 'notice--good' : ''}`} role="status">{notice.text}</p>}
    {loadFailed && (
      <p class="pagewrap__sub">
        We couldn’t load your club just now. Nothing has changed — try again in a moment.
      </p>
    )}

    {!loadFailed && clubs.length === 0 && (
      <>
        <p class="pagewrap__sub">
          A club runs as many leagues as you like under one plan, with up to
          4 admins (you count as one). Each admin runs their own leagues; the
          club’s plan covers them all.
        </p>
        <p class="pagewrap__sub">
          You don’t need one to run a league or a tournament — a club is for
          running several of them together.
        </p>
        <form method="POST" action="/api/clubs/action" class="card stack">
          <input type="hidden" name="action" value="create" />
          <label class="field">
            <span>Club name</span>
            <input name="name" required maxlength="120" placeholder="e.g. Pine Valley Men’s Club" />
          </label>
          <button class="btn btn--primary" type="submit">Create the club</button>
        </form>
        <p class="pagewrap__fine">Got an invite from a club? Open the link in that email.</p>
      </>
    )}

    {clubs.length > 1 && (
      <ul class="clubs">
        {clubs.map((c) => (
          <li class="card clubs__item">
            <a class="clubs__link" href={clubHref(c.org_id)}>{c.name}</a>
            <span class="clubs__meta">
              {c.covered ? 'Plan active' : 'No plan yet'} ·
              {' '}{c.leagues.length} {c.leagues.length === 1 ? 'league' : 'leagues'} ·
              {' '}{c.seats_used} of {c.seats_max} seats
            </span>
          </li>
        ))}
      </ul>
    )}
  </main>
</BaseLayout>

<style>
  .stack { display: grid; gap: 12px; }
  .field { display: grid; gap: 6px; font-weight: 600; }
  .field input {
    font: inherit; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px;
  }
  .clubs { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 12px; }
  .clubs__item { display: grid; gap: 4px; }
  .clubs__link { font-size: 1.125rem; font-weight: 700; color: var(--brand-green-dark); }
  .clubs__meta { font-size: 0.875rem; color: var(--ink-muted); }
  .notice { margin: 0 0 14px; padding: 10px 14px; border-radius: 10px; border: 1px solid var(--line); background: rgba(180, 83, 9, 0.07); }
  .notice--good { background: var(--brand-green-pale); }
  .pagewrap__fine { margin: 0; font-size: 0.875rem; color: var(--ink-muted); }
</style>
