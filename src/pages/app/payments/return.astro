---
// `/app/payments/return?scope=&id=` — W2, plan step 3.5. Stripe's
// Account Link `return_url`.
//
// 🚨 RETURN ≠ COMPLETE. Stripe sends the owner here whether they
// finished, quit halfway, or are still waiting on verification. So
// this page re-reads §2.2 and shows what it says: "Ready" only when
// `charges_enabled`, otherwise "Continue setup". `charges_enabled`
// itself is flipped by the `account.updated` webhook (plan 3.3), not
// by anyone landing here.
//
// OFF unless PAYMENTS_ENABLED (404). Owner only, like W1.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MerchantSetup from '../../../components/payments/MerchantSetup.astro';
import { eventPath, merchantView, parseEntityId, parseScope, paymentsSetupPath } from '../../../lib/payments';
import { fixtureParam, getMerchant, modeFor, notFound } from '../../../lib/paymentsServer';
import { isOwner, loadPayable, supabaseFor, withQuery, type RouteCtx } from '../../../lib/paymentsRoutes';

const locals = Astro.locals as App.Locals;
const mode = modeFor(locals);
if (mode === 'off') return notFound();

const scope = parseScope(Astro.url.searchParams.get('scope'));
const id = parseEntityId(Astro.url.searchParams.get('id'));
if (!scope || !id) return notFound();

let payable = null;
try {
  payable = await loadPayable(supabaseFor(Astro as unknown as RouteCtx), scope, id);
} catch (err) {
  console.error('[app/payments/return] load failed', err);
}
if (!isOwner(payable, locals.user?.id)) return Astro.redirect(eventPath(scope, id), 302);

const fixture = fixtureParam(mode, Astro.url);
const res = await getMerchant({ locals }, mode, scope, id, fixture);
const neverOnboarded = !res.ok && res.code === 'merchant_not_ready';
const view = res.ok ? merchantView(res.data) : neverOnboarded ? merchantView(null) : null;
const action = withQuery('/api/merchants/onboard', { fixture });
const title = view?.state === 'ready' ? 'You’re set up.' : 'Back from Stripe.';
---

<BaseLayout title={`Card payments · ${payable!.name} · Bagpipe Golf`}>
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">{scope === 'league' ? 'League' : 'Tournament'} · card payments</p>
    <h1 class="pagewrap__title">{title}</h1>
    <p class="pagewrap__sub">{payable!.name}</p>
    <MerchantSetup
      scope={scope}
      id={id}
      name={payable!.name}
      view={view}
      loadFailed={!res.ok && !neverOnboarded}
      action={action}
    />
    <p class="pagewrap__sub">
      <a href={paymentsSetupPath(scope, id)}>Card payments settings</a> ·
      <a href={eventPath(scope, id)}>Back to {scope === 'league' ? 'the league' : 'the tournament'}</a>
    </p>
  </main>
</BaseLayout>
