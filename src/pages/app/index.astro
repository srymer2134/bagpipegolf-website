---
import { clubHref } from '../../lib/clubs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createSupabaseClient } from '../../lib/supabase';
import { listBets, formatVsPar, type RoundRow, type BetRow } from '../../lib/queries';
import { loadRoundsForDisplay } from '../../lib/spineRounds';
import { myLeagues, type MyLeague } from '../../lib/leaguePortal';
import {
  listMyTournaments,
  isCompleted,
  type TournamentRow,
} from '../../lib/tournamentQueries';

const user = Astro.locals.user!;

const supabase = createSupabaseClient({
  request: Astro.request,
  cookies: Astro.cookies,
  locals: Astro.locals,
});

let recentRounds: RoundRow[] = [];
let activeBets: BetRow[] = [];
let allTournaments: TournamentRow[] = [];
let myLeagueRows: MyLeague[] = [];
let loadError: string | null = null;
try {
  // Recent rounds come from the spine merged with the legacy table —
  // reading `public.rounds` alone showed nothing newer than
  // 2026-09-10. See lib/spineRounds.ts.
  const [recent, bets, tournaments, leagues] = await Promise.all([
    loadRoundsForDisplay(Astro, supabase, { limit: 4 }),
    listBets(supabase, { limit: 6, activeOnly: true }),
    listMyTournaments(supabase, { limit: 6 }),
    // The dashboard is meant to show everything you are part of on one
    // page, and leagues were the one thing missing from it: reachable
    // from the Manage shelf, never shown (Sam, 2026-11-13).
    user?.id ? myLeagues(supabase, user.id) : Promise.resolve([]),
  ]);
  recentRounds = recent.rows;
  activeBets = bets;
  allTournaments = tournaments;
  myLeagueRows = leagues;
} catch (err: any) {
  loadError = err?.message ?? 'Could not load dashboard.';
}

// Dashboard shows tournaments that aren't yet completed — the
// live / upcoming set is what a TD cares about mid-event.
const openTournaments = allTournaments.filter((t) => !isCompleted(t));

const fmtDate = (iso: string | null) => {
  if (!iso) return '—';
  const d = new Date(iso + (iso.length === 10 ? 'T12:00:00' : ''));
  if (isNaN(d.getTime())) return iso;
  return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
};

const playerNames = (b: BetRow) =>
  (b.players ?? [])
    .map((p) => (p?.name as string) || (p?.id as string) || '')
    .filter(Boolean);

// Clubs are optional and most accounts have none. When there is none
// the club section does not render AT ALL — not an empty state, not an
// upsell. A player who will never buy a Club plan should not get a
// club-shaped hole in their dashboard; /pricing is where it is sold.
const clubs = (Astro.locals as App.Locals).clubs ?? [];

// Seasons still running. A finished league belongs in its own list,
// not on a dashboard that answers "what is live right now".
const activeLeagues = myLeagueRows.filter((l) => !l.completed_at).slice(0, 6);
---

<BaseLayout title="Dashboard · Bagpipe Golf">
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">Dashboard</p>
    <h1 class="pagewrap__title">Welcome back.</h1>
    <p class="pagewrap__sub">
      Signed in as <strong>{user.email}</strong>
    </p>

    {loadError && <div class="errorbar">⚠️ {loadError}</div>}

    <section class="block">
      <header class="block__head">
        <h2 class="block__title">Your tournaments</h2>
        <a class="block__more" href="/app/tournaments">All tournaments →</a>
      </header>
      {openTournaments.length === 0 ? (
        <div class="empty">
          No active or upcoming tournaments. Start one at <a href="/app/tournaments/new">+ New tournament</a>, or create one in the Bagpipe Golf mobile app.
        </div>
      ) : (
        <div class="tourneys">
          {openTournaments.map((t) => (
            <a class="tourney" href={`/app/tournaments/${t.id}/leaderboard`}>
              <div class="tourney__head">
                <h3 class="tourney__name">{t.name}</h3>
                <span class="chip chip--active">Leaderboard</span>
              </div>
              {t.course_name && <p class="tourney__course">{t.course_name}</p>}
              <p class="tourney__meta">
                {(t.players ?? []).length} players · {(t.rounds ?? []).length} round{(t.rounds ?? []).length === 1 ? '' : 's'}
              </p>
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="block">
      <header class="block__head">
        <h2 class="block__title">Recent rounds</h2>
        <a class="block__more" href="/app/history">Round history →</a>
      </header>
      {recentRounds.length === 0 ? (
        <div class="empty">
          No rounds yet. Finish a round in the mobile app and it shows up here.
        </div>
      ) : (
        <div class="rounds">
          {recentRounds.map((r) => (
            <a class="round" href={`/app/round/${r.id}`}>
              <div class="round__date">{fmtDate(r.date_played)}</div>
              <div class="round__course">{r.course_name ?? 'Unknown course'}</div>
              <div class="round__meta">
                {r.tee_color && <span class="chip chip--muted">{r.tee_color}</span>}
                {r.completed === false && <span class="chip chip--warn">In progress</span>}
              </div>
              <div class="round__score">
                <span class="round__total">{r.total_score ?? '—'}</span>
                <span class="round__vspar">{formatVsPar(r.total_score, r.par_total)}</span>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="block">
      <header class="block__head">
        <h2 class="block__title">Active side games</h2>
        <a class="block__more" href="/app/side-games">All side games →</a>
      </header>
      {activeBets.length === 0 ? (
        <div class="empty">
          No active games. Start one in the mobile app — it'll sync here.
        </div>
      ) : (
        <div class="bets">
          {activeBets.map((b) => (
            <a class="bet" href={`/app/side-games/${b.id}`}>
              <div class="bet__head">
                <span class="bet__date">{fmtDate(b.created_at)}</span>
                {b.current_hole != null && b.total_holes && (
                  <span class="chip chip--warn">Hole {b.current_hole} / {b.total_holes}</span>
                )}
              </div>
              <h3 class="bet__course">{b.course_name ?? 'Unknown course'}</h3>
              <div class="bet__tags">
                {(b.game_types ?? []).slice(0, 4).map((g) => <span class="chip">{g.replace(/_/g, ' ')}</span>)}
                {(b.game_types ?? []).length > 4 && <span class="chip chip--muted">+{(b.game_types ?? []).length - 4}</span>}
              </div>
              <div class="bet__players">
                {playerNames(b).slice(0, 4).join(' · ')}
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    {activeLeagues.length > 0 && (
      <section class="block">
        <header class="block__head">
          <h2 class="block__title">Your leagues</h2>
          <a class="block__more" href="/app/leagues">All leagues →</a>
        </header>
        <div class="grid grid--3">
          {activeLeagues.map((l) => (
            <article class="card">
              <h3>{l.name}</h3>
              <p>
                {l.role === 'commissioner' ? 'You run this league' : 'You play in this league'}
                {l.member_count ? ` · ${l.member_count} member${l.member_count === 1 ? '' : 's'}` : ''}
              </p>
              <a class="btn btn--ghost btn--sm" href={`/app/leagues/${l.id}`}>Open</a>
            </article>
          ))}
        </div>
      </section>
    )}

    {clubs.length > 0 && (
      <section class="block">
        <div class="block__head">
          <h2 class="block__title">{clubs.length === 1 ? 'Your club' : 'Your clubs'}</h2>
          {clubs.length > 1 && <a class="block__more" href="/app/club">All clubs →</a>}
        </div>
        <div class="grid grid--3">
          {clubs.map((c) => (
            <article class="card">
              <h3>{c.name}</h3>
              <p>Leagues, admins and the plan that covers them.</p>
              <a class="btn btn--ghost btn--sm" href={clubHref(c.orgId)}>Open</a>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="block">
      <!-- "Coming soon" until 2026-11-13, which it had said since the
           site's first commit (b0517a8, 2026-06-09, the auth shell).
           Every card under it has shipped — /app/tournaments,
           /app/leagues, /app/payments/setup and /app/profile all
           answer 200 — so the heading was promising four things that
           had already arrived, directly below a paid Club card. This
           block is a navigation shelf: the sections above show your
           data, this one is the rest of the product one click away. -->
      <h2 class="block__title">Manage</h2>
      <div class="grid grid--3">
        <article class="card">
          <h3>Tournaments</h3>
          <p>Live leaderboards + Match Board from events you're playing or directing.</p>
          <a class="btn btn--ghost btn--sm" href="/app/tournaments">Open</a>
        </article>
        <article class="card">
          <h3>Leagues</h3>
          <p>Weekly standings, schedule, sub assignments.</p>
          <a class="btn btn--ghost btn--sm" href="/app/leagues">Open</a>
          <!-- Direct entry to card-payments setup. Before this, finishing
               setup meant: Leagues list -> pick one -> Manage -> hunt for
               the button. /app/payments/setup skips straight through when
               you own exactly one league, and shows a picker when you own
               several. Harmless when payments are off for this account:
               that route 404s like every other payments surface. -->
          <a class="btn btn--ghost btn--sm" href="/app/payments/setup">Card payments</a>
        </article>
        <article class="card">
          <h3>Profile</h3>
          <p>Display name, handicap, notification preferences.</p>
          <a class="btn btn--ghost btn--sm" href="/app/profile">Open</a>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .errorbar {
    background: #FEF2F2;
    border: 1px solid #FECACA;
    color: var(--error);
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 0.875rem;
    margin-bottom: 18px;
  }

  .block { margin-top: 32px; }
  .block:first-of-type { margin-top: 8px; }
  .block__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
  }
  .block__title {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0;
  }
  .block__more {
    color: var(--brand-green);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
  }
  .block__more:hover { color: var(--brand-green-dark); }

  .rounds {
    display: grid;
    gap: 8px;
  }
  .round {
    display: grid;
    grid-template-columns: 70px 1.5fr auto auto;
    gap: 14px;
    align-items: center;
    padding: 12px 16px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    color: var(--ink);
  }
  .round:hover {
    border-color: var(--brand-green);
    box-shadow: 0 4px 12px rgba(15, 61, 37, 0.08);
  }
  .round__date {
    font-size: 0.8125rem;
    color: var(--ink-muted);
    font-weight: 600;
  }
  .round__course {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--brand-green-dark);
  }
  .round__meta { display: flex; gap: 6px; }
  .round__score {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .round__total {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--brand-green-dark);
    line-height: 1;
  }
  .round__vspar {
    font-size: 0.75rem;
    color: var(--ink-muted);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .round {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'course score' 'date score' 'meta meta';
      gap: 4px 12px;
    }
    .round__course { grid-area: course; }
    .round__date { grid-area: date; }
    .round__meta { grid-area: meta; margin-top: 4px; }
    .round__score { grid-area: score; }
  }

  .bets {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }
  .bet {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 16px;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .bet:hover {
    border-color: var(--brand-green);
    box-shadow: 0 4px 12px rgba(15, 61, 37, 0.08);
  }
  .bet__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .bet__date {
    font-size: 0.75rem;
    color: var(--ink-muted);
    font-weight: 600;
  }
  .bet__course {
    font-size: 1rem;
    font-weight: 700;
    color: var(--brand-green-dark);
    margin: 0;
  }
  .bet__tags { display: flex; gap: 4px; flex-wrap: wrap; }
  .bet__players {
    font-size: 0.8125rem;
    color: var(--ink);
  }

  .card h3 {
    font-size: 1.0625rem;
    color: var(--brand-green-dark);
    margin: 0;
  }
  .card p { margin: 6px 0 10px; color: var(--ink-muted); font-size: 0.875rem; }
  .card .btn { justify-self: start; }

  .empty {
    background: #fff;
    border: 1px dashed var(--line);
    border-radius: 14px;
    padding: 24px 24px;
    text-align: center;
    color: var(--ink-muted);
    font-size: 0.875rem;
  }

  .tourneys {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
  }
  .tourney {
    background: linear-gradient(135deg, #fff 0%, #f0f7f2 100%);
    border: 1.5px solid var(--brand-green);
    border-radius: 14px;
    padding: 14px 16px;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .tourney:hover {
    box-shadow: 0 4px 12px rgba(15, 61, 37, 0.12);
  }
  .tourney__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }
  .tourney__name {
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--brand-green-dark);
    margin: 0;
    line-height: 1.25;
  }
  .tourney__course {
    font-size: 0.8125rem;
    color: var(--ink);
    margin: 0;
    font-weight: 600;
  }
  .tourney__meta {
    font-size: 0.75rem;
    color: var(--ink-muted);
    margin: 0;
  }
  .chip {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .chip--active {
    background: var(--brand-green);
    color: white;
  }
</style>
