---
// New Tournament wizard (Phase 1 — essentials).
//
// Server-rendered shell containing all 5 steps in the DOM; a client-
// side <script> block toggles visibility as the user clicks Next /
// Back. No framework integration — Astro's default vanilla-JS
// approach is enough for a state machine with 5 nodes.
//
// Auth is enforced by middleware.ts (PROTECTED_PREFIXES includes
// /app), so any visitor rendering this page is already signed in.
// The submit path is `/api/tournaments/create`, which forwards to
// Railway with the visitor's Supabase JWT.
//
// Scope for Phase 1 mirrors docs/plans/WEBSITE_TOURNAMENT_CREATE_PLAN.md
// in the flutter repo — Basics, Format, Rounds, Players, Review.
// Everything more advanced (flights, side games, sponsors, pairing
// composer) is a later phase.
//
// 2026-08-25 Phase 1.1 fixes (Sam post-launch wizard test):
//   * Tee-box dropdown now pulls real tees + rating/slope/par from
//     the picked course via a new /api/courses/[id] proxy, instead
//     of the earlier hardcoded generic-color list. Rounds step
//     shows "Blue — 72.1 / 132" style options.
//   * Director's first-player HCP pre-fills from their
//     `public.profiles.handicap` (server-side fetch) instead of
//     hardcoded 18.
//   * Players step gains an "Add from friends" picker that reads
//     the director's `public.friends` roster (server-side via RLS)
//     and adds a chosen friend with their name + stored handicap
//     in one tap.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createSupabaseClient } from '../../../lib/supabase';
import {
  CUP_TEMPLATE_LIST,
  BANDON_ROUND_BOUNDS,
  bandonDunesCupRounds,
} from '../../../lib/cupTemplates';

const user = Astro.locals.user;
const displayName =
  (typeof user?.user_metadata?.name === 'string' &&
    user!.user_metadata.name.trim()) ||
  user?.email ||
  '';

// Server-side fetch: director's own handicap + friends roster.  Both
// use the visitor's Supabase JWT via RLS — no service-role needed.
// Failure modes are non-fatal: an empty friends list just hides the
// picker; a missing profile HCP falls back to 18.
const supabase = createSupabaseClient({
  request: Astro.request,
  cookies: Astro.cookies,
  locals: Astro.locals,
});

let directorHandicap = 18;
try {
  const { data: profile } = await supabase
    .from('profiles')
    .select('handicap')
    .eq('id', user!.id)
    .maybeSingle();
  const hcp = (profile as { handicap?: number | null } | null)?.handicap;
  if (hcp !== null && hcp !== undefined) {
    const asNum = Number(hcp);
    if (Number.isFinite(asNum)) directorHandicap = asNum;
  }
} catch (e) {
  console.warn('[tournaments/new] director HCP fetch failed', e);
}

type Friend = {
  id: string;
  display_name: string;
  handicap: number;
};
// Pre-compute the full Bandon round-count → rounds map so the
// client picker can swap rounds without re-running any of the
// module's derivation logic. 2..12 = 11 entries; each is small
// so total inline payload stays under ~4KB.
const bandonRoundsByCount: Record<number, ReturnType<typeof bandonDunesCupRounds>> = {};
for (let n = BANDON_ROUND_BOUNDS.min; n <= BANDON_ROUND_BOUNDS.max; n++) {
  bandonRoundsByCount[n] = bandonDunesCupRounds(n);
}

// Serialize the shared Cup templates for the client picker. Only
// the wizard-relevant subset ships — the marketing copy stays on
// the server (it's rendered directly into the picker cards via
// Astro's SSR loop below).
const cupTemplatesForClient = CUP_TEMPLATE_LIST.map((t) => ({
  id: t.id,
  name: t.name,
  defaults: t.defaults,
  rounds: t.rounds,
}));

let friends: Friend[] = [];
try {
  const { data } = await supabase
    .from('friends')
    .select('friend_user_id, display_name, handicap')
    .eq('user_id', user!.id)
    .order('display_name');
  if (Array.isArray(data)) {
    friends = data.map((f: Record<string, unknown>) => ({
      id: String(f.friend_user_id ?? ''),
      display_name: String(f.display_name ?? '').trim(),
      handicap:
        typeof f.handicap === 'number' && Number.isFinite(f.handicap)
          ? f.handicap
          : 18,
    }));
    // Drop malformed rows + dedup by friend_user_id (defensive).
    const seen = new Set<string>();
    friends = friends.filter((f) => {
      if (!f.id || !f.display_name) return false;
      if (seen.has(f.id)) return false;
      seen.add(f.id);
      return true;
    });
  }
} catch (e) {
  console.warn('[tournaments/new] friends fetch failed', e);
}
---

<BaseLayout title="New tournament · Bagpipe Golf">
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">New tournament</p>
    <h1 class="pagewrap__title">Set up your event.</h1>
    <p class="pagewrap__sub">
      Basics, format, rounds, roster — then you're live. Anything
      more advanced (flights, side games, sponsors) opens in the
      Bagpipe Golf mobile app under Events.
    </p>

    <ol class="wizard__steps" aria-hidden="true">
      <li data-step-pill="0" class="is-current">Template</li>
      <li data-step-pill="1">1. Basics</li>
      <li data-step-pill="2">2. Format</li>
      <li data-step-pill="3">3. Rounds</li>
      <li data-step-pill="4">4. Players</li>
      <li data-step-pill="5">5. Flights</li>
      <li data-step-pill="6">6. Review</li>
    </ol>

    <form id="wizard" novalidate>
      <!-- Step 0 — Template picker (optional) -->
      <section data-step="0" class="wizard__step is-current" aria-label="Template">
        <h2 class="wizard__stepTitle">Pick a template</h2>
        <p class="wizard__stepSub">
          Optional — start from one of the four shipping Cup
          templates and edit anything on the next screens, or pick
          <em>Blank</em> to build from scratch. Cup templates come
          pre-loaded with rounds, formats, and Cup point weights.
        </p>

        <div class="templatePicker" role="radiogroup" aria-label="Cup templates">
          <!-- Blank card is always first. -->
          <button
            type="button"
            class="templateCard is-current"
            data-template-id="blank"
            role="radio"
            aria-checked="true"
          >
            <span class="templateCard__badge">Default</span>
            <h3 class="templateCard__name">Blank</h3>
            <p class="templateCard__pitch">
              Start from scratch — pick your own rounds, formats,
              and points. Best for one-off events or your own
              custom trip format.
            </p>
            <p class="templateCard__meta">Single 18-hole stroke round to start.</p>
          </button>

          {CUP_TEMPLATE_LIST.map((t) => (
            <button
              type="button"
              class="templateCard"
              data-template-id={t.id}
              role="radio"
              aria-checked="false"
            >
              <span class="templateCard__badge templateCard__badge--cup">Cup</span>
              <h3 class="templateCard__name">{t.name}</h3>
              <p class="templateCard__pitch">{t.copy.pitch}</p>
              <p class="templateCard__fit">
                <span class="templateCard__fitlabel">Who it's for:</span> {t.copy.fit}
              </p>
              <ul class="templateCard__includes">
                {t.copy.includes.slice(0, 3).map((line) => <li>{line}</li>)}
              </ul>
              {t.id === 'bandonDunesCup' && (
                <div
                  class="templateCard__bandonPicker"
                  data-bandon-picker
                  hidden
                >
                  <label>
                    <span>Round count</span>
                    <input
                      type="number"
                      id="bandonRoundCount"
                      min={BANDON_ROUND_BOUNDS.min}
                      max={BANDON_ROUND_BOUNDS.max}
                      value={BANDON_ROUND_BOUNDS.default}
                      step="1"
                    />
                  </label>
                  <p class="templateCard__bandonHint">
                    2–12 rounds. 6+ adds the Preserve par-3
                    shootout; 10+ adds Shorty's.
                  </p>
                </div>
              )}
              <p class="templateCard__meta">{t.copy.meta}</p>
            </button>
          ))}
        </div>

        <p class="templatePicker__note" hidden id="templateNote"></p>
      </section>

      <!-- Step 1 — Basics -->
      <section data-step="1" class="wizard__step" aria-label="Basics">
        <h2 class="wizard__stepTitle">Basics</h2>

        <label class="field">
          <span class="field__label">Tournament name</span>
          <input
            type="text"
            name="name"
            id="name"
            autocomplete="off"
            required
            maxlength="80"
            placeholder="Ex. Ballyneal Brigade 2026"
          />
        </label>

        <div class="field">
          <span class="field__label">Course</span>
          <div class="courseSearch">
            <input
              type="text"
              id="courseSearch"
              autocomplete="off"
              placeholder="Search course by name…"
            />
            <ul id="courseResults" class="courseSearch__results" hidden></ul>
            <div id="coursePicked" class="courseSearch__picked" hidden>
              <div>
                <strong id="coursePickedName"></strong>
                <div id="coursePickedClub" class="courseSearch__pickedClub"></div>
              </div>
              <button
                type="button"
                id="courseChangeBtn"
                class="btn btn--ghost btn--sm"
              >Change</button>
            </div>
            <p class="field__hint">
              Type at least 2 characters. If the course isn't found,
              try the club name.
            </p>
          </div>
        </div>

        <fieldset class="field field--group">
          <legend class="field__label">Field</legend>
          <div class="radios">
            <label><input type="radio" name="fieldGender" value="male" checked /> Men</label>
            <label><input type="radio" name="fieldGender" value="female" /> Women</label>
            <label><input type="radio" name="fieldGender" value="mixed" /> Mixed</label>
          </div>
        </fieldset>
      </section>

      <!-- Step 2 — Format -->
      <section data-step="2" class="wizard__step" aria-label="Format">
        <h2 class="wizard__stepTitle">Format</h2>

        <fieldset class="field field--group">
          <legend class="field__label">Scoring mode</legend>
          <div class="radios radios--stacked">
            <label>
              <input type="radio" name="scoringMode" value="strokeAggregate" checked />
              <span><strong>Stroke play</strong> — total score across all rounds</span>
            </label>
            <label>
              <input type="radio" name="scoringMode" value="scramble" />
              <span><strong>Scramble</strong> — one team score per hole</span>
            </label>
            <label>
              <input type="radio" name="scoringMode" value="bestBall" />
              <span><strong>Best ball</strong> — team of individual scorecards, best score counts</span>
            </label>
            <label>
              <input type="radio" name="scoringMode" value="matchPlay" />
              <span><strong>Match play</strong> — head-to-head by hole</span>
            </label>
          </div>
        </fieldset>

        <label class="checkbox">
          <input type="checkbox" id="useNetScoring" checked />
          <span>Use net scoring (subtract each player's course handicap)</span>
        </label>

        <fieldset class="field field--group fieldComps">
          <legend class="field__label">Field Competitions</legend>
          <label class="checkbox checkbox--stacked">
            <input type="checkbox" id="trackCTPOnPar3s" />
            <span>
              <strong>Track Closest-to-Pin on par 3s</strong>
              <em class="checkbox__hint">
                Leaderboard shows the CTP winner for each par 3 across
                the tournament.
              </em>
            </span>
          </label>
          <label class="checkbox checkbox--stacked">
            <input type="checkbox" id="trackLongestDrive" />
            <span>
              <strong>Track Longest Drive</strong>
              <em class="checkbox__hint">
                Leaderboard shows the LD winner for each designated
                hole.
              </em>
            </span>
          </label>
        </fieldset>
      </section>

      <!-- Step 3 — Rounds -->
      <section data-step="3" class="wizard__step" aria-label="Rounds">
        <h2 class="wizard__stepTitle">Rounds</h2>
        <p class="wizard__stepSub">
          Add up to 4 rounds. Each round has its own tee color +
          hole count.
        </p>

        <ul id="roundsList" class="roundsList"></ul>

        <button type="button" id="addRoundBtn" class="btn btn--ghost">
          + Add round
        </button>
      </section>

      <!-- Step 4 — Players -->
      <section data-step="4" class="wizard__step" aria-label="Players">
        <h2 class="wizard__stepTitle">Players</h2>
        <p class="wizard__stepSub">
          Add each player. Pull from your friends list for one-tap
          add, or type a name + handicap manually.
        </p>

        {friends.length > 0 && (
          <div class="friendPicker">
            <label class="friendPicker__label" for="friendSelect">
              Add from friends
            </label>
            <div class="friendPicker__row">
              <select id="friendSelect">
                <option value="">— pick a friend —</option>
                {friends.map((f) => (
                  <option
                    value={f.id}
                    data-name={f.display_name}
                    data-hcp={f.handicap}
                  >
                    {f.display_name} (Handicap {f.handicap})
                  </option>
                ))}
              </select>
              <button type="button" id="addFriendBtn" class="btn btn--primary btn--sm">
                Add friend
              </button>
            </div>
          </div>
        )}

        <div class="playerAdd">
          <input type="text" id="playerNameInput" placeholder="Player name" maxlength="60" />
          <input type="number" id="playerHcpInput" placeholder="Handicap" step="0.1" min="-10" max="54" />
          <button type="button" id="addPlayerBtn" class="btn btn--ghost btn--sm">Add manually</button>
        </div>

        <ul id="playersList" class="playersList" aria-live="polite"></ul>
        <p id="playersEmpty" class="wizard__stepSub">
          No players yet. Add yourself first — you're the director.
        </p>

        <!--
          Invite by email (roadmap #5). Emails collected here are
          POSTed to /api/tournaments/[id]/invites AFTER the tournament
          is created — never blocks the wizard submit. Chip-input UX
          mirrors the mobile app's InviteByEmailSection widget.
        -->
        <div class="inviteBox">
          <h3 class="inviteBox__title">Invite by email <span class="inviteBox__optional">optional</span></h3>
          <p class="inviteBox__hint">
            Add player emails and they'll get a link to view (or
            sign up + join) the tournament. You can skip and share
            the tournament URL manually — or add more invites later
            from the Manage page.
          </p>
          <div class="inviteBox__row">
            <input
              type="email"
              id="inviteEmailInput"
              placeholder="name@example.com"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
            />
            <button type="button" id="inviteAddBtn" class="btn btn--ghost btn--sm">
              Add
            </button>
          </div>
          <p class="inviteBox__hint inviteBox__hint--tight">
            Tip: paste multiple emails separated by commas or new lines.
          </p>
          <ul id="inviteChipsList" class="inviteChips" aria-live="polite"></ul>
          <p id="inviteChipsEmpty" class="inviteBox__hint inviteBox__hint--muted">
            No emails queued.
          </p>
        </div>
      </section>

      <!-- Step 5 — Flights (optional) -->
      <section data-step="5" class="wizard__step" aria-label="Flights">
        <h2 class="wizard__stepTitle">Flights (optional)</h2>
        <p class="wizard__stepSub">
          Split the field into handicap-bracketed brackets — each
          flight competes for its own prizes. Skip this step if
          you want a single competition across the whole field
          (the default).
        </p>

        <fieldset class="field field--group flightsMode">
          <legend class="field__label">Flights mode</legend>
          <div class="radios radios--stacked">
            <label>
              <input type="radio" name="flightsMode" value="off" checked />
              <span><strong>No flights</strong> — single competition</span>
            </label>
            <label>
              <input type="radio" name="flightsMode" value="auto" />
              <span><strong>Auto-split by handicap</strong> — equal-count buckets</span>
            </label>
            <label>
              <input type="radio" name="flightsMode" value="manual" />
              <span><strong>Manual composer</strong> — hand-pick who goes where</span>
            </label>
          </div>
        </fieldset>

        <!-- Auto-split panel -->
        <div id="flightsAutoPanel" class="flightsPanel" hidden>
          <label class="field flightsCountField">
            <span class="field__label">Number of flights</span>
            <select id="flightsAutoCount">
              <option value="2">2 flights</option>
              <option value="3">3 flights</option>
              <option value="4">4 flights</option>
            </select>
          </label>

          <label class="checkbox">
            <input type="checkbox" id="flightsAdjustToggle" />
            <span>Adjust auto boundaries manually</span>
          </label>

          <div id="flightsAutoPreview" class="flightsPreview" aria-live="polite"></div>
        </div>

        <!-- Manual composer panel -->
        <div id="flightsManualPanel" class="flightsPanel" hidden>
          <div class="flightsManualHeader">
            <button type="button" id="flightsManualAddBtn" class="btn btn--ghost btn--sm">
              + Add flight
            </button>
            <button type="button" id="flightsManualSeedBtn" class="btn btn--ghost btn--sm">
              Auto-assign by handicap
            </button>
          </div>
          <ul id="flightsManualList" class="flightsManualList"></ul>
          <p class="wizard__stepSub">
            Each player picks one flight. Unassigned players
            (shown below) fall through to the first flight on
            submit.
          </p>
          <ul id="flightsManualAssignments" class="flightsAssignList" aria-live="polite"></ul>
        </div>
      </section>

      <!-- Step 6 — Review -->
      <section data-step="6" class="wizard__step" aria-label="Review">
        <h2 class="wizard__stepTitle">Review</h2>

        <dl class="review">
          <div><dt>Name</dt><dd id="rvName">—</dd></div>
          <div><dt>Course</dt><dd id="rvCourse">—</dd></div>
          <div><dt>Field</dt><dd id="rvField">—</dd></div>
          <div><dt>Scoring</dt><dd id="rvScoring">—</dd></div>
          <div><dt>Net</dt><dd id="rvNet">—</dd></div>
          <div id="rvFieldCompsRow" hidden><dt>Field Competitions</dt><dd id="rvFieldComps">—</dd></div>
          <div><dt>Rounds</dt><dd id="rvRounds">—</dd></div>
          <div><dt>Players</dt><dd id="rvPlayers">—</dd></div>
          <div id="rvFlightsRow" hidden><dt>Flights</dt><dd id="rvFlights">—</dd></div>
        </dl>

        <p class="wizard__stepSub">
          Everything else — flights, side games, sponsors, Field
          Competitions — you can configure in the mobile app once
          the tournament is created.
        </p>

        <aside id="reviewCupNote" class="reviewCupNote" hidden>
          <strong>Cup template applied.</strong>
          Rounds, formats, and Cup point weights are pre-filled.
          Team pairings, per-round side games, and per-round
          course overrides (Bandon's par-3 shootouts, Scarecrow's
          two-course split) can be configured on the Manage page
          in the mobile app after the tournament is created.
        </aside>
      </section>

      <!-- Persistent error surface -->
      <div id="wizardError" class="errorbar" hidden></div>

      <!-- Nav buttons -->
      <div class="wizard__nav">
        <button type="button" id="backBtn" class="btn btn--ghost" disabled>
          ← Back
        </button>
        <button type="button" id="nextBtn" class="btn btn--primary">
          Next →
        </button>
        <button type="button" id="submitBtn" class="btn btn--primary" hidden>
          Create tournament
        </button>
      </div>
    </form>
  </main>
</BaseLayout>

<script is:inline define:vars={{
  defaultDirectorName: displayName,
  defaultDirectorHcp: directorHandicap,
  cupTemplates: cupTemplatesForClient,
  bandonRoundsByCount,
  bandonRoundBounds: {
    min: BANDON_ROUND_BOUNDS.min,
    max: BANDON_ROUND_BOUNDS.max,
    default: BANDON_ROUND_BOUNDS.default,
  },
}}>
  // ── Wizard state ──────────────────────────────────────────
  //
  // Held in module scope so the step navigation + submit can both
  // read/write without a framework store. Simple enough for 5 steps.
  //
  // state.course carries the picked course + (once loaded) the full
  // tee_boxes array from `/api/courses/[id]`. state.rounds[i] holds
  // the per-round selection AND the resolved rating/slope/par from
  // whichever tee the user picked, so the submit payload can include
  // rating/slope at the tournament level without a second fetch.
  // Wizard step numbering: 0 = Template picker (optional), 1..4 =
  // Basics/Format/Rounds/Players (original flow), 5 = Flights
  // (optional, added 2026-08-26), 6 = Review. Every `=== 5` /
  // `=== 6` comparison below is intentional — step 5 is the new
  // Flights step, step 6 is Review.
  const state = {
    step: 0,
    // 'blank' = default; otherwise a template id from cupTemplates.
    templateId: 'blank',
    // Bandon-only: user-chosen round count. Ignored for other
    // templates.
    bandonRoundCount: bandonRoundBounds.default,
    course: null, // {id, clubName, courseName, teeBoxes: [...] once loaded}
    rounds: [
      // Rating/slope/par default to null until a course loads +
      // the user picks a tee. Populated in renderRounds().
      // Phase 2a: startType defaults to teeTimes (foursomes) — the
      // most common shape.
      { teeName: '', totalHoles: 18, format: 'stroke',
        courseRating: null, slopeRating: null, parTotal: null,
        gender: 'male',
        pointsAvailable: 1,
        useIndividualScoring: false,
        matchupCompositionMode: null,
        scheduledDate: null, firstTeeTime: null, courseKey: null,
        startType: 'teeTimes', teeTimeGroupSize: 4, shotgunStartTime: '' },
    ],
    // Tournament-level Cup defaults. Overridden when a Cup
    // template is picked; the Format step still exposes the
    // scoring-mode radios for manual override.
    scoringModeOverride: null, // when non-null, replaces the Step 2 radio choice
    useNetScoringOverride: null,
    trackCTPOnPar3s: false,
    trackLongestDrive: false,
    players: [],
    // Flights (Step 5). `mode` = 'off' | 'auto' | 'manual'; `off`
    // means single competition (empty flights on submit). `auto`
    // uses the shared `autoSplitFlights` helper on the current
    // player list — boundaries can be overridden by the user via
    // the "Adjust boundaries" toggle. `manual` = user-composed
    // list w/ per-player flight dropdowns.
    flightsMode: 'off',
    flightsAutoCount: 2,
    flightsAutoAdjusted: false,
    // The active flight list — populated by auto-split OR by the
    // manual composer. Empty when mode === 'off'. Each entry:
    // { id, name, handicapMin, handicapMax, playerIds } — matches
    // WizardFlightInput on the wire (camelCase in memory,
    // snake_case on submit via buildCreatePayload).
    flights: [],
    // Email invites (roadmap #5). NOT part of the tournament create
    // payload — sent as a follow-up POST to
    // /api/tournaments/[id]/invites once the tournament id is known.
    // Deduped + lowercased at add time. Wizard never blocks on invite
    // send failures; a partial-send is surfaced via a snackbar-style
    // banner but the wizard still redirects to the leaderboard.
    invites: [],
  };

  // Pre-seed the director as the first player when we have a name.
  // HCP comes from their profiles row (server-fetched); falls back
  // to 18 only when the profile HCP is null/missing.
  if (defaultDirectorName) {
    state.players.push({
      name: defaultDirectorName,
      handicap: Number.isFinite(defaultDirectorHcp) ? defaultDirectorHcp : 18,
    });
  }

  const steps = document.querySelectorAll('[data-step]');
  const pills = document.querySelectorAll('[data-step-pill]');
  const backBtn = document.getElementById('backBtn');
  const nextBtn = document.getElementById('nextBtn');
  const submitBtn = document.getElementById('submitBtn');
  const errorBox = document.getElementById('wizardError');

  function show(step) {
    state.step = step;
    steps.forEach((el) => {
      el.classList.toggle('is-current', Number(el.dataset.step) === step);
    });
    pills.forEach((el) => {
      el.classList.toggle('is-current', Number(el.dataset.stepPill) === step);
    });
    // Back is enabled from Basics onwards (Template picker is
    // the first step and has nothing to go back to).
    backBtn.disabled = step === 0;
    nextBtn.hidden = step === 6;
    submitBtn.hidden = step !== 6;
    errorBox.hidden = true;
    if (step === 3) renderRounds();
    if (step === 4) renderPlayers();
    if (step === 5) renderFlights();
    if (step === 6) renderReview();
  }

  function showError(msg) {
    errorBox.textContent = msg;
    errorBox.hidden = false;
  }

  function validateStep(step) {
    if (step === 1) {
      const name = /** @type {HTMLInputElement} */ (document.getElementById('name')).value.trim();
      if (name.length === 0) return 'Tournament name is required.';
      if (!state.course) return 'Pick a course before continuing.';
    }
    if (step === 3) {
      if (state.rounds.length === 0) return 'Add at least one round.';
    }
    if (step === 4) {
      if (state.players.length === 0) return 'Add at least one player.';
    }
    return null;
  }

  nextBtn.addEventListener('click', () => {
    const err = validateStep(state.step);
    if (err) return showError(err);
    show(Math.min(state.step + 1, 6));
  });
  backBtn.addEventListener('click', () => {
    show(Math.max(state.step - 1, 0));
  });

  // ── Template picker (Step 0) ─────────────────────────────
  //
  // Selecting a template card mutates state.rounds + a handful of
  // tournament-level defaults (scoringMode, useNetScoring, CTP /
  // LD tracking). The Blank card is the no-op default — resets
  // state to the wizard's original single-round starter.
  //
  // Bandon Dunes Cup is the only round-count-driven template —
  // its card exposes a number input (2..12) that swaps the round
  // list in place from the server-precomputed `bandonRoundsByCount`
  // map.
  //
  // The user can advance to Basics without picking anything (Blank
  // stays active by default). Coming back and picking a different
  // template REPLACES rounds — a `templateNote` warning surfaces
  // this so the user isn't surprised.
  //
  // Any tournament-level defaults the template sets get echoed
  // onto the Format step so the Format radios stay in sync. If
  // the user manually toggles a radio afterward, that override
  // wins on submit.
  const templateCards = document.querySelectorAll('[data-template-id]');
  const templateNote = document.getElementById('templateNote');
  const bandonInput = document.getElementById('bandonRoundCount');
  const bandonPicker = document.querySelector('[data-bandon-picker]');
  const reviewCupNote = document.getElementById('reviewCupNote');
  const scoringRadios = document.getElementsByName('scoringMode');
  const useNetScoringEl = document.getElementById('useNetScoring');
  const trackCTPEl = /** @type {HTMLInputElement} */ (document.getElementById('trackCTPOnPar3s'));
  const trackLDEl = /** @type {HTMLInputElement} */ (document.getElementById('trackLongestDrive'));

  // User toggles win over template pre-fills. Every change writes
  // through to state so applyTemplateOverrides can't clobber the
  // user's explicit intent on a subsequent step re-render (state
  // is the source of truth; syncFormatRadiosToState only fires on
  // template application).
  trackCTPEl.addEventListener('change', () => {
    state.trackCTPOnPar3s = !!trackCTPEl.checked;
  });
  trackLDEl.addEventListener('change', () => {
    state.trackLongestDrive = !!trackLDEl.checked;
  });

  function templateById(id) {
    return cupTemplates.find((t) => t.id === id) || null;
  }

  function makeBlankRound() {
    return {
      teeName: '', totalHoles: 18, format: 'stroke',
      courseRating: null, slopeRating: null, parTotal: null,
      gender: 'male',
      pointsAvailable: 1,
      useIndividualScoring: false,
      matchupCompositionMode: null,
      scheduledDate: null, firstTeeTime: null, courseKey: null,
      startType: 'teeTimes', teeTimeGroupSize: 4, shotgunStartTime: '',
    };
  }

  function templateRoundToState(r) {
    // Turn a Cup template round into the wizard's round shape.
    // The template drives format + points + composition mode +
    // date/time hints; tee/holes/course-specific ratings still
    // come from the wizard's Rounds step (or fall back to the
    // default single-tee starter shape when the user submits
    // without editing).
    return {
      teeName: '',
      totalHoles: 18,
      format: r.format,
      courseRating: null,
      slopeRating: null,
      parTotal: null,
      gender: 'male',
      pointsAvailable: r.pointsAvailable ?? 1,
      useIndividualScoring: r.useIndividualScoring === true,
      matchupCompositionMode: r.matchupCompositionMode ?? null,
      scheduledDate: r.scheduledDate ?? null,
      firstTeeTime: r.firstTeeTime ?? null,
      courseKey: r.courseKey ?? null,
      // Session label from the template — echoed as roundName
      // on the wire so the mobile app shows "R1 · Best Ball
      // (Pacific Dunes)" rather than a generic "R1".
      roundName: r.name ?? null,
      startType: 'teeTimes',
      teeTimeGroupSize: 4,
      shotgunStartTime: '',
    };
  }

  function applyTemplateOverrides(id) {
    const t = templateById(id);
    if (!t) {
      // Blank — reset overrides and use one starter round.
      state.templateId = 'blank';
      state.rounds = [makeBlankRound()];
      state.scoringModeOverride = null;
      state.useNetScoringOverride = null;
      state.trackCTPOnPar3s = false;
      state.trackLongestDrive = false;
      return;
    }
    state.templateId = id;
    // Bandon uses the round-count-driven list; other templates
    // use the static rounds baked into the template.
    const rounds = id === 'bandonDunesCup'
      ? (bandonRoundsByCount[state.bandonRoundCount] || t.rounds)
      : t.rounds;
    state.rounds = rounds.map(templateRoundToState);
    state.scoringModeOverride = t.defaults.scoringMode; // 'stroke_aggregate' | 'match_points'
    state.useNetScoringOverride = t.defaults.useNetScoring;
    state.trackCTPOnPar3s = !!t.defaults.trackCTPOnPar3s;
    state.trackLongestDrive = !!t.defaults.trackLongestDrive;
  }

  function syncFormatRadiosToState() {
    // Mirror the template's scoring-mode default onto the Format
    // step's radios so the user sees the pre-fill on arrival. The
    // Format step only has 4 buckets today (strokeAggregate /
    // scramble / bestBall / matchPlay); match_points falls into
    // 'matchPlay' as the closest analog since it drives Cup-style
    // head-to-head math on the mobile side.
    //
    // Field Competitions checkboxes always sync — Blank resets
    // both to false, Bandon/Ballyneal pre-check CTP, Ryder/Scarecrow
    // leave both off. Mirroring runs before the scoringMode early
    // return so the DOM never lags state when the user picks Blank.
    trackCTPEl.checked = !!state.trackCTPOnPar3s;
    trackLDEl.checked = !!state.trackLongestDrive;
    if (state.scoringModeOverride == null) return;
    const target =
      state.scoringModeOverride === 'match_points' ? 'matchPlay'
      : 'strokeAggregate';
    for (const r of scoringRadios) {
      if (r.value === target) r.checked = true;
    }
    if (state.useNetScoringOverride != null) {
      useNetScoringEl.checked = !!state.useNetScoringOverride;
    }
  }

  function refreshTemplateCards() {
    templateCards.forEach((card) => {
      const id = card.getAttribute('data-template-id');
      const isCurrent = id === state.templateId ||
        (state.templateId === 'blank' && id === 'blank');
      card.classList.toggle('is-current', isCurrent);
      card.setAttribute('aria-checked', isCurrent ? 'true' : 'false');
    });
    if (bandonPicker) {
      bandonPicker.hidden = state.templateId !== 'bandonDunesCup';
    }
    // Note when a Cup template is active — makes the "next steps
    // will show the pre-filled rounds" behavior explicit.
    if (state.templateId === 'blank') {
      templateNote.hidden = true;
      templateNote.textContent = '';
    } else {
      const t = templateById(state.templateId);
      const name = t ? t.name : 'Cup template';
      const count = state.rounds.length;
      templateNote.hidden = false;
      templateNote.textContent =
        `${name} applied — ${count} round${count === 1 ? '' : 's'} pre-filled. ` +
        `You can still edit rounds and formats on the Rounds step.`;
    }
    // Review-step callout only for Cup templates.
    if (reviewCupNote) {
      reviewCupNote.hidden = state.templateId === 'blank';
    }
  }

  templateCards.forEach((card) => {
    card.addEventListener('click', (ev) => {
      // Clicks inside the Bandon round-count input shouldn't
      // trigger a template swap — the input lives inside the card.
      if (ev.target && ev.target.closest && ev.target.closest('[data-bandon-picker]')) {
        return;
      }
      const id = card.getAttribute('data-template-id');
      applyTemplateOverrides(id);
      syncFormatRadiosToState();
      refreshTemplateCards();
    });
  });

  if (bandonInput) {
    bandonInput.addEventListener('change', () => {
      const raw = Number(bandonInput.value);
      const clamped = Math.min(
        bandonRoundBounds.max,
        Math.max(bandonRoundBounds.min, Number.isFinite(raw) ? Math.round(raw) : bandonRoundBounds.default),
      );
      if (clamped !== raw) bandonInput.value = String(clamped);
      state.bandonRoundCount = clamped;
      // Re-apply Bandon with the new count so state.rounds refreshes.
      if (state.templateId === 'bandonDunesCup') {
        applyTemplateOverrides('bandonDunesCup');
        refreshTemplateCards();
      }
    });
  }

  // ── Course search ────────────────────────────────────────
  const courseInput = /** @type {HTMLInputElement} */ (document.getElementById('courseSearch'));
  const courseResults = /** @type {HTMLUListElement} */ (document.getElementById('courseResults'));
  const coursePicked = document.getElementById('coursePicked');
  const coursePickedName = document.getElementById('coursePickedName');
  const coursePickedClub = document.getElementById('coursePickedClub');
  const courseChangeBtn = document.getElementById('courseChangeBtn');

  let debounceTimer = null;
  courseInput.addEventListener('input', () => {
    const q = courseInput.value.trim();
    if (debounceTimer) clearTimeout(debounceTimer);
    if (q.length < 2) {
      courseResults.hidden = true;
      courseResults.innerHTML = '';
      return;
    }
    debounceTimer = setTimeout(() => runSearch(q), 250);
  });

  async function runSearch(q) {
    try {
      const res = await fetch(`/api/courses/search?q=${encodeURIComponent(q)}`);
      if (!res.ok) throw new Error(`Search failed: ${res.status}`);
      const data = await res.json();
      const hits = Array.isArray(data.courses) ? data.courses : [];
      courseResults.innerHTML = '';
      if (hits.length === 0) {
        const li = document.createElement('li');
        li.className = 'courseSearch__empty';
        li.textContent = 'No matches. Try the club name.';
        courseResults.appendChild(li);
      } else {
        for (const c of hits.slice(0, 8)) {
          const li = document.createElement('li');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'courseSearch__hit';
          const name = c.course_name || c.club_name || 'Course';
          const club = c.course_name && c.club_name && c.course_name !== c.club_name ? c.club_name : null;
          btn.innerHTML =
            `<strong>${escapeHtml(name)}</strong>` +
            (club ? `<span>${escapeHtml(club)}</span>` : '') +
            (c.location ? `<em>${escapeHtml(c.location)}</em>` : '');
          btn.addEventListener('click', async () => {
            state.course = {
              id: c.id,
              clubName: c.club_name ?? null,
              courseName: c.course_name ?? null,
              teeBoxes: [], // hydrated below
            };
            coursePickedName.textContent = name;
            coursePickedClub.textContent = club ?? '';
            coursePicked.hidden = false;
            courseInput.hidden = true;
            courseResults.hidden = true;

            // Fetch full course detail so the Rounds step can render
            // real tee boxes with rating/slope/par instead of the
            // hardcoded fallback list. Non-fatal on failure — the
            // fallback list keeps the wizard usable.
            try {
              const dRes = await fetch(`/api/courses/${encodeURIComponent(c.id)}`);
              if (dRes.ok) {
                const dJson = await dRes.json();
                const teeBoxes = (dJson && dJson.course && Array.isArray(dJson.course.tee_boxes))
                  ? dJson.course.tee_boxes
                  : [];
                state.course.teeBoxes = teeBoxes;
                // If the user has already advanced past Basics, re-
                // render Rounds so the tee options refresh in place.
                if (state.step === 3) renderRounds();
                // If a round has no tee selected yet + we have tees
                // available, pre-select the first male tee (or first
                // tee overall) so the user isn't staring at empty.
                if (teeBoxes.length > 0) {
                  const preferred = teeBoxes.find((t) => t.gender === 'male') ?? teeBoxes[0];
                  for (const r of state.rounds) {
                    if (!r.teeName) applyTeeToRound(r, preferred);
                  }
                }
              }
            } catch (err) {
              // Non-fatal — the fallback tee list keeps the wizard
              // usable even if the course-detail fetch flakes.
              console.warn('[wizard] course detail fetch failed', err);
            }
          });
          li.appendChild(btn);
          courseResults.appendChild(li);
        }
      }
      courseResults.hidden = false;
    } catch (err) {
      courseResults.innerHTML = `<li class="courseSearch__empty">${escapeHtml(String(err))}</li>`;
      courseResults.hidden = false;
    }
  }

  courseChangeBtn.addEventListener('click', () => {
    state.course = null;
    coursePicked.hidden = true;
    courseInput.hidden = false;
    courseInput.value = '';
    courseInput.focus();
  });

  // ── Rounds editor ────────────────────────────────────────
  const roundsList = document.getElementById('roundsList');
  document.getElementById('addRoundBtn').addEventListener('click', () => {
    if (state.rounds.length >= 12) {
      showError('Up to 12 rounds per tournament.');
      return;
    }
    state.rounds.push({
      teeName: 'White',
      totalHoles: 18,
      format: 'stroke',
      // Phase 2a defaults — tee times, foursomes, no shotgun time.
      startType: 'teeTimes',
      teeTimeGroupSize: 4,
      shotgunStartTime: '',
    });
    renderRounds();
  });

  // Apply a tee object (from the course-detail response) onto a
  // round in state.rounds. Copies name + gender + resolves the
  // rating/slope/par so the submit payload can include them at the
  // tournament level.
  function applyTeeToRound(round, tee) {
    round.teeName = tee.tee_name;
    round.gender = tee.gender || 'male';
    round.courseRating = typeof tee.course_rating === 'number' ? tee.course_rating : null;
    round.slopeRating = typeof tee.slope_rating === 'number' ? tee.slope_rating : null;
    round.parTotal = typeof tee.par_total === 'number' ? tee.par_total : null;
  }

  function teeLabel(tee) {
    const bits = [tee.tee_name];
    if (tee.gender === 'female') bits.push('(F)');
    if (tee.course_rating != null && tee.slope_rating != null) {
      bits.push(`— ${tee.course_rating} / ${tee.slope_rating}`);
    } else if (tee.course_rating != null) {
      bits.push(`— ${tee.course_rating}`);
    }
    return bits.join(' ');
  }

  function renderRounds() {
    roundsList.innerHTML = '';
    const teeBoxes = (state.course && Array.isArray(state.course.teeBoxes))
      ? state.course.teeBoxes
      : [];
    // When no course is picked yet OR the course returned no tee
    // data (some upstreams don't), fall back to a stable list of
    // generic colors so the user can still create the tournament.
    // Rating/slope won't be included in the payload; the mobile
    // app renders a fallback there too.
    const useFallback = teeBoxes.length === 0;
    const fallbackNames = ['Championship', 'Blue', 'White', 'Gold', 'Red', 'Green'];

    state.rounds.forEach((r, i) => {
      const li = document.createElement('li');
      li.className = 'roundsList__row';
      const teeOptions = useFallback
        ? fallbackNames
            .map((n) => `<option value="fallback::${escapeHtml(n)}" ${n === r.teeName ? 'selected' : ''}>${escapeHtml(n)}</option>`)
            .join('')
        : teeBoxes
            .map((t, ti) => {
              const isSel = t.tee_name === r.teeName && (t.gender || 'male') === (r.gender || 'male');
              return `<option value="idx::${ti}" ${isSel ? 'selected' : ''}>${escapeHtml(teeLabel(t))}</option>`;
            })
            .join('');
      // Phase 2a: start type + group size + shotgun time. Read
      // defensively — old rounds seeded pre-2a won't have these
      // fields; falls back to teeTimes / 4 / no time.
      const startType = r.startType === 'shotgun' ? 'shotgun' : 'teeTimes';
      const groupSize = r.teeTimeGroupSize === 2 || r.teeTimeGroupSize === 3 ? r.teeTimeGroupSize : 4;
      const shotgunTime = typeof r.shotgunStartTime === 'string' ? r.shotgunStartTime : '';
      li.innerHTML = `
        <div class="roundsList__idx">R${i + 1}</div>
        <label>
          <span>Tee</span>
          <select data-round-tee="${i}">
            ${useFallback ? '' : '<option value="">Pick a tee</option>'}
            ${teeOptions}
          </select>
        </label>
        <label>
          <span>Holes</span>
          <select data-round-holes="${i}">
            <option value="18" ${r.totalHoles === 18 ? 'selected' : ''}>18</option>
            <option value="9" ${r.totalHoles === 9 ? 'selected' : ''}>9</option>
          </select>
        </label>
        <label>
          <span>Format</span>
          <select data-round-format="${i}">
            <option value="stroke" ${r.format === 'stroke' ? 'selected' : ''}>Stroke</option>
            <option value="scramble" ${r.format === 'scramble' ? 'selected' : ''}>Scramble</option>
            <option value="bestBall" ${r.format === 'bestBall' ? 'selected' : ''}>Best ball</option>
            <option value="matchPlay" ${r.format === 'matchPlay' ? 'selected' : ''}>Match</option>
          </select>
        </label>
        <label>
          <span>Start</span>
          <select data-round-starttype="${i}">
            <option value="teeTimes" ${startType === 'teeTimes' ? 'selected' : ''}>Tee times</option>
            <option value="shotgun" ${startType === 'shotgun' ? 'selected' : ''}>Shotgun</option>
          </select>
        </label>
        <label>
          <span>Groups</span>
          <select data-round-groupsize="${i}">
            <option value="4" ${groupSize === 4 ? 'selected' : ''}>Foursomes (4)</option>
            <option value="3" ${groupSize === 3 ? 'selected' : ''}>Threesomes (3)</option>
            <option value="2" ${groupSize === 2 ? 'selected' : ''}>Twosomes (2)</option>
          </select>
        </label>
        <label data-round-shotguntime-wrap="${i}" ${startType !== 'shotgun' ? 'hidden' : ''}>
          <span>Shotgun time</span>
          <input
            type="time"
            data-round-shotguntime="${i}"
            value="${escapeHtml(shotgunTime)}"
          />
        </label>
        <button type="button" class="roundsList__remove" data-round-remove="${i}" aria-label="Remove round ${i + 1}">×</button>
      `;
      roundsList.appendChild(li);
    });
    roundsList.querySelectorAll('[data-round-tee]').forEach((el) => {
      el.addEventListener('change', (e) => {
        const idx = Number(el.getAttribute('data-round-tee'));
        const val = /** @type {HTMLSelectElement} */ (e.target).value;
        if (val.startsWith('fallback::')) {
          const name = val.substring('fallback::'.length);
          state.rounds[idx].teeName = name;
          state.rounds[idx].gender = 'male';
          state.rounds[idx].courseRating = null;
          state.rounds[idx].slopeRating = null;
          state.rounds[idx].parTotal = null;
        } else if (val.startsWith('idx::')) {
          const ti = Number(val.substring('idx::'.length));
          const tee = teeBoxes[ti];
          if (tee) applyTeeToRound(state.rounds[idx], tee);
        } else {
          state.rounds[idx].teeName = '';
        }
      });
    });
    roundsList.querySelectorAll('[data-round-holes]').forEach((el) => {
      el.addEventListener('change', (e) => {
        const idx = Number(el.getAttribute('data-round-holes'));
        state.rounds[idx].totalHoles = Number(/** @type {HTMLSelectElement} */ (e.target).value);
      });
    });
    roundsList.querySelectorAll('[data-round-format]').forEach((el) => {
      el.addEventListener('change', (e) => {
        const idx = Number(el.getAttribute('data-round-format'));
        state.rounds[idx].format = /** @type {HTMLSelectElement} */ (e.target).value;
      });
    });
    roundsList.querySelectorAll('[data-round-starttype]').forEach((el) => {
      el.addEventListener('change', (e) => {
        const idx = Number(el.getAttribute('data-round-starttype'));
        const val = /** @type {HTMLSelectElement} */ (e.target).value;
        state.rounds[idx].startType = val === 'shotgun' ? 'shotgun' : 'teeTimes';
        // Toggle the shotgun-time input's visibility inline so the
        // user sees the field appear immediately without a full
        // re-render (which would reset any in-flight tee edits).
        const wrap = roundsList.querySelector(`[data-round-shotguntime-wrap="${idx}"]`);
        if (wrap) wrap.hidden = state.rounds[idx].startType !== 'shotgun';
        if (state.rounds[idx].startType !== 'shotgun') {
          state.rounds[idx].shotgunStartTime = '';
        }
      });
    });
    roundsList.querySelectorAll('[data-round-groupsize]').forEach((el) => {
      el.addEventListener('change', (e) => {
        const idx = Number(el.getAttribute('data-round-groupsize'));
        const v = Number(/** @type {HTMLSelectElement} */ (e.target).value);
        state.rounds[idx].teeTimeGroupSize = (v === 2 || v === 3) ? v : 4;
      });
    });
    roundsList.querySelectorAll('[data-round-shotguntime]').forEach((el) => {
      el.addEventListener('input', (e) => {
        const idx = Number(el.getAttribute('data-round-shotguntime'));
        state.rounds[idx].shotgunStartTime =
          /** @type {HTMLInputElement} */ (e.target).value;
      });
    });
    roundsList.querySelectorAll('[data-round-remove]').forEach((el) => {
      el.addEventListener('click', () => {
        const idx = Number(el.getAttribute('data-round-remove'));
        if (state.rounds.length <= 1) {
          showError('At least one round is required.');
          return;
        }
        state.rounds.splice(idx, 1);
        renderRounds();
      });
    });
  }

  // ── Players editor ───────────────────────────────────────
  const playersList = document.getElementById('playersList');
  const playersEmpty = document.getElementById('playersEmpty');
  const playerNameInput = /** @type {HTMLInputElement} */ (document.getElementById('playerNameInput'));
  const playerHcpInput = /** @type {HTMLInputElement} */ (document.getElementById('playerHcpInput'));

  document.getElementById('addPlayerBtn').addEventListener('click', () => {
    const name = playerNameInput.value.trim();
    if (name.length === 0) {
      showError("Player name can't be empty.");
      return;
    }
    if (state.players.length >= 24) {
      showError('Phase 1 supports up to 24 players.');
      return;
    }
    const raw = playerHcpInput.value.trim();
    const hcp = raw === '' ? 18 : Number(raw);
    if (!Number.isFinite(hcp)) {
      showError("Handicap must be a number (or leave blank for 18).");
      return;
    }
    state.players.push({ name, handicap: hcp });
    playerNameInput.value = '';
    playerHcpInput.value = '';
    playerNameInput.focus();
    errorBox.hidden = true;
    renderPlayers();
  });

  // Friend picker — server-rendered <select> populated from the
  // director's public.friends roster. Adding a friend copies their
  // stored display_name + handicap onto the players list; the
  // friend_user_id becomes state.players[i].userId so the mobile
  // app can bind the player row to the actual signed-in user for
  // scoring + notifications later.
  const friendSelectEl = document.getElementById('friendSelect');
  const addFriendBtn = document.getElementById('addFriendBtn');
  if (friendSelectEl && addFriendBtn) {
    addFriendBtn.addEventListener('click', () => {
      const sel = /** @type {HTMLSelectElement} */ (friendSelectEl);
      const opt = sel.options[sel.selectedIndex];
      if (!opt || !opt.value) {
        showError('Pick a friend first.');
        return;
      }
      if (state.players.length >= 24) {
        showError('Phase 1 supports up to 24 players.');
        return;
      }
      const friendUserId = opt.value;
      const name = opt.getAttribute('data-name') || 'Friend';
      const hcpRaw = opt.getAttribute('data-hcp');
      const hcp = hcpRaw != null && Number.isFinite(Number(hcpRaw)) ? Number(hcpRaw) : 18;
      // Prevent adding the same friend twice.
      if (state.players.some((p) => p.userId && p.userId === friendUserId)) {
        showError(`${name} is already in the roster.`);
        return;
      }
      state.players.push({ name, handicap: hcp, userId: friendUserId });
      // Reset the select back to the placeholder.
      sel.selectedIndex = 0;
      errorBox.hidden = true;
      renderPlayers();
    });
  }

  function renderPlayers() {
    playersList.innerHTML = '';
    state.players.forEach((p, i) => {
      const li = document.createElement('li');
      li.className = 'playersList__row';
      li.innerHTML = `
        <span class="playersList__name">${escapeHtml(p.name)}</span>
        <span class="playersList__hcp">Handicap ${p.handicap}</span>
        <button type="button" class="playersList__remove" data-player-remove="${i}" aria-label="Remove ${escapeHtml(p.name)}">×</button>
      `;
      playersList.appendChild(li);
    });
    playersList.querySelectorAll('[data-player-remove]').forEach((el) => {
      el.addEventListener('click', () => {
        const idx = Number(el.getAttribute('data-player-remove'));
        state.players.splice(idx, 1);
        renderPlayers();
      });
    });
    playersEmpty.hidden = state.players.length > 0;
  }

  // ── Invite-by-email chip input (Players step) ────────────
  //
  // Simple RFC-lite email regex — Railway re-validates + dedupes
  // server-side, so this only exists to catch obviously bad shapes
  // (missing @, whitespace, ".@..") before we let a chip land in
  // the pending list. Wizard state carries the emails as-is; the
  // post-create submit path POSTs the whole list to
  // /api/tournaments/[id]/invites.
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const inviteEmailInput = /** @type {HTMLInputElement} */ (document.getElementById('inviteEmailInput'));
  const inviteAddBtn = document.getElementById('inviteAddBtn');
  const inviteChipsList = document.getElementById('inviteChipsList');
  const inviteChipsEmpty = document.getElementById('inviteChipsEmpty');

  function normaliseEmail(raw) {
    return String(raw).trim().toLowerCase();
  }

  function addInviteEmails(raw) {
    // Accept commas + newlines + tabs + semicolons as separators so
    // pasted "a@x.com, b@x.com" splits cleanly.
    const parts = String(raw)
      .split(/[\s,;]+/)
      .map(normaliseEmail)
      .filter((e) => e.length > 0);
    let added = 0;
    let firstInvalid = null;
    for (const email of parts) {
      if (!EMAIL_RE.test(email)) {
        if (!firstInvalid) firstInvalid = email;
        continue;
      }
      if (state.invites.includes(email)) continue;
      state.invites.push(email);
      added++;
    }
    if (firstInvalid && added === 0) {
      showError(`"${firstInvalid}" isn't a valid email address.`);
    } else if (firstInvalid) {
      showError(`Some entries were skipped — "${firstInvalid}" isn't a valid email.`);
    } else {
      errorBox.hidden = true;
    }
    renderInviteChips();
  }

  function renderInviteChips() {
    if (!inviteChipsList || !inviteChipsEmpty) return;
    inviteChipsList.innerHTML = '';
    state.invites.forEach((email, i) => {
      const li = document.createElement('li');
      li.className = 'inviteChips__chip';
      li.innerHTML = `
        <span class="inviteChips__email">${escapeHtml(email)}</span>
        <button type="button" class="inviteChips__remove" data-invite-remove="${i}" aria-label="Remove ${escapeHtml(email)}">×</button>
      `;
      inviteChipsList.appendChild(li);
    });
    inviteChipsList.querySelectorAll('[data-invite-remove]').forEach((el) => {
      el.addEventListener('click', () => {
        const idx = Number(el.getAttribute('data-invite-remove'));
        state.invites.splice(idx, 1);
        renderInviteChips();
      });
    });
    inviteChipsEmpty.hidden = state.invites.length > 0;
  }

  if (inviteAddBtn && inviteEmailInput) {
    inviteAddBtn.addEventListener('click', () => {
      const raw = inviteEmailInput.value;
      if (raw.trim().length === 0) return;
      addInviteEmails(raw);
      inviteEmailInput.value = '';
      inviteEmailInput.focus();
    });
    inviteEmailInput.addEventListener('keydown', (ev) => {
      // Enter / comma / Tab all commit the current buffer as a chip.
      // Tab still moves focus after committing, matching typical
      // pill-input UX; preventDefault only fires when we actually
      // absorb the key (i.e. commit a chip).
      if (ev.key === 'Enter' || ev.key === ',' || ev.key === ';') {
        const raw = inviteEmailInput.value;
        if (raw.trim().length === 0) return;
        ev.preventDefault();
        addInviteEmails(raw);
        inviteEmailInput.value = '';
      }
    });
    inviteEmailInput.addEventListener('blur', () => {
      const raw = inviteEmailInput.value;
      if (raw.trim().length === 0) return;
      addInviteEmails(raw);
      inviteEmailInput.value = '';
    });
    // On paste, auto-split even if the user immediately blurs away.
    inviteEmailInput.addEventListener('paste', (ev) => {
      const text = ev.clipboardData?.getData('text');
      if (!text || !/[\s,;]/.test(text)) return; // let single-address paste flow naturally
      ev.preventDefault();
      addInviteEmails(text);
      inviteEmailInput.value = '';
    });
  }

  /**
   * POST the pending invite list to /api/tournaments/[id]/invites.
   * Returns a summary `{sent, failed}` for the wizard's post-submit
   * banner. Always resolves — never throws — so a network hiccup on
   * the invite path can't turn a successful tournament create into
   * an error state.
   */
  async function sendPendingInvites(tournamentId) {
    if (!state.invites.length) return { sent: 0, failed: 0 };
    try {
      const res = await fetch(`/api/tournaments/${encodeURIComponent(tournamentId)}/invites`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ emails: state.invites }),
      });
      if (!res.ok) {
        return { sent: 0, failed: state.invites.length };
      }
      const body = await res.json().catch(() => null);
      const invites = body && Array.isArray(body.invites) ? body.invites : [];
      const sent = invites.filter((i) => i.sent === true).length;
      const failed = state.invites.length - sent;
      return { sent, failed };
    } catch (e) {
      return { sent: 0, failed: state.invites.length };
    }
  }

  // ── Flights editor (Step 5) ──────────────────────────────
  //
  // Mirrors the mobile app's flight-generation algorithm from
  // `lib/features/tourney/screens/new_tournament_screen.dart`
  // `_ensureDefaultFlights`: sort players by handicap ascending,
  // split into equal-count buckets (perFlight = ceil(N /
  // flightCount)), lowest bucket → Championship. See
  // `autoSplitFlights` in `src/lib/tournamentCreate.ts` for the
  // shared engine.
  //
  // Three modes:
  //   * off     — no flights (default, empty flights array)
  //   * auto    — recomputes from state.players on every render
  //               (unless flightsAutoAdjusted, in which case the
  //               user has moved boundaries and we preserve them)
  //   * manual  — user-composed list with per-player dropdowns
  //
  // Flights are stored on state.flights in a shape identical to
  // WizardFlightInput (camelCase in-memory, snake_case on submit).
  // Player ids inside flights are `wp_<index>` — the payload
  // builder rewrites to server ids at submit.
  const MAX_FLIGHTS = 6;
  const DEFAULT_FLIGHT_NAMES = [
    'Championship', 'First', 'Second', 'Third', 'Fourth', 'Fifth',
  ];

  const flightsAutoPanel = document.getElementById('flightsAutoPanel');
  const flightsManualPanel = document.getElementById('flightsManualPanel');
  const flightsAutoCountEl = /** @type {HTMLSelectElement} */ (document.getElementById('flightsAutoCount'));
  const flightsAdjustToggle = /** @type {HTMLInputElement} */ (document.getElementById('flightsAdjustToggle'));
  const flightsAutoPreview = document.getElementById('flightsAutoPreview');
  const flightsManualAddBtn = document.getElementById('flightsManualAddBtn');
  const flightsManualSeedBtn = document.getElementById('flightsManualSeedBtn');
  const flightsManualList = document.getElementById('flightsManualList');
  const flightsManualAssignments = document.getElementById('flightsManualAssignments');
  const flightsModeRadios = document.getElementsByName('flightsMode');

  // Wizard-local stable id for a player's index. The payload
  // builder rewrites these to `p_<tournamentId>_<i>` on submit
  // (see `wizardPlayerId` in tournamentCreate.ts). Kept as a
  // function so a future migration to real player ids on the
  // wizard side is a one-line change.
  function wpId(i) { return `wp_${i}`; }

  function autoSplitLocal(playerCount) {
    // Equal-count buckets on the current roster sorted by
    // handicap ascending. Returns an array of `{id, name,
    // handicapMin, handicapMax, playerIds}` where playerIds are
    // `wp_<i>` referencing state.players.
    const n = state.players.length;
    const count = Math.max(1, Math.min(MAX_FLIGHTS, Math.floor(playerCount)));
    if (n === 0) return [];
    const indexed = state.players.map((p, i) => ({
      wpId: wpId(i),
      hcp: Number.isFinite(Number(p.handicap)) ? Number(p.handicap) : 18,
    }));
    indexed.sort((a, b) => a.hcp - b.hcp);
    const perFlight = Math.ceil(n / count);
    const stamp = Date.now();
    const out = [];
    for (let i = 0; i < count; i++) {
      const start = i * perFlight;
      if (start >= n) break;
      const end = Math.min(start + perFlight, n);
      const slice = indexed.slice(start, end);
      out.push({
        id: `flight_${i}_${stamp + i}`,
        name: DEFAULT_FLIGHT_NAMES[i] ?? `Flight ${i + 1}`,
        handicapMin: slice[0].hcp,
        handicapMax: slice[slice.length - 1].hcp,
        playerIds: slice.map((s) => s.wpId),
      });
    }
    return out;
  }

  function defaultFlightCountFor(n) {
    if (n <= 16) return 2;
    if (n <= 32) return 3;
    return 4;
  }

  function selectFlightsMode(mode) {
    state.flightsMode = mode;
    // Ensure the radio DOM matches state (handles programmatic
    // mode switches from the "Auto-assign" seed button).
    for (const r of flightsModeRadios) {
      if (r.value === mode) r.checked = true;
    }
    if (mode === 'off') {
      state.flights = [];
      state.flightsAutoAdjusted = false;
    }
    if (mode === 'auto') {
      // Regenerate on entry so a roster change since last visit
      // is reflected. Preserves any manual boundary edits when
      // flightsAutoAdjusted is true.
      if (!state.flightsAutoAdjusted) {
        state.flights = autoSplitLocal(state.flightsAutoCount);
      }
    }
    if (mode === 'manual') {
      // Seed with the auto-split output when empty so users
      // don't stare at a blank composer. They can then edit.
      if (state.flights.length === 0) {
        const count = Math.min(MAX_FLIGHTS,
          defaultFlightCountFor(state.players.length));
        state.flights = autoSplitLocal(count);
      }
    }
    renderFlights();
  }

  for (const r of flightsModeRadios) {
    r.addEventListener('change', () => {
      if (r.checked) selectFlightsMode(r.value);
    });
  }

  flightsAutoCountEl.addEventListener('change', () => {
    const n = Math.max(2, Math.min(4, Number(flightsAutoCountEl.value) || 2));
    state.flightsAutoCount = n;
    // Rebuild — user changing the count implies they want a
    // fresh split, so we reset any boundary adjustments.
    state.flightsAutoAdjusted = false;
    flightsAdjustToggle.checked = false;
    state.flights = autoSplitLocal(n);
    renderFlights();
  });

  flightsAdjustToggle.addEventListener('change', () => {
    state.flightsAutoAdjusted = !!flightsAdjustToggle.checked;
    renderFlights();
  });

  flightsManualAddBtn.addEventListener('click', () => {
    if (state.flights.length >= MAX_FLIGHTS) {
      showError(`Up to ${MAX_FLIGHTS} flights per tournament.`);
      return;
    }
    const idx = state.flights.length;
    state.flights.push({
      id: `flight_manual_${Date.now()}_${idx}`,
      name: DEFAULT_FLIGHT_NAMES[idx] ?? `Flight ${idx + 1}`,
      handicapMin: null,
      handicapMax: null,
      playerIds: [],
    });
    renderFlights();
  });

  flightsManualSeedBtn.addEventListener('click', () => {
    const count = state.flights.length > 0
      ? state.flights.length
      : Math.min(MAX_FLIGHTS, defaultFlightCountFor(state.players.length));
    state.flights = autoSplitLocal(count);
    renderFlights();
  });

  function renderFlights() {
    // Visibility of the two panels reflects the current mode.
    flightsAutoPanel.hidden = state.flightsMode !== 'auto';
    flightsManualPanel.hidden = state.flightsMode !== 'manual';

    if (state.flightsMode === 'auto') {
      // Recompute on entry unless the user manually adjusted the
      // boundaries — this covers the case where they added or
      // removed players on Step 4 and stepped back into Flights.
      if (!state.flightsAutoAdjusted) {
        state.flights = autoSplitLocal(state.flightsAutoCount);
      }
      flightsAutoCountEl.value = String(state.flightsAutoCount);
      flightsAdjustToggle.checked = !!state.flightsAutoAdjusted;
      renderFlightsAutoPreview();
    }
    if (state.flightsMode === 'manual') {
      renderFlightsManual();
    }
  }

  function playerLookupByWp() {
    const map = new Map();
    state.players.forEach((p, i) => {
      map.set(wpId(i), p);
    });
    return map;
  }

  function renderFlightsAutoPreview() {
    flightsAutoPreview.innerHTML = '';
    if (state.players.length === 0) {
      const p = document.createElement('p');
      p.className = 'wizard__stepSub';
      p.textContent = 'Add players first — auto-split needs at least one player to bucket.';
      flightsAutoPreview.appendChild(p);
      return;
    }
    const lookup = playerLookupByWp();
    const adjusted = state.flightsAutoAdjusted;
    state.flights.forEach((f, fi) => {
      const card = document.createElement('div');
      card.className = 'flightCard';
      const boundaryEditable = adjusted;
      const minStr = f.handicapMin != null ? String(f.handicapMin) : '';
      const maxStr = f.handicapMax != null ? String(f.handicapMax) : '';
      const boundaryHtml = boundaryEditable
        ? `<label class="flightCard__bound">
             <span>Min HCP</span>
             <input type="number" step="0.1" data-flight-bound="min" data-flight-idx="${fi}" value="${escapeHtml(minStr)}" />
           </label>
           <label class="flightCard__bound">
             <span>Max HCP</span>
             <input type="number" step="0.1" data-flight-bound="max" data-flight-idx="${fi}" value="${escapeHtml(maxStr)}" />
           </label>`
        : `<span class="flightCard__range">
             ${minStr === '' && maxStr === '' ? 'no bounds' : `${minStr} – ${maxStr}`}
           </span>`;
      const nameHtml = boundaryEditable
        ? `<input type="text" class="flightCard__nameInput" data-flight-name="${fi}" value="${escapeHtml(f.name)}" maxlength="30" />`
        : `<strong class="flightCard__name">${escapeHtml(f.name)}</strong>`;
      const players = (f.playerIds || [])
        .map((pid) => {
          const p = lookup.get(pid);
          if (!p) return '';
          return `<li>${escapeHtml(p.name)} <span class="playersList__hcp">Handicap ${escapeHtml(String(p.handicap))}</span></li>`;
        })
        .join('');
      card.innerHTML = `
        <div class="flightCard__head">
          ${nameHtml}
          ${boundaryHtml}
          <span class="flightCard__count">${(f.playerIds || []).length} player${(f.playerIds || []).length === 1 ? '' : 's'}</span>
        </div>
        <ul class="flightCard__players">${players || '<li class="wizard__stepSub">No players in this flight.</li>'}</ul>
      `;
      flightsAutoPreview.appendChild(card);
    });
    // Wire boundary edits + name edits when in adjust mode.
    if (adjusted) {
      flightsAutoPreview.querySelectorAll('[data-flight-bound]').forEach((el) => {
        el.addEventListener('input', (e) => {
          const fi = Number(el.getAttribute('data-flight-idx'));
          const which = el.getAttribute('data-flight-bound');
          const raw = /** @type {HTMLInputElement} */ (e.target).value.trim();
          const v = raw === '' ? null : Number(raw);
          if (raw !== '' && !Number.isFinite(v)) return;
          if (which === 'min') state.flights[fi].handicapMin = v;
          if (which === 'max') state.flights[fi].handicapMax = v;
          // Re-bucket players against the new min/max — an
          // adjusted boundary re-assigns players whose HCP falls
          // in the new range. Only re-runs when both min+max are
          // set for the flight; partial edits are tolerated.
          rebucketFromBoundaries();
        });
      });
      flightsAutoPreview.querySelectorAll('[data-flight-name]').forEach((el) => {
        el.addEventListener('input', (e) => {
          const fi = Number(el.getAttribute('data-flight-name'));
          state.flights[fi].name = /** @type {HTMLInputElement} */ (e.target).value;
        });
      });
    }
  }

  function rebucketFromBoundaries() {
    // Given the current handicapMin/Max on each flight, assign
    // every player to the FIRST flight whose range covers them.
    // Players outside every range fall into the last flight.
    // Cheap enough for wizard-size rosters (≤24 players × ≤6
    // flights) that we don't bother with anything smarter.
    const flights = state.flights;
    if (flights.length === 0) return;
    const assignments = flights.map(() => []);
    state.players.forEach((p, i) => {
      const wp = wpId(i);
      const hcp = Number.isFinite(Number(p.handicap)) ? Number(p.handicap) : 18;
      let placed = false;
      for (let fi = 0; fi < flights.length; fi++) {
        const f = flights[fi];
        const min = f.handicapMin;
        const max = f.handicapMax;
        if (min == null || max == null) continue;
        if (hcp >= min && hcp <= max) {
          assignments[fi].push(wp);
          placed = true;
          break;
        }
      }
      if (!placed) assignments[assignments.length - 1].push(wp);
    });
    for (let fi = 0; fi < flights.length; fi++) {
      flights[fi].playerIds = assignments[fi];
    }
    // Re-paint the counts + roster chips without wiping the
    // in-progress number input the user just typed into. Cheapest
    // way is to reserialize + re-render, but that would blur the
    // input. So walk the DOM and update the player list + counts
    // only.
    const cards = flightsAutoPreview.querySelectorAll('.flightCard');
    const lookup = playerLookupByWp();
    cards.forEach((card, fi) => {
      const list = card.querySelector('.flightCard__players');
      const count = card.querySelector('.flightCard__count');
      if (list) {
        const ids = flights[fi].playerIds || [];
        list.innerHTML = ids
          .map((pid) => {
            const p = lookup.get(pid);
            if (!p) return '';
            return `<li>${escapeHtml(p.name)} <span class="playersList__hcp">Handicap ${escapeHtml(String(p.handicap))}</span></li>`;
          })
          .join('') || '<li class="wizard__stepSub">No players in this flight.</li>';
      }
      if (count) {
        const n = (flights[fi].playerIds || []).length;
        count.textContent = `${n} player${n === 1 ? '' : 's'}`;
      }
    });
  }

  function renderFlightsManual() {
    // The flights list itself (rename / delete).
    flightsManualList.innerHTML = '';
    state.flights.forEach((f, fi) => {
      const li = document.createElement('li');
      li.className = 'flightsManualRow';
      li.innerHTML = `
        <input type="text" class="flightsManualRow__name" data-flight-name="${fi}" value="${escapeHtml(f.name)}" maxlength="30" />
        <span class="flightsManualRow__count">${(f.playerIds || []).length} player${(f.playerIds || []).length === 1 ? '' : 's'}</span>
        <button type="button" class="flightsManualRow__remove" data-flight-remove="${fi}" aria-label="Remove ${escapeHtml(f.name)}">×</button>
      `;
      flightsManualList.appendChild(li);
    });
    flightsManualList.querySelectorAll('[data-flight-name]').forEach((el) => {
      el.addEventListener('input', (e) => {
        const fi = Number(el.getAttribute('data-flight-name'));
        state.flights[fi].name = /** @type {HTMLInputElement} */ (e.target).value;
      });
    });
    flightsManualList.querySelectorAll('[data-flight-remove]').forEach((el) => {
      el.addEventListener('click', () => {
        const fi = Number(el.getAttribute('data-flight-remove'));
        if (state.flights.length <= 1) {
          showError('At least one flight is required in manual mode. Switch to "No flights" to disable flighting.');
          return;
        }
        state.flights.splice(fi, 1);
        renderFlights();
      });
    });

    // Per-player flight assignment.
    flightsManualAssignments.innerHTML = '';
    if (state.players.length === 0) {
      const li = document.createElement('li');
      li.className = 'wizard__stepSub';
      li.textContent = 'Add players first to assign them to flights.';
      flightsManualAssignments.appendChild(li);
      return;
    }
    state.players.forEach((p, pi) => {
      const wp = wpId(pi);
      const currentFlight = state.flights.findIndex((f) =>
        (f.playerIds || []).includes(wp));
      const options = state.flights
        .map((f, fi) => {
          const sel = fi === currentFlight ? 'selected' : '';
          return `<option value="${fi}" ${sel}>${escapeHtml(f.name)}</option>`;
        }).join('');
      const unassignedSel = currentFlight < 0 ? 'selected' : '';
      const li = document.createElement('li');
      li.className = 'flightsAssignRow';
      li.innerHTML = `
        <span class="flightsAssignRow__name">${escapeHtml(p.name)}</span>
        <span class="flightsAssignRow__hcp">Handicap ${escapeHtml(String(p.handicap))}</span>
        <select data-flight-assign="${pi}">
          <option value="-1" ${unassignedSel}>— unassigned —</option>
          ${options}
        </select>
      `;
      flightsManualAssignments.appendChild(li);
    });
    flightsManualAssignments.querySelectorAll('[data-flight-assign]').forEach((el) => {
      el.addEventListener('change', (e) => {
        const pi = Number(el.getAttribute('data-flight-assign'));
        const targetFi = Number(/** @type {HTMLSelectElement} */ (e.target).value);
        const wp = wpId(pi);
        // Remove from every flight, then push into the target
        // (if any). Simple + correct — no ghost double-assignments.
        for (const f of state.flights) {
          f.playerIds = (f.playerIds || []).filter((id) => id !== wp);
        }
        if (targetFi >= 0 && targetFi < state.flights.length) {
          state.flights[targetFi].playerIds.push(wp);
        }
        // Update the per-flight count chips without a full re-render
        // (avoids blurring an in-progress name edit).
        const rows = flightsManualList.querySelectorAll('.flightsManualRow');
        rows.forEach((row, fi) => {
          const count = row.querySelector('.flightsManualRow__count');
          if (count) {
            const n = (state.flights[fi].playerIds || []).length;
            count.textContent = `${n} player${n === 1 ? '' : 's'}`;
          }
        });
      });
    });
  }

  // ── Review ───────────────────────────────────────────────
  function renderReview() {
    const nameEl = /** @type {HTMLInputElement} */ (document.getElementById('name'));
    const rvName = document.getElementById('rvName');
    const rvCourse = document.getElementById('rvCourse');
    const rvField = document.getElementById('rvField');
    const rvScoring = document.getElementById('rvScoring');
    const rvNet = document.getElementById('rvNet');
    const rvRounds = document.getElementById('rvRounds');
    const rvPlayers = document.getElementById('rvPlayers');
    rvName.textContent = nameEl.value.trim() || '—';
    rvCourse.textContent = state.course
      ? (state.course.courseName ?? state.course.clubName ?? '—')
      : '—';
    const fg = document.querySelector('input[name="fieldGender"]:checked');
    rvField.textContent = fg && fg.value === 'female' ? 'Women' : fg && fg.value === 'mixed' ? 'Mixed' : 'Men';
    const sm = document.querySelector('input[name="scoringMode"]:checked');
    // Cup templates take precedence when they set an override —
    // display the Cup label rather than the pre-Cup radio choice.
    const scoringLabels = {
      strokeAggregate: 'Stroke play',
      scramble: 'Scramble',
      bestBall: 'Best ball',
      matchPlay: 'Match play',
      stroke_aggregate: 'Stroke aggregate',
      match_points: 'Cup — Match Points',
    };
    const scoringKey = state.scoringModeOverride
      ?? (sm ? sm.value : 'strokeAggregate');
    rvScoring.textContent = scoringLabels[scoringKey] || String(scoringKey);
    const netEl = /** @type {HTMLInputElement} */ (document.getElementById('useNetScoring'));
    const netVal = state.useNetScoringOverride != null
      ? state.useNetScoringOverride
      : netEl.checked;
    rvNet.textContent = netVal ? 'Yes' : 'No';
    // Field Competitions — show only when at least one is on. State
    // is the source of truth (user toggles + template pre-fills both
    // write through).
    const rvFieldCompsRow = document.getElementById('rvFieldCompsRow');
    const rvFieldComps = document.getElementById('rvFieldComps');
    const fieldCompsOn = [];
    if (state.trackCTPOnPar3s) fieldCompsOn.push('Closest-to-Pin');
    if (state.trackLongestDrive) fieldCompsOn.push('Longest Drive');
    if (fieldCompsOn.length > 0) {
      rvFieldCompsRow.hidden = false;
      rvFieldComps.textContent = fieldCompsOn.join(', ');
    } else {
      rvFieldCompsRow.hidden = true;
      rvFieldComps.textContent = '';
    }
    rvRounds.textContent = state.rounds
      .map((r, i) => {
        // For Cup rounds, prefer the template-set roundName over the
        // generic "R1 White 18h" summary.
        const base = r.roundName || `R${i + 1} ${r.teeName || '—'} ${r.totalHoles}h`;
        return r.pointsAvailable && r.pointsAvailable !== 1
          ? `${base} (${r.pointsAvailable} pts)`
          : base;
      })
      .join(' · ');
    rvPlayers.textContent = state.players.length === 0
      ? 'None'
      : `${state.players.length} · ${state.players.slice(0, 3).map((p) => p.name).join(', ')}${state.players.length > 3 ? '…' : ''}`;
    // Flights — visible only when the user opted into flighting.
    // Shows "N flights: Name (count), ..." so the Review answer
    // isn't just "yes" — the director can eyeball whether the
    // split matches what they expected.
    const rvFlightsRow = document.getElementById('rvFlightsRow');
    const rvFlights = document.getElementById('rvFlights');
    if (state.flightsMode !== 'off' && state.flights.length > 0) {
      const summary = state.flights
        .map((f) => `${f.name} (${(f.playerIds || []).length})`)
        .join(', ');
      rvFlightsRow.hidden = false;
      rvFlights.textContent =
        `${state.flights.length} flight${state.flights.length === 1 ? '' : 's'}: ${summary}`;
    } else {
      rvFlightsRow.hidden = true;
      rvFlights.textContent = '';
    }
  }

  // ── Submit ───────────────────────────────────────────────
  submitBtn.addEventListener('click', async () => {
    const nameEl = /** @type {HTMLInputElement} */ (document.getElementById('name'));
    const fg = document.querySelector('input[name="fieldGender"]:checked');
    const sm = document.querySelector('input[name="scoringMode"]:checked');
    const netEl = /** @type {HTMLInputElement} */ (document.getElementById('useNetScoring'));

    // Course-level rating/slope/par default to the first round's
    // resolved tee data — matches how the mobile app treats
    // Round 1 as the "primary" tee for the tournament-level fields.
    const primary = state.rounds[0] || {};
    const payload = {
      name: nameEl.value.trim(),
      course: state.course
        ? {
            id: state.course.id,
            clubName: state.course.clubName,
            courseName: state.course.courseName,
          }
        : null,
      // Full tee-box catalog from the picked course (empty when the
      // upstream didn't return per-tee data — mobile app renders
      // its own fallback in that case).
      teeBoxes: state.course && Array.isArray(state.course.teeBoxes)
        ? state.course.teeBoxes
        : [],
      courseRating: primary.courseRating ?? null,
      slopeRating: primary.slopeRating ?? null,
      parTotal: primary.parTotal ?? null,
      fieldGender: fg ? fg.value : 'male',
      // Cup templates set an override in state.scoringModeOverride
      // (snake_case wire value). When null the wizard's Format-step
      // radio choice wins — API-side validator accepts BOTH shapes.
      scoringMode: state.scoringModeOverride ?? (sm ? sm.value : 'strokeAggregate'),
      useNetScoring: state.useNetScoringOverride != null
        ? !!state.useNetScoringOverride
        : netEl.checked,
      templateId: state.templateId || 'blank',
      trackCTPOnPar3s: !!state.trackCTPOnPar3s,
      trackLongestDrive: !!state.trackLongestDrive,
      rounds: state.rounds,
      players: state.players,
      // Empty flights array when the user picked "No flights" —
      // matches original wizard behavior. Non-empty writes the
      // auto-split or manual composer state. Server-side validator
      // caps at MAX_FLIGHTS and drops any playerId that doesn't
      // resolve to a real roster slot. Payload builder rewrites
      // `wp_<i>` → `p_<tournamentId>_<i>` server-side ids.
      flights: state.flightsMode === 'off' ? [] : state.flights,
    };

    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating…';
    errorBox.hidden = true;
    try {
      const res = await fetch('/api/tournaments/create', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        showError(data.error || `Create failed with ${res.status}`);
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create tournament';
        return;
      }
      const id = data.id;
      if (!id) {
        showError('Tournament was created but the id was not returned.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create tournament';
        return;
      }

      // Fire pending invites AFTER the tournament exists. Never
      // blocks the redirect on invite send failures — a partial
      // failure surfaces via a `?invites=…` query param the
      // leaderboard reads (opt-in in a future PR) and via a brief
      // pre-redirect banner update here. The Manage page's Invites
      // card is the recovery path for any that didn't send.
      submitBtn.textContent = 'Sending invites…';
      const inviteResult = await sendPendingInvites(id);
      if (inviteResult.failed > 0) {
        // Keep the redirect but log the miss so the user knows to
        // check the Manage page. Using window.alert here rather
        // than showError because we're mid-redirect — the wizard
        // errorbox is about to unmount.
        window.alert(
          `Tournament created — but ${inviteResult.failed} invite${inviteResult.failed === 1 ? '' : 's'} didn't send.\n\n` +
          `You can resend from the Manage page.`,
        );
      }

      window.location.href = `/app/tournaments/${encodeURIComponent(id)}/leaderboard`;
    } catch (err) {
      showError(err && err.message ? err.message : 'Network error — try again.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Create tournament';
    }
  });

  // ── Utils ────────────────────────────────────────────────
  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, (ch) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    })[ch] || ch);
  }

  // First render — start on the Template picker (Step 0).
  // Blank is the default template, so a user who just wants the
  // pre-Cup flow can hit Next once and land on Basics as before.
  refreshTemplateCards();
  show(0);
</script>

