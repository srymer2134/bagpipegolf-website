---
// New Tournament wizard (Phase 1 — essentials).
//
// Server-rendered shell containing all 5 steps in the DOM; a client-
// side <script> block toggles visibility as the user clicks Next /
// Back. No framework integration — Astro's default vanilla-JS
// approach is enough for a state machine with 5 nodes.
//
// Auth is enforced by middleware.ts (PROTECTED_PREFIXES includes
// /app), so any visitor rendering this page is already signed in.
// The submit path is `/api/tournaments/create`, which forwards to
// Railway with the visitor's Supabase JWT.
//
// Scope for Phase 1 mirrors docs/plans/WEBSITE_TOURNAMENT_CREATE_PLAN.md
// in the flutter repo — Basics, Format, Rounds, Players, Review.
// Everything more advanced (flights, side games, sponsors, pairing
// composer) is a later phase.
//
// 2026-08-25 Phase 1.1 fixes (Sam post-launch wizard test):
//   * Tee-box dropdown now pulls real tees + rating/slope/par from
//     the picked course via a new /api/courses/[id] proxy, instead
//     of the earlier hardcoded generic-color list. Rounds step
//     shows "Blue — 72.1 / 132" style options.
//   * Director's first-player HCP pre-fills from their
//     `public.profiles.handicap` (server-side fetch) instead of
//     hardcoded 18.
//   * Players step gains an "Add from friends" picker that reads
//     the director's `public.friends` roster (server-side via RLS)
//     and adds a chosen friend with their name + stored handicap
//     in one tap.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createSupabaseClient } from '../../../lib/supabase';

const user = Astro.locals.user;
const displayName =
  (typeof user?.user_metadata?.name === 'string' &&
    user!.user_metadata.name.trim()) ||
  user?.email ||
  '';

// Server-side fetch: director's own handicap + friends roster.  Both
// use the visitor's Supabase JWT via RLS — no service-role needed.
// Failure modes are non-fatal: an empty friends list just hides the
// picker; a missing profile HCP falls back to 18.
const supabase = createSupabaseClient({
  request: Astro.request,
  cookies: Astro.cookies,
  locals: Astro.locals,
});

let directorHandicap = 18;
try {
  const { data: profile } = await supabase
    .from('profiles')
    .select('handicap')
    .eq('id', user!.id)
    .maybeSingle();
  const hcp = (profile as { handicap?: number | null } | null)?.handicap;
  if (hcp !== null && hcp !== undefined) {
    const asNum = Number(hcp);
    if (Number.isFinite(asNum)) directorHandicap = asNum;
  }
} catch (e) {
  console.warn('[tournaments/new] director HCP fetch failed', e);
}

type Friend = {
  id: string;
  display_name: string;
  handicap: number;
};
let friends: Friend[] = [];
try {
  const { data } = await supabase
    .from('friends')
    .select('friend_user_id, display_name, handicap')
    .eq('user_id', user!.id)
    .order('display_name');
  if (Array.isArray(data)) {
    friends = data.map((f: Record<string, unknown>) => ({
      id: String(f.friend_user_id ?? ''),
      display_name: String(f.display_name ?? '').trim(),
      handicap:
        typeof f.handicap === 'number' && Number.isFinite(f.handicap)
          ? f.handicap
          : 18,
    }));
    // Drop malformed rows + dedup by friend_user_id (defensive).
    const seen = new Set<string>();
    friends = friends.filter((f) => {
      if (!f.id || !f.display_name) return false;
      if (seen.has(f.id)) return false;
      seen.add(f.id);
      return true;
    });
  }
} catch (e) {
  console.warn('[tournaments/new] friends fetch failed', e);
}
---

<BaseLayout title="New tournament · Bagpipe Golf">
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">New tournament</p>
    <h1 class="pagewrap__title">Set up your event.</h1>
    <p class="pagewrap__sub">
      Basics, format, rounds, roster — then you're live. Anything
      more advanced (flights, side games, sponsors) opens in the
      Bagpipe Golf mobile app under Events.
    </p>

    <ol class="wizard__steps" aria-hidden="true">
      <li data-step-pill="1" class="is-current">1. Basics</li>
      <li data-step-pill="2">2. Format</li>
      <li data-step-pill="3">3. Rounds</li>
      <li data-step-pill="4">4. Players</li>
      <li data-step-pill="5">5. Review</li>
    </ol>

    <form id="wizard" novalidate>
      <!-- Step 1 — Basics -->
      <section data-step="1" class="wizard__step is-current" aria-label="Basics">
        <h2 class="wizard__stepTitle">Basics</h2>

        <label class="field">
          <span class="field__label">Tournament name</span>
          <input
            type="text"
            name="name"
            id="name"
            autocomplete="off"
            required
            maxlength="80"
            placeholder="Ex. Ballyneal Brigade 2026"
          />
        </label>

        <div class="field">
          <span class="field__label">Course</span>
          <div class="courseSearch">
            <input
              type="text"
              id="courseSearch"
              autocomplete="off"
              placeholder="Search course by name…"
            />
            <ul id="courseResults" class="courseSearch__results" hidden></ul>
            <div id="coursePicked" class="courseSearch__picked" hidden>
              <div>
                <strong id="coursePickedName"></strong>
                <div id="coursePickedClub" class="courseSearch__pickedClub"></div>
              </div>
              <button
                type="button"
                id="courseChangeBtn"
                class="btn btn--ghost btn--sm"
              >Change</button>
            </div>
            <p class="field__hint">
              Type at least 2 characters. If the course isn't found,
              try the club name.
            </p>
          </div>
        </div>

        <fieldset class="field field--group">
          <legend class="field__label">Field</legend>
          <div class="radios">
            <label><input type="radio" name="fieldGender" value="male" checked /> Men</label>
            <label><input type="radio" name="fieldGender" value="female" /> Women</label>
            <label><input type="radio" name="fieldGender" value="mixed" /> Mixed</label>
          </div>
        </fieldset>
      </section>

      <!-- Step 2 — Format -->
      <section data-step="2" class="wizard__step" aria-label="Format">
        <h2 class="wizard__stepTitle">Format</h2>

        <fieldset class="field field--group">
          <legend class="field__label">Scoring mode</legend>
          <div class="radios radios--stacked">
            <label>
              <input type="radio" name="scoringMode" value="strokeAggregate" checked />
              <span><strong>Stroke play</strong> — total score across all rounds</span>
            </label>
            <label>
              <input type="radio" name="scoringMode" value="scramble" />
              <span><strong>Scramble</strong> — one team score per hole</span>
            </label>
            <label>
              <input type="radio" name="scoringMode" value="bestBall" />
              <span><strong>Best ball</strong> — team of individual scorecards, best score counts</span>
            </label>
            <label>
              <input type="radio" name="scoringMode" value="matchPlay" />
              <span><strong>Match play</strong> — head-to-head by hole</span>
            </label>
          </div>
        </fieldset>

        <label class="checkbox">
          <input type="checkbox" id="useNetScoring" checked />
          <span>Use net scoring (subtract each player's course handicap)</span>
        </label>
      </section>

      <!-- Step 3 — Rounds -->
      <section data-step="3" class="wizard__step" aria-label="Rounds">
        <h2 class="wizard__stepTitle">Rounds</h2>
        <p class="wizard__stepSub">
          Add up to 4 rounds. Each round has its own tee color +
          hole count.
        </p>

        <ul id="roundsList" class="roundsList"></ul>

        <button type="button" id="addRoundBtn" class="btn btn--ghost">
          + Add round
        </button>
      </section>

      <!-- Step 4 — Players -->
      <section data-step="4" class="wizard__step" aria-label="Players">
        <h2 class="wizard__stepTitle">Players</h2>
        <p class="wizard__stepSub">
          Add each player. Pull from your friends list for one-tap
          add, or type a name + handicap manually.
        </p>

        {friends.length > 0 && (
          <div class="friendPicker">
            <label class="friendPicker__label" for="friendSelect">
              Add from friends
            </label>
            <div class="friendPicker__row">
              <select id="friendSelect">
                <option value="">— pick a friend —</option>
                {friends.map((f) => (
                  <option
                    value={f.id}
                    data-name={f.display_name}
                    data-hcp={f.handicap}
                  >
                    {f.display_name} (HCP {f.handicap})
                  </option>
                ))}
              </select>
              <button type="button" id="addFriendBtn" class="btn btn--primary btn--sm">
                Add friend
              </button>
            </div>
          </div>
        )}

        <div class="playerAdd">
          <input type="text" id="playerNameInput" placeholder="Player name" maxlength="60" />
          <input type="number" id="playerHcpInput" placeholder="HCP" step="0.1" min="-10" max="54" />
          <button type="button" id="addPlayerBtn" class="btn btn--ghost btn--sm">Add manually</button>
        </div>

        <ul id="playersList" class="playersList" aria-live="polite"></ul>
        <p id="playersEmpty" class="wizard__stepSub">
          No players yet. Add yourself first — you're the director.
        </p>
      </section>

      <!-- Step 5 — Review -->
      <section data-step="5" class="wizard__step" aria-label="Review">
        <h2 class="wizard__stepTitle">Review</h2>

        <dl class="review">
          <div><dt>Name</dt><dd id="rvName">—</dd></div>
          <div><dt>Course</dt><dd id="rvCourse">—</dd></div>
          <div><dt>Field</dt><dd id="rvField">—</dd></div>
          <div><dt>Scoring</dt><dd id="rvScoring">—</dd></div>
          <div><dt>Net</dt><dd id="rvNet">—</dd></div>
          <div><dt>Rounds</dt><dd id="rvRounds">—</dd></div>
          <div><dt>Players</dt><dd id="rvPlayers">—</dd></div>
        </dl>

        <p class="wizard__stepSub">
          Everything else — flights, side games, sponsors, Field
          Competitions — you can configure in the mobile app once
          the tournament is created.
        </p>
      </section>

      <!-- Persistent error surface -->
      <div id="wizardError" class="errorbar" hidden></div>

      <!-- Nav buttons -->
      <div class="wizard__nav">
        <button type="button" id="backBtn" class="btn btn--ghost" disabled>
          ← Back
        </button>
        <button type="button" id="nextBtn" class="btn btn--primary">
          Next →
        </button>
        <button type="button" id="submitBtn" class="btn btn--primary" hidden>
          Create tournament
        </button>
      </div>
    </form>
  </main>
</BaseLayout>

<script is:inline define:vars={{
  defaultDirectorName: displayName,
  defaultDirectorHcp: directorHandicap,
}}>
  // ── Wizard state ──────────────────────────────────────────
  //
  // Held in module scope so the step navigation + submit can both
  // read/write without a framework store. Simple enough for 5 steps.
  //
  // state.course carries the picked course + (once loaded) the full
  // tee_boxes array from `/api/courses/[id]`. state.rounds[i] holds
  // the per-round selection AND the resolved rating/slope/par from
  // whichever tee the user picked, so the submit payload can include
  // rating/slope at the tournament level without a second fetch.
  const state = {
    step: 1,
    course: null, // {id, clubName, courseName, teeBoxes: [...] once loaded}
    rounds: [
      // Rating/slope/par default to null until a course loads +
      // the user picks a tee. Populated in renderRounds().
      { teeName: '', totalHoles: 18, format: 'stroke',
        courseRating: null, slopeRating: null, parTotal: null,
        gender: 'male' },
    ],
    players: [],
  };

  // Pre-seed the director as the first player when we have a name.
  // HCP comes from their profiles row (server-fetched); falls back
  // to 18 only when the profile HCP is null/missing.
  if (defaultDirectorName) {
    state.players.push({
      name: defaultDirectorName,
      handicap: Number.isFinite(defaultDirectorHcp) ? defaultDirectorHcp : 18,
    });
  }

  const steps = document.querySelectorAll('[data-step]');
  const pills = document.querySelectorAll('[data-step-pill]');
  const backBtn = document.getElementById('backBtn');
  const nextBtn = document.getElementById('nextBtn');
  const submitBtn = document.getElementById('submitBtn');
  const errorBox = document.getElementById('wizardError');

  function show(step) {
    state.step = step;
    steps.forEach((el) => {
      el.classList.toggle('is-current', Number(el.dataset.step) === step);
    });
    pills.forEach((el) => {
      el.classList.toggle('is-current', Number(el.dataset.stepPill) === step);
    });
    backBtn.disabled = step === 1;
    nextBtn.hidden = step === 5;
    submitBtn.hidden = step !== 5;
    errorBox.hidden = true;
    if (step === 3) renderRounds();
    if (step === 4) renderPlayers();
    if (step === 5) renderReview();
  }

  function showError(msg) {
    errorBox.textContent = msg;
    errorBox.hidden = false;
  }

  function validateStep(step) {
    if (step === 1) {
      const name = /** @type {HTMLInputElement} */ (document.getElementById('name')).value.trim();
      if (name.length === 0) return 'Tournament name is required.';
      if (!state.course) return 'Pick a course before continuing.';
    }
    if (step === 3) {
      if (state.rounds.length === 0) return 'Add at least one round.';
    }
    if (step === 4) {
      if (state.players.length === 0) return 'Add at least one player.';
    }
    return null;
  }

  nextBtn.addEventListener('click', () => {
    const err = validateStep(state.step);
    if (err) return showError(err);
    show(Math.min(state.step + 1, 5));
  });
  backBtn.addEventListener('click', () => {
    show(Math.max(state.step - 1, 1));
  });

  // ── Course search ────────────────────────────────────────
  const courseInput = /** @type {HTMLInputElement} */ (document.getElementById('courseSearch'));
  const courseResults = /** @type {HTMLUListElement} */ (document.getElementById('courseResults'));
  const coursePicked = document.getElementById('coursePicked');
  const coursePickedName = document.getElementById('coursePickedName');
  const coursePickedClub = document.getElementById('coursePickedClub');
  const courseChangeBtn = document.getElementById('courseChangeBtn');

  let debounceTimer = null;
  courseInput.addEventListener('input', () => {
    const q = courseInput.value.trim();
    if (debounceTimer) clearTimeout(debounceTimer);
    if (q.length < 2) {
      courseResults.hidden = true;
      courseResults.innerHTML = '';
      return;
    }
    debounceTimer = setTimeout(() => runSearch(q), 250);
  });

  async function runSearch(q) {
    try {
      const res = await fetch(`/api/courses/search?q=${encodeURIComponent(q)}`);
      if (!res.ok) throw new Error(`Search failed: ${res.status}`);
      const data = await res.json();
      const hits = Array.isArray(data.courses) ? data.courses : [];
      courseResults.innerHTML = '';
      if (hits.length === 0) {
        const li = document.createElement('li');
        li.className = 'courseSearch__empty';
        li.textContent = 'No matches. Try the club name.';
        courseResults.appendChild(li);
      } else {
        for (const c of hits.slice(0, 8)) {
          const li = document.createElement('li');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'courseSearch__hit';
          const name = c.course_name || c.club_name || 'Course';
          const club = c.course_name && c.club_name && c.course_name !== c.club_name ? c.club_name : null;
          btn.innerHTML =
            `<strong>${escapeHtml(name)}</strong>` +
            (club ? `<span>${escapeHtml(club)}</span>` : '') +
            (c.location ? `<em>${escapeHtml(c.location)}</em>` : '');
          btn.addEventListener('click', async () => {
            state.course = {
              id: c.id,
              clubName: c.club_name ?? null,
              courseName: c.course_name ?? null,
              teeBoxes: [], // hydrated below
            };
            coursePickedName.textContent = name;
            coursePickedClub.textContent = club ?? '';
            coursePicked.hidden = false;
            courseInput.hidden = true;
            courseResults.hidden = true;

            // Fetch full course detail so the Rounds step can render
            // real tee boxes with rating/slope/par instead of the
            // hardcoded fallback list. Non-fatal on failure — the
            // fallback list keeps the wizard usable.
            try {
              const dRes = await fetch(`/api/courses/${encodeURIComponent(c.id)}`);
              if (dRes.ok) {
                const dJson = await dRes.json();
                const teeBoxes = (dJson && dJson.course && Array.isArray(dJson.course.tee_boxes))
                  ? dJson.course.tee_boxes
                  : [];
                state.course.teeBoxes = teeBoxes;
                // If the user has already advanced past Basics, re-
                // render Rounds so the tee options refresh in place.
                if (state.step === 3) renderRounds();
                // If a round has no tee selected yet + we have tees
                // available, pre-select the first male tee (or first
                // tee overall) so the user isn't staring at empty.
                if (teeBoxes.length > 0) {
                  const preferred = teeBoxes.find((t) => t.gender === 'male') ?? teeBoxes[0];
                  for (const r of state.rounds) {
                    if (!r.teeName) applyTeeToRound(r, preferred);
                  }
                }
              }
            } catch (err) {
              // Non-fatal — the fallback tee list keeps the wizard
              // usable even if the course-detail fetch flakes.
              console.warn('[wizard] course detail fetch failed', err);
            }
          });
          li.appendChild(btn);
          courseResults.appendChild(li);
        }
      }
      courseResults.hidden = false;
    } catch (err) {
      courseResults.innerHTML = `<li class="courseSearch__empty">${escapeHtml(String(err))}</li>`;
      courseResults.hidden = false;
    }
  }

  courseChangeBtn.addEventListener('click', () => {
    state.course = null;
    coursePicked.hidden = true;
    courseInput.hidden = false;
    courseInput.value = '';
    courseInput.focus();
  });

  // ── Rounds editor ────────────────────────────────────────
  const roundsList = document.getElementById('roundsList');
  document.getElementById('addRoundBtn').addEventListener('click', () => {
    if (state.rounds.length >= 4) {
      showError('Phase 1 supports up to 4 rounds. Add more in the mobile app.');
      return;
    }
    state.rounds.push({ teeName: 'White', totalHoles: 18, format: 'stroke' });
    renderRounds();
  });

  // Apply a tee object (from the course-detail response) onto a
  // round in state.rounds. Copies name + gender + resolves the
  // rating/slope/par so the submit payload can include them at the
  // tournament level.
  function applyTeeToRound(round, tee) {
    round.teeName = tee.tee_name;
    round.gender = tee.gender || 'male';
    round.courseRating = typeof tee.course_rating === 'number' ? tee.course_rating : null;
    round.slopeRating = typeof tee.slope_rating === 'number' ? tee.slope_rating : null;
    round.parTotal = typeof tee.par_total === 'number' ? tee.par_total : null;
  }

  function teeLabel(tee) {
    const bits = [tee.tee_name];
    if (tee.gender === 'female') bits.push('(F)');
    if (tee.course_rating != null && tee.slope_rating != null) {
      bits.push(`— ${tee.course_rating} / ${tee.slope_rating}`);
    } else if (tee.course_rating != null) {
      bits.push(`— ${tee.course_rating}`);
    }
    return bits.join(' ');
  }

  function renderRounds() {
    roundsList.innerHTML = '';
    const teeBoxes = (state.course && Array.isArray(state.course.teeBoxes))
      ? state.course.teeBoxes
      : [];
    // When no course is picked yet OR the course returned no tee
    // data (some upstreams don't), fall back to a stable list of
    // generic colors so the user can still create the tournament.
    // Rating/slope won't be included in the payload; the mobile
    // app renders a fallback there too.
    const useFallback = teeBoxes.length === 0;
    const fallbackNames = ['Championship', 'Blue', 'White', 'Gold', 'Red', 'Green'];

    state.rounds.forEach((r, i) => {
      const li = document.createElement('li');
      li.className = 'roundsList__row';
      const teeOptions = useFallback
        ? fallbackNames
            .map((n) => `<option value="fallback::${escapeHtml(n)}" ${n === r.teeName ? 'selected' : ''}>${escapeHtml(n)}</option>`)
            .join('')
        : teeBoxes
            .map((t, ti) => {
              const isSel = t.tee_name === r.teeName && (t.gender || 'male') === (r.gender || 'male');
              return `<option value="idx::${ti}" ${isSel ? 'selected' : ''}>${escapeHtml(teeLabel(t))}</option>`;
            })
            .join('');
      li.innerHTML = `
        <div class="roundsList__idx">R${i + 1}</div>
        <label>
          <span>Tee</span>
          <select data-round-tee="${i}">
            ${useFallback ? '' : '<option value="">Pick a tee</option>'}
            ${teeOptions}
          </select>
        </label>
        <label>
          <span>Holes</span>
          <select data-round-holes="${i}">
            <option value="18" ${r.totalHoles === 18 ? 'selected' : ''}>18</option>
            <option value="9" ${r.totalHoles === 9 ? 'selected' : ''}>9</option>
          </select>
        </label>
        <label>
          <span>Format</span>
          <select data-round-format="${i}">
            <option value="stroke" ${r.format === 'stroke' ? 'selected' : ''}>Stroke</option>
            <option value="scramble" ${r.format === 'scramble' ? 'selected' : ''}>Scramble</option>
            <option value="bestBall" ${r.format === 'bestBall' ? 'selected' : ''}>Best ball</option>
            <option value="matchPlay" ${r.format === 'matchPlay' ? 'selected' : ''}>Match</option>
          </select>
        </label>
        <button type="button" class="roundsList__remove" data-round-remove="${i}" aria-label="Remove round ${i + 1}">×</button>
      `;
      roundsList.appendChild(li);
    });
    roundsList.querySelectorAll('[data-round-tee]').forEach((el) => {
      el.addEventListener('change', (e) => {
        const idx = Number(el.getAttribute('data-round-tee'));
        const val = /** @type {HTMLSelectElement} */ (e.target).value;
        if (val.startsWith('fallback::')) {
          const name = val.substring('fallback::'.length);
          state.rounds[idx].teeName = name;
          state.rounds[idx].gender = 'male';
          state.rounds[idx].courseRating = null;
          state.rounds[idx].slopeRating = null;
          state.rounds[idx].parTotal = null;
        } else if (val.startsWith('idx::')) {
          const ti = Number(val.substring('idx::'.length));
          const tee = teeBoxes[ti];
          if (tee) applyTeeToRound(state.rounds[idx], tee);
        } else {
          state.rounds[idx].teeName = '';
        }
      });
    });
    roundsList.querySelectorAll('[data-round-holes]').forEach((el) => {
      el.addEventListener('change', (e) => {
        const idx = Number(el.getAttribute('data-round-holes'));
        state.rounds[idx].totalHoles = Number(/** @type {HTMLSelectElement} */ (e.target).value);
      });
    });
    roundsList.querySelectorAll('[data-round-format]').forEach((el) => {
      el.addEventListener('change', (e) => {
        const idx = Number(el.getAttribute('data-round-format'));
        state.rounds[idx].format = /** @type {HTMLSelectElement} */ (e.target).value;
      });
    });
    roundsList.querySelectorAll('[data-round-remove]').forEach((el) => {
      el.addEventListener('click', () => {
        const idx = Number(el.getAttribute('data-round-remove'));
        if (state.rounds.length <= 1) {
          showError('At least one round is required.');
          return;
        }
        state.rounds.splice(idx, 1);
        renderRounds();
      });
    });
  }

  // ── Players editor ───────────────────────────────────────
  const playersList = document.getElementById('playersList');
  const playersEmpty = document.getElementById('playersEmpty');
  const playerNameInput = /** @type {HTMLInputElement} */ (document.getElementById('playerNameInput'));
  const playerHcpInput = /** @type {HTMLInputElement} */ (document.getElementById('playerHcpInput'));

  document.getElementById('addPlayerBtn').addEventListener('click', () => {
    const name = playerNameInput.value.trim();
    if (name.length === 0) {
      showError("Player name can't be empty.");
      return;
    }
    if (state.players.length >= 24) {
      showError('Phase 1 supports up to 24 players.');
      return;
    }
    const raw = playerHcpInput.value.trim();
    const hcp = raw === '' ? 18 : Number(raw);
    if (!Number.isFinite(hcp)) {
      showError("Handicap must be a number (or leave blank for 18).");
      return;
    }
    state.players.push({ name, handicap: hcp });
    playerNameInput.value = '';
    playerHcpInput.value = '';
    playerNameInput.focus();
    errorBox.hidden = true;
    renderPlayers();
  });

  // Friend picker — server-rendered <select> populated from the
  // director's public.friends roster. Adding a friend copies their
  // stored display_name + handicap onto the players list; the
  // friend_user_id becomes state.players[i].userId so the mobile
  // app can bind the player row to the actual signed-in user for
  // scoring + notifications later.
  const friendSelectEl = document.getElementById('friendSelect');
  const addFriendBtn = document.getElementById('addFriendBtn');
  if (friendSelectEl && addFriendBtn) {
    addFriendBtn.addEventListener('click', () => {
      const sel = /** @type {HTMLSelectElement} */ (friendSelectEl);
      const opt = sel.options[sel.selectedIndex];
      if (!opt || !opt.value) {
        showError('Pick a friend first.');
        return;
      }
      if (state.players.length >= 24) {
        showError('Phase 1 supports up to 24 players.');
        return;
      }
      const friendUserId = opt.value;
      const name = opt.getAttribute('data-name') || 'Friend';
      const hcpRaw = opt.getAttribute('data-hcp');
      const hcp = hcpRaw != null && Number.isFinite(Number(hcpRaw)) ? Number(hcpRaw) : 18;
      // Prevent adding the same friend twice.
      if (state.players.some((p) => p.userId && p.userId === friendUserId)) {
        showError(`${name} is already in the roster.`);
        return;
      }
      state.players.push({ name, handicap: hcp, userId: friendUserId });
      // Reset the select back to the placeholder.
      sel.selectedIndex = 0;
      errorBox.hidden = true;
      renderPlayers();
    });
  }

  function renderPlayers() {
    playersList.innerHTML = '';
    state.players.forEach((p, i) => {
      const li = document.createElement('li');
      li.className = 'playersList__row';
      li.innerHTML = `
        <span class="playersList__name">${escapeHtml(p.name)}</span>
        <span class="playersList__hcp">HCP ${p.handicap}</span>
        <button type="button" class="playersList__remove" data-player-remove="${i}" aria-label="Remove ${escapeHtml(p.name)}">×</button>
      `;
      playersList.appendChild(li);
    });
    playersList.querySelectorAll('[data-player-remove]').forEach((el) => {
      el.addEventListener('click', () => {
        const idx = Number(el.getAttribute('data-player-remove'));
        state.players.splice(idx, 1);
        renderPlayers();
      });
    });
    playersEmpty.hidden = state.players.length > 0;
  }

  // ── Review ───────────────────────────────────────────────
  function renderReview() {
    const nameEl = /** @type {HTMLInputElement} */ (document.getElementById('name'));
    const rvName = document.getElementById('rvName');
    const rvCourse = document.getElementById('rvCourse');
    const rvField = document.getElementById('rvField');
    const rvScoring = document.getElementById('rvScoring');
    const rvNet = document.getElementById('rvNet');
    const rvRounds = document.getElementById('rvRounds');
    const rvPlayers = document.getElementById('rvPlayers');
    rvName.textContent = nameEl.value.trim() || '—';
    rvCourse.textContent = state.course
      ? (state.course.courseName ?? state.course.clubName ?? '—')
      : '—';
    const fg = document.querySelector('input[name="fieldGender"]:checked');
    rvField.textContent = fg && fg.value === 'female' ? 'Women' : fg && fg.value === 'mixed' ? 'Mixed' : 'Men';
    const sm = document.querySelector('input[name="scoringMode"]:checked');
    rvScoring.textContent = ({
      strokeAggregate: 'Stroke play',
      scramble: 'Scramble',
      bestBall: 'Best ball',
      matchPlay: 'Match play',
    })[sm ? sm.value : 'strokeAggregate'];
    const netEl = /** @type {HTMLInputElement} */ (document.getElementById('useNetScoring'));
    rvNet.textContent = netEl.checked ? 'Yes' : 'No';
    rvRounds.textContent = state.rounds
      .map((r, i) => `R${i + 1} ${r.teeName} ${r.totalHoles}h`)
      .join(' · ');
    rvPlayers.textContent = state.players.length === 0
      ? 'None'
      : `${state.players.length} · ${state.players.slice(0, 3).map((p) => p.name).join(', ')}${state.players.length > 3 ? '…' : ''}`;
  }

  // ── Submit ───────────────────────────────────────────────
  submitBtn.addEventListener('click', async () => {
    const nameEl = /** @type {HTMLInputElement} */ (document.getElementById('name'));
    const fg = document.querySelector('input[name="fieldGender"]:checked');
    const sm = document.querySelector('input[name="scoringMode"]:checked');
    const netEl = /** @type {HTMLInputElement} */ (document.getElementById('useNetScoring'));

    // Course-level rating/slope/par default to the first round's
    // resolved tee data — matches how the mobile app treats
    // Round 1 as the "primary" tee for the tournament-level fields.
    const primary = state.rounds[0] || {};
    const payload = {
      name: nameEl.value.trim(),
      course: state.course
        ? {
            id: state.course.id,
            clubName: state.course.clubName,
            courseName: state.course.courseName,
          }
        : null,
      // Full tee-box catalog from the picked course (empty when the
      // upstream didn't return per-tee data — mobile app renders
      // its own fallback in that case).
      teeBoxes: state.course && Array.isArray(state.course.teeBoxes)
        ? state.course.teeBoxes
        : [],
      courseRating: primary.courseRating ?? null,
      slopeRating: primary.slopeRating ?? null,
      parTotal: primary.parTotal ?? null,
      fieldGender: fg ? fg.value : 'male',
      scoringMode: sm ? sm.value : 'strokeAggregate',
      useNetScoring: netEl.checked,
      rounds: state.rounds,
      players: state.players,
    };

    submitBtn.disabled = true;
    submitBtn.textContent = 'Creating…';
    errorBox.hidden = true;
    try {
      const res = await fetch('/api/tournaments/create', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        showError(data.error || `Create failed with ${res.status}`);
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create tournament';
        return;
      }
      const id = data.id;
      if (!id) {
        showError('Tournament was created but the id was not returned.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create tournament';
        return;
      }
      window.location.href = `/app/tournaments/${encodeURIComponent(id)}/leaderboard`;
    } catch (err) {
      showError(err && err.message ? err.message : 'Network error — try again.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Create tournament';
    }
  });

  // ── Utils ────────────────────────────────────────────────
  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, (ch) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    })[ch] || ch);
  }

  // First render
  show(1);
</script>

