    .quick {
      min-height: 40px; padding: 4px 10px; border-radius: 6px; cursor: pointer;
      border: 1px solid var(--brand-green, #1A5C38); background: #fff;
      color: var(--brand-green, #1A5C38); font-size: 0.9375rem; font-weight: 600;
