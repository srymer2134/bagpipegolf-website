    .other { margin-top: 8px; }
    .other > summary { font-size: 0.875rem; cursor: pointer; color: var(--brand-green, #1A5C38); padding: 4px 0; }
    .formats { display: grid; gap: 6px; margin: 0 0 8px; max-width: 520px; }
