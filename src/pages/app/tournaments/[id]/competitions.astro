---
// Tournament-wide competitions — W4b of the parity plan.
//
// Sam's requirement, verbatim: "if its a tourney wide side game or
// competition (i.e.-closest to the pin, skins, etc) that will need to
// be something the TD/LDs have access to update on the website as
// well as the app."
//
// What is editable here, and why only these:
//
//   * CLOSEST TO PIN — per hole, per round. Nobody can derive this
//     from a scorecard; a human watched the shot. Until now it could
//     only be entered in the app, so a director at a clubhouse desk
//     had to pick up a phone.
//   * LONGEST DRIVE — per gender bracket, per round. Same reason.
//
//   * SKINS results are deliberately NOT editable. They are computed
//     from scores (`skinsPool.ts`), so "editing" one would mean
//     overriding the engine. Which skins pools run (gross / net /
//     super) and their buy-ins ARE configured here, under "Set up
//     competitions".
//
// Setup also carries, per round, which holes run CTP and Longest Drive
// (`ctp_holes`, `longest_drive_holes`), and the Longest Drive option
// the field gender allows — the same choices as the app wizard
// (2026-11-08). Winners are picked from the roster by tournament player
// id; an old typed name stays visible with a "re-pick" hint and is
// never silently cleared.
//
// Which holes offer a CTP picker comes from `resolveCtpHoles`, a port
// of the app's resolver pinned by fixtures generated from it
// (`ctpHoles.ts` + `__fixtures__/ctp-holes.json`). Offering the wrong
// holes is quietly wrong in both directions: too few and a prize goes
// unpaid, too many and pickers spray over a round where the director
// deliberately chose two.
//
// WRITE SAFETY: the browser never sends `rounds`. See
// `/api/tournaments/[id]/competitions` and `lib/tournamentWrite.ts`.

import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TournamentSubnav from '../../../../components/TournamentSubnav.astro';
import { createSupabaseClient } from '../../../../lib/supabase';
import {
  getPublicTournament,
  holeCountForRound,
  parsForRound,
  type TournamentPlayer,
  type TournamentRound,
} from '../../../../lib/tournamentQueries';
import {
  explicitCtpHoles,
  longestDriveGenders,
  par3Holes,
  resolveCtpHoles,
} from '../../../../lib/ctpHoles';
import {
  fieldGenderOf,
  readCompetitionConfig,
  SKINS_KINDS,
} from '../../../../lib/competitionConfig';
import {
  explicitLdHoles,
  formatHoleList,
  holesWithPar,
  LD_FORMAT_DESCRIPTION,
  LD_FORMAT_LABEL,
  ldHolesLabel,
  longestDriveFieldNoteFor,
  longestDriveFormatFrom,
  longestDriveFormatsFor,
  longestDriveTitleFor,
  resolveLdHoles,
} from '../../../../lib/fieldCompetitions';
import {
  competitionRosterFor,
  describeCompetitionWinner,
} from '../../../../lib/competitionWinner';

const { id } = Astro.params;
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.request.url)}`, 302);
}

const supabase = createSupabaseClient({
  request: Astro.request,
  cookies: Astro.cookies,
  locals: Astro.locals,
});

let tournament = null;
let loadError: string | null = null;
try {
  tournament = await getPublicTournament(supabase, id!);
} catch (err: any) {
  loadError = err?.message ?? 'Could not load tournament.';
}

if (tournament && tournament.user_id !== user.id) {
  return Astro.redirect(`/app/tournaments/${id}/leaderboard`, 302);
}

const rounds: TournamentRound[] = tournament?.rounds ?? [];
const wanted = Astro.url.searchParams.get('round');
const round = rounds.find((r) => r.id === wanted) ?? rounds[0] ?? null;
const players: TournamentPlayer[] = tournament?.players ?? [];

// ── Winners (the observation side) ───────────────────────────────
const ctpHoles = tournament && round ? resolveCtpHoles(tournament, round) : [];
const ldGenders = tournament ? longestDriveGenders(tournament) : [];
const roundLdLabel = tournament && round ? ldHolesLabel(tournament, round) : null;

function storedCtp(r: TournamentRound | null): Record<string, string> {
  if (!r) return {};
  const raw = (r as Record<string, unknown>).closest_to_pin_by_hole
    ?? (r as Record<string, unknown>).closestToPinByHole;
  if (!raw || typeof raw !== 'object') return {};
  const out: Record<string, string> = {};
  for (const [k, v] of Object.entries(raw as Record<string, unknown>)) {
    const hole = Number(k);
    // Normalise "05" -> "5" so lookups by hole number hit, and drop a
    // non-numeric key rather than storing it under "NaN".
    if (!Number.isInteger(hole) || hole < 1) continue;
    if (typeof v === 'string' && v.length > 0) out[String(hole)] = v;
  }
  return out;
}
const ctp = storedCtp(round);

// One picker per configured CTP hole, plus any hole that still holds a
// recorded winner after the director narrowed `ctp_holes` — the app's
// `ctpRowHolesFor`, so an entry is never hidden. An untracked hole only
// offers "keep" or "clear", which is all the route permits there.
const ctpRows = Array.from(new Set([
  ...ctpHoles,
  ...Object.keys(ctp).map(Number).filter((h) => Number.isInteger(h)),
])).sort((a, b) => a - b).map((hole) => ({
  hole,
  tracked: ctpHoles.includes(hole),
  current: describeCompetitionWinner(players, ctp[String(hole)]),
}));

// The pickers list the round's players (attendance honoured), by
// tournament player id — never typed names. A stored value that is not
// a roster id is resolved by the app's rule (id, else a UNIQUE name);
// anything else stays visible as legacy text with a "re-pick" hint and
// is sent back untouched, so a save never deletes it.
const ctpRoster = tournament && round ? competitionRosterFor(tournament, round) : [];
const roundRow = (round ?? {}) as Record<string, unknown>;
const ldRows = ldGenders.map((g) => {
  let roster = tournament && round ? competitionRosterFor(tournament, round, g) : [];
  // A mixed field whose players carry no gender would offer an empty
  // women's list (unset defaults to men, as in the app). Rather than a
  // picker nobody can use, offer the round's whole field and say so.
  const fellBack = roster.length === 0 && ctpRoster.length > 0;
  if (fellBack) roster = ctpRoster;
  const stored = g === 'male'
    ? roundRow.longest_drive_male_id ?? roundRow.longestDriveMaleId
    : roundRow.longest_drive_female_id ?? roundRow.longestDriveFemaleId;
  return {
    gender: g,
    label: g === 'male' ? "Men's" : "Women's",
    roster,
    fellBack,
    current: describeCompetitionWinner(players, stored),
  };
});

// ── Setup (the config side) ──────────────────────────────────────
const config = tournament ? readCompetitionConfig(tournament) : null;
const fieldGender = tournament ? fieldGenderOf(tournament) : 'male';
const ldFormats = longestDriveFormatsFor(fieldGender);
const ldRawGenders = tournament
  ? ((tournament as Record<string, unknown>).longest_drive_genders
      ?? (tournament as Record<string, unknown>).longestDriveGenders)
  : null;
const ldFormat = longestDriveFormatFrom(
  Array.isArray(ldRawGenders) ? (ldRawGenders as unknown[]).map(String)
    : config && config.longestDriveGenders.length > 0 ? config.longestDriveGenders : null,
  fieldGender,
);

// Per-round hole pickers, mirroring the app wizard's
// `_buildCtpHolesSetup` / `_buildLongestDriveSetup`: CTP offers the par
// 3s up front (all selected by default) with every other hole behind
// "Other holes"; LD offers the par 5s up front with the par 4s behind
// "Other holes" and never a par 3. With no pars loaded every hole is
// offered up front.
const roundSetups = tournament
  ? rounds.map((r) => {
      const pars = parsForRound(tournament!, r);
      const count = holeCountForRound(tournament!, r) || 18;
      const all = Array.from({ length: count }, (_, i) => i + 1);
      const noPars = pars.length === 0;
      const p3 = par3Holes(tournament!, r);
      const p5 = holesWithPar(pars, 5);
      const explicitCtp = explicitCtpHoles(r);
      return {
        id: r.id,
        name: r.name,
        noPars,
        par3s: p3,
        ctpPrimary: noPars ? all : p3,
        ctpOther: noPars ? [] : all.filter((h) => !p3.includes(h)),
        ctpSelected: explicitCtp ?? p3,
        ldPrimary: noPars ? all : p5,
        ldOther: noPars ? [] : all.filter((h) => !p3.includes(h) && !p5.includes(h)),
        ldSelected: explicitLdHoles(r) ?? [],
      };
    })
  : [];

const SKINS_LABELS: Record<string, string> = {
  gross_skins: 'Gross skins',
  net_skins: 'Net skins',
  super_skins: 'Super skins (gross, across flights)',
};

const BUYIN_KINDS: Array<{ key: string; label: string; on: boolean }> = config
  ? [
      ...SKINS_KINDS.map((k) => ({
        key: k, label: SKINS_LABELS[k] ?? k, on: config.skins.includes(k),
      })),
      { key: 'closest_to_pin', label: 'Closest to the pin', on: config.closestToPin },
      { key: 'longest_drive', label: 'Longest drive', on: config.longestDrive },
    ]
  : [];
const hasAnything = ctpRows.length > 0 || ldRows.length > 0;
const optLabel = (p: TournamentPlayer) => p.name;
---

<BaseLayout title="Competitions · Bagpipe Golf">
  <main class="pagewrap">
    {loadError && <div class="notice notice--warn">{loadError}</div>}
    {!tournament && !loadError && (
      <div class="notice notice--warn">That tournament could not be found.</div>
    )}

    {tournament && (
      <>
        <p class="pagewrap__eyebrow">{tournament.name}</p>
        <h1 class="pagewrap__title">Competitions.</h1>
        <TournamentSubnav id={id!} active="competitions" />

        {rounds.length === 0 && (
          <div class="notice notice--warn">This tournament has no rounds yet.</div>
        )}

        {config && (
          <details class="setup" open={!hasAnything && config.skins.length === 0}>
            <summary>Set up competitions</summary>
            <p class="hint">
              Which field-wide competitions this tournament runs, and what each
              costs to enter. Skins are scored from the cards; closest to the
              pin and longest drive are recorded by hand below.
            </p>

            <div id="cfgMsg" class="notice" role="status" hidden></div>

            <fieldset class="grp">
              <legend class="grp__h">Skins</legend>
              <ul class="list">
                {SKINS_KINDS.map((k) => (
                  <li class="item">
                    <label class="chk">
                      <input type="checkbox" data-cfg="skins" value={k}
                             checked={config.skins.includes(k)} />
                      <span>{SKINS_LABELS[k]}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </fieldset>

            <fieldset class="grp">
              <legend class="grp__h">Closest to the pin</legend>
              <label class="chk">
                <input type="checkbox" data-cfg="ctp" checked={config.closestToPin} />
                <span>Closest to the pin</span>
              </label>
              <div class="perRound" data-show-when="ctp" hidden={!config.closestToPin}>
                <p class="hint">
                  Pick the CTP holes for each round. The par 3s are on by
                  default; add any other hole (a short par 4) under
                  &ldquo;Other holes&rdquo;.
                </p>
                {roundSetups.map((r) => (
                  <div class="roundPick" data-round={r.id} data-kind="ctp">
                    <p class="roundPick__h">{r.name}</p>
                    <p class="roundPick__sum" data-summary
                       data-none="No CTP this round — tick a hole to add one">
                      {r.ctpSelected.length > 0
                        ? `On ${formatHoleList(r.ctpSelected)}`
                        : 'No CTP this round — tick a hole to add one'}
                    </p>
                    <div class="holes" role="group" aria-label={`Closest to the pin holes, ${r.name}`}>
                      {r.par3s.length > 0 && (
                        <button type="button" class="quick" data-quick={JSON.stringify(r.par3s)}>
                          All par 3s
                        </button>
                      )}
                      {r.ctpPrimary.map((h) => (
                        <label class="hole">
                          <input type="checkbox" data-hole={String(h)}
                                 checked={r.ctpSelected.includes(h)} />
                          <span>#{h}</span>
                        </label>
                      ))}
                    </div>
                    {r.ctpOther.length > 0 && (
                      <details class="other"
                               open={r.ctpOther.some((h) => r.ctpSelected.includes(h))}>
                        <summary>Other holes (e.g. a short par 4)</summary>
                        <div class="holes">
                          {r.ctpOther.map((h) => (
                            <label class="hole hole--odd">
                              <input type="checkbox" data-hole={String(h)}
                                     checked={r.ctpSelected.includes(h)} />
                              <span>#{h}</span>
                            </label>
                          ))}
                        </div>
                      </details>
                    )}
                  </div>
                ))}
              </div>
            </fieldset>

            <fieldset class="grp">
              <legend class="grp__h">Longest drive</legend>
              <label class="chk">
                <input type="checkbox" data-cfg="ld" checked={config.longestDrive} />
                <span>{longestDriveTitleFor(fieldGender)}</span>
              </label>
              <div data-show-when="ld" hidden={!config.longestDrive}>
                <p class="hint">{longestDriveFieldNoteFor(fieldGender)}</p>
                {ldFormats.length > 1 && (
                  <div class="formats" role="radiogroup" aria-label="Who competes for longest drive">
                    {ldFormats.map((f) => (
                      <label class="fmt">
                        <input type="radio" name="ldFormat" value={f}
                               data-genders={JSON.stringify(
                                 f === 'mensAndWomens' ? ['male', 'female']
                                 : f === 'mensOnly' ? ['male'] : ['female'])}
                               checked={ldFormat === f} />
                        <span>
                          <strong>{LD_FORMAT_LABEL[f]}</strong>
                          <em>{LD_FORMAT_DESCRIPTION[f]}</em>
                        </span>
                      </label>
                    ))}
                  </div>
                )}
                <div class="perRound">
                  <p class="hint">
                    The longest-drive hole(s) for each round. Par 5s are
                    suggested; par 4s are under &ldquo;Other holes&rdquo;.
                  </p>
                  {roundSetups.map((r) => (
                    <div class="roundPick" data-round={r.id} data-kind="ld">
                      <p class="roundPick__h">{r.name}</p>
                      <p class="roundPick__sum" data-summary
                         data-none="No hole picked yet — tick the LD hole">
                        {r.ldSelected.length > 0
                          ? `On ${formatHoleList(r.ldSelected)}`
                          : 'No hole picked yet — tick the LD hole'}
                      </p>
                      <div class="holes" role="group" aria-label={`Longest drive holes, ${r.name}`}>
                        {r.ldPrimary.map((h) => (
                          <label class="hole">
                            <input type="checkbox" data-hole={String(h)}
                                   checked={r.ldSelected.includes(h)} />
                            <span>#{h}</span>
                          </label>
                        ))}
                      </div>
                      {r.ldOther.length > 0 && (
                        <details class="other"
                                 open={r.ldOther.some((h) => r.ldSelected.includes(h))}>
                          <summary>Other holes (par 4s)</summary>
                          <div class="holes">
                            {r.ldOther.map((h) => (
                              <label class="hole hole--odd">
                                <input type="checkbox" data-hole={String(h)}
                                       checked={r.ldSelected.includes(h)} />
                                <span>#{h}</span>
                              </label>
                            ))}
                          </div>
                        </details>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </fieldset>

            <fieldset class="grp">
              <legend class="grp__h">Entry per player</legend>
              <p class="hint">Leave at 0 to track without money.</p>
              <ul class="list">
                {BUYIN_KINDS.map((b) => (
                  <li class="item">
                    <label class="item__label" for={`buyin_${b.key}`}>{b.label}</label>
                    <input class="item__buyin" type="number" min="0" step="1"
                           inputmode="decimal" id={`buyin_${b.key}`}
                           data-buyin={b.key}
                           value={String(config.buyIns[b.key] ?? 0)} />
                  </li>
                ))}
              </ul>
            </fieldset>

            <button type="button" class="btn btn--primary" id="saveCfg">
              Save setup
            </button>
          </details>
        )}

        {round && rounds.length > 1 && (
          <nav class="rounds" aria-label="Choose a round">
            {rounds.map((r) => (
              <a
                href={`/app/tournaments/${id}/competitions?round=${encodeURIComponent(r.id)}`}
                class:list={['rounds__chip', r.id === round.id && 'is-active']}
                aria-current={r.id === round.id ? 'page' : undefined}
              >{r.name}</a>
            ))}
          </nav>
        )}

        {round && !hasAnything && (
          <div class="notice">
            No closest-to-pin or longest-drive prize is set up for this round.
            Turn them on under &ldquo;Set up competitions&rdquo; above, and the
            winner pickers will appear here.
          </div>
        )}

        {round && hasAnything && (
          <>
            <div id="saveMsg" class="notice" role="status" hidden></div>

            {ctpRows.length > 0 && (
              <section class="block">
                <h2 class="block__h">Closest to the pin</h2>
                <p class="hint">
                  {ctpHoles.length > 0
                    ? `${round.name}: ${formatHoleList(ctpHoles)}. Leave a hole on “nobody” if no one hit the green.`
                    : `No CTP holes on ${round.name} any more.`}
                </p>
                <ul class="list">
                  {ctpRows.map((row) => (
                    <li class="item item--stack">
                      <label class="item__label" for={`ctp_${row.hole}`}>
                        Hole {row.hole}
                        {!row.tracked && <span class="tag">no longer a CTP hole</span>}
                      </label>
                      <select class="item__pick" id={`ctp_${row.hole}`} data-ctp={String(row.hole)}>
                        <option value="">{row.tracked ? '— nobody —' : '— clear —'}</option>
                        {row.current.legacyText && (
                          <option value={row.current.stored ?? ''} selected>
                            {row.current.legacyText} (not on the roster · re-pick)
                          </option>
                        )}
                        {row.tracked
                          ? ctpRoster.map((p) => (
                              <option value={p.id} selected={row.current.player?.id === p.id}>
                                {optLabel(p)}
                              </option>
                            ))
                          : row.current.player && (
                              <option value={row.current.stored ?? row.current.player.id} selected>
                                {row.current.player.name}
                              </option>
                            )}
                      </select>
                      {row.current.legacyText && (
                        <p class="legacy">
                          &ldquo;{row.current.legacyText}&rdquo; was typed in by hand
                          and matches no one on the roster. Pick the winner from
                          the list to link them.
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {ldRows.length > 0 && (
              <section class="block">
                <h2 class="block__h">Longest drive</h2>
                <p class="hint">
                  One winner per {ldRows.length > 1 ? 'bracket, ' : ''}per round.
                  {roundLdLabel ? ` ${round.name}: ${roundLdLabel}.` : ''}
                </p>
                <ul class="list">
                  {ldRows.map((row) => (
                    <li class="item item--stack">
                      <label class="item__label" for={`ld_${row.gender}`}>{row.label}</label>
                      <select class="item__pick" id={`ld_${row.gender}`} data-ld={row.gender}>
                        <option value="">&mdash; nobody &mdash;</option>
                        {row.current.legacyText && (
                          <option value={row.current.stored ?? ''} selected>
                            {row.current.legacyText} (not on the roster · re-pick)
                          </option>
                        )}
                        {row.roster.map((p) => (
                          <option value={p.id} selected={row.current.player?.id === p.id}>
                            {optLabel(p)}
                          </option>
                        ))}
                        {row.current.player && !row.roster.some((p) => p.id === row.current.player!.id) && (
                          <option value={row.current.player.id} selected>
                            {row.current.player.name}
                          </option>
                        )}
                      </select>
                      {row.fellBack && (
                        <p class="legacy">
                          No player on this round is marked {row.gender === 'female' ? 'female' : 'male'},
                          so the whole field is listed.
                        </p>
                      )}
                      {row.current.legacyText && (
                        <p class="legacy">
                          &ldquo;{row.current.legacyText}&rdquo; was typed in by hand
                          and matches no one on the roster. Pick the winner from
                          the list to link them.
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            )}

            <button type="button" class="btn btn--primary" id="save">
              Save winners
            </button>
          </>
        )}

        <p class="foot">
          Skins are computed from the scorecards, not recorded here &mdash;
          see the <a href={`/app/tournaments/${id}/leaderboard?board=skins`}>skins board</a>
          and the <a href={`/app/tournaments/${id}/payouts`}>payouts</a> page.
        </p>
      </>
    )}
  </main>

  <script
    is:inline
    define:vars={{
      apiPath: `/api/tournaments/${id}/competitions`,
      cfgPath: `/api/tournaments/${id}/competition-config`,
      roundId: round?.id ?? null,
      isMixed: fieldGender === 'mixed',
    }}
  >
    // ── Setup: show the per-round pickers only for what is switched on ──
    for (const kind of ['ctp', 'ld']) {
      const box = document.querySelector(`[data-cfg="${kind}"]`);
      const panel = document.querySelector(`[data-show-when="${kind}"]`);
      if (box && panel) {
        box.addEventListener('change', () => { panel.hidden = !box.checked; });
      }
    }

    // ── Per-round hole pickers ──
    // A round's list is only SENT when the director touched it. An
    // untouched round keeps what it has — in particular an absent
    // `ctp_holes`, which means "follow the par 3s" — instead of being
    // frozen into an explicit list by an unrelated save.
    const holesOf = (pick) =>
      [...pick.querySelectorAll('input[data-hole]')]
        .filter((el) => el.checked)
        .map((el) => Number(el.dataset.hole))
        .sort((a, b) => a - b);
    const summarise = (pick) => {
      const sum = pick.querySelector('[data-summary]');
      const holes = holesOf(pick);
      sum.textContent = holes.length > 0
        ? `On ${holes.map((h) => `#${h}`).join(', ')}`
        : sum.dataset.none;
    };
    document.querySelectorAll('.roundPick').forEach((pick) => {
      pick.addEventListener('change', (e) => {
        if (!e.target.matches('input[data-hole]')) return;
        pick.dataset.dirty = '1';
        summarise(pick);
      });
      const quick = pick.querySelector('[data-quick]');
      if (quick) {
        quick.addEventListener('click', () => {
          const want = new Set(JSON.parse(quick.dataset.quick));
          pick.querySelectorAll('input[data-hole]').forEach((el) => {
            el.checked = want.has(Number(el.dataset.hole));
          });
          pick.dataset.dirty = '1';
          summarise(pick);
        });
      }
    });

    const saveCfg = document.getElementById('saveCfg');
    if (saveCfg) {
      const cfgNote = (msg, kind) => {
        const n = document.getElementById('cfgMsg');
        n.textContent = msg;
        n.className = `notice notice--${kind}`;
        n.hidden = false;
      };
      const checked = (sel) =>
        [...document.querySelectorAll(sel)].filter((el) => el.checked);

      saveCfg.addEventListener('click', async () => {
        const buyIns = {};
        document.querySelectorAll('[data-buyin]').forEach((el) => {
          const n = Number(el.value);
          if (Number.isFinite(n) && n > 0) buyIns[el.dataset.buyin] = n;
        });
        const fmt = document.querySelector('input[name="ldFormat"]:checked');

        const config = {
          skins: checked('[data-cfg="skins"]').map((el) => el.value),
          closestToPin: !!document.querySelector('[data-cfg="ctp"]')?.checked,
          longestDrive: !!document.querySelector('[data-cfg="ld"]')?.checked,
          // A single-gender event derives its bracket server-side from
          // field_gender; only a mixed field sends its one LD option.
          longestDriveGenders: isMixed && fmt ? JSON.parse(fmt.dataset.genders) : [],
          buyIns,
        };

        const byRound = new Map();
        document.querySelectorAll('.roundPick[data-dirty="1"]').forEach((pick) => {
          const entry = byRound.get(pick.dataset.round) || { roundId: pick.dataset.round };
          entry[pick.dataset.kind === 'ctp' ? 'ctpHoles' : 'ldHoles'] = holesOf(pick);
          byRound.set(pick.dataset.round, entry);
        });

        saveCfg.disabled = true;
        saveCfg.textContent = 'Saving…';
        try {
          const res = await fetch(cfgPath, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ config, rounds: [...byRound.values()] }),
          });
          const out = await res.json().catch(() => ({}));
          if (!res.ok) {
            cfgNote(out.guard === 'score_loss'
              ? `${out.error} Reload this page to pick up the latest.`
              : (out.error || 'Could not save the setup.'), 'warn');
            return;
          }
          // The page renders its pickers FROM this config, so a reload
          // is the honest way to show the new shape.
          cfgNote('Setup saved — reloading…', 'ok');
          window.location.reload();
        } catch {
          cfgNote('Network error — nothing was saved.', 'warn');
        } finally {
          saveCfg.disabled = false;
          saveCfg.textContent = 'Save setup';
        }
      });
    }

    if (roundId) {
      const save = document.getElementById('save');
      if (save) {
        save.addEventListener('click', async () => {
          const closestToPin = {};
          document.querySelectorAll('[data-ctp]').forEach((el) => {
            closestToPin[el.dataset.ctp] = el.value || '';
          });
          const body = { roundId, closestToPin };
          // Only brackets that render are sent; an absent key leaves that
          // winner alone on the server.
          const male = document.querySelector('[data-ld="male"]');
          const female = document.querySelector('[data-ld="female"]');
          if (male) body.longestDriveMaleId = male.value || null;
          if (female) body.longestDriveFemaleId = female.value || null;

          const note = (msg, kind) => {
            const n = document.getElementById('saveMsg');
            n.textContent = msg;
            n.className = `notice notice--${kind}`;
            n.hidden = false;
          };

          save.disabled = true;
          save.textContent = 'Saving…';
          try {
            const res = await fetch(apiPath, {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify(body),
            });
            const out = await res.json().catch(() => ({}));
            if (!res.ok) {
              note(out.guard === 'score_loss'
                ? `${out.error} Reload this page to pick up the latest.`
                : (out.error || 'Could not save the winners.'), 'warn');
              return;
            }
            note('Winners saved.', 'ok');
          } catch {
            note('Network error — nothing was saved.', 'warn');
          } finally {
            save.disabled = false;
            save.textContent = 'Save winners';
          }
        });
      }
    }
  </script>

