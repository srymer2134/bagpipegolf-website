---
// Manage tournament — Slice A1 (roster editor).
//
// Director-only surface. Ships the "Roster" card from the earlier
// wireframe stub as a real editor + leaves the other cards
// (Lifecycle, Per-round setup, Communications, Sponsors, Settle &
// post) as "Coming soon" for Slice A2/A3/A4.
//
// Auth chain:
//   1. Middleware gates the /app/* prefix behind a signed-in
//      Supabase session (see src/middleware.ts). Signed-out
//      visitors bounce to /login already.
//   2. THIS page then loads the tournament and enforces
//      director-only access: only the row's `user_id` (the creator)
//      sees the editor. Non-directors who are signed in get
//      redirected to the read-only spectator leaderboard —
//      matches the existing UX pattern where /manage is the
//      admin surface + /leaderboard is the shared surface.
//
// Roster save flow:
//   * Client posts the mutated `players` array to
//     `/api/tournaments/[id]/update`.
//   * That Astro API route proxies PATCH /api/tournaments/:id to
//     Railway with the visitor's Supabase JWT. Same allowlist +
//     ownership check the mobile app hits.
//   * On success, we reload the page so the server-rendered
//     roster reflects the truth — no client-side state sync
//     needed for A1.

import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TournamentSubnav from '../../../../components/TournamentSubnav.astro';
import { createSupabaseClient } from '../../../../lib/supabase';
import { getPublicTournament, type TournamentPlayer } from '../../../../lib/tournamentQueries';

const { id } = Astro.params;
const user = Astro.locals.user;

// Middleware guarantees `user` is non-null on /app/* — this belt-
// and-suspenders redirect covers the odd race where the auth
// cookie expires between middleware and page render.
if (!user) {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.request.url)}`, 302);
}

const supabase = createSupabaseClient({
  request: Astro.request,
  cookies: Astro.cookies,
  locals: Astro.locals,
});

let tournament = null;
let loadError: string | null = null;
try {
  tournament = await getPublicTournament(supabase, id!);
} catch (err: any) {
  loadError = err?.message ?? 'Could not load tournament.';
}

// Director gate. If the row exists but the current user isn't the
// creator, bounce to the read-only leaderboard. Later slices may
// broaden this (e.g. co-directors via `captainUserIds`) but for A1
// we mirror the mobile app's owner-only edit surface.
if (tournament && tournament.user_id !== user.id) {
  return Astro.redirect(`/app/tournaments/${id}/leaderboard`, 302);
}

// Fetch the director's friends roster for the "Add from friends"
// picker — same server-side pattern as the wizard.
type Friend = { id: string; display_name: string; handicap: number };
let friends: Friend[] = [];
if (tournament) {
  try {
    const { data } = await supabase
      .from('friends')
      .select('friend_user_id, display_name, handicap')
      .eq('user_id', user.id)
      .order('display_name');
    if (Array.isArray(data)) {
      const seen = new Set<string>();
      friends = data
        .map((f: Record<string, unknown>) => ({
          id: String(f.friend_user_id ?? ''),
          display_name: String(f.display_name ?? '').trim(),
          handicap:
            typeof f.handicap === 'number' && Number.isFinite(f.handicap)
              ? f.handicap
              : 18,
        }))
        .filter((f) => {
          if (!f.id || !f.display_name) return false;
          if (seen.has(f.id)) return false;
          seen.add(f.id);
          return true;
        });
    }
  } catch (e) {
    console.warn('[tournaments/[id]/manage] friends fetch failed', e);
  }
}

const players: TournamentPlayer[] = tournament?.players ?? [];
const playerCount = players.length;

// Pre-fetch tournament invites (roadmap #5) so the Invites card
// renders with real chip state on first paint. Owner-read RLS
// policy from `20260612_tournament_invites.sql` scopes this to
// the director. `accepted` rows are filtered client-side by the
// mobile app; we do it here too so a full-house tournament doesn't
// render 20 "accepted" chips alongside the actual roster.
type TournamentInvite = {
  id: string;
  email: string;
  token: string;
  status: string;
  created_at: string | null;
};
let initialInvites: TournamentInvite[] = [];
if (tournament) {
  try {
    const { data } = await supabase
      .from('tournament_invites')
      .select('id, email, token, status, created_at')
      .eq('tournament_id', id!)
      .neq('status', 'accepted')
      .order('created_at', { ascending: false });
    if (Array.isArray(data)) {
      initialInvites = data.map((row: Record<string, unknown>) => ({
        id: String(row.id ?? ''),
        email: String(row.email ?? ''),
        token: String(row.token ?? ''),
        status: String(row.status ?? 'pending'),
        created_at:
          typeof row.created_at === 'string' ? row.created_at : null,
      }));
    }
  } catch (e) {
    console.warn('[tournaments/[id]/manage] invites fetch failed', e);
  }
}
---

<BaseLayout title="Manage tournament · Bagpipe Golf">
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">Tournament · director controls</p>
    <h1 class="pagewrap__title">Manage tournament.</h1>
    <p class="pagewrap__sub">
      <span class="chip chip--warn">Director only</span>
      Wizard-equivalent surface for the tournament director.
    </p>

    <TournamentSubnav id={id!} active="manage" />

    {loadError && (
      <div class="errorbar" role="alert">⚠️ {loadError}</div>
    )}

    {!tournament && !loadError && (
      <div class="empty">
        <h3>Tournament not found</h3>
        <p>
          We couldn't load a tournament with that id. It may have
          been deleted, or the link may be wrong.
        </p>
      </div>
    )}

    {tournament && (
      <>
        <!-- Basics card (Slice A2) — rename tournament -->
        <section class="rosterCard" data-card="basics">
          <header class="rosterCard__head">
            <div>
              <h2 class="rosterCard__title">Basics</h2>
              <p class="rosterCard__meta">
                Rename the tournament. Anything that references it
                (leaderboard, share links) updates automatically.
              </p>
            </div>
          </header>

          <div id="basicsError" class="errorbar" hidden></div>

          <label class="fieldLabel" for="basicsName">Tournament name</label>
          <input
            type="text"
            id="basicsName"
            class="basicsInput"
            value={tournament.name}
            maxlength="80"
          />

          <div class="rosterCard__actions">
            <button type="button" id="basicsCancelBtn" class="btn btn--ghost">
              Cancel
            </button>
            <button type="button" id="basicsSaveBtn" class="btn btn--primary" disabled>
              Save name
            </button>
          </div>
        </section>

        <!-- Rounds card (Slice A2) — add / remove / edit rounds -->
        <section class="rosterCard" data-card="rounds">
          <header class="rosterCard__head">
            <div>
              <h2 class="rosterCard__title">Rounds</h2>
              <p class="rosterCard__meta">
                <span id="roundCount">{tournament.rounds?.length ?? 0}</span> of 12 ·
                add or edit rounds, change tee or format, remove
                rounds that haven't been played.
              </p>
            </div>
          </header>

          <div id="roundsError" class="errorbar" hidden></div>

          <ul id="roundsList" class="roundsList" aria-live="polite"></ul>

          <button type="button" id="addRoundBtn" class="btn btn--ghost btn--sm">
            + Add round
          </button>

          <div class="rosterCard__actions">
            <button type="button" id="roundsCancelBtn" class="btn btn--ghost">
              Cancel
            </button>
            <button type="button" id="roundsSaveBtn" class="btn btn--primary" disabled>
              Save rounds
            </button>
          </div>
        </section>

        <section class="rosterCard">
          <header class="rosterCard__head">
            <div>
              <h2 class="rosterCard__title">Roster</h2>
              <p class="rosterCard__meta">
                <span id="playerCount">{playerCount}</span>
                {' '}player{playerCount === 1 ? '' : 's'} ·
                {' '}<strong>{tournament.name}</strong>
              </p>
            </div>
          </header>

          <div id="wizardError" class="errorbar" hidden></div>

          {friends.length > 0 && (
            <div class="friendPicker">
              <label class="friendPicker__label" for="friendSelect">
                Add from friends
              </label>
              <div class="friendPicker__row">
                <select id="friendSelect">
                  <option value="">— pick a friend —</option>
                  {friends.map((f) => (
                    <option
                      value={f.id}
                      data-name={f.display_name}
                      data-hcp={f.handicap}
                    >
                      {f.display_name} (Handicap {f.handicap})
                    </option>
                  ))}
                </select>
                <button type="button" id="addFriendBtn" class="btn btn--primary btn--sm">
                  Add friend
                </button>
              </div>
            </div>
          )}

          <div class="playerAdd">
            <input type="text" id="playerNameInput" placeholder="Player name" maxlength="60" />
            <input type="number" id="playerHcpInput" placeholder="Handicap" step="0.1" min="-10" max="54" />
            <button type="button" id="addPlayerBtn" class="btn btn--ghost btn--sm">Add manually</button>
          </div>

          <ul id="playersList" class="playersList" aria-live="polite">
            {players.map((p, idx) => (
              <li
                class="playersList__row"
                data-player-idx={idx}
                data-player-id={p.id}
                data-player-name={p.name}
                data-player-hcp={p.handicapIndex ?? ''}
                data-player-user-id={p.userId ?? ''}
              >
                <span class="playersList__name">
                  {p.name}
                  {p.userId ? <span class="badge badge--user">Bagpipe user</span> : null}
                </span>
                <input
                  type="number"
                  step="0.1"
                  min="-10"
                  max="54"
                  class="playersList__hcpInput"
                  data-hcp-edit-idx={idx}
                  value={p.handicapIndex ?? 18}
                  aria-label={`Handicap for ${p.name}`}
                />
                <button
                  type="button"
                  class="playersList__remove"
                  data-player-remove={idx}
                  aria-label={`Remove ${p.name}`}
                >×</button>
              </li>
            ))}
          </ul>
          <p id="playersEmpty" class="rosterCard__meta" hidden={playerCount > 0}>
            No players yet. Add yourself or pick from friends.
          </p>

          <div class="rosterCard__actions">
            <button type="button" id="cancelBtn" class="btn btn--ghost">
              Cancel
            </button>
            <button type="button" id="saveBtn" class="btn btn--primary" disabled>
              Save roster
            </button>
          </div>
        </section>

        <!--
          Invites card (roadmap #5) — email-to-join for players who
          aren't in the director's friends list yet. Backed by
          Patrick's §14 endpoints (POST /api/tournaments/:id/invites
          for send + re-arm-on-resend, direct Supabase UPDATE for
          revoke via the owner-scoped RLS policy).
        -->
        <section class="rosterCard" data-card="invites">
          <header class="rosterCard__head">
            <div>
              <h2 class="rosterCard__title">Invites</h2>
              <p class="rosterCard__meta">
                Email players a link to join. Existing Bagpipe users
                land on the tournament; new users sign up first, then
                accept. Resend anytime — the token doesn't change, so
                a resend just re-arms the same invite.
              </p>
            </div>
          </header>

          <div id="invitesError" class="errorbar" hidden></div>

          <div class="inviteBox">
            <div class="inviteBox__row">
              <input
                type="email"
                id="mgInviteInput"
                placeholder="name@example.com"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              />
              <button type="button" id="mgInviteAddBtn" class="btn btn--ghost btn--sm">
                Add
              </button>
              <button type="button" id="mgInviteSendBtn" class="btn btn--primary btn--sm" disabled>
                Send invites
              </button>
            </div>
            <p class="inviteBox__hint inviteBox__hint--tight">
              Tip: paste multiple emails separated by commas or new lines.
            </p>
            <ul id="mgInviteChipsList" class="inviteChips" aria-live="polite"></ul>
            <p id="mgInviteChipsEmpty" class="inviteBox__hint inviteBox__hint--muted">
              No emails queued.
            </p>
          </div>

          <h3 class="invitesList__title">Pending invites</h3>
          <ul id="mgInvitesList" class="invitesList" aria-live="polite"></ul>
          <p id="mgInvitesEmpty" class="inviteBox__hint inviteBox__hint--muted">
            No invites sent yet.
          </p>
        </section>

        <!-- Flights card — handicap-split brackets -->
        <section class="rosterCard" data-card="flights">
          <header class="rosterCard__head">
            <div>
              <h2 class="rosterCard__title">Flights</h2>
              <p class="rosterCard__meta">
                Split the field into handicap-bracketed brackets —
                each flight competes for its own prizes. Empty =
                single competition across the whole field
                (default).
              </p>
            </div>
          </header>

          <div id="flightsError" class="errorbar" hidden></div>

          <fieldset class="field field--group flightsMode">
            <legend class="field__label">Flights mode</legend>
            <div class="radios radios--stacked">
              <label>
                <input type="radio" name="mgFlightsMode" value="off" />
                <span><strong>No flights</strong> — single competition</span>
              </label>
              <label>
                <input type="radio" name="mgFlightsMode" value="auto" />
                <span><strong>Auto-split by handicap</strong> — equal-count buckets</span>
              </label>
              <label>
                <input type="radio" name="mgFlightsMode" value="manual" />
                <span><strong>Manual composer</strong></span>
              </label>
            </div>
          </fieldset>

          <div id="mgFlightsAutoPanel" class="flightsPanel" hidden>
            <label class="field flightsCountField">
              <span class="field__label">Number of flights</span>
              <select id="mgFlightsAutoCount">
                <option value="2">2 flights</option>
                <option value="3">3 flights</option>
                <option value="4">4 flights</option>
              </select>
            </label>
            <label class="checkbox">
              <input type="checkbox" id="mgFlightsAdjustToggle" />
              <span>Adjust auto boundaries manually</span>
            </label>
            <div id="mgFlightsAutoPreview" class="flightsPreview" aria-live="polite"></div>
          </div>

          <div id="mgFlightsManualPanel" class="flightsPanel" hidden>
            <div class="flightsManualHeader">
              <button type="button" id="mgFlightsManualAddBtn" class="btn btn--ghost btn--sm">
                + Add flight
              </button>
              <button type="button" id="mgFlightsManualSeedBtn" class="btn btn--ghost btn--sm">
                Auto-assign by handicap
              </button>
            </div>
            <ul id="mgFlightsManualList" class="flightsManualList"></ul>
            <ul id="mgFlightsManualAssignments" class="flightsAssignList" aria-live="polite"></ul>
          </div>

          <div class="rosterCard__actions">
            <button type="button" id="mgFlightsCancelBtn" class="btn btn--ghost">
              Cancel
            </button>
            <button type="button" id="mgFlightsSaveBtn" class="btn btn--primary" disabled>
              Save flights
            </button>
          </div>
        </section>

        <!-- Pairings card — roadmap #6 (groups + teams composer) -->
        <section class="rosterCard" data-card="pairings">
          <header class="rosterCard__head">
            <div>
              <h2 class="rosterCard__title">Pairings</h2>
              <p class="rosterCard__meta">
                Assign players to groups (foursomes / threesomes /
                twosomes) or to Cup teams — per round. Skip if
                players self-organize on the tee.
              </p>
            </div>
          </header>

          <div id="pairingsError" class="errorbar" hidden></div>

          <div id="mgPairingsRoundTabs" class="pairingsRoundTabs" role="tablist" aria-label="Round selector"></div>
          <div id="mgPairingsRoundBody" class="pairingsRoundBody" aria-live="polite"></div>

          <div class="rosterCard__actions">
            <button type="button" id="mgPairingsCancelBtn" class="btn btn--ghost">
              Cancel
            </button>
            <button type="button" id="mgPairingsSaveBtn" class="btn btn--primary" disabled>
              Save pairings
            </button>
          </div>
        </section>

        <!-- Danger zone (Slice A3) — duplicate + delete -->
        <section class="dangerCard">
          <header class="rosterCard__head">
            <div>
              <h2 class="rosterCard__title">Danger zone</h2>
              <p class="rosterCard__meta">
                Duplicate for "same event, next season" — or delete
                if this was a test. Delete is permanent + wipes all
                scores, calcutta, and payouts for this tournament.
              </p>
            </div>
          </header>

          <div id="dangerError" class="errorbar" hidden></div>

          <div class="dangerCard__actions">
            <button type="button" id="duplicateBtn" class="btn btn--ghost">
              Duplicate tournament
            </button>
            <button type="button" id="deleteBtn" class="btn btn--danger">
              Delete tournament…
            </button>
          </div>
        </section>

        <section class="grid grid--2 coming">
          <article class="card">
            <span class="chip chip--muted">Coming soon</span>
            <h3>Lifecycle</h3>
            <p>Setup → Field final → Tee times live → Payouts posted.</p>
          </article>
          <article class="card">
            <span class="chip chip--muted">Coming soon</span>
            <h3>Per-round setup</h3>
            <p>Format, course, tees, pairings, shotgun, handicap snapshot.</p>
          </article>
          <article class="card">
            <span class="chip chip--muted">Coming soon</span>
            <h3>Communications</h3>
            <p>Push / email / SMS blast to the field, AI-assisted compose.</p>
          </article>
          <article class="card">
            <span class="chip chip--muted">Coming soon</span>
            <h3>Sponsors</h3>
            <p>Logos on leaderboard, kiosk, print pack.</p>
          </article>
          <article class="card">
            <span class="chip chip--muted">Coming soon</span>
            <h3>Settle &amp; post</h3>
            <p>Director-controlled payout distribution with balance guard.</p>
          </article>
        </section>
      </>
    )}
  </main>
</BaseLayout>

{tournament && (
  <>
  <script is:inline define:vars={{
    tournamentId: id,
    initialPlayers: players,
  }}>
    // ── Editor state ──────────────────────────────────────────
    //
    // Deep-copy `initialPlayers` so `dirty` detection compares
    // against a stable snapshot. `working` mutates as the user
    // adds / removes / edits.
    const initial = JSON.parse(JSON.stringify(initialPlayers ?? []));
    const state = {
      working: JSON.parse(JSON.stringify(initial)),
      saving: false,
    };

    const listEl = document.getElementById('playersList');
    const emptyEl = document.getElementById('playersEmpty');
    const countEl = document.getElementById('playerCount');
    const errorBox = document.getElementById('wizardError');
    const saveBtn = document.getElementById('saveBtn');
    const cancelBtn = document.getElementById('cancelBtn');
    const friendSelectEl = document.getElementById('friendSelect');
    const addFriendBtn = document.getElementById('addFriendBtn');
    const playerNameInput = document.getElementById('playerNameInput');
    const playerHcpInput = document.getElementById('playerHcpInput');

    function showError(msg) {
      errorBox.textContent = msg;
      errorBox.hidden = false;
    }
    function clearError() { errorBox.hidden = true; }

    // Two lists are "dirty" when their canonical JSON differs. We
    // normalize each player to a stable shape so pure-cosmetic
    // reorderings or added-then-removed edits still flag correctly.
    function normalize(p) {
      return {
        id: p.id,
        name: (p.name ?? '').trim(),
        handicapIndex: typeof p.handicapIndex === 'number'
          ? p.handicapIndex : Number(p.handicapIndex) || 18,
        userId: p.userId ?? null,
      };
    }
    function isDirty() {
      const a = JSON.stringify(state.working.map(normalize));
      const b = JSON.stringify(initial.map(normalize));
      return a !== b;
    }
    function refreshSaveGate() {
      saveBtn.disabled = state.saving || !isDirty();
    }

    // Re-render the roster list from state.working. Cheap enough
    // (max ~24 players) that a full innerHTML wipe is fine.
    function renderPlayers() {
      listEl.innerHTML = '';
      state.working.forEach((p, idx) => {
        const li = document.createElement('li');
        li.className = 'playersList__row';
        li.dataset.playerIdx = String(idx);
        li.innerHTML = `
          <span class="playersList__name">
            ${escapeHtml(p.name)}
            ${p.userId ? '<span class="badge badge--user">Bagpipe user</span>' : ''}
          </span>
          <input
            type="number"
            step="0.1"
            min="-10"
            max="54"
            class="playersList__hcpInput"
            data-hcp-edit-idx="${idx}"
            value="${Number.isFinite(p.handicapIndex) ? p.handicapIndex : 18}"
            aria-label="Handicap for ${escapeHtml(p.name)}"
          />
          <button
            type="button"
            class="playersList__remove"
            data-player-remove="${idx}"
            aria-label="Remove ${escapeHtml(p.name)}"
          >×</button>
        `;
        listEl.appendChild(li);
      });
      // Rewire per-row listeners.
      listEl.querySelectorAll('[data-player-remove]').forEach((el) => {
        el.addEventListener('click', () => {
          const i = Number(el.getAttribute('data-player-remove'));
          state.working.splice(i, 1);
          renderPlayers();
          refreshSaveGate();
          clearError();
        });
      });
      listEl.querySelectorAll('[data-hcp-edit-idx]').forEach((el) => {
        el.addEventListener('input', (e) => {
          const i = Number(el.getAttribute('data-hcp-edit-idx'));
          const v = Number(e.target.value);
          state.working[i].handicapIndex = Number.isFinite(v) ? v : 18;
          refreshSaveGate();
        });
      });
      emptyEl.hidden = state.working.length > 0;
      countEl.textContent = String(state.working.length);
    }

    // Bind the initial server-rendered rows so the first render also
    // reacts to Remove + HCP edits without waiting for renderPlayers().
    function wireInitialRows() {
      listEl.querySelectorAll('[data-player-remove]').forEach((el) => {
        el.addEventListener('click', () => {
          const i = Number(el.getAttribute('data-player-remove'));
          state.working.splice(i, 1);
          renderPlayers();
          refreshSaveGate();
          clearError();
        });
      });
      listEl.querySelectorAll('[data-hcp-edit-idx]').forEach((el) => {
        el.addEventListener('input', (e) => {
          const i = Number(el.getAttribute('data-hcp-edit-idx'));
          const v = Number(e.target.value);
          state.working[i].handicapIndex = Number.isFinite(v) ? v : 18;
          refreshSaveGate();
        });
      });
    }

    // ── Add flows ─────────────────────────────────────────────
    document.getElementById('addPlayerBtn').addEventListener('click', () => {
      const name = playerNameInput.value.trim();
      if (name.length === 0) return showError("Player name can't be empty.");
      if (state.working.length >= 24) return showError('Phase 1 supports up to 24 players.');
      const raw = playerHcpInput.value.trim();
      const hcp = raw === '' ? 18 : Number(raw);
      if (!Number.isFinite(hcp)) return showError('Handicap must be a number.');
      state.working.push({
        // Stable local id for this new roster entry. `p_manage_...`
        // prefix disambiguates from wizard-created ids so a future
        // migration can distinguish "added post-create" if useful.
        id: `p_manage_${tournamentId}_${Date.now()}_${state.working.length}`,
        name,
        handicapIndex: hcp,
        userId: null,
      });
      playerNameInput.value = '';
      playerHcpInput.value = '';
      playerNameInput.focus();
      renderPlayers();
      refreshSaveGate();
      clearError();
    });

    if (friendSelectEl && addFriendBtn) {
      addFriendBtn.addEventListener('click', () => {
        const sel = friendSelectEl;
        const opt = sel.options[sel.selectedIndex];
        if (!opt || !opt.value) return showError('Pick a friend first.');
        if (state.working.length >= 24) return showError('Phase 1 supports up to 24 players.');
        const friendUserId = opt.value;
        const name = opt.getAttribute('data-name') || 'Friend';
        const hcpRaw = opt.getAttribute('data-hcp');
        const hcp = hcpRaw != null && Number.isFinite(Number(hcpRaw)) ? Number(hcpRaw) : 18;
        if (state.working.some((p) => p.userId && p.userId === friendUserId)) {
          return showError(`${name} is already in the roster.`);
        }
        state.working.push({
          id: `p_manage_${tournamentId}_${Date.now()}_${state.working.length}`,
          name,
          handicapIndex: hcp,
          userId: friendUserId,
        });
        sel.selectedIndex = 0;
        renderPlayers();
        refreshSaveGate();
        clearError();
      });
    }

    // ── Cancel + Save ────────────────────────────────────────
    cancelBtn.addEventListener('click', () => {
      if (!isDirty()) return;
      const ok = confirm('Discard your changes?');
      if (!ok) return;
      window.location.reload();
    });

    saveBtn.addEventListener('click', async () => {
      if (state.saving || !isDirty()) return;
      state.saving = true;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving…';
      clearError();
      try {
        const res = await fetch(`/api/tournaments/${encodeURIComponent(tournamentId)}/update`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ players: state.working.map(normalize) }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          state.saving = false;
          saveBtn.textContent = 'Save roster';
          refreshSaveGate();
          return showError(data.error || `Save failed with ${res.status}`);
        }
        // Reload so the server-rendered roster picks up whatever
        // Railway just wrote (including any server-side scrubs like
        // isCurrentUser flag stripping).
        window.location.reload();
      } catch (err) {
        state.saving = false;
        saveBtn.textContent = 'Save roster';
        refreshSaveGate();
        showError(err?.message || 'Network error — try again.');
      }
    });

    // ── Utils ────────────────────────────────────────────────
    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, (ch) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[ch] || ch);
    }

    wireInitialRows();
    refreshSaveGate();
  </script>

  <script is:inline define:vars={{
    tournamentId: id,
    initialName: tournament.name,
  }}>
    const nameInput = document.getElementById('basicsName');
    const saveBtn = document.getElementById('basicsSaveBtn');
    const cancelBtn = document.getElementById('basicsCancelBtn');
    const errorBox = document.getElementById('basicsError');

    let saving = false;

    function showError(msg) { errorBox.textContent = msg; errorBox.hidden = false; }
    function clearError() { errorBox.hidden = true; }

    function refreshGate() {
      const dirty = nameInput.value.trim() !== initialName.trim();
      saveBtn.disabled = saving || !dirty || nameInput.value.trim().length === 0;
    }
    nameInput.addEventListener('input', () => { clearError(); refreshGate(); });

    cancelBtn.addEventListener('click', () => {
      nameInput.value = initialName;
      clearError();
      refreshGate();
    });

    saveBtn.addEventListener('click', async () => {
      const name = nameInput.value.trim();
      if (name.length === 0) return showError("Name can't be empty.");
      if (saving) return;
      saving = true;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving…';
      clearError();
      try {
        const res = await fetch(`/api/tournaments/${encodeURIComponent(tournamentId)}/update`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ name }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          saving = false;
          saveBtn.textContent = 'Save name';
          refreshGate();
          return showError(data.error || `Save failed with ${res.status}`);
        }
        window.location.reload();
      } catch (err) {
        saving = false;
        saveBtn.textContent = 'Save name';
        refreshGate();
        showError(err?.message || 'Network error — try again.');
      }
    });
  </script>

  <script is:inline define:vars={{
    tournamentId: id,
    initialRounds: tournament.rounds ?? [],
    tournamentTeeBoxes: tournament.tee_boxes ?? [],
  }}>
    // Deep-copy so dirty detection compares against a stable
    // snapshot. `working` mutates as the user edits.
    const initial = JSON.parse(JSON.stringify(initialRounds));
    const teeBoxes = Array.isArray(tournamentTeeBoxes) ? tournamentTeeBoxes : [];
    const state = {
      working: JSON.parse(JSON.stringify(initial)),
      saving: false,
    };

    const listEl = document.getElementById('roundsList');
    const countEl = document.getElementById('roundCount');
    const errorBox = document.getElementById('roundsError');
    const saveBtn = document.getElementById('roundsSaveBtn');
    const cancelBtn = document.getElementById('roundsCancelBtn');
    const addBtn = document.getElementById('addRoundBtn');

    // Fallback tee names when the picked course returned no per-tee
    // data (rare — happens for GolfCourseAPI hits with sparse
    // metadata). Matches the wizard's fallback list.
    const FALLBACK_TEES = ['Championship', 'Blue', 'White', 'Gold', 'Red', 'Green'];

    function showError(msg) { errorBox.textContent = msg; errorBox.hidden = false; }
    function clearError() { errorBox.hidden = true; }

    // Normalize each round for dirty compare. Preserves ALL keys the
    // server sent (so scores + timestamps + unknown mobile-app fields
    // survive the round trip) but pins the fields this editor
    // touches to a canonical shape.
    function normalizeForCompare(r) {
      const rawStart = r.start_type ?? r.startType;
      const start = rawStart === 'shotgun' ? 'shotgun' : 'teeTimes';
      const rawGroup = Number(r.tee_time_group_size ?? r.teeTimeGroupSize);
      const group = rawGroup === 2 || rawGroup === 3 ? rawGroup : 4;
      const shotgunTime =
        typeof (r.shotgun_start_time ?? r.shotgunStartTime) === 'string'
          ? (r.shotgun_start_time ?? r.shotgunStartTime)
          : null;
      return {
        teeBoxName: r.teeBoxName ?? r.teeName ?? '',
        totalHoles: Number(r.totalHoles) || 18,
        format: r.format ?? 'stroke',
        // Phase 2a: include start / group / shotgun-time in the
        // dirty compare so editing any of them enables Save.
        start,
        group,
        shotgunTime: start === 'shotgun' && shotgunTime ? shotgunTime : null,
      };
    }
    function isDirty() {
      if (state.working.length !== initial.length) return true;
      const a = JSON.stringify(state.working.map(normalizeForCompare));
      const b = JSON.stringify(initial.map(normalizeForCompare));
      return a !== b;
    }
    function refreshGate() {
      saveBtn.disabled = state.saving || !isDirty();
    }

    // Any non-null score in the round's player_hole_scores /
    // playerHoleScores means the round has been played — gate the
    // Remove button so users don't accidentally nuke recorded data.
    function roundHasScores(r) {
      const raw = r.player_hole_scores ?? r.playerHoleScores ?? [];
      if (!Array.isArray(raw)) return false;
      for (const row of raw) {
        const scores = row?.holeScores ?? row?.hole_scores ?? [];
        if (Array.isArray(scores) && scores.some((s) => s != null && s > 0)) {
          return true;
        }
      }
      return false;
    }

    function renderRounds() {
      listEl.innerHTML = '';
      state.working.forEach((r, i) => {
        const currentTee = r.teeBoxName ?? r.teeName ?? '';
        const currentHoles = Number(r.totalHoles) || 18;
        const currentFormat = r.format ?? 'stroke';
        const hasScores = roundHasScores(r);

        const teeOptions = teeBoxes.length > 0
          ? teeBoxes.map((t) => {
              const val = t.tee_name ?? t.teeName ?? '';
              const label = teeLabel(t);
              const sel = val === currentTee ? 'selected' : '';
              return `<option value="${escapeHtml(val)}" ${sel}>${escapeHtml(label)}</option>`;
            }).join('')
          : FALLBACK_TEES.map((n) => {
              const sel = n === currentTee ? 'selected' : '';
              return `<option value="${escapeHtml(n)}" ${sel}>${escapeHtml(n)}</option>`;
            }).join('');

        // Phase 2a: pull start_type / tee_time_group_size /
        // shotgun_start_time from the round's persisted shape.
        // Server writes snake_case per Tournament.toApiJson; older
        // rounds without these fields default to teeTimes / 4 / null.
        const rawStart = (r.start_type ?? r.startType);
        const currentStart = rawStart === 'shotgun' ? 'shotgun' : 'teeTimes';
        const rawGroup = Number(r.tee_time_group_size ?? r.teeTimeGroupSize);
        const currentGroup =
          rawGroup === 2 || rawGroup === 3 ? rawGroup : 4;
        const currentShotgunTime =
          typeof (r.shotgun_start_time ?? r.shotgunStartTime) === 'string'
            ? (r.shotgun_start_time ?? r.shotgunStartTime)
            : '';

        const li = document.createElement('li');
        li.className = 'roundsList__row';
        li.dataset.roundIdx = String(i);
        li.innerHTML = `
          <div class="roundsList__idx">R${i + 1}</div>
          <label>
            <span>Tee</span>
            <select data-round-tee="${i}">
              ${teeOptions}
            </select>
          </label>
          <label>
            <span>Holes</span>
            <select data-round-holes="${i}">
              <option value="18" ${currentHoles === 18 ? 'selected' : ''}>18</option>
              <option value="9" ${currentHoles === 9 ? 'selected' : ''}>9</option>
            </select>
          </label>
          <label>
            <span>Format</span>
            <select data-round-format="${i}">
              <option value="stroke" ${currentFormat === 'stroke' ? 'selected' : ''}>Stroke</option>
              <option value="scramble" ${currentFormat === 'scramble' ? 'selected' : ''}>Scramble</option>
              <option value="bestBall" ${currentFormat === 'bestBall' ? 'selected' : ''}>Best ball</option>
              <option value="matchPlay" ${currentFormat === 'matchPlay' ? 'selected' : ''}>Match</option>
            </select>
          </label>
          <label>
            <span>Start</span>
            <select data-round-starttype="${i}">
              <option value="teeTimes" ${currentStart === 'teeTimes' ? 'selected' : ''}>Tee times</option>
              <option value="shotgun" ${currentStart === 'shotgun' ? 'selected' : ''}>Shotgun</option>
            </select>
          </label>
          <label>
            <span>Groups</span>
            <select data-round-groupsize="${i}">
              <option value="4" ${currentGroup === 4 ? 'selected' : ''}>Foursomes (4)</option>
              <option value="3" ${currentGroup === 3 ? 'selected' : ''}>Threesomes (3)</option>
              <option value="2" ${currentGroup === 2 ? 'selected' : ''}>Twosomes (2)</option>
            </select>
          </label>
          <label data-round-shotguntime-wrap="${i}" ${currentStart !== 'shotgun' ? 'hidden' : ''}>
            <span>Shotgun time</span>
            <input
              type="time"
              data-round-shotguntime="${i}"
              value="${escapeHtml(currentShotgunTime)}"
            />
          </label>
          <button
            type="button"
            class="roundsList__remove"
            data-round-remove="${i}"
            title="${hasScores ? 'Round has scores — cannot remove' : 'Remove round'}"
            ${hasScores ? 'disabled' : ''}
          >×</button>
        `;
        listEl.appendChild(li);
      });

      // Rewire per-row listeners after re-render.
      listEl.querySelectorAll('[data-round-tee]').forEach((el) => {
        el.addEventListener('change', (e) => {
          const idx = Number(el.getAttribute('data-round-tee'));
          state.working[idx].teeBoxName = e.target.value;
          refreshGate();
        });
      });
      listEl.querySelectorAll('[data-round-holes]').forEach((el) => {
        el.addEventListener('change', (e) => {
          const idx = Number(el.getAttribute('data-round-holes'));
          state.working[idx].totalHoles = Number(e.target.value);
          refreshGate();
        });
      });
      listEl.querySelectorAll('[data-round-format]').forEach((el) => {
        el.addEventListener('change', (e) => {
          const idx = Number(el.getAttribute('data-round-format'));
          state.working[idx].format = e.target.value;
          refreshGate();
        });
      });
      // Phase 2a: start type + group size + shotgun time. Writes
      // BOTH snake_case (mobile-app canonical) and camelCase (web
      // wizard convention) so a round object round-tripping through
      // this editor always carries both keys — no upstream consumer
      // gets confused by a shape drift.
      listEl.querySelectorAll('[data-round-starttype]').forEach((el) => {
        el.addEventListener('change', (e) => {
          const idx = Number(el.getAttribute('data-round-starttype'));
          const val = e.target.value === 'shotgun' ? 'shotgun' : 'teeTimes';
          state.working[idx].startType = val;
          state.working[idx].start_type = val === 'shotgun' ? 'shotgun' : 'tee_times';
          // Toggle visibility of the shotgun-time input inline so
          // the field appears without a full re-render.
          const wrap = listEl.querySelector(`[data-round-shotguntime-wrap="${idx}"]`);
          if (wrap) wrap.hidden = val !== 'shotgun';
          if (val !== 'shotgun') {
            state.working[idx].shotgunStartTime = '';
            state.working[idx].shotgun_start_time = null;
          }
          refreshGate();
        });
      });
      listEl.querySelectorAll('[data-round-groupsize]').forEach((el) => {
        el.addEventListener('change', (e) => {
          const idx = Number(el.getAttribute('data-round-groupsize'));
          const v = Number(e.target.value);
          const size = v === 2 || v === 3 ? v : 4;
          state.working[idx].teeTimeGroupSize = size;
          state.working[idx].tee_time_group_size = size;
          refreshGate();
        });
      });
      listEl.querySelectorAll('[data-round-shotguntime]').forEach((el) => {
        el.addEventListener('input', (e) => {
          const idx = Number(el.getAttribute('data-round-shotguntime'));
          const v = e.target.value ?? '';
          state.working[idx].shotgunStartTime = v;
          state.working[idx].shotgun_start_time = v.length > 0 ? v : null;
          refreshGate();
        });
      });
      listEl.querySelectorAll('[data-round-remove]').forEach((el) => {
        el.addEventListener('click', () => {
          if (el.disabled) return;
          const idx = Number(el.getAttribute('data-round-remove'));
          if (state.working.length <= 1) {
            return showError('At least one round is required.');
          }
          state.working.splice(idx, 1);
          renderRounds();
          refreshGate();
          clearError();
          countEl.textContent = String(state.working.length);
        });
      });

      addBtn.disabled = state.working.length >= 12;
    }

    function teeLabel(tee) {
      const bits = [tee.tee_name ?? tee.teeName ?? '?'];
      if (tee.gender === 'female') bits.push('(F)');
      if (tee.course_rating != null && tee.slope_rating != null) {
        bits.push(`— ${tee.course_rating} / ${tee.slope_rating}`);
      } else if (tee.course_rating != null) {
        bits.push(`— ${tee.course_rating}`);
      }
      return bits.join(' ');
    }

    addBtn.addEventListener('click', () => {
      if (state.working.length >= 12) return;
      // Default tee = first course tee_box (usually the men's back
      // per curated ordering) or 'White' fallback.
      const defaultTee = teeBoxes.length > 0
        ? (teeBoxes[0].tee_name ?? teeBoxes[0].teeName ?? 'White')
        : 'White';
      const newRound = {
        // Client-generated id — mobile app treats round IDs as
        // stable strings; append-only, so the new id can't collide
        // with existing ones in this tournament. Preserves parity
        // with wizard-created rounds which don't set id (server
        // handles both shapes).
        id: `r_${tournamentId}_${Date.now()}_${state.working.length}`,
        index: state.working.length,
        teeBoxName: defaultTee,
        totalHoles: 18,
        format: 'stroke',
        // Phase 2a defaults — tee times, foursomes, no shotgun time.
        // Snake-case matches Tournament.toApiJson on mobile so any
        // round-trip through the mobile app doesn't lose these
        // fields; camelCase is set on edit for consistency with the
        // wizard's in-memory shape.
        start_type: 'tee_times',
        startType: 'teeTimes',
        tee_time_group_size: 4,
        teeTimeGroupSize: 4,
        shotgun_start_time: null,
        shotgunStartTime: '',
        playerHoleScores: {},
        playerStrokes: {},
        completed: false,
      };
      state.working.push(newRound);
      renderRounds();
      refreshGate();
      clearError();
      countEl.textContent = String(state.working.length);
    });

    cancelBtn.addEventListener('click', () => {
      if (!isDirty()) return;
      if (!confirm('Discard your round changes?')) return;
      window.location.reload();
    });

    saveBtn.addEventListener('click', async () => {
      if (state.saving || !isDirty()) return;
      state.saving = true;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving…';
      clearError();

      // Merge edited fields onto each round, preserving unknown
      // server-side fields (scores, timestamps, etc). Re-index in
      // case rounds were added or removed.
      const nextRounds = state.working.map((r, i) => ({
        ...r,
        index: i,
      }));
      const totalHoles = nextRounds.reduce(
        (sum, r) => sum + (Number(r.totalHoles) || 0),
        0,
      );

      try {
        const res = await fetch(`/api/tournaments/${encodeURIComponent(tournamentId)}/update`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            rounds: nextRounds,
            total_holes: totalHoles,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          state.saving = false;
          saveBtn.textContent = 'Save rounds';
          refreshGate();
          return showError(data.error || `Save failed with ${res.status}`);
        }
        window.location.reload();
      } catch (err) {
        state.saving = false;
        saveBtn.textContent = 'Save rounds';
        refreshGate();
        showError(err?.message || 'Network error — try again.');
      }
    });

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, (ch) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[ch] || ch);
    }

    renderRounds();
    refreshGate();
  </script>

  <script is:inline define:vars={{
    tournamentId: id,
    tournamentName: tournament.name,
  }}>
    const duplicateBtn = document.getElementById('duplicateBtn');
    const deleteBtn = document.getElementById('deleteBtn');
    const errorBox = document.getElementById('dangerError');
    let busy = false;

    function showError(msg) { errorBox.textContent = msg; errorBox.hidden = false; }
    function clearError() { errorBox.hidden = true; }

    duplicateBtn.addEventListener('click', async () => {
      if (busy) return;
      busy = true;
      duplicateBtn.disabled = true;
      duplicateBtn.textContent = 'Duplicating…';
      clearError();
      try {
        const res = await fetch(`/api/tournaments/${encodeURIComponent(tournamentId)}/duplicate`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.id) {
          busy = false;
          duplicateBtn.disabled = false;
          duplicateBtn.textContent = 'Duplicate tournament';
          return showError(data.error || `Duplicate failed with ${res.status}`);
        }
        // Land on the new tournament's Manage page so the director
        // can immediately tweak roster/rounds for the new event.
        window.location.href = `/app/tournaments/${encodeURIComponent(data.id)}/manage`;
      } catch (err) {
        busy = false;
        duplicateBtn.disabled = false;
        duplicateBtn.textContent = 'Duplicate tournament';
        showError(err?.message || 'Network error — try again.');
      }
    });

    deleteBtn.addEventListener('click', async () => {
      if (busy) return;
      // Typed confirmation — user must type the tournament name.
      // Standard pattern from the mobile Delete Account flow.
      const typed = prompt(
        `This permanently deletes "${tournamentName}" — including all rounds, scores, and calcutta. This cannot be undone.\n\nType the tournament name to confirm:`,
      );
      if (typed == null) return; // cancel
      if (typed.trim() !== tournamentName.trim()) {
        return showError("Name didn't match — nothing was deleted.");
      }
      busy = true;
      deleteBtn.disabled = true;
      deleteBtn.textContent = 'Deleting…';
      clearError();
      try {
        const res = await fetch(`/api/tournaments/${encodeURIComponent(tournamentId)}/delete`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          busy = false;
          deleteBtn.disabled = false;
          deleteBtn.textContent = 'Delete tournament…';
          return showError(data.error || `Delete failed with ${res.status}`);
        }
        window.location.href = '/app/tournaments';
      } catch (err) {
        busy = false;
        deleteBtn.disabled = false;
        deleteBtn.textContent = 'Delete tournament…';
        showError(err?.message || 'Network error — try again.');
      }
    });
  </script>

  <script is:inline define:vars={{
    tournamentId: id,
    initialFlights: tournament.flights ?? [],
    initialPlayers: players,
  }}>
    // Flights editor. Mirrors the wizard step at
    // src/pages/app/tournaments/new.astro — same auto-split
    // algorithm (equal-count buckets sorted by handicap
    // ascending) and same three-mode UX (off / auto / manual).
    //
    // Key difference from the wizard: this editor works against
    // REAL server-generated player ids (`p_<tournamentId>_<i>`),
    // not the wizard's `wp_<i>` local ids. Payload writes those
    // ids straight through — no re-mapping needed.
    const MAX_FLIGHTS = 6;
    const DEFAULT_FLIGHT_NAMES = [
      'Championship', 'First', 'Second', 'Third', 'Fourth', 'Fifth',
    ];

    // Normalize server flights (snake_case + tolerant camel/snake
    // for compat with older writes) to the editor's canonical
    // camelCase shape.
    function normalizeFlight(raw, i) {
      const idsRaw = Array.isArray(raw?.playerIds)
        ? raw.playerIds
        : Array.isArray(raw?.player_ids)
          ? raw.player_ids
          : [];
      return {
        id: (typeof raw?.id === 'string' && raw.id.length > 0)
          ? raw.id
          : `flight_${i}_${Date.now()}`,
        name: (typeof raw?.name === 'string' && raw.name.trim().length > 0)
          ? raw.name.trim()
          : `Flight ${i + 1}`,
        handicapMin: (typeof (raw?.handicapMin ?? raw?.handicap_min) === 'number')
          ? Number(raw.handicapMin ?? raw.handicap_min)
          : null,
        handicapMax: (typeof (raw?.handicapMax ?? raw?.handicap_max) === 'number')
          ? Number(raw.handicapMax ?? raw.handicap_max)
          : null,
        playerIds: idsRaw
          .filter((x) => typeof x === 'string'),
      };
    }

    const normalizedInitial = (Array.isArray(initialFlights) ? initialFlights : [])
      .map(normalizeFlight)
      .slice(0, MAX_FLIGHTS);

    const state = {
      // Mode derived from initial: any flights on disk → 'manual'
      // (safest — preserves the exact server state until the user
      // opts into an auto reshuffle). No flights → 'off'.
      mode: normalizedInitial.length > 0 ? 'manual' : 'off',
      autoCount: 2,
      autoAdjusted: false,
      // Deep copy so dirty compare works against a stable baseline.
      flights: JSON.parse(JSON.stringify(normalizedInitial)),
      saving: false,
    };

    // Snapshot for dirty compare. Compares canonical JSON so
    // pure-cosmetic reorderings still register.
    const initialSnapshot = JSON.stringify({
      mode: normalizedInitial.length > 0 ? 'manual' : 'off',
      flights: normalizedInitial,
    });

    const flightsModeRadios = document.getElementsByName('mgFlightsMode');
    const autoPanel = document.getElementById('mgFlightsAutoPanel');
    const manualPanel = document.getElementById('mgFlightsManualPanel');
    const autoCountEl = document.getElementById('mgFlightsAutoCount');
    const adjustToggle = document.getElementById('mgFlightsAdjustToggle');
    const autoPreview = document.getElementById('mgFlightsAutoPreview');
    const manualAddBtn = document.getElementById('mgFlightsManualAddBtn');
    const manualSeedBtn = document.getElementById('mgFlightsManualSeedBtn');
    const manualList = document.getElementById('mgFlightsManualList');
    const manualAssignments = document.getElementById('mgFlightsManualAssignments');
    const errorBox = document.getElementById('flightsError');
    const saveBtn = document.getElementById('mgFlightsSaveBtn');
    const cancelBtn = document.getElementById('mgFlightsCancelBtn');

    function showError(msg) { errorBox.textContent = msg; errorBox.hidden = false; }
    function clearError() { errorBox.hidden = true; }

    // Set the initial radio checked state from state.mode.
    for (const r of flightsModeRadios) {
      if (r.value === state.mode) r.checked = true;
    }

    function currentSnapshot() {
      return JSON.stringify({
        mode: state.mode === 'off' ? 'off' : 'manual',
        flights: state.mode === 'off' ? [] : state.flights,
      });
    }
    function isDirty() {
      return currentSnapshot() !== initialSnapshot;
    }
    function refreshSaveGate() {
      saveBtn.disabled = state.saving || !isDirty();
    }

    function playerHcp(p) {
      const v = Number(p?.handicapIndex);
      return Number.isFinite(v) ? v : 18;
    }

    function autoSplit(count) {
      const n = initialPlayers.length;
      const c = Math.max(1, Math.min(MAX_FLIGHTS, Math.floor(count)));
      if (n === 0) return [];
      const indexed = initialPlayers.map((p) => ({
        id: p.id,
        hcp: playerHcp(p),
      }));
      indexed.sort((a, b) => a.hcp - b.hcp);
      const perFlight = Math.ceil(n / c);
      const stamp = Date.now();
      const out = [];
      for (let i = 0; i < c; i++) {
        const start = i * perFlight;
        if (start >= n) break;
        const end = Math.min(start + perFlight, n);
        const slice = indexed.slice(start, end);
        out.push({
          id: `flight_${i}_${stamp + i}`,
          name: DEFAULT_FLIGHT_NAMES[i] ?? `Flight ${i + 1}`,
          handicapMin: slice[0].hcp,
          handicapMax: slice[slice.length - 1].hcp,
          playerIds: slice.map((s) => s.id),
        });
      }
      return out;
    }

    function defaultCountFor(n) {
      if (n <= 16) return 2;
      if (n <= 32) return 3;
      return 4;
    }

    for (const r of flightsModeRadios) {
      r.addEventListener('change', () => {
        if (!r.checked) return;
        state.mode = r.value;
        if (state.mode === 'off') {
          state.autoAdjusted = false;
        }
        if (state.mode === 'auto') {
          if (!state.autoAdjusted) state.flights = autoSplit(state.autoCount);
        }
        if (state.mode === 'manual') {
          if (state.flights.length === 0) {
            state.flights = autoSplit(defaultCountFor(initialPlayers.length));
          }
        }
        render();
      });
    }

    autoCountEl.addEventListener('change', () => {
      const n = Math.max(2, Math.min(4, Number(autoCountEl.value) || 2));
      state.autoCount = n;
      state.autoAdjusted = false;
      adjustToggle.checked = false;
      state.flights = autoSplit(n);
      render();
    });

    adjustToggle.addEventListener('change', () => {
      state.autoAdjusted = !!adjustToggle.checked;
      render();
    });

    manualAddBtn.addEventListener('click', () => {
      if (state.flights.length >= MAX_FLIGHTS) {
        showError(`Up to ${MAX_FLIGHTS} flights per tournament.`);
        return;
      }
      const idx = state.flights.length;
      state.flights.push({
        id: `flight_manual_${Date.now()}_${idx}`,
        name: DEFAULT_FLIGHT_NAMES[idx] ?? `Flight ${idx + 1}`,
        handicapMin: null,
        handicapMax: null,
        playerIds: [],
      });
      clearError();
      render();
    });

    manualSeedBtn.addEventListener('click', () => {
      const count = state.flights.length > 0
        ? state.flights.length
        : Math.min(MAX_FLIGHTS, defaultCountFor(initialPlayers.length));
      state.flights = autoSplit(count);
      render();
    });

    function render() {
      autoPanel.hidden = state.mode !== 'auto';
      manualPanel.hidden = state.mode !== 'manual';
      if (state.mode === 'auto') {
        autoCountEl.value = String(state.autoCount);
        renderAutoPreview();
      }
      if (state.mode === 'manual') {
        renderManual();
      }
      refreshSaveGate();
    }

    function playerLookup() {
      const map = new Map();
      for (const p of initialPlayers) map.set(p.id, p);
      return map;
    }

    function renderAutoPreview() {
      autoPreview.innerHTML = '';
      if (initialPlayers.length === 0) {
        const p = document.createElement('p');
        p.className = 'rosterCard__meta';
        p.textContent = 'No players yet — auto-split needs at least one player. Add players in the Roster card first.';
        autoPreview.appendChild(p);
        return;
      }
      const lookup = playerLookup();
      const adjusted = state.autoAdjusted;
      state.flights.forEach((f, fi) => {
        const card = document.createElement('div');
        card.className = 'flightCard';
        const minStr = f.handicapMin != null ? String(f.handicapMin) : '';
        const maxStr = f.handicapMax != null ? String(f.handicapMax) : '';
        const boundaryHtml = adjusted
          ? `<label class="flightCard__bound">
               <span>Min HCP</span>
               <input type="number" step="0.1" data-flight-bound="min" data-flight-idx="${fi}" value="${escapeHtml(minStr)}" />
             </label>
             <label class="flightCard__bound">
               <span>Max HCP</span>
               <input type="number" step="0.1" data-flight-bound="max" data-flight-idx="${fi}" value="${escapeHtml(maxStr)}" />
             </label>`
          : `<span class="flightCard__range">
               ${minStr === '' && maxStr === '' ? 'no bounds' : `${minStr} – ${maxStr}`}
             </span>`;
        const nameHtml = adjusted
          ? `<input type="text" class="flightCard__nameInput" data-flight-name="${fi}" value="${escapeHtml(f.name)}" maxlength="30" />`
          : `<strong class="flightCard__name">${escapeHtml(f.name)}</strong>`;
        const rows = (f.playerIds || [])
          .map((pid) => {
            const p = lookup.get(pid);
            if (!p) return '';
            const hcp = playerHcp(p);
            return `<li>${escapeHtml(p.name)} <span class="playersList__hcp">Handicap ${escapeHtml(String(hcp))}</span></li>`;
          }).join('');
        card.innerHTML = `
          <div class="flightCard__head">
            ${nameHtml}
            ${boundaryHtml}
            <span class="flightCard__count">${(f.playerIds || []).length} player${(f.playerIds || []).length === 1 ? '' : 's'}</span>
          </div>
          <ul class="flightCard__players">${rows || '<li class="rosterCard__meta">No players in this flight.</li>'}</ul>
        `;
        autoPreview.appendChild(card);
      });
      if (adjusted) {
        autoPreview.querySelectorAll('[data-flight-bound]').forEach((el) => {
          el.addEventListener('input', (e) => {
            const fi = Number(el.getAttribute('data-flight-idx'));
            const which = el.getAttribute('data-flight-bound');
            const raw = e.target.value.trim();
            const v = raw === '' ? null : Number(raw);
            if (raw !== '' && !Number.isFinite(v)) return;
            if (which === 'min') state.flights[fi].handicapMin = v;
            if (which === 'max') state.flights[fi].handicapMax = v;
            rebucketFromBoundaries();
            refreshSaveGate();
          });
        });
        autoPreview.querySelectorAll('[data-flight-name]').forEach((el) => {
          el.addEventListener('input', (e) => {
            const fi = Number(el.getAttribute('data-flight-name'));
            state.flights[fi].name = e.target.value;
            refreshSaveGate();
          });
        });
      }
    }

    function rebucketFromBoundaries() {
      const flights = state.flights;
      if (flights.length === 0) return;
      const assignments = flights.map(() => []);
      for (const p of initialPlayers) {
        const hcp = playerHcp(p);
        let placed = false;
        for (let fi = 0; fi < flights.length; fi++) {
          const f = flights[fi];
          if (f.handicapMin == null || f.handicapMax == null) continue;
          if (hcp >= f.handicapMin && hcp <= f.handicapMax) {
            assignments[fi].push(p.id);
            placed = true;
            break;
          }
        }
        if (!placed) assignments[assignments.length - 1].push(p.id);
      }
      for (let fi = 0; fi < flights.length; fi++) {
        flights[fi].playerIds = assignments[fi];
      }
      // Only refresh the count chips + player rosters, not the
      // input the user is typing into.
      const cards = autoPreview.querySelectorAll('.flightCard');
      const lookup = playerLookup();
      cards.forEach((card, fi) => {
        const list = card.querySelector('.flightCard__players');
        const count = card.querySelector('.flightCard__count');
        if (list) {
          const ids = flights[fi].playerIds || [];
          list.innerHTML = ids
            .map((pid) => {
              const p = lookup.get(pid);
              if (!p) return '';
              const hcp = playerHcp(p);
              return `<li>${escapeHtml(p.name)} <span class="playersList__hcp">Handicap ${escapeHtml(String(hcp))}</span></li>`;
            }).join('') || '<li class="rosterCard__meta">No players in this flight.</li>';
        }
        if (count) {
          const n = (flights[fi].playerIds || []).length;
          count.textContent = `${n} player${n === 1 ? '' : 's'}`;
        }
      });
    }

    function renderManual() {
      manualList.innerHTML = '';
      state.flights.forEach((f, fi) => {
        const li = document.createElement('li');
        li.className = 'flightsManualRow';
        li.innerHTML = `
          <input type="text" class="flightsManualRow__name" data-flight-name="${fi}" value="${escapeHtml(f.name)}" maxlength="30" />
          <span class="flightsManualRow__count">${(f.playerIds || []).length} player${(f.playerIds || []).length === 1 ? '' : 's'}</span>
          <button type="button" class="flightsManualRow__remove" data-flight-remove="${fi}" aria-label="Remove ${escapeHtml(f.name)}">×</button>
        `;
        manualList.appendChild(li);
      });
      manualList.querySelectorAll('[data-flight-name]').forEach((el) => {
        el.addEventListener('input', (e) => {
          const fi = Number(el.getAttribute('data-flight-name'));
          state.flights[fi].name = e.target.value;
          refreshSaveGate();
        });
      });
      manualList.querySelectorAll('[data-flight-remove]').forEach((el) => {
        el.addEventListener('click', () => {
          const fi = Number(el.getAttribute('data-flight-remove'));
          if (state.flights.length <= 1) {
            showError('At least one flight in manual mode. Switch to "No flights" to remove all.');
            return;
          }
          state.flights.splice(fi, 1);
          clearError();
          render();
        });
      });

      manualAssignments.innerHTML = '';
      if (initialPlayers.length === 0) {
        const li = document.createElement('li');
        li.className = 'rosterCard__meta';
        li.textContent = 'No players yet — add players in the Roster card to assign them here.';
        manualAssignments.appendChild(li);
        return;
      }
      initialPlayers.forEach((p) => {
        const pid = p.id;
        const currentFlight = state.flights.findIndex((f) =>
          (f.playerIds || []).includes(pid));
        const options = state.flights.map((f, fi) => {
          const sel = fi === currentFlight ? 'selected' : '';
          return `<option value="${fi}" ${sel}>${escapeHtml(f.name)}</option>`;
        }).join('');
        const unassignedSel = currentFlight < 0 ? 'selected' : '';
        const hcp = playerHcp(p);
        const li = document.createElement('li');
        li.className = 'flightsAssignRow';
        li.dataset.playerId = pid;
        li.innerHTML = `
          <span class="flightsAssignRow__name">${escapeHtml(p.name)}</span>
          <span class="flightsAssignRow__hcp">Handicap ${escapeHtml(String(hcp))}</span>
          <select data-flight-assign="${escapeHtml(pid)}">
            <option value="-1" ${unassignedSel}>— unassigned —</option>
            ${options}
          </select>
        `;
        manualAssignments.appendChild(li);
      });
      manualAssignments.querySelectorAll('[data-flight-assign]').forEach((el) => {
        el.addEventListener('change', (e) => {
          const pid = el.getAttribute('data-flight-assign');
          const targetFi = Number(e.target.value);
          for (const f of state.flights) {
            f.playerIds = (f.playerIds || []).filter((id) => id !== pid);
          }
          if (targetFi >= 0 && targetFi < state.flights.length) {
            state.flights[targetFi].playerIds.push(pid);
          }
          // Cheap re-count without full re-render.
          const rows = manualList.querySelectorAll('.flightsManualRow');
          rows.forEach((row, fi) => {
            const count = row.querySelector('.flightsManualRow__count');
            if (count) {
              const n = (state.flights[fi].playerIds || []).length;
              count.textContent = `${n} player${n === 1 ? '' : 's'}`;
            }
          });
          refreshSaveGate();
        });
      });
    }

    cancelBtn.addEventListener('click', () => {
      if (!isDirty()) return;
      if (!confirm('Discard your flight changes?')) return;
      window.location.reload();
    });

    saveBtn.addEventListener('click', async () => {
      if (state.saving || !isDirty()) return;
      state.saving = true;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving…';
      clearError();

      // Emit snake_case on the wire to match the mobile app's
      // canonical TournamentFlight.toJson shape. The Railway
      // PATCH allowlist accepts `flights` (verified 2026-08-26
      // in packages/api/src/routes/tournaments.ts line 59).
      const wireFlights = state.mode === 'off'
        ? []
        : state.flights.map((f, i) => {
            const out = {
              id: f.id,
              name: (f.name && f.name.trim().length > 0)
                ? f.name.trim() : `Flight ${i + 1}`,
              player_ids: (f.playerIds || []).filter((id) =>
                initialPlayers.some((p) => p.id === id)),
            };
            if (typeof f.handicapMin === 'number' && Number.isFinite(f.handicapMin)) {
              out.handicap_min = f.handicapMin;
            }
            if (typeof f.handicapMax === 'number' && Number.isFinite(f.handicapMax)) {
              out.handicap_max = f.handicapMax;
            }
            return out;
          });

      try {
        const res = await fetch(`/api/tournaments/${encodeURIComponent(tournamentId)}/update`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ flights: wireFlights }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          state.saving = false;
          saveBtn.textContent = 'Save flights';
          refreshSaveGate();
          return showError(data.error || `Save failed with ${res.status}`);
        }
        window.location.reload();
      } catch (err) {
        state.saving = false;
        saveBtn.textContent = 'Save flights';
        refreshSaveGate();
        showError(err?.message || 'Network error — try again.');
      }
    });

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, (ch) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[ch] || ch);
    }

    render();
  </script>

  <script is:inline define:vars={{
    tournamentId: id,
    initialRounds: tournament.rounds ?? [],
    initialPlayers: players,
    initialTeams: (tournament as any).teams ?? [],
  }}>
    // ── Pairings editor (roadmap #6) ────────────────────────
    //
    // Mirrors the wizard's Step 6 UX (three-mode radios per
    // round, groups composer, teams composer) but works against
    // REAL server ids — no `wp_<i>` → server-id rewrite here.
    //
    // Reads per-round `round.teams[]` for existing pairings.
    // Groups mode = teams with no `captain_id`; Teams mode is
    // detected via a top-level `tournament.teams[]` presence
    // check (season teams). When BOTH are empty, mode defaults
    // to 'none'.
    //
    // Saves via PATCH /api/tournaments/:id/update with the
    // rewritten `rounds` array (each round's `teams` field
    // populated for groups/teams modes; empty for 'none') AND
    // the top-level `teams` when Teams mode is used on any
    // round.

    function normalizePlayerIds(raw) {
      const ids = Array.isArray(raw?.playerIds)
        ? raw.playerIds
        : Array.isArray(raw?.player_ids)
        ? raw.player_ids
        : [];
      return ids.filter((x) => typeof x === 'string');
    }

    function normalizeRoundTeam(raw, i, roundIndex) {
      return {
        id: (typeof raw?.id === 'string' && raw.id.length > 0)
          ? raw.id
          : `group_${roundIndex}_${i}_${Date.now()}`,
        name: (typeof raw?.name === 'string' && raw.name.trim().length > 0)
          ? raw.name.trim()
          : `Group ${String.fromCharCode(65 + i)}`,
        playerIds: normalizePlayerIds(raw),
        startingHole: Number.isFinite(Number(raw?.startingHole ?? raw?.starting_hole))
          ? Number(raw?.startingHole ?? raw?.starting_hole)
          : null,
        captainId:
          typeof (raw?.captainId ?? raw?.captain_id) === 'string'
            ? (raw?.captainId ?? raw?.captain_id)
            : null,
      };
    }

    function normalizeTopTeam(raw, i) {
      return {
        id: (typeof raw?.id === 'string' && raw.id.length > 0)
          ? raw.id : `season_team_${i}`,
        name: (typeof raw?.name === 'string' && raw.name.trim().length > 0)
          ? raw.name.trim() : `Team ${String.fromCharCode(65 + i)}`,
        playerIds: normalizePlayerIds(raw),
      };
    }

    const topTeams = (Array.isArray(initialTeams) ? initialTeams : []).map(normalizeTopTeam);
    const hasSeasonTeams = topTeams.length > 0;

    function pairingFromRound(round, roundIndex) {
      const rawTeams = Array.isArray(round?.teams) ? round.teams : [];
      const normalized = rawTeams.map((t, i) => normalizeRoundTeam(t, i, roundIndex));
      if (normalized.length === 0) {
        return { roundIndex, mode: 'none', groups: [], teams: [] };
      }
      // Heuristic: if the tournament has season teams AND the
      // round's team names match one of the season teams,
      // treat as 'teams' mode. Otherwise treat as 'groups' mode.
      if (hasSeasonTeams) {
        const seasonNames = new Set(topTeams.map((t) => t.name.toLowerCase()));
        const matchesSeason = normalized.every((t) => seasonNames.has(t.name.toLowerCase()));
        if (matchesSeason) {
          return {
            roundIndex,
            mode: 'teams',
            groups: [],
            teams: normalized.map((t) => ({
              id: t.id,
              name: t.name,
              playerIds: t.playerIds,
              captainId: t.captainId,
            })),
          };
        }
      }
      return {
        roundIndex,
        mode: 'groups',
        groups: normalized.map((t) => ({
          id: t.id,
          name: t.name,
          playerIds: t.playerIds,
          startingHole: t.startingHole,
        })),
        teams: [],
      };
    }

    const roundsArr = Array.isArray(initialRounds) ? initialRounds : [];
    const state = {
      activeRoundIndex: 0,
      pairings: roundsArr.map((r, i) => pairingFromRound(r, i)),
      saving: false,
    };
    const initialSnapshot = JSON.stringify(state.pairings);

    const tabsEl = document.getElementById('mgPairingsRoundTabs');
    const bodyEl = document.getElementById('mgPairingsRoundBody');
    const errorEl = document.getElementById('pairingsError');
    const saveBtn = document.getElementById('mgPairingsSaveBtn');
    const cancelBtn = document.getElementById('mgPairingsCancelBtn');

    function showError(msg) { errorEl.textContent = msg; errorEl.hidden = false; }
    function clearError() { errorEl.hidden = true; }
    function currentSnapshot() { return JSON.stringify(state.pairings); }
    function isDirty() { return currentSnapshot() !== initialSnapshot; }
    function refreshSaveGate() { saveBtn.disabled = state.saving || !isDirty(); }

    function ensurePairing(roundIndex, mode) {
      let p = state.pairings.find((x) => x.roundIndex === roundIndex);
      if (!p) {
        p = { roundIndex, mode, groups: [], teams: [] };
        state.pairings.push(p);
        state.pairings.sort((a, b) => a.roundIndex - b.roundIndex);
      } else {
        p.mode = mode;
        p.groups = p.groups || [];
        p.teams = p.teams || [];
      }
      return p;
    }

    function assignedIds(p) {
      const s = new Set();
      if (!p) return s;
      const src = p.mode === 'groups' ? (p.groups || []) : (p.mode === 'teams' ? (p.teams || []) : []);
      for (const g of src) for (const pid of g.playerIds || []) s.add(pid);
      return s;
    }

    function teeTimeGroupSizeFor(round) {
      const raw = Number(round?.teeTimeGroupSize ?? round?.tee_time_group_size ?? 4);
      return raw === 2 || raw === 3 || raw === 4 ? raw : 4;
    }

    function startTypeFor(round) {
      const raw = round?.startType ?? round?.start_type;
      return raw === 'shotgun' ? 'shotgun' : 'teeTimes';
    }

    function totalHolesFor(round) {
      const raw = Number(round?.totalHoles ?? round?.total_holes ?? 18);
      return raw === 9 ? 9 : 18;
    }

    function roundLabel(round, i) {
      const nm = typeof round?.name === 'string' ? round.name.trim() : '';
      return nm.length > 0 ? nm : `R${i + 1}`;
    }

    function groupCountFor(round) {
      const size = teeTimeGroupSizeFor(round);
      const n = initialPlayers.length;
      return Math.max(1, Math.ceil(n / size));
    }

    function seedEmptyGroups(roundIndex) {
      const round = roundsArr[roundIndex];
      const count = groupCountFor(round);
      const st = startTypeFor(round);
      return Array.from({ length: count }, (_, i) => ({
        id: `group_${roundIndex}_${i}_${Date.now()}`,
        name: `Group ${String.fromCharCode(65 + i)}`,
        playerIds: [],
        startingHole: st === 'shotgun' ? (i + 1) : null,
      }));
    }

    function seedEmptyTeams(roundIndex, count) {
      return Array.from({ length: count }, (_, i) => ({
        id: `team_${roundIndex}_${i}_${Date.now()}`,
        name: hasSeasonTeams && topTeams[i]
          ? topTeams[i].name
          : `Team ${String.fromCharCode(65 + i)}`,
        playerIds: [],
        captainId: null,
      }));
    }

    function autoAssignSnake(bucketCount) {
      const n = initialPlayers.length;
      const count = Math.max(1, Math.floor(bucketCount));
      const buckets = Array.from({ length: count }, () => []);
      if (n === 0) return buckets;
      const sorted = initialPlayers.map((p) => ({
        pid: p.id,
        hcp: Number.isFinite(Number(p.handicapIndex ?? p.handicap)) ? Number(p.handicapIndex ?? p.handicap) : 18,
      })).sort((a, b) => a.hcp - b.hcp);
      let idx = 0;
      let forward = true;
      for (const s of sorted) {
        buckets[idx].push(s.pid);
        if (forward) {
          if (idx === count - 1) forward = false;
          else idx += 1;
        } else {
          if (idx === 0) forward = true;
          else idx -= 1;
        }
      }
      return buckets;
    }

    function getPairing(i) {
      return state.pairings.find((x) => x.roundIndex === i) || null;
    }

    function renderTabs() {
      tabsEl.innerHTML = '';
      if (roundsArr.length === 0) {
        bodyEl.innerHTML = '<p class="rosterCard__meta">No rounds configured.</p>';
        return;
      }
      roundsArr.forEach((r, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.setAttribute('role', 'tab');
        btn.className = 'pairingsRoundTab';
        const isCurrent = i === state.activeRoundIndex;
        if (isCurrent) btn.classList.add('is-current');
        btn.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        btn.textContent = roundLabel(r, i);
        btn.addEventListener('click', () => {
          state.activeRoundIndex = i;
          renderTabs();
          renderBody();
        });
        tabsEl.appendChild(btn);
      });
    }

    function renderBody() {
      const i = state.activeRoundIndex;
      const round = roundsArr[i];
      if (!round) { bodyEl.innerHTML = ''; return; }
      const pairing = getPairing(i);
      const mode = pairing ? pairing.mode : 'none';
      bodyEl.innerHTML = '';

      const fs = document.createElement('fieldset');
      fs.className = 'field field--group';
      fs.innerHTML = `
        <legend class="field__label">Pairings for ${escapeHtml(roundLabel(round, i))}</legend>
        <div class="radios radios--stacked">
          <label>
            <input type="radio" name="mgPairingMode_${i}" value="none" ${mode === 'none' ? 'checked' : ''} />
            <span><strong>No pairings</strong> — players self-organize on the tee</span>
          </label>
          <label>
            <input type="radio" name="mgPairingMode_${i}" value="groups" ${mode === 'groups' ? 'checked' : ''} />
            <span><strong>Groups</strong> — split field into ${teeTimeGroupSizeFor(round)}-somes${startTypeFor(round) === 'shotgun' ? ' with shotgun start holes' : ' (tee times)'}</span>
          </label>
          <label>
            <input type="radio" name="mgPairingMode_${i}" value="teams" ${mode === 'teams' ? 'checked' : ''} />
            <span><strong>Teams</strong> — Cup-style team assignment (2/3/4 teams)</span>
          </label>
        </div>
      `;
      bodyEl.appendChild(fs);
      fs.querySelectorAll('input[type=radio]').forEach((input) => {
        input.addEventListener('change', () => {
          const next = input.value;
          if (next === 'none') {
            ensurePairing(i, 'none');
          } else if (next === 'groups') {
            const p = ensurePairing(i, 'groups');
            if (!p.groups || p.groups.length === 0) p.groups = seedEmptyGroups(i);
          } else if (next === 'teams') {
            const p = ensurePairing(i, 'teams');
            if (!p.teams || p.teams.length === 0) p.teams = seedEmptyTeams(i, 2);
          }
          renderBody();
          refreshSaveGate();
        });
      });

      // Copy-from-another-round.
      const prevOptions = [];
      for (let j = 0; j < roundsArr.length; j++) {
        if (j === i) continue;
        const pj = getPairing(j);
        if (!pj || pj.mode === 'none') continue;
        prevOptions.push({ index: j, label: roundLabel(roundsArr[j], j), mode: pj.mode });
      }
      if (prevOptions.length > 0) {
        const copyRow = document.createElement('div');
        copyRow.className = 'pairingsCopyRow';
        const sel = document.createElement('select');
        sel.innerHTML =
          '<option value="">Copy from another round…</option>' +
          prevOptions.map((o) => `<option value="${o.index}">${escapeHtml(o.label)} (${o.mode})</option>`).join('');
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn--ghost btn--sm';
        btn.textContent = 'Copy';
        btn.disabled = true;
        sel.addEventListener('change', () => { btn.disabled = sel.value === ''; });
        btn.addEventListener('click', () => {
          const src = getPairing(Number(sel.value));
          if (!src) return;
          const dst = ensurePairing(i, src.mode);
          dst.mode = src.mode;
          const st = startTypeFor(roundsArr[i]);
          if (src.mode === 'groups') {
            dst.groups = (src.groups || []).map((g, gi) => ({
              id: `group_${i}_${gi}_${Date.now()}`,
              name: g.name,
              playerIds: [...(g.playerIds || [])],
              startingHole: st === 'shotgun' ? (g.startingHole ?? null) : null,
            }));
          } else if (src.mode === 'teams') {
            dst.teams = (src.teams || []).map((t, ti) => ({
              id: `team_${i}_${ti}_${Date.now()}`,
              name: t.name,
              playerIds: [...(t.playerIds || [])],
              captainId: t.captainId ?? null,
            }));
          }
          renderBody();
          refreshSaveGate();
        });
        copyRow.appendChild(sel);
        copyRow.appendChild(btn);
        bodyEl.appendChild(copyRow);
      }

      if (mode === 'none') {
        const hint = document.createElement('p');
        hint.className = 'rosterCard__meta';
        hint.textContent = 'No pairings set. Players will self-organize on the tee.';
        bodyEl.appendChild(hint);
        return;
      }
      if (mode === 'groups') { renderGroups(round, ensurePairing(i, 'groups')); }
      if (mode === 'teams') { renderTeams(ensurePairing(i, 'teams')); }
    }

    function renderGroups(round, pairing) {
      const roundIndex = pairing.roundIndex;
      const assigned = assignedIds(pairing);

      const actions = document.createElement('div');
      actions.className = 'pairingsActionsRow';
      actions.innerHTML = `
        <button type="button" class="btn btn--ghost btn--sm" data-action="autoGroups">Auto-assign by handicap</button>
        <button type="button" class="btn btn--ghost btn--sm" data-action="clearGroups">Clear all</button>
      `;
      bodyEl.appendChild(actions);
      actions.querySelector('[data-action="autoGroups"]').addEventListener('click', () => {
        const groups = seedEmptyGroups(roundIndex);
        const buckets = autoAssignSnake(groups.length);
        for (let k = 0; k < groups.length; k++) groups[k].playerIds = buckets[k] || [];
        pairing.groups = groups;
        renderBody(); refreshSaveGate();
      });
      actions.querySelector('[data-action="clearGroups"]').addEventListener('click', () => {
        for (const g of pairing.groups || []) g.playerIds = [];
        renderBody(); refreshSaveGate();
      });

      const poolWrap = document.createElement('div');
      poolWrap.className = 'pairingsPool';
      poolWrap.innerHTML = `<div class="pairingsPool__label">Available (${initialPlayers.length - assigned.size})</div>`;
      const poolChips = document.createElement('div');
      poolChips.className = 'pairingsPool__chips';
      initialPlayers.forEach((p) => {
        if (assigned.has(p.id)) return;
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'pairingsChip pairingsChip--pool';
        const hcp = Number(p.handicapIndex ?? p.handicap ?? 18);
        chip.textContent = `${p.name} (${Number.isFinite(hcp) ? hcp.toFixed(1) : '18.0'})`;
        chip.addEventListener('click', () => {
          const size = teeTimeGroupSizeFor(round);
          let target = null;
          for (const g of pairing.groups) if ((g.playerIds || []).length < size) { target = g; break; }
          if (!target) {
            const gi = pairing.groups.length;
            target = {
              id: `group_${roundIndex}_${gi}_${Date.now()}`,
              name: `Group ${String.fromCharCode(65 + gi)}`,
              playerIds: [],
              startingHole: startTypeFor(round) === 'shotgun' ? (gi + 1) : null,
            };
            pairing.groups.push(target);
          }
          target.playerIds.push(p.id);
          renderBody(); refreshSaveGate();
        });
        poolChips.appendChild(chip);
      });
      if (initialPlayers.length - assigned.size === 0) {
        const empty = document.createElement('span');
        empty.className = 'pairingsPool__empty';
        empty.textContent = 'All players assigned.';
        poolChips.appendChild(empty);
      }
      poolWrap.appendChild(poolChips);
      bodyEl.appendChild(poolWrap);

      const wrap = document.createElement('div');
      wrap.className = 'pairingsGroups';
      (pairing.groups || []).forEach((g) => {
        const card = document.createElement('div');
        card.className = 'pairingsGroupCard';
        const size = teeTimeGroupSizeFor(round);
        card.innerHTML = `
          <div class="pairingsGroupCard__head">
            <strong>${escapeHtml(g.name)}</strong>
            <span class="pairingsGroupCard__count">${(g.playerIds || []).length}/${size}</span>
          </div>
        `;
        if (startTypeFor(round) === 'shotgun') {
          const label = document.createElement('label');
          label.className = 'pairingsGroupCard__holeLabel';
          label.textContent = 'Start hole';
          const sel = document.createElement('select');
          sel.className = 'pairingsGroupCard__holeSelect';
          const total = totalHolesFor(round);
          for (let h = 1; h <= total; h++) {
            const opt = document.createElement('option');
            opt.value = String(h);
            opt.textContent = String(h);
            if (Number(g.startingHole) === h) opt.selected = true;
            sel.appendChild(opt);
          }
          sel.addEventListener('change', () => {
            g.startingHole = Number(sel.value);
            refreshSaveGate();
          });
          label.appendChild(sel);
          card.appendChild(label);
        }
        const chips = document.createElement('div');
        chips.className = 'pairingsGroupCard__chips';
        (g.playerIds || []).forEach((pid) => {
          const p = initialPlayers.find((pp) => pp.id === pid);
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'pairingsChip pairingsChip--assigned';
          chip.textContent = p ? `${p.name} × remove` : `${pid} × remove`;
          chip.addEventListener('click', () => {
            g.playerIds = (g.playerIds || []).filter((x) => x !== pid);
            renderBody(); refreshSaveGate();
          });
          chips.appendChild(chip);
        });
        if ((g.playerIds || []).length === 0) {
          const empty = document.createElement('span');
          empty.className = 'pairingsPool__empty';
          empty.textContent = 'Empty group — tap players in the pool above.';
          chips.appendChild(empty);
        }
        card.appendChild(chips);
        wrap.appendChild(card);
      });
      bodyEl.appendChild(wrap);
    }

    function renderTeams(pairing) {
      const roundIndex = pairing.roundIndex;
      const assigned = assignedIds(pairing);

      const controls = document.createElement('div');
      controls.className = 'pairingsActionsRow';
      const cntLabel = document.createElement('label');
      cntLabel.className = 'pairingsTeamCountLabel';
      cntLabel.textContent = 'Team count';
      const cntSel = document.createElement('select');
      [2, 3, 4].forEach((n) => {
        const opt = document.createElement('option');
        opt.value = String(n);
        opt.textContent = `${n} teams`;
        if ((pairing.teams || []).length === n) opt.selected = true;
        cntSel.appendChild(opt);
      });
      cntSel.addEventListener('change', () => {
        const next = Number(cntSel.value);
        const cur = (pairing.teams || []).length;
        if (next > cur) {
          for (let k = cur; k < next; k++) {
            pairing.teams.push({
              id: `team_${roundIndex}_${k}_${Date.now()}`,
              name: `Team ${String.fromCharCode(65 + k)}`,
              playerIds: [],
              captainId: null,
            });
          }
        } else if (next < cur) {
          pairing.teams = pairing.teams.slice(0, next);
        }
        renderBody(); refreshSaveGate();
      });
      cntLabel.appendChild(cntSel);
      controls.appendChild(cntLabel);

      const auto = document.createElement('button');
      auto.type = 'button'; auto.className = 'btn btn--ghost btn--sm';
      auto.textContent = 'Auto-assign by handicap';
      auto.addEventListener('click', () => {
        const count = (pairing.teams || []).length || 2;
        const buckets = autoAssignSnake(count);
        for (let k = 0; k < pairing.teams.length; k++) {
          pairing.teams[k].playerIds = buckets[k] || [];
          pairing.teams[k].captainId = pairing.teams[k].playerIds[0] || null;
        }
        renderBody(); refreshSaveGate();
      });
      controls.appendChild(auto);

      const clr = document.createElement('button');
      clr.type = 'button'; clr.className = 'btn btn--ghost btn--sm';
      clr.textContent = 'Clear all';
      clr.addEventListener('click', () => {
        for (const t of pairing.teams || []) { t.playerIds = []; t.captainId = null; }
        renderBody(); refreshSaveGate();
      });
      controls.appendChild(clr);
      bodyEl.appendChild(controls);

      const poolWrap = document.createElement('div');
      poolWrap.className = 'pairingsPool';
      poolWrap.innerHTML = `<div class="pairingsPool__label">Available (${initialPlayers.length - assigned.size})</div>`;
      const poolChips = document.createElement('div');
      poolChips.className = 'pairingsPool__chips';
      initialPlayers.forEach((p) => {
        if (assigned.has(p.id)) return;
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'pairingsChip pairingsChip--pool';
        const hcp = Number(p.handicapIndex ?? p.handicap ?? 18);
        chip.textContent = `${p.name} (${Number.isFinite(hcp) ? hcp.toFixed(1) : '18.0'})`;
        chip.addEventListener('click', () => {
          let target = null;
          let smallest = Infinity;
          for (const t of pairing.teams) {
            const nn = (t.playerIds || []).length;
            if (nn < smallest) { smallest = nn; target = t; }
          }
          if (!target) target = pairing.teams[0];
          if (target) {
            target.playerIds.push(p.id);
            if (!target.captainId) target.captainId = p.id;
          }
          renderBody(); refreshSaveGate();
        });
        poolChips.appendChild(chip);
      });
      if (initialPlayers.length - assigned.size === 0) {
        const empty = document.createElement('span');
        empty.className = 'pairingsPool__empty';
        empty.textContent = 'All players assigned.';
        poolChips.appendChild(empty);
      }
      poolWrap.appendChild(poolChips);
      bodyEl.appendChild(poolWrap);

      const wrap = document.createElement('div');
      wrap.className = 'pairingsTeams';
      (pairing.teams || []).forEach((t, ti) => {
        const card = document.createElement('div');
        card.className = 'pairingsTeamCard';
        const nameInput = document.createElement('input');
        nameInput.type = 'text';
        nameInput.className = 'pairingsTeamCard__name';
        nameInput.value = t.name || `Team ${String.fromCharCode(65 + ti)}`;
        nameInput.addEventListener('input', () => {
          t.name = nameInput.value;
          refreshSaveGate();
        });
        const head = document.createElement('div');
        head.className = 'pairingsTeamCard__head';
        head.appendChild(nameInput);
        const cnt = document.createElement('span');
        cnt.className = 'pairingsTeamCard__count';
        cnt.textContent = `${(t.playerIds || []).length} player${(t.playerIds || []).length === 1 ? '' : 's'}`;
        head.appendChild(cnt);
        card.appendChild(head);
        const chips = document.createElement('div');
        chips.className = 'pairingsTeamCard__chips';
        (t.playerIds || []).forEach((pid) => {
          const p = initialPlayers.find((pp) => pp.id === pid);
          const isCap = t.captainId === pid;
          const row = document.createElement('div');
          row.className = 'pairingsPlayerRow';
          const nm = document.createElement('span');
          nm.className = 'pairingsPlayerRow__name';
          const hcp = p ? Number(p.handicapIndex ?? p.handicap ?? 18) : 18;
          nm.textContent = p ? `${p.name} (${Number.isFinite(hcp) ? hcp.toFixed(1) : '18.0'})` : pid;
          row.appendChild(nm);
          const cap = document.createElement('button');
          cap.type = 'button';
          cap.className = 'pairingsPlayerRow__cap' + (isCap ? ' is-current' : '');
          cap.textContent = isCap ? '★' : '☆';
          cap.title = isCap ? 'Captain' : 'Make captain';
          cap.addEventListener('click', () => {
            t.captainId = isCap ? null : pid;
            renderBody(); refreshSaveGate();
          });
          row.appendChild(cap);
          const rm = document.createElement('button');
          rm.type = 'button';
          rm.className = 'pairingsPlayerRow__remove';
          rm.textContent = '×';
          rm.addEventListener('click', () => {
            t.playerIds = (t.playerIds || []).filter((x) => x !== pid);
            if (t.captainId === pid) t.captainId = t.playerIds[0] || null;
            renderBody(); refreshSaveGate();
          });
          row.appendChild(rm);
          chips.appendChild(row);
        });
        if ((t.playerIds || []).length === 0) {
          const empty = document.createElement('span');
          empty.className = 'pairingsPool__empty';
          empty.textContent = 'Empty team — tap players in the pool above.';
          chips.appendChild(empty);
        }
        card.appendChild(chips);
        wrap.appendChild(card);
      });
      bodyEl.appendChild(wrap);
    }

    // Build the wire payload — `rounds` array with each round's
    // `teams` field emitted per its pairing mode, plus top-level
    // `teams` derived from any Teams-mode pairing entry.
    function buildWirePayload() {
      // Player id validity — drop unknowns silently.
      const validPids = new Set(initialPlayers.map((p) => p.id));

      const newRounds = roundsArr.map((r, i) => {
        const p = getPairing(i);
        // Preserve everything on the existing round row; only
        // rewrite `teams`.
        const clone = JSON.parse(JSON.stringify(r));
        if (!p || p.mode === 'none') {
          clone.teams = [];
          return clone;
        }
        if (p.mode === 'groups') {
          clone.teams = (p.groups || []).map((g, gi) => {
            const out = {
              id: g.id || `group_${i}_${gi}`,
              name: g.name || `Group ${String.fromCharCode(65 + gi)}`,
              player_ids: (g.playerIds || []).filter((pid) => validPids.has(pid)),
            };
            if (typeof g.startingHole === 'number' && Number.isFinite(g.startingHole)) {
              out.starting_hole = Math.max(1, Math.min(18, Math.round(g.startingHole)));
            }
            return out;
          });
        } else if (p.mode === 'teams') {
          clone.teams = (p.teams || []).map((t, ti) => {
            const pids = (t.playerIds || []).filter((pid) => validPids.has(pid));
            const out = {
              id: t.id || `team_${i}_${ti}`,
              name: t.name || `Team ${String.fromCharCode(65 + ti)}`,
              player_ids: pids,
            };
            if (t.captainId && pids.includes(t.captainId)) {
              out.captain_id = t.captainId;
            }
            return out;
          });
        }
        return clone;
      });

      // Season teams — merge any Teams-mode rounds by team name.
      const seasonByName = new Map();
      let seasonIdx = 0;
      for (const p of state.pairings) {
        if (p.mode !== 'teams') continue;
        for (const t of (p.teams || [])) {
          const key = (t.name || '').trim().toLowerCase();
          if (!key) continue;
          if (!seasonByName.has(key)) {
            seasonByName.set(key, {
              id: `season_team_${seasonIdx++}`,
              name: t.name.trim(),
              player_ids: new Set(),
            });
          }
          const entry = seasonByName.get(key);
          for (const pid of t.playerIds || []) if (validPids.has(pid)) entry.player_ids.add(pid);
        }
      }
      const newTeams = [...seasonByName.values()].map((t) => ({
        id: t.id,
        name: t.name,
        player_ids: [...t.player_ids],
      }));

      return { rounds: newRounds, teams: newTeams };
    }

    cancelBtn.addEventListener('click', () => {
      state.pairings = JSON.parse(initialSnapshot);
      state.activeRoundIndex = 0;
      renderTabs(); renderBody(); refreshSaveGate(); clearError();
    });

    saveBtn.addEventListener('click', async () => {
      if (state.saving || !isDirty()) return;
      state.saving = true;
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving…';
      clearError();
      try {
        const payload = buildWirePayload();
        const res = await fetch(`/api/tournaments/${encodeURIComponent(tournamentId)}/update`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          state.saving = false;
          saveBtn.textContent = 'Save pairings';
          refreshSaveGate();
          return showError(data.error || `Save failed with ${res.status}`);
        }
        window.location.reload();
      } catch (err) {
        state.saving = false;
        saveBtn.textContent = 'Save pairings';
        refreshSaveGate();
        showError(err?.message || 'Network error — try again.');
      }
    });

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, (ch) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[ch] || ch);
    }

    renderTabs();
    renderBody();
    refreshSaveGate();
  </script>

  <script is:inline define:vars={{
    tournamentId: id,
    initialInvites,
  }}>
    // ── Invites card — roadmap #5 ───────────────────────────
    //
    // Reads the initial invite list from the SSR fetch, so first
    // paint has real chip state. Mutations go through the
    // /api/tournaments/[id]/invites proxy — POST for send/resend,
    // DELETE for revoke. Every write re-fetches via GET so the
    // list stays in sync with server truth (matches the mobile
    // app's TournamentInvitesNotifier._refresh pattern).
    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const inviteInputEl = document.getElementById('mgInviteInput');
    const inviteAddEl = document.getElementById('mgInviteAddBtn');
    const inviteSendEl = document.getElementById('mgInviteSendBtn');
    const inviteChipsEl = document.getElementById('mgInviteChipsList');
    const inviteChipsEmptyEl = document.getElementById('mgInviteChipsEmpty');
    const inviteListEl = document.getElementById('mgInvitesList');
    const inviteListEmptyEl = document.getElementById('mgInvitesEmpty');
    const inviteErrorEl = document.getElementById('invitesError');

    // Pending draft chips — collected in the input, sent as one
    // batch when the user clicks "Send invites".
    const draft = [];
    let sending = false;
    // Server-side invite list — starts from SSR data, refreshed
    // after every send/revoke.
    let invites = Array.isArray(initialInvites) ? initialInvites.slice() : [];

    function showInviteError(msg) {
      inviteErrorEl.textContent = msg;
      inviteErrorEl.hidden = false;
    }
    function clearInviteError() {
      inviteErrorEl.hidden = true;
      inviteErrorEl.textContent = '';
    }

    function normaliseEmail(raw) { return String(raw).trim().toLowerCase(); }

    function addDraftEmails(raw) {
      const parts = String(raw)
        .split(/[\s,;]+/)
        .map(normaliseEmail)
        .filter((e) => e.length > 0);
      let added = 0;
      let firstInvalid = null;
      for (const email of parts) {
        if (!EMAIL_RE.test(email)) {
          if (!firstInvalid) firstInvalid = email;
          continue;
        }
        if (draft.includes(email)) continue;
        draft.push(email);
        added++;
      }
      if (firstInvalid && added === 0) {
        showInviteError(`"${firstInvalid}" isn't a valid email address.`);
      } else if (firstInvalid) {
        showInviteError(`Some entries were skipped — "${firstInvalid}" isn't valid.`);
      } else {
        clearInviteError();
      }
      renderDraft();
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, (ch) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[ch] || ch);
    }

    function renderDraft() {
      inviteChipsEl.innerHTML = '';
      draft.forEach((email, i) => {
        const li = document.createElement('li');
        li.className = 'inviteChips__chip';
        li.innerHTML = `
          <span class="inviteChips__email">${escapeHtml(email)}</span>
          <button type="button" class="inviteChips__remove" data-draft-remove="${i}" aria-label="Remove ${escapeHtml(email)}">×</button>
        `;
        inviteChipsEl.appendChild(li);
      });
      inviteChipsEl.querySelectorAll('[data-draft-remove]').forEach((el) => {
        el.addEventListener('click', () => {
          const idx = Number(el.getAttribute('data-draft-remove'));
          draft.splice(idx, 1);
          renderDraft();
        });
      });
      inviteChipsEmptyEl.hidden = draft.length > 0;
      inviteSendEl.disabled = draft.length === 0 || sending;
    }

    function fmtDate(iso) {
      if (!iso) return '';
      const d = new Date(iso);
      if (isNaN(d.getTime())) return '';
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
    }

    function renderInvites() {
      inviteListEl.innerHTML = '';
      invites.forEach((inv) => {
        const li = document.createElement('li');
        li.className = 'invitesList__row';
        const statusCls = `invitesList__status--${inv.status || 'pending'}`;
        const dateStr = fmtDate(inv.created_at);
        li.innerHTML = `
          <span class="invitesList__email">${escapeHtml(inv.email)}</span>
          <span class="invitesList__status ${statusCls}">${escapeHtml(inv.status || 'pending')}${dateStr ? ' · ' + escapeHtml(dateStr) : ''}</span>
          <button type="button" class="invitesList__btn" data-invite-resend="${escapeHtml(inv.email)}">Resend</button>
          <button type="button" class="invitesList__btn invitesList__btn--danger" data-invite-revoke="${escapeHtml(inv.id)}" ${inv.status === 'revoked' ? 'disabled' : ''}>Revoke</button>
        `;
        inviteListEl.appendChild(li);
      });
      inviteListEl.querySelectorAll('[data-invite-resend]').forEach((el) => {
        el.addEventListener('click', () => resendInvite(el.getAttribute('data-invite-resend')));
      });
      inviteListEl.querySelectorAll('[data-invite-revoke]').forEach((el) => {
        el.addEventListener('click', () => revokeInvite(el.getAttribute('data-invite-revoke')));
      });
      inviteListEmptyEl.hidden = invites.length > 0;
    }

    async function refreshInvites() {
      try {
        const res = await fetch(`/api/tournaments/${encodeURIComponent(tournamentId)}/invites`, {
          method: 'GET',
        });
        if (!res.ok) return;
        const body = await res.json().catch(() => null);
        if (body && Array.isArray(body.invites)) {
          invites = body.invites;
          renderInvites();
        }
      } catch (e) {
        // Non-fatal — the list will refresh on next mutation.
      }
    }

    async function sendDraft() {
      if (draft.length === 0 || sending) return;
      sending = true;
      inviteSendEl.disabled = true;
      const originalLabel = inviteSendEl.textContent;
      inviteSendEl.textContent = 'Sending…';
      clearInviteError();
      try {
        const res = await fetch(`/api/tournaments/${encodeURIComponent(tournamentId)}/invites`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ emails: draft.slice() }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          showInviteError(body.error || `Send failed with ${res.status}`);
          return;
        }
        const results = Array.isArray(body.invites) ? body.invites : [];
        const failed = results.filter((r) => r.sent !== true).length;
        // Clear the draft — server dedupes/reuses tokens for the ones that
        // failed to email, so a subsequent resend from the pending list is
        // the correct path (not re-adding to draft).
        draft.length = 0;
        renderDraft();
        if (failed > 0) {
          showInviteError(
            `${results.length - failed} invite${results.length - failed === 1 ? '' : 's'} sent, ` +
            `${failed} didn't send. Use Resend below to retry.`,
          );
        }
        await refreshInvites();
      } catch (e) {
        showInviteError((e && e.message) || 'Network error — try again.');
      } finally {
        sending = false;
        inviteSendEl.disabled = draft.length === 0;
        inviteSendEl.textContent = originalLabel;
      }
    }

    async function resendInvite(email) {
      if (!email) return;
      clearInviteError();
      try {
        const res = await fetch(`/api/tournaments/${encodeURIComponent(tournamentId)}/invites`, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ emails: [email] }),
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) {
          showInviteError(body.error || `Resend failed with ${res.status}`);
          return;
        }
        const results = Array.isArray(body.invites) ? body.invites : [];
        const one = results[0];
        if (one && one.sent === false) {
          showInviteError(`Row re-armed but email dispatch failed for ${email}.`);
        }
        await refreshInvites();
      } catch (e) {
        showInviteError((e && e.message) || 'Network error — try again.');
      }
    }

    async function revokeInvite(inviteId) {
      if (!inviteId) return;
      if (!confirm('Revoke this invite? The link stops working immediately.')) return;
      clearInviteError();
      try {
        const res = await fetch(
          `/api/tournaments/${encodeURIComponent(tournamentId)}/invites?inviteId=${encodeURIComponent(inviteId)}`,
          { method: 'DELETE' },
        );
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          showInviteError(body.error || `Revoke failed with ${res.status}`);
          return;
        }
        await refreshInvites();
      } catch (e) {
        showInviteError((e && e.message) || 'Network error — try again.');
      }
    }

    if (inviteAddEl && inviteInputEl) {
      inviteAddEl.addEventListener('click', () => {
        const raw = inviteInputEl.value;
        if (raw.trim().length === 0) return;
        addDraftEmails(raw);
        inviteInputEl.value = '';
        inviteInputEl.focus();
      });
      inviteInputEl.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter' || ev.key === ',' || ev.key === ';') {
          const raw = inviteInputEl.value;
          if (raw.trim().length === 0) return;
          ev.preventDefault();
          addDraftEmails(raw);
          inviteInputEl.value = '';
        }
      });
      inviteInputEl.addEventListener('blur', () => {
        const raw = inviteInputEl.value;
        if (raw.trim().length === 0) return;
        addDraftEmails(raw);
        inviteInputEl.value = '';
      });
      inviteInputEl.addEventListener('paste', (ev) => {
        const text = ev.clipboardData?.getData('text');
        if (!text || !/[\s,;]/.test(text)) return;
        ev.preventDefault();
        addDraftEmails(text);
        inviteInputEl.value = '';
      });
    }
    if (inviteSendEl) {
      inviteSendEl.addEventListener('click', sendDraft);
    }

    renderDraft();
    renderInvites();
  </script>
  </>
)}

