---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TournamentSubnav from '../../../../components/TournamentSubnav.astro';

const { id } = Astro.params;
---

<BaseLayout title={`Calcutta · Tournament ${id} · Bagpipe Golf`}>
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">Tournament · Calcutta</p>
    <h1 class="pagewrap__title">Calcutta auction.</h1>
    <p class="pagewrap__sub">
      Lots, ownership, live payouts.
    </p>

    <TournamentSubnav id={id!} active="calcutta" />

    <section class="grid grid--2">
      <article class="card">
        <span class="chip chip--muted">Coming soon</span>
        <h3>Lots</h3>
        <p>Players / teams up for auction.</p>
      </article>
      <article class="card">
        <span class="chip chip--muted">Coming soon</span>
        <h3>Ownership</h3>
        <p>Buyer, price, split shares.</p>
      </article>
      <article class="card">
        <span class="chip chip--muted">Coming soon</span>
        <h3>Pot &amp; payout curve</h3>
        <p>Total pot, places paid, distribution.</p>
      </article>
      <article class="card">
        <span class="chip chip--muted">Coming soon</span>
        <h3>Live position</h3>
        <p>Live valuations as the leaderboard moves.</p>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .card h3 {
    font-size: 17px;
    color: var(--brand-green-dark);
    margin: 8px 0 4px;
  }
  .card p { margin: 0; color: var(--ink-muted); font-size: 14px; }
</style>
