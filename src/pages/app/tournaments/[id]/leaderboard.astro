---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TournamentSubnav from '../../../../components/TournamentSubnav.astro';

const { id } = Astro.params;
---

<BaseLayout title={`Leaderboard · Tournament ${id} · Bagpipe Golf`}>
  <main class="pagewrap">
    <p class="pagewrap__eyebrow">Tournament · leaderboard</p>
    <h1 class="pagewrap__title">Leaderboard</h1>
    <p class="pagewrap__sub">Live gross, net, Stableford, Match Board, side pools.</p>

    <TournamentSubnav id={id!} active="leaderboard" />

    <section class="grid grid--2">
      <article class="card">
        <span class="chip chip--muted">Coming soon</span>
        <h3>Stroke leaderboard</h3>
        <p>Gross / net / Stableford with sort toggle, vs-par columns.</p>
      </article>
      <article class="card">
        <span class="chip chip--muted">Coming soon</span>
        <h3>Match Board</h3>
        <p>Cup-format awards per match — 1.0 / 0.5 / 0.0, closeout-aware.</p>
      </article>
      <article class="card">
        <span class="chip chip--muted">Coming soon</span>
        <h3>Side pools</h3>
        <p>Closest-to-pin, longest drive, skins.</p>
      </article>
      <article class="card">
        <span class="chip chip--muted">Coming soon</span>
        <h3>Kiosk mode</h3>
        <p>Full-screen TV view for the clubhouse.</p>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .card h3 {
    font-size: 17px;
    color: var(--brand-green-dark);
    margin: 8px 0 4px;
  }
  .card p { margin: 0; color: var(--ink-muted); font-size: 14px; }
</style>
