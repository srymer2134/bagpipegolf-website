---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TournamentSubnav from '../../../../components/TournamentSubnav.astro';
import { createSupabaseClient } from '../../../../lib/supabase';
import { getPublicTournament } from '../../../../lib/tournamentQueries';
import {
  buildRoundLeaderboard,
  buildTotalLeaderboard,
  buildBrigadeTotals,
  extractCtpEntries,
  formatVsPar,
  isBallynealBrigade,
  type LeaderboardRow,
  type BrigadeRow,
} from '../../../../lib/leaderboard';
import {
  buildRoundTeamStandings,
  buildTotalTeamStandings,
  isBestBallFormat,
  type TeamStandingRow,
} from '../../../../lib/teamStandings';
import {
  buildRoundMatchBoard,
  buildAllRoundsMatchBoard,
  isHeadToHeadFormat,
  type MatchStatus,
} from '../../../../lib/matchBoard';
import {
  buildAllSkinsSections,
  hasAnySkinsPool,
  type SkinsSection,
} from '../../../../lib/skinsPool';
import type { TournamentRound } from '../../../../lib/tournamentQueries';

// Public leaderboard — no auth required. RLS grants anon SELECT
// on public.tournaments via the `web_leaderboard_public_read_
// tournaments` policy (migration 20260727 in the Flutter repo).
// Sam's Ballyneal Brigade 2026-07-27 ask: "cast to large screen"
// for TV/clubhouse viewing. Kiosk-optimised layout at the bottom.
//
// View state is URL-driven so it survives the 30-second auto
// refresh + is shareable via QR code:
//   ?view=net       → net leaderboard (default gross)
//   ?round=<id>     → single-round view (default TOTAL)
//   ?kiosk=1        → big-print TV mode
//
// Match Board (Cup-style head-to-head) is deferred — Brigade is
// stroke-aggregate. Add when a Cup tourney needs the web view.

const { id } = Astro.params;
const url = new URL(Astro.request.url);
const kiosk = url.searchParams.get('kiosk') === '1';
const view = url.searchParams.get('view') === 'net' ? 'net' : 'gross';
const roundIdParam = url.searchParams.get('round');
// `?board=teams`   → Best Ball team standings (2-man low-net /
//                     4-man best-2-of-4-nets). Ignored on non-BB rounds.
// `?board=matches` → Cup-style head-to-head Match Board. Ignored
//                     when no round in the tournament uses a match-play
//                     format (best_ball / best_three_of_four / singles).
const boardParam = url.searchParams.get('board');
const boardMode: 'individual' | 'teams' | 'matches' | 'skins' =
  boardParam === 'teams' ? 'teams'
  : boardParam === 'matches' ? 'matches'
  : boardParam === 'skins' ? 'skins'
  : 'individual';

const supabase = createSupabaseClient({
  request: Astro.request,
  cookies: Astro.cookies,
  locals: Astro.locals,
});

let notFound = false;
let loadError: string | null = null;
let tournamentName = 'Tournament';
let courseName: string | null = null;
let rows: LeaderboardRow[] = [];
let brigadeRows: BrigadeRow[] = [];
let isBrigadeTotal = false;
let teamRows: TeamStandingRow[] = [];
let matchGroups: { round: TournamentRound; matches: MatchStatus[] }[] = [];
let skinsSections: SkinsSection[] = [];
let anySkinsEnabled = false;
let ctpEntries: ReturnType<typeof extractCtpEntries> = [];
type RoundTab = { id: string; name: string; format: string };
let rounds: RoundTab[] = [];
let activeRoundId: string | null = null;
let anyNetAvailable = false;
// Toggle-visibility signals. Drives which chips render on the
// Individual/Teams/Matches toolbar row.
let anyBestBall = false;
let anyMatchPlay = false;
let activeRoundIsBestBall = false;
let activeRoundIsMatchPlay = false;

try {
  if (!id) {
    notFound = true;
  } else {
    const t = await getPublicTournament(supabase, id);
    if (!t) {
      notFound = true;
    } else {
      tournamentName = t.name;
      courseName = t.course_name;
      const brigadeSpecial = isBallynealBrigade(t);
      // Brigade R2 used a daily-HC allowance model; TD hides it
      // from the chip strip so casual viewers don't compare its
      // scores against R1/R3 (which use tournament-wide HCs).
      rounds = t.rounds
        .filter((r) => !(brigadeSpecial && r.name === 'Round 2'))
        .map((r) => ({
          id: r.id,
          name: r.name,
          format: r.format,
        }));
      const validRound =
          roundIdParam != null && rounds.some((r) => r.id === roundIdParam);
      activeRoundId = validRound ? roundIdParam : null;
      anyBestBall = rounds.some((r) => isBestBallFormat(r.format));
      anyMatchPlay = rounds.some((r) => isHeadToHeadFormat(r.format));
      activeRoundIsBestBall = activeRoundId != null
          && rounds.find((r) => r.id === activeRoundId)?.format != null
          && isBestBallFormat(rounds.find((r) => r.id === activeRoundId)!.format);
      activeRoundIsMatchPlay = activeRoundId != null
          && rounds.find((r) => r.id === activeRoundId)?.format != null
          && isHeadToHeadFormat(rounds.find((r) => r.id === activeRoundId)!.format);

      anySkinsEnabled = hasAnySkinsPool(t);
      const canShowTeams = activeRoundId ? activeRoundIsBestBall : anyBestBall;
      const canShowMatches = activeRoundId ? activeRoundIsMatchPlay : anyMatchPlay;
      const canShowSkins = anySkinsEnabled;
      const effectiveBoard =
        boardMode === 'teams' && canShowTeams ? 'teams'
        : boardMode === 'matches' && canShowMatches ? 'matches'
        : boardMode === 'skins' && canShowSkins ? 'skins'
        : 'individual';

      if (effectiveBoard === 'teams') {
        teamRows = activeRoundId
          ? buildRoundTeamStandings(
              t,
              t.rounds.find((r) => r.id === activeRoundId)!,
            )
          : buildTotalTeamStandings(t);
      } else if (effectiveBoard === 'matches') {
        if (activeRoundId) {
          const rd = t.rounds.find((r) => r.id === activeRoundId)!;
          matchGroups = [{ round: rd, matches: buildRoundMatchBoard(t, rd) }];
        } else {
          matchGroups = buildAllRoundsMatchBoard(t);
        }
      } else if (effectiveBoard === 'skins') {
        skinsSections = buildAllSkinsSections(t);
      } else {
        // Brigade special-case: Total view uses the daily-HC
        // aggregate (R2 hidden, HC applied only to R3).
        if (isBallynealBrigade(t) && !activeRoundId) {
          isBrigadeTotal = true;
          brigadeRows = buildBrigadeTotals(t, view);
          anyNetAvailable = brigadeRows.some((r) => r.overallNet != null);
        } else {
          rows = activeRoundId
            ? buildRoundLeaderboard(t, activeRoundId, view)
            : buildTotalLeaderboard(t, view);
          anyNetAvailable = rows.some((r) => r.net != null);
        }
      }
      ctpEntries = extractCtpEntries(t);
    }
  }
} catch (err: any) {
  loadError = err?.message ?? 'Could not load tournament.';
}

// Effective board (after the "only-show-if-format-supports-it" guards).
const showTeamsBoard = boardMode === 'teams'
  && (activeRoundId ? activeRoundIsBestBall : anyBestBall);
const showMatchBoard = boardMode === 'matches'
  && (activeRoundId ? activeRoundIsMatchPlay : anyMatchPlay);
const showSkinsBoard = boardMode === 'skins' && anySkinsEnabled;

// Helper to build a URL for a toggle click that preserves the
// other params (so tapping "Net" doesn't kick you out of kiosk
// mode or reset the round selector).
function buildUrl(overrides: Record<string, string | null>): string {
  const next = new URL(Astro.request.url);
  for (const [k, v] of Object.entries(overrides)) {
    if (v == null) next.searchParams.delete(k);
    else next.searchParams.set(k, v);
  }
  return next.pathname + next.search;
}
---

<BaseLayout title={`${tournamentName} · Leaderboard · Bagpipe Golf`}>
  <!--
    Auto-refresh every 30s. Meta refresh (rather than JS polling)
    keeps the page dead-simple + works even when the browser tab
    is backgrounded on a clubhouse laptop that's plugged into an
    HDMI TV. Preserves all query params across refreshes so kiosk
    mode + sort toggle + round selector all persist.
  -->
  <meta http-equiv="refresh" content="30" slot="head" />

  <main class={`pagewrap ${kiosk ? 'kiosk' : ''}`}>
    {!kiosk && (
      <>
        <p class="pagewrap__eyebrow">Tournament · leaderboard</p>
        <h1 class="pagewrap__title">{tournamentName}</h1>
        {courseName && (
          <p class="pagewrap__sub">{courseName}</p>
        )}
        {id && <TournamentSubnav id={id} active="leaderboard" />}

        <div class="toolbar">
          {(anyBestBall || anyMatchPlay) && (
            <div class="segmented">
              <a
                class={`seg ${!showTeamsBoard && !showMatchBoard ? 'seg--active' : ''}`}
                href={buildUrl({ board: null })}
              >
                Individual
              </a>
              {anyBestBall && (
                <a
                  class={`seg ${showTeamsBoard ? 'seg--active' : ''}`}
                  href={buildUrl({ board: 'teams' })}
                  title={
                    activeRoundId && !activeRoundIsBestBall
                      ? 'Team standings only on Best Ball rounds — pick one to enable.'
                      : 'Best Ball team standings'
                  }
                >
                  Teams
                </a>
              )}
              {anyMatchPlay && (
                <a
                  class={`seg ${showMatchBoard ? 'seg--active' : ''}`}
                  href={buildUrl({ board: 'matches' })}
                  title={
                    activeRoundId && !activeRoundIsMatchPlay
                      ? 'Match Board only on match-play rounds — pick one to enable.'
                      : 'Cup-style head-to-head match board'
                  }
                >
                  Matches
                </a>
              )}
              {anySkinsEnabled && (
                <a
                  class={`seg ${showSkinsBoard ? 'seg--active' : ''}`}
                  href={buildUrl({ board: 'skins' })}
                  title="Skins pools (per-flight + Super Skins)"
                >
                  Skins
                </a>
              )}
            </div>
          )}

          {!showTeamsBoard && !showMatchBoard && !showSkinsBoard && anyNetAvailable && (
            <div class="segmented">
              <a
                class={`seg ${view === 'gross' ? 'seg--active' : ''}`}
                href={buildUrl({ view: null })}
              >
                Gross
              </a>
              <a
                class={`seg ${view === 'net' ? 'seg--active' : ''}`}
                href={buildUrl({ view: 'net' })}
              >
                Net
              </a>
            </div>
          )}

          <a
            class="btn btn--primary"
            href={buildUrl({ kiosk: '1' })}
            title="Open kiosk mode (fullscreen-friendly big-print for TV)"
          >
            📺 Kiosk
          </a>
          <button
            id="fs-btn"
            class="btn btn--ghost"
            type="button"
          >
            ⛶ Fullscreen
          </button>
          <span class="muted small">
            Auto-refresh · 30s
          </span>
        </div>

        {rounds.length > 1 && (
          <div class="round-strip">
            <a
              class={`round-chip ${activeRoundId == null ? 'round-chip--active' : ''}`}
              href={buildUrl({ round: null })}
            >
              Total
            </a>
            {rounds.map((r) => (
              <a
                class={`round-chip ${activeRoundId === r.id ? 'round-chip--active' : ''}`}
                href={buildUrl({ round: r.id })}
              >
                {r.name}
              </a>
            ))}
          </div>
        )}
      </>
    )}

    {kiosk && (
      <div class="kiosk-header">
        <div class="kiosk-title">{tournamentName}</div>
        <div class="kiosk-sub">
          {courseName && <span>{courseName}</span>}
          {activeRoundId && (
            <span class="kiosk-round">
              {' · '}
              {rounds.find((r) => r.id === activeRoundId)?.name}
            </span>
          )}
          <span class="kiosk-view">
            {' · '}
            {view === 'net' ? 'NET' : 'GROSS'}
          </span>
        </div>
        <div class="kiosk-mode-toggle">
          <a href={buildUrl({ kiosk: null })} class="btn btn--ghost small">Exit kiosk</a>
        </div>
      </div>
    )}

    {loadError && (
      <article class="card card--warn">
        <h3>Could not load leaderboard</h3>
        <p>{loadError}</p>
      </article>
    )}

    {notFound && !loadError && (
      <article class="card">
        <h3>Tournament not found</h3>
        <p>
          Double-check the id in the URL. If the tournament was recently
          created, it may take a moment to sync.
        </p>
      </article>
    )}

    {!loadError && !notFound && !showTeamsBoard && !showMatchBoard && !showSkinsBoard && rows.length === 0 && brigadeRows.length === 0 && (
      <article class="card">
        <h3>No scores yet</h3>
        <p>
          The leaderboard fills in as scorekeepers enter scores. This
          page refreshes automatically every 30 seconds.
        </p>
      </article>
    )}

    {!loadError && !notFound && showTeamsBoard && teamRows.length === 0 && (
      <article class="card">
        <h3>No team scores yet</h3>
        <p>
          Team standings fill in as scorekeepers enter Best Ball scores. Auto-refreshes every 30 seconds.
        </p>
      </article>
    )}

    {!loadError && !notFound && isBrigadeTotal && brigadeRows.length > 0 && (
      <>
        <p class="brigade-caption muted small">
          Total = Sun HDCP applied to Round 3 only. Round 2 hidden
          (daily allowance format). Sort: <strong>{view === 'net' ? 'Net' : 'Gross'}</strong>.
        </p>
        <table class="lbtable">
          <thead>
            <tr>
              <th class="col-rank">#</th>
              <th class="col-name">Player</th>
              <th class="col-num">Total</th>
              <th class="col-num">R3</th>
              <th class="col-num">Gross</th>
              <th class="col-num">HDCP</th>
              <th class="col-num">Net</th>
            </tr>
          </thead>
          <tbody>
            {brigadeRows.map((r) => (
              <tr>
                <td class="col-rank">{r.rank}</td>
                <td class="col-name">{r.name}</td>
                <td class="col-num">{r.r1PlusR2}</td>
                <td class="col-num">{r.r3Gross ?? '—'}</td>
                <td class="col-num"><strong>{r.overallGross}</strong></td>
                <td class="col-num">{r.r3Hdcp ?? '—'}</td>
                <td class="col-num"><strong>{r.overallNet ?? '—'}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )}

    {!loadError && !notFound && !isBrigadeTotal && !showTeamsBoard && !showMatchBoard && !showSkinsBoard && rows.length > 0 && (
      <table class="lbtable">
        <thead>
          <tr>
            <th class="col-rank">#</th>
            <th class="col-name">Player</th>
            <th class="col-thru">Thru</th>
            {view === 'net' ? (
              <>
                <th class="col-hc">HC</th>
                <th class="col-net">Net</th>
                <th class="col-vs">vs Par</th>
              </>
            ) : (
              <>
                <th class="col-gross">Gross</th>
                <th class="col-vs">vs Par</th>
              </>
            )}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => {
            const vsPar = view === 'net' ? r.netVsPar : r.grossVsPar;
            const primary = view === 'net' ? r.net : r.gross;
            const vsClass =
                vsPar == null ? 'even' : vsPar < 0 ? 'under' : vsPar > 0 ? 'over' : 'even';
            return (
              <tr>
                <td class="col-rank">{r.rank}</td>
                <td class="col-name">{r.name}</td>
                <td class="col-thru">{r.thru}</td>
                {view === 'net' && (
                  <td class="col-hc">{r.courseHandicapAvg ?? '—'}</td>
                )}
                <td class={view === 'net' ? 'col-net' : 'col-gross'}>
                  {primary ?? '—'}
                </td>
                <td class={`col-vs ${vsClass}`}>
                  {vsPar == null ? '—' : formatVsPar(vsPar)}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )}

    {!loadError && !notFound && showTeamsBoard && teamRows.length > 0 && (
      <table class="lbtable">
        <thead>
          <tr>
            <th class="col-rank">#</th>
            <th class="col-name">Team</th>
            <th class="col-thru">Holes</th>
            <th class="col-gross">Gross</th>
            <th class="col-net">Net</th>
            <th class="col-vs">vs Par</th>
          </tr>
        </thead>
        <tbody>
          {teamRows.map((r) => {
            const vsClass =
                r.netVsPar < 0 ? 'under'
                : r.netVsPar > 0 ? 'over'
                : 'even';
            return (
              <tr>
                <td class="col-rank">{r.rank}</td>
                <td class="col-name">
                  <div class="team-name">{r.teamName}</div>
                  <div class="team-players">{r.playerNames.join(' · ')}</div>
                </td>
                <td class="col-thru">{r.holesPlayed}</td>
                <td class="col-gross">{r.gross}</td>
                <td class="col-net">{r.net}</td>
                <td class={`col-vs ${vsClass}`}>{formatVsPar(r.netVsPar)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )}

    {!loadError && !notFound && showMatchBoard && matchGroups.length === 0 && (
      <article class="card">
        <h3>No matches yet</h3>
        <p>
          The Match Board fills in as scorekeepers post scores on
          match-play rounds. Auto-refreshes every 30 seconds.
        </p>
      </article>
    )}

    {!loadError && !notFound && showMatchBoard && matchGroups.length > 0 && (
      <div class="matches">
        {matchGroups.map((group) => (
          <section class="match-round">
            {matchGroups.length > 1 && (
              <h2 class="match-round__title">{group.round.name}</h2>
            )}
            <div class="match-list">
              {group.matches.map((m) => {
                const t1Winning = m.holesUp > 0 || (m.complete && m.holesUp === 0);
                const t2Winning = m.holesUp < 0 || (m.complete && m.holesUp === 0);
                const t1Cls = m.complete
                  ? (m.holesUp > 0 ? 'match-side--won' : m.holesUp === 0 ? 'match-side--halved' : 'match-side--lost')
                  : m.holesUp > 0 ? 'match-side--leading' : m.holesUp === 0 ? 'match-side--tied' : '';
                const t2Cls = m.complete
                  ? (m.holesUp < 0 ? 'match-side--won' : m.holesUp === 0 ? 'match-side--halved' : 'match-side--lost')
                  : m.holesUp < 0 ? 'match-side--leading' : m.holesUp === 0 ? 'match-side--tied' : '';
                return (
                  <article class={`match-card ${m.complete ? 'match-card--complete' : ''}`}>
                    <div class={`match-side ${t1Cls}`}>
                      <div class="match-team">{m.team1.name}</div>
                      <div class="match-players">{m.team1.playerNames.join(' · ')}</div>
                    </div>
                    <div class="match-vs">
                      <div class="match-status">{m.statusLabel}</div>
                      <div class="match-thru">
                        {m.complete ? 'Final' : `Thru ${m.holesPlayed} / ${m.totalHoles}`}
                      </div>
                    </div>
                    <div class={`match-side match-side--right ${t2Cls}`}>
                      <div class="match-team">{m.team2.name}</div>
                      <div class="match-players">{m.team2.playerNames.join(' · ')}</div>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    )}

    {!loadError && !notFound && showSkinsBoard && skinsSections.length === 0 && (
      <article class="card">
        <h3>No skins won yet</h3>
        <p>
          Skins pools fill in as scorekeepers enter scores. Ties carry
          forward — a hole must have a strict low to award a skin.
          Auto-refreshes every 30 seconds.
        </p>
      </article>
    )}

    {!loadError && !notFound && showSkinsBoard && skinsSections.length > 0 && (
      <div class="skins-sections">
        {skinsSections.map((s) => (
          <section class="skins-section">
            <h2 class="skins-title">{s.title}</h2>
            <table class="lbtable">
              <thead>
                <tr>
                  <th class="col-rank">#</th>
                  <th class="col-name">Player</th>
                  <th class="col-thru">Skins</th>
                </tr>
              </thead>
              <tbody>
                {s.rows.map((r) => (
                  <tr>
                    <td class="col-rank">{r.rank}</td>
                    <td class="col-name">{r.name}</td>
                    <td class="col-thru">{r.skinsWon}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        ))}
      </div>
    )}

    {!loadError && !notFound && ctpEntries.length > 0 && (
      <section class="ctp-section">
        <h2 class="ctp-title">Closest to Pin</h2>
        <table class="ctptable">
          <thead>
            <tr>
              <th>Round</th>
              <th>Hole</th>
              <th>Winner</th>
            </tr>
          </thead>
          <tbody>
            {ctpEntries.map((c) => (
              <tr>
                <td>{c.roundName}</td>
                <td>#{c.hole}</td>
                <td>{c.winnerName}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}
  </main>
</BaseLayout>

<script>
  const btn = document.getElementById('fs-btn');
  if (btn) {
    btn.addEventListener('click', () => {
      const el = document.documentElement as unknown as {
        requestFullscreen?: () => Promise<void>;
        webkitRequestFullscreen?: () => Promise<void>;
      };
      try {
        (el.requestFullscreen ?? el.webkitRequestFullscreen)?.call(el);
      } catch (e) {
        console.warn('Fullscreen request failed', e);
      }
    });
  }
</script>

<style>
  .toolbar {
    display: flex;
    gap: 12px;
    align-items: center;
    margin: 12px 0 12px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .btn--primary {
    background: var(--brand-green);
    color: white;
  }
  .btn--ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--divider);
  }
  .btn.small {
    padding: 6px 10px;
    font-size: 13px;
  }
  .muted {
    color: var(--ink-muted);
  }
  .small {
    font-size: 13px;
  }

  /* Segmented Gross/Net toggle */
  .segmented {
    display: inline-flex;
    border: 1px solid var(--divider);
    border-radius: 8px;
    overflow: hidden;
  }
  .seg {
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    background: transparent;
  }
  .seg + .seg {
    border-left: 1px solid var(--divider);
  }
  .seg--active {
    background: var(--brand-green);
    color: white;
  }

  /* Round chip strip */
  .round-strip {
    display: flex;
    gap: 8px;
    margin: 4px 0 16px;
    overflow-x: auto;
    padding-bottom: 4px;
  }
  .round-chip {
    padding: 6px 12px;
    border: 1px solid var(--divider);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .round-chip--active {
    background: var(--brand-green);
    color: white;
    border-color: var(--brand-green);
  }

  .lbtable {
    width: 100%;
    border-collapse: collapse;
    margin-top: 8px;
  }
  .lbtable th,
  .lbtable td {
    padding: 12px 8px;
    text-align: left;
    border-bottom: 1px solid var(--divider);
  }
  .lbtable th {
    font-size: 12px;
    letter-spacing: 0.6px;
    font-weight: 800;
    color: var(--ink-muted);
    text-transform: uppercase;
  }
  .lbtable .col-rank {
