---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createSupabaseClient } from '../lib/supabase';

let error: string | null = null;
let info: string | null = null;
const url = new URL(Astro.request.url);
const next = url.searchParams.get('next') || '/app';
let prefillEmail = '';
let prefillFirst = '';
let prefillLast = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = (form.get('email') ?? '').toString().trim();
  const password = (form.get('password') ?? '').toString();
  const confirm = (form.get('confirm') ?? '').toString();
  const firstName = (form.get('firstName') ?? '').toString().trim();
  const lastName = (form.get('lastName') ?? '').toString().trim();
  prefillEmail = email;
  prefillFirst = firstName;
  prefillLast = lastName;

  // "First Last", the same display name the app builds at signup.
  const displayName = [firstName, lastName].filter(Boolean).join(' ').trim();

  if (!firstName || !lastName) {
    error = 'Enter your first and last name.';
  } else if (!email || !password) {
    error = 'Email and password are required.';
  } else if (password.length < 8) {
    error = 'Password must be at least 8 characters.';
  } else if (password !== confirm) {
    error = 'Passwords do not match.';
  } else {
    try {
      const supabase = createSupabaseClient({
        request: Astro.request,
        cookies: Astro.cookies,
        locals: Astro.locals,
      });
      const { data, error: authErr } = await supabase.auth.signUp({
        email,
        password,
        options: {
          // Carry `next` through the confirmation link.
          //
          // Email confirmation is OFF on this project today — 178 of 179
          // users were confirmed within 2s of creation and none are
          // unconfirmed — so `signUp` returns a session and the redirect
          // below is what actually runs.
          //
          // But that is a Supabase setting, not a guarantee. If anyone
          // turns confirmations on, this link is the only way back, and
          // without `next` it would drop every cold invite recipient on
          // /app instead of the invite they were accepting. `/login`
          // already honours `next`, so this costs nothing and removes a
          // silent failure that would look like "invites are broken".
          emailRedirectTo: new URL(
            `/login?next=${encodeURIComponent(next.startsWith('/') ? next : '/app')}`,
            Astro.request.url,
          ).toString(),
        },
      });
      if (authErr) {
        error = authErr.message || 'Sign-up failed.';
      } else if (data.session) {
        // Persist "First Last" over the trigger's default.
        //
        // `handle_new_user` seeds profiles.display_name with
        // split_part(email, '@', 1), so without this a new member shows
        // up on a league roster as "jsmith". The app does the same
        // write for the same reason (AuthNotifier.signUp).
        //
        // PARTIAL update, display_name only — deliberately. A full
        // profile write would carry model defaults and could clobber a
        // handicap. The row already exists; the trigger made it.
        //
        // Best-effort: a blip here must not fail a signup that has
        // already succeeded. The fallback is the email local part,
        // which is wrong but harmless and editable.
        if (displayName && data.user?.id) {
          try {
            await supabase
              .from('profiles')
              .update({ display_name: displayName })
              .eq('id', data.user.id);
          } catch (e) {
            console.error('[signup] display_name write failed', e);
          }
        }
        return Astro.redirect(next.startsWith('/') ? next : '/app', 303);
      } else {
        // Email confirmation required — no session returned.
        info = next !== '/app'
          ? `Check ${email} for a confirmation link. Opening it brings you straight back here to finish.`
          : `Check ${email} for a confirmation link to finish signing up.`;
      }
    } catch (err: any) {
      console.error('[signup POST] auth call threw', err);
      error =
        'Sign-up is temporarily unavailable. Please try again in a moment. ' +
        (err?.message ? `(${err.message})` : '');
    }
  }
}
---

<BaseLayout title="Create account · Bagpipe Golf">
  <main class="pagewrap pagewrap--narrow">
    <p class="pagewrap__eyebrow">Create account</p>
    <h1 class="pagewrap__title">Join Bagpipe Golf.</h1>
    <p class="pagewrap__sub">
      One account works for the mobile app and this site.
    </p>

    <form method="post" class="card authform">
      {error && <div class="authform__error" role="alert">{error}</div>}
      {info && <div class="authform__info" role="status">{info}</div>}

      <div class="authform__row2">
        <label class="authform__field">
          <span class="authform__label">First name</span>
          <input
            name="firstName"
            type="text"
            autocomplete="given-name"
            autocapitalize="words"
            required
            value={prefillFirst}
            class="authform__input"
          />
        </label>
        <label class="authform__field">
          <span class="authform__label">Last name</span>
          <input
            name="lastName"
            type="text"
            autocomplete="family-name"
            autocapitalize="words"
            required
            value={prefillLast}
            class="authform__input"
          />
        </label>
      </div>
      <p class="authform__hint">
        This is the name other players see — on scorecards, leaderboards and
        league rosters.
      </p>

      <label class="authform__field">
        <span class="authform__label">Email</span>
        <input
          name="email"
          type="email"
          autocomplete="email"
          required
          value={prefillEmail}
          class="authform__input"
        />
      </label>

      <label class="authform__field">
        <span class="authform__label">Password</span>
        <input
          name="password"
          type="password"
          autocomplete="new-password"
          required
          minlength="8"
          class="authform__input"
        />
      </label>

      <label class="authform__field">
        <span class="authform__label">Confirm password</span>
        <input
          name="confirm"
          type="password"
          autocomplete="new-password"
          required
          minlength="8"
          class="authform__input"
        />
      </label>

      <button type="submit" class="btn btn--primary btn--block">Create account</button>

      <div class="authform__meta">
        <span>Already have an account? <a href={`/login?next=${encodeURIComponent(next)}`}>Sign in</a></span>
      </div>
    </form>
  </main>
</BaseLayout>

<style>
  .authform__row2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  @media (max-width: 420px) {
    .authform__row2 { grid-template-columns: 1fr; }
  }
  .authform__hint {
    font-size: 0.78125rem;
    color: var(--ink-muted, #4b5b54);
    margin: -4px 0 14px;
    line-height: 1.45;
  }

  .authform { display: grid; gap: 18px; margin-top: 8px; }
  .authform__error,
  .authform__info {
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 0.875rem;
    border-width: 1px;
    border-style: solid;
  }
  .authform__error {
    background: #FEF2F2;
    border-color: #FECACA;
    color: var(--error);
  }
  .authform__info {
    background: var(--brand-green-pale);
    border-color: var(--brand-green);
    color: var(--brand-green-dark);
  }
  .authform__field { display: grid; gap: 6px; }
  .authform__label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .authform__input {
    border: 1.5px solid var(--line);
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 1rem;
    font-family: inherit;
    background: #fff;
    transition: border-color 0.12s ease;
  }
  .authform__input:focus {
    outline: none;
    border-color: var(--brand-green);
    box-shadow: 0 0 0 4px rgba(26, 92, 56, 0.12);
  }
  .authform__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }
  .authform__meta a { font-weight: 600; }
</style>
