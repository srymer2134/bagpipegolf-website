<style>
  .prose {
    color: var(--ink);
    font-size: 0.969rem;
    line-height: 1.6;
  }
  .prose__lead {
    font-size: 1rem;
    color: var(--ink);
    margin: 0 0 28px;
  }
  .prose h2 {
    margin: 32px 0 10px;
    font-size: 1.25rem;
    color: var(--brand-green-dark);
    font-weight: 800;
  }
  .prose h2:first-of-type { margin-top: 8px; }
  .prose h3 {
    margin: 20px 0 8px;
    font-size: 1rem;
    color: var(--brand-green-dark);
    font-weight: 700;
  }
  .prose p {
    color: var(--ink);
    margin: 0 0 12px;
  }
  .prose ul {
    margin: 0 0 14px;
    padding-left: 22px;
  }
  .prose li {
    color: var(--ink);
    margin-bottom: 8px;
  }
  .prose__legal {
    font-size: 0.875rem;
    color: var(--ink-muted);
    background: var(--paper-tint);
    border-left: 3px solid var(--line);
    padding: 12px 14px;
    border-radius: 4px;
  }
  .prose__meta {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: var(--ink-hint);
    font-size: 0.812rem;
  }
  .callout {
    padding: 14px 16px;
    border-radius: 10px;
    margin: 0 0 16px;
    font-size: 0.938rem;
  }
  .callout--warn {
    background: #FEF3C7;
    color: #78350F;
    border: 1px solid #FDE68A;
  }
</style>
