<BaseLayout title="Terms of Service · Bagpipe Golf">
  <main class="pagewrap pagewrap--narrow">
    <p class="pagewrap__eyebrow">Legal</p>
    <h1 class="pagewrap__title">Terms of service.</h1>
    <p class="pagewrap__sub">
      Last updated: <strong>November 9, 2026</strong>.
    </p>

    <article class="card prose">
      <p class="prose__lead">
        These Terms of Service ("Terms") are an agreement between you and
        <strong>Taybuta, Inc.</strong>, a Wyoming corporation with its
        principal place of business in Colorado, doing business as Bagpipe
