---
// Shared head + frame for every page on bagpipegolf.com.
// Single-file marketing site for v1 — extract a nav bar + footer
// component once the site grows past one route.

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Bagpipe Golf — the on-course caddie, scorecard, and side-bet engine for golfers and tournament directors.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
    <style is:global>
      /* Bagpipe Golf brand — mirrors lib/core/constants/app_colors.dart
         in the Flutter app so the marketing site reads as the same product. */
      :root {
        --brand-green: #1A5C38;       /* AppColors.primary */
        --brand-green-dark: #0F3D25;  /* AppColors.primaryDark */
        --brand-green-pale: #E8F5EE;  /* AppColors.primaryLight */
        --ink: #1A1A1A;               /* AppColors.textPrimary */
        --ink-muted: #6B7280;         /* AppColors.textSecondary */
        --ink-hint: #9CA3AF;          /* AppColors.textHint */
        --paper: #FFFFFF;             /* AppColors.surface */
        --paper-tint: #F5F5F5;        /* AppColors.surfaceVariant */
        --line: #E5E7EB;              /* AppColors.divider */
        --success: #16A34A;
        --warning: #D97706;
        --error: #DC2626;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text",
          "Segoe UI", system-ui, sans-serif;
        background: var(--paper);
        color: var(--ink);
        font-size: 17px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3 {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
          "Segoe UI", system-ui, sans-serif;
        letter-spacing: -0.01em;
        margin: 0;
      }
      a { color: var(--brand-green); }
      a:hover { color: var(--brand-green-dark); }
      img { max-width: 100%; height: auto; display: block; }
    </style>
  </body>
</html>
