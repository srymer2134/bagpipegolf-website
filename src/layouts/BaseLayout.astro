---
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  // Pages that ship their own full-bleed chrome (the landing hero today)
  // can opt out of the standard nav + footer. Default false = standard chrome.
  bare?: boolean;
}

const {
  title,
  description = "Bagpipe Golf — the on-course caddie, scorecard, and side-bet engine for golfers and tournament directors.",
  bare = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {!bare && <SiteNav />}
    <slot />
    {!bare && <Footer />}

    <style is:global>
      /* Bagpipe Golf brand — mirrors lib/core/constants/app_colors.dart
         in the Flutter app so the marketing site reads as the same product. */
      :root {
        --brand-green: #1A5C38;
        --brand-green-dark: #0F3D25;
        --brand-green-pale: #E8F5EE;
        --ink: #1A1A1A;
        --ink-muted: #6B7280;
        --ink-hint: #9CA3AF;
        --paper: #FFFFFF;
        --paper-tint: #F5F5F5;
        --line: #E5E7EB;
        --success: #16A34A;
        --warning: #D97706;
        --error: #DC2626;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text",
          "Segoe UI", system-ui, sans-serif;
        background: var(--paper);
        color: var(--ink);
        font-size: 17px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3 {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
          "Segoe UI", system-ui, sans-serif;
        letter-spacing: -0.01em;
        margin: 0;
      }
      a { color: var(--brand-green); }
      a:hover { color: var(--brand-green-dark); }
      img { max-width: 100%; height: auto; display: block; }

      /* ── Shared button styles (used by nav, page CTAs, forms) ─────── */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 14px 22px;
        font-size: 16px;
        font-weight: 700;
        border-radius: 999px;
        text-decoration: none;
        border: 2px solid transparent;
        cursor: pointer;
        transition: transform 0.06s ease, box-shadow 0.12s ease, background 0.12s ease, color 0.12s ease;
        font-family: inherit;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn--primary {
        background: var(--brand-green);
        color: #fff;
        box-shadow: 0 4px 14px rgba(26, 92, 56, 0.28);
      }
      .btn--primary:hover { background: var(--brand-green-dark); color: #fff; }
      .btn--ghost {
        background: transparent;
        color: var(--brand-green);
        border-color: var(--brand-green);
      }
      .btn--ghost:hover { background: var(--brand-green); color: #fff; }
      .btn--block { width: 100%; }
      .btn[disabled] { opacity: 0.55; cursor: not-allowed; transform: none; }

      /* ── Shared page chrome for stub pages ───────────────────────── */
      .pagewrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 56px 24px 32px;
      }
      .pagewrap--narrow { max-width: 720px; }
      .pagewrap__eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 12px;
        font-weight: 800;
        color: var(--brand-green);
        margin-bottom: 12px;
      }
      .pagewrap__title {
        font-size: clamp(32px, 4.5vw, 48px);
        font-weight: 800;
        color: var(--brand-green-dark);
        margin-bottom: 12px;
        line-height: 1.1;
      }
      .pagewrap__sub {
        font-size: 18px;
        color: var(--ink-muted);
        margin: 0 0 28px;
        max-width: 64ch;
      }

      .card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 26px 22px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }

      .grid { display: grid; gap: 20px; }
      .grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      @media (max-width: 880px) {
        .grid--2, .grid--3 { grid-template-columns: 1fr; }
      }

      .chip {
        display: inline-block;
        background: var(--brand-green-pale);
        color: var(--brand-green-dark);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 999px;
      }
      .chip--muted {
        background: var(--paper-tint);
        color: var(--ink-muted);
      }
      .chip--warn {
        background: #FEF3C7;
        color: #92400E;
      }
    </style>
  </body>
</html>
