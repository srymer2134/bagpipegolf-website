---
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Title used for SHARE PREVIEWS (og:title / twitter:title) when it
   *  should differ from the browser-tab `<title>`.
   *
   *  Sam, 2026-10-01: sharing a link showed "Bagpipe Golf — Play games.
   *  Settle scores." because og:title was wired straight to `title`, and
   *  the tagline rode along. The brand should lead in a preview. The
   *  `<title>` keeps the tagline — it is a real search signal and a
   *  preview is not the place it earns anything.
   *
   *  Defaults to `title`, so every other page keeps its own specific
   *  preview headline (a side-game page sharing as "Wolf golf game:
   *  rules…" is far more useful than sharing as "Bagpipe Golf"). */
  ogTitle?: string;
  // Pages that ship their own full-bleed chrome (the landing hero today)
  // can opt out of the standard nav + footer. Default false = standard chrome.
  bare?: boolean;
}

const {
  title,
  ogTitle,
  description = "Bagpipe Golf — the on-course caddie, scorecard, and side-game engine for golfers and tournament directors.",
  bare = false,
} = Astro.props;

const SITE = Astro.site ?? new URL('https://bagpipegolf.com');
const shareTitle = ogTitle ?? title;
// og:url was `Astro.site` on EVERY page, so each one claimed to be the
// home page. Scrapers de-duplicate on it, which is why distinct pages
// could preview as the same thing.
const pageUrl = new URL(Astro.url.pathname, SITE).toString();
// Purpose-built 1200x630 share card (public/og.jpg), rendered from the
// brand tokens with the logo on a pale tile. Replaces both the original
// `/og.png` (which 404'd, so previews had no image at all) and the square
// logo stopgap, which a large card would have centre-cropped.
const shareImage = new URL('/og.jpg', SITE).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Direct JPG favicon — earlier SVG hack that used <image href> to
         embed the JPG failed because browsers don't fetch external
         references inside SVG favicons. Direct JPG works everywhere. -->
    <link rel="icon" type="image/jpeg" href="/bagpipe-golf-logo.jpg" />
    <link rel="apple-touch-icon" href="/bagpipe-golf-logo.jpg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Bagpipe Golf" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bagpipe Golf — play games, settle scores." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
  </head>
  <body>
    {!bare && <SiteNav />}
    <slot />
    {!bare && <Footer />}

    <style is:global>
      /* Bagpipe Golf brand — mirrors lib/core/constants/app_colors.dart
         in the Flutter app so the marketing site reads as the same product. */
      :root {
        --brand-green: #1A5C38;
        --brand-green-dark: #0F3D25;
        --brand-green-pale: #E8F5EE;
        --ink: #1A1A1A;
        --ink-muted: #6B7280;
        --ink-hint: #9CA3AF;
        --paper: #FFFFFF;
        --paper-tint: #F5F5F5;
        --line: #E5E7EB;
        --success: #16A34A;
        --warning: #D97706;
        --error: #DC2626;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text",
          "Segoe UI", system-ui, sans-serif;
        background: var(--paper);
        color: var(--ink);
        font-size: 1.0625rem;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3 {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
          "Segoe UI", system-ui, sans-serif;
        letter-spacing: -0.01em;
        margin: 0;
      }
      a { color: var(--brand-green); }
      a:hover { color: var(--brand-green-dark); }
      img { max-width: 100%; height: auto; display: block; }

      /* ── Shared button styles (used by nav, page CTAs, forms) ─────── */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 14px 22px;
        font-size: 1rem;
        font-weight: 700;
        border-radius: 999px;
        text-decoration: none;
        border: 2px solid transparent;
        cursor: pointer;
        transition: transform 0.06s ease, box-shadow 0.12s ease, background 0.12s ease, color 0.12s ease;
        font-family: inherit;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn--primary {
        background: var(--brand-green);
        color: #fff;
        box-shadow: 0 4px 14px rgba(26, 92, 56, 0.28);
      }
      .btn--primary:hover { background: var(--brand-green-dark); color: #fff; }
      .btn--ghost {
        background: transparent;
        color: var(--brand-green);
        border-color: var(--brand-green);
      }
      .btn--ghost:hover { background: var(--brand-green); color: #fff; }
      .btn--block { width: 100%; }
      .btn[disabled] { opacity: 0.55; cursor: not-allowed; transform: none; }

      /* ── Shared page chrome for stub pages ───────────────────────── */
      .pagewrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 56px 24px 32px;
      }
      .pagewrap--narrow { max-width: 720px; }
      .pagewrap__eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--brand-green);
        margin-bottom: 12px;
      }
      .pagewrap__title {
        font-size: clamp(2rem, 4.5vw, 3rem);
        font-weight: 800;
        color: var(--brand-green-dark);
        margin-bottom: 12px;
        line-height: 1.1;
      }
      .pagewrap__sub {
        font-size: 1.125rem;
        color: var(--ink-muted);
        margin: 0 0 28px;
        max-width: 64ch;
      }

      .card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 26px 22px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      }

      .grid { display: grid; gap: 20px; }
      .grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      @media (max-width: 880px) {
        .grid--2, .grid--3 { grid-template-columns: 1fr; }
      }

      .chip {
        display: inline-block;
        background: var(--brand-green-pale);
        color: var(--brand-green-dark);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 999px;
      }
      .chip--muted {
        background: var(--paper-tint);
        color: var(--ink-muted);
      }
      .chip--warn {
        background: #FEF3C7;
        color: #92400E;
      }
      /* A chip that is a link to that game's rules. Reads as a chip
         first and a link second — no underline until hover, because a
         row of underlined chips looks like an error. */
      a.chip--link {
        text-decoration: none;
        transition: background 140ms ease, color 140ms ease;
      }
      a.chip--link:hover,
      a.chip--link:focus-visible {
        background: var(--brand-green-dark);
        color: #fff;
      }
    </style>
  </body>
</html>
