 "rules": [
  {
   "constraint": "leagues_tie_hole_points_chk",
   "sql": "check (tie_hole_points = 0 or tie_hole_points = points_per_hole / 2)",
   "fields": [
    "tie_hole_points",
    "points_per_hole"
   ],
   "summary": "tie_hole_points must be exactly 0 or half of points_per_hole"
  },
  {
   "constraint": "leagues_match_play_format_chk",
   "sql": "check (points_model <> 'match_play' or week_format in ('match_play_singles', 'two_singles_team', 'best_ball'))",
   "fields": [
    "points_model",
    "week_format"
   ],
   "summary": "when points_model is 'match_play', week_format must be one of match_play_singles, two_singles_team, best_ball"
  },
  {
   "constraint": "leagues_absent_rule_format_chk",
   "sql": "check (points_model <> 'match_play' or ( (absent_rule <> 'forfeit_hole' or week_format = 'best_ball') and (absent_rule <> 'against_par' or week_format in ('match_play_singles', 'two_singles_team'))))",
   "fields": [
    "points_model",
    "absent_rule",
    "week_format"
   ],
   "summary": "when points_model is 'match_play': absent_rule 'forfeit_hole' requires week_format 'best_ball', and 'against_par' requires a singles format (match_play_singles or two_singles_team)"
  },
  {
   "constraint": "leagues_allowance_pct_chk",
   "sql": "check (allowance_pct is null or allowance_pct between 50 and 100)",
   "fields": [
    "allowance_pct"
   ],
   "summary": "allowance_pct is null or between 50 and 100 inclusive"
  }
 ],
